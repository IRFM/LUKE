\end_inset 

 et finalement 
\begin_inset Formula \begin{eqnarray*}
\widetilde{D}_{(0)}^{\text{EC-O}(n)}(p,\xi_{0}) & \equiv & \sigma\left\{ \frac{\sigma\xi}{\xi_{0}}D^{\text{EC-O}(n)}(p,\xi)\right\} \\
