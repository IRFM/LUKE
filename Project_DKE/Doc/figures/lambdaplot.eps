/zzz xdef

/OurEncoding{ zzz StandardEncoding Re-encode }bdef

/EncodeFont	{
	findfont
	dup length dict begin
	{
		1 index /FID ne
		{ def }
		{ pop pop }
		ifelse
	} forall
	/FontName xdef
	/Encoding xdef
	FontName currentdict
	end
	definefont pop
} bind def

