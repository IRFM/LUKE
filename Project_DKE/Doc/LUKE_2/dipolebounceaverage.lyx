\begin_body

\begin_layout Title
Bounce-averaged collision operator in dipole geometry
\end_layout

\begin_layout Author
François-Xavier DUTHOIT
\end_layout

\begin_layout Standard
\begin_inset FormulaMacro
\newcommand{\bhat}{\widehat{\mathsf{b}}}
\end_inset


\begin_inset FormulaMacro
\newcommand{\extd}{\mathsf{d}}
\end_inset


\end_layout

\begin_layout Section
Coordinate transformation for the guiding-center collision operator
\end_layout

\begin_layout Subsection
\begin_inset Formula $\xi\rightarrow\xi_{0}$
\end_inset

 Coordinate transformation
\end_layout

\begin_layout Standard
Due to the conservation of the magnetic moment, we have the following relation,
 zero indices indicating the values at the minimum field point :
\begin_inset Formula \begin{equation}
\frac{1-\xi^{2}}{B}=\frac{1-\xi_{0}^{2}}{B_{0}}\end{equation}

\end_inset

We can therefore deduce :
\begin_inset Formula \begin{equation}
\extd\xi_{0}=\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\ln\frac{B_{0}}{B}\cdot\extd\mathbf{x}+\frac{B_{0}\xi}{B\xi_{0}}\extd\xi\end{equation}

\end_inset

The Jacobian for the transformation reads :
\begin_inset Formula \begin{equation}
J_{\xi_{0}}=\left(\frac{\partial\xi_{0}}{\partial\xi}\right)^{-1}=\frac{B\xi_{0}}{B_{0}\xi}\end{equation}

\end_inset

The guiding-center Jacobian therefore reads :
\begin_inset Formula \begin{equation}
\boxed{\mathcal{J}_{gc}=p^{2}\frac{B\xi_{0}}{B_{0}\xi}}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Guiding-center coefficients
\end_layout

\begin_layout Standard
Since we will be working with a dipole magnetic field, we will use the guiding-c
enter coefficients with 
\begin_inset Formula $\bhat\cdot\nabla\times\bhat=0$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{K}_{gc}^{\xi_{0}}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{K}_{gc}^{\xi_{0}}$
\end_inset

 reads :
\begin_inset Formula \begin{eqnarray}
\mathcal{K}_{gc}^{\xi_{0}} & = & \mathcal{K}_{gc}^{\xi}\frac{\partial\xi_{0}}{\partial\xi}\nonumber \\
 & = & \boxed{0}\label{eq:-6}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\mathbf{X}}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\mathbf{X}}$
\end_inset

 reads, at first order in 
\begin_inset Formula $\epsilon_{B}$
\end_inset

 :
\begin_inset Formula \begin{eqnarray}
\mathcal{D}_{gc}^{\xi_{0}\mathbf{X}} & = & \nabla\xi_{0}\cdot\mathcal{D}_{gc}^{\mathbf{XX}}+\frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi\mathbf{X}}\nonumber \\
 & = & \boxed{\frac{1-\xi_{0}^{2}}{2\xi_{0}}\mathcal{D}^{X}\nabla_{\perp}\ln\frac{B_{0}}{B}+\frac{B_{0}\xi}{B\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}}\label{eq:-5}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}p}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}p}$
\end_inset

 reads, at first order in 
\begin_inset Formula $\epsilon_{B}$
\end_inset

 :
\begin_inset Formula \begin{eqnarray}
\mathcal{D}_{gc}^{\xi_{0}p} & = & \nabla\xi_{0}\cdot\mathcal{D}_{gc}^{\mathbf{X}p}+\frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi p}\nonumber \\
 & \simeq & \frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi p}\nonumber \\
 & = & \boxed{0}\label{eq:-4}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\xi_{0}}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\xi_{0}}$
\end_inset

 reads, at first order in 
\begin_inset Formula $\epsilon_{B}$
\end_inset

 :
\begin_inset Formula \begin{eqnarray}
\mathcal{D}_{gc}^{\xi_{0}\xi_{0}} & = & \nabla\xi_{0}\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\xi_{0}+\mathcal{D}_{gc}^{\xi\xi}\left(\frac{\partial\xi_{0}}{\partial\xi}\right)^{2}+2\frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\xi_{0}\nonumber \\
 & \simeq & \mathcal{D}_{gc}^{\xi\xi}\left(\frac{\partial\xi_{0}}{\partial\xi}\right)^{2}\nonumber \\
 & = & \frac{1-\xi^{2}}{p^{2}}\mathcal{D}_{t}\left(\frac{B_{0}\xi}{B\xi_{0}}\right)^{2}\nonumber \\
 & = & \boxed{\frac{1-\xi_{0}^{2}}{p^{2}}\mathcal{D}_{t}\frac{B_{0}\xi^{2}}{B\xi_{0}^{2}}}\label{eq:-3}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Collision operator
\end_layout

\begin_layout Standard
The expression for the guiding-center collision operator in 
\begin_inset Formula $\left(\mathbf{x},p,\xi\right)$
\end_inset

 coordinates reads, noting 
\begin_inset Formula $\mathcal{V}$
\end_inset

 the spatial Jacobian :
\begin_inset Formula \begin{eqnarray}
C_{gc}\left[\overline{F}\right] & = & -\frac{1}{\mathcal{V}\mathcal{J}_{gc}}\frac{\partial}{\partial z^{\alpha}}\left[\mathcal{V}\mathcal{J}_{gc}\left(\mathcal{K}_{gc}^{\alpha}\overline{F}-\mathcal{D}_{gc}^{\alpha\beta}\frac{\partial\overline{F}}{\partial z^{\beta}}\right)\right]\nonumber \\
 & = & \frac{1}{p^{2}}\frac{\partial}{\partial p}\left[p^{3}\nu\overline{F}+p\mathcal{D}_{\ell}\left(p\frac{\partial\overline{F}}{\partial p}-\bar{\boldsymbol{\rho}}_{gc}\cdot\nabla\overline{F}\right)\right]\nonumber \\
 &  & +\frac{\xi}{\xi_{0}}\frac{\partial}{\partial\xi_{0}}\left[\frac{\xi}{\xi_{0}}\left(1-\xi_{0}^{2}\right)\frac{\mathcal{D}_{t}}{p^{2}}\frac{\partial\overline{F}}{\partial\xi_{0}}+\left(\frac{B}{B_{0}}\frac{1-\xi_{0}^{2}}{2\xi}\mathcal{D}^{X}\nabla_{\perp}\ln\frac{B_{0}}{B}+\mathcal{D}_{gc}^{\xi\mathbf{X}}\right)\cdot\nabla\overline{F}\right]\nonumber \\
 &  & +\frac{B_{0}\xi}{B\xi_{0}}\nabla\cdot\left[\frac{B\xi_{0}}{B_{0}\xi}\mathcal{D}^{X}\mathbb{I}_{\perp}\cdot\nabla\overline{F}+\mathcal{D}_{gc}^{\mathbf{X}\xi}\frac{\partial\overline{F}}{\partial\xi_{0}}-\frac{B\xi_{0}}{B_{0}\xi}\left(\nu\overline{F}+\frac{\mathcal{D}_{\ell}}{p}\frac{\partial\overline{F}}{\partial p}\right)\bar{\boldsymbol{\rho}}_{gc}\right]\label{eq:-2}\end{eqnarray}

\end_inset

with the following expressions :
\begin_inset Formula \begin{equation}
\bar{\boldsymbol{\rho}}_{gc}=-\frac{p^{2}}{2m^{2}\Omega^{2}}\left[\left(1-\xi^{2}\right)\nabla_{\perp}\ln B+2\xi^{2}\bhat\cdot\nabla\bhat\right]\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\mathcal{D}^{X}=\frac{1}{2m^{2}\Omega^{2}}\left[\left(\mathcal{D}_{\ell}-\mathcal{D}_{t}\right)\left(1-\xi^{2}\right)+2\mathcal{D}_{t}\right]\end{equation}

\end_inset


\begin_inset Formula \begin{equation}
\mathcal{D}_{gc}^{\mathbf{X}\xi}=\frac{\xi\left(1-\xi^{2}\right)}{2m^{2}\Omega^{2}}\left[\left(\mathcal{D}_{\ell}+\mathcal{D}_{t}\right)\bhat\cdot\nabla\bhat-\mathcal{D}_{t}\nabla_{\perp}\ln B\right]\end{equation}

\end_inset

Applying the transformation 
\begin_inset Formula $\xi\rightarrow\xi_{0}$
\end_inset

 gives the following expressions :
\begin_inset Formula \begin{equation}
\bar{\boldsymbol{\rho}}_{gc}=-\frac{p^{2}}{2m^{2}\Omega^{2}}\left[\frac{B}{B_{0}}\left(1-\xi_{0}^{2}\right)\nabla_{\perp}\ln B+2\left(1-\frac{B}{B_{0}}\left(1-\xi_{0}^{2}\right)\right)\bhat\cdot\nabla\bhat\right]\label{eq:rhogcxi0}\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\mathcal{D}^{X}=\frac{1}{2m^{2}\Omega^{2}}\left[\frac{B}{B_{0}}\left(\mathcal{D}_{\ell}-\mathcal{D}_{t}\right)\left(1-\xi_{0}^{2}\right)+2\mathcal{D}_{t}\right]\end{equation}

\end_inset


\begin_inset Formula \begin{equation}
\mathcal{D}_{gc}^{\mathbf{X}\xi}=\frac{B}{B_{0}}\frac{\xi\left(1-\xi_{0}^{2}\right)}{2m^{2}\Omega^{2}}\left[\left(\mathcal{D}_{\ell}+\mathcal{D}_{t}\right)\bhat\cdot\nabla\bhat-\mathcal{D}_{t}\nabla_{\perp}\ln B\right]\label{eq:dxxixi0}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Dipole magnetic field
\end_layout

\begin_layout Standard
The expression for the dipole magnetic field produced by a magnetic dipole
 
\begin_inset Formula $M$
\end_inset

 in spherical 
\begin_inset Formula $\left(\rho,\vartheta,\phi\right)$
\end_inset

 coordinates reads :
\begin_inset Formula \begin{equation}
\mathbf{B}=B\bhat=\frac{\mu_{0}M}{4\pi\rho^{3}}\left(2\cos\vartheta\widehat{\rho}+\sin\vartheta\widehat{\vartheta}\right)=\nabla\psi\times\nabla\phi=B_{\vartheta}\nabla\vartheta+B_{\psi}\nabla\psi\end{equation}

\end_inset

Since 
\begin_inset Formula $\mathbf{B}\cdot\nabla\psi=0$
\end_inset

, we must have the property :
\begin_inset Formula \begin{equation}
B_{\psi}=-\frac{\nabla\vartheta\cdot\nabla\psi}{\left|\nabla\psi\right|^{2}}B_{\vartheta}\equiv\tilde{\alpha}\left(\psi,\vartheta\right)B_{\vartheta}\end{equation}

\end_inset

We can therefore deduce the expression for 
\begin_inset Formula $\bhat$
\end_inset

 :
\begin_inset Formula \begin{equation}
\boxed{\bhat=\frac{B_{\vartheta}}{B}\left(\nabla\vartheta+\tilde{\alpha}\nabla\psi\right)}\end{equation}

\end_inset

We can also deduce the gradient of the magnetic field :
\begin_inset Formula \begin{eqnarray}
\nabla B & = & \frac{\partial B}{\partial\psi}\nabla\psi+\frac{\partial B}{\partial\vartheta}\nabla\vartheta\nonumber \\
 & = & \left(\frac{\partial B}{\partial\psi}-\tilde{\alpha}\frac{\partial B}{\partial\vartheta}\right)\nabla\psi+\frac{B}{B^{\vartheta}}\frac{\partial B}{\partial\vartheta}\bhat\label{eq:-1}\end{eqnarray}

\end_inset

Since 
\begin_inset Formula $\nabla\times\mathbf{B}=0$
\end_inset

 due to dipole geometry, we can deduce :
\begin_inset Formula \begin{equation}
\nabla\times\bhat=-\frac{1}{B}\nabla B\times\bhat=\frac{1}{B}\left(\frac{\partial B}{\partial\psi}-\tilde{\alpha}\frac{\partial B}{\partial\vartheta}\right)\bhat\times\nabla\psi\end{equation}

\end_inset

We immediately see the relation 
\begin_inset Formula $\bhat\cdot\nabla\times\bhat=0$
\end_inset

.
 Using the expression for 
\begin_inset Formula $\nabla\times\bhat$
\end_inset

, we then calculate :
\begin_inset Formula \begin{equation}
\bhat\cdot\nabla\bhat=\left(\nabla\times\bhat\right)\times\bhat=\frac{1}{B}\left(\frac{\partial B}{\partial\psi}-\tilde{\alpha}\frac{\partial B}{\partial\vartheta}\right)\nabla\psi\end{equation}

\end_inset

The flux coordinate 
\begin_inset Formula $\psi$
\end_inset

 has the following expression :
\begin_inset Formula \begin{equation}
\psi=\frac{\mu_{0}M}{4\pi}\frac{\sin^{2}\vartheta}{\rho}\end{equation}

\end_inset

The gradient 
\begin_inset Formula $\nabla\psi$
\end_inset

 therefore reads :
\begin_inset Formula \begin{equation}
\nabla\psi=\frac{\mu_{0}M}{4\pi\rho^{2}}\sin\vartheta\left(2\cos\vartheta\widehat{\vartheta}-\sin\vartheta\widehat{\rho}\right)\end{equation}

\end_inset

The unit vector 
\begin_inset Formula $\widehat{\psi}=\nabla\psi/\left|\nabla\psi\right|$
\end_inset

 has the following expression :
\begin_inset Formula \begin{equation}
\widehat{\psi}=\frac{2\cos\vartheta}{\sqrt{1+3\cos^{2}\vartheta}}\widehat{\vartheta}-\frac{\sin\vartheta}{\sqrt{1+3\cos^{2}\vartheta}}\widehat{\rho}\end{equation}

\end_inset

We can deduce the spatial Jacobian for 
\begin_inset Formula $\left(\psi,\vartheta,\phi\right)$
\end_inset

 coordinates, with 
\begin_inset Formula $\widehat{\vartheta}=\rho\nabla\vartheta$
\end_inset

 and 
\begin_inset Formula $\widehat{\phi}=\rho\sin\vartheta\nabla\phi$
\end_inset

 :
\begin_inset Formula \begin{eqnarray}
\mathcal{V} & = & \left(\nabla\psi\times\nabla\phi\cdot\nabla\vartheta\right)^{-1}\nonumber \\
 & = & \left(\frac{\mu_{0}M}{4\pi\rho^{4}}\sin\vartheta\right)^{-1}\nonumber \\
 & = & \frac{1}{B}\frac{\rho\sqrt{1+3\cos^{2}\vartheta}}{\sin\vartheta}\nonumber \\
 & = & \boxed{\frac{1}{B}\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}}\label{eq:}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\bar{\boldsymbol{\rho}}_{gc}\cdot\nabla\psi$
\end_inset

 and 
\begin_inset Formula $\mathcal{D}_{gc}^{\mathbf{X}\xi}\cdot\nabla\psi$
\end_inset

 in magnetic dipole geometry
\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\nabla_{\perp}\ln B\cdot\nabla\psi=\nabla\ln B\cdot\nabla\psi=\frac{1}{B}\left(\frac{\partial B}{\partial\psi}-\tilde{\alpha}\frac{\partial B}{\partial\vartheta}\right)\left|\nabla\psi\right|^{2}$
\end_inset

 and 
\begin_inset Formula $\bhat\cdot\nabla\bhat\cdot\nabla\psi=\frac{1}{B}\left(\frac{\partial B}{\partial\psi}-\tilde{\alpha}\frac{\partial B}{\partial\vartheta}\right)\left|\nabla\psi\right|^{2}$
\end_inset

, we therefore have, using the expression for 
\begin_inset Formula $\bar{\boldsymbol{\rho}}_{gc}$
\end_inset

 found in (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:rhogcxi0"

\end_inset

) :
\begin_inset Formula \begin{equation}
\bar{\boldsymbol{\rho}}_{gc}\cdot\nabla\psi=-\frac{p^{2}\left|\nabla\psi\right|^{2}}{2m^{2}\Omega^{2}B}\left[2-\frac{B}{B_{0}}\left(1-\xi^{2}\right)\right]\left(\frac{\partial B}{\partial\psi}-\tilde{\alpha}\frac{\partial B}{\partial\vartheta}\right)\end{equation}

\end_inset

Likewise, using the expression for 
\begin_inset Formula $\mathcal{D}_{gc}^{\mathbf{X}\xi}$
\end_inset

 found in (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dxxixi0"

\end_inset

), we can deduce :
\begin_inset Formula \begin{equation}
\mathcal{D}_{gc}^{\mathbf{X}\xi}\cdot\nabla\psi=\frac{\xi\left(1-\xi_{0}^{2}\right)\left|\nabla\psi\right|^{2}}{2m^{2}\Omega^{2}B_{0}}\mathcal{D}_{\ell}\left(\frac{\partial B}{\partial\psi}-\tilde{\alpha}\frac{\partial B}{\partial\vartheta}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Section
Bounce-averaging operation
\end_layout

\begin_layout Subsection
Bounce time
\end_layout

\begin_layout Standard
The bounce time 
\begin_inset Formula $\tau_{b}$
\end_inset

 is defined as half a bounce period.
 Its expression reads :
\begin_inset Formula \begin{equation}
\tau_{b}\left(\psi\right)=\int_{s_{min}}^{s_{max}}\frac{ds}{\left|v_{\parallel}\right|}=\frac{1}{v\left|\xi_{0}\right|}\int_{\vartheta_{min}}^{\vartheta_{max}}d\vartheta\frac{\xi_{0}}{\xi}\frac{\rho\sqrt{1+3\cos^{2}\vartheta}}{\sin\vartheta}\end{equation}

\end_inset

Since 
\begin_inset Formula $\left|\widehat{\psi}\cdot\widehat{\rho}\right|=\sin\vartheta/\sqrt{1+3\cos^{2}\vartheta}$
\end_inset

, we therefore have :
\begin_inset Formula \begin{equation}
\tau_{b}\left(\psi,\xi_{0}\right)=\frac{1}{v\left|\xi_{0}\right|}\int_{\vartheta_{min}}^{\vartheta_{max}}d\vartheta\frac{\xi_{0}}{\xi}\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\end{equation}

\end_inset

We normalize the bounce time as follows :
\begin_inset Formula \begin{equation}
\tau_{b}\left(\psi,\xi_{0}\right)=\frac{\Lambda_{0}}{v\left|\xi_{0}\right|}\lambda\left(\psi,\xi_{0}\right)\end{equation}

\end_inset

where
\begin_inset Formula \begin{equation}
\lambda\left(\psi,\xi_{0}\right)=\frac{1}{\Lambda_{0}\left(\psi\right)}\int_{\vartheta_{min}}^{\vartheta_{max}}d\vartheta\frac{\xi_{0}}{\xi}\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\end{equation}

\end_inset

is the normalized bounce time with respect to particles with parallel momentum
 only, so that 
\begin_inset Formula $\lambda\left(\psi,\pm1\right)=1$
\end_inset

.
 
\begin_inset Formula $\Lambda_{0}$
\end_inset

 corresponds to the connection length, defined as the length of the magnetic
 field line at 
\begin_inset Formula $\psi$
\end_inset

.
 It reads :
\begin_inset Formula \begin{equation}
\Lambda_{0}\left(\psi\right)=\int_{0}^{\pi}d\vartheta\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\equiv\oint_{L}ds\end{equation}

\end_inset

This integral has an exact solution, calculated in previous work
\begin_inset CommandInset citation
LatexCommand cite
key "key-1"

\end_inset

.
 The connection length has the following expression, where 
\begin_inset Formula $\rho_{0}$
\end_inset

 is the radius at minimum field :
\begin_inset Formula \begin{equation}
\Lambda_{0}\left(\psi\right)=\rho_{0}\left(2+\frac{\sqrt{3}}{3}\ln\left(2+\sqrt{3}\right)\right)\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Bounce average
\end_layout

\begin_layout Standard
We introduce the following expression for the bounce-average :
\begin_inset Formula \begin{equation}
\left\{ A\right\} =\frac{1}{2\tau_{b}}\oint_{L}\frac{ds}{\left|v_{\parallel}\right|}A\end{equation}

\end_inset

Since there are no circulating particles in magnetic dipole geometry, the
 expression becomes, 
\begin_inset Formula $\sigma=\frac{\xi_{0}}{\left|\xi_{0}\right|}$
\end_inset

 being the pitch-angle sign :
\begin_inset Formula \begin{eqnarray}
\left\{ A\right\}  & = & \frac{1}{\tau_{b}}\frac{1}{2}\sum_{\sigma}\int_{s_{min}}^{s_{max}}\frac{ds}{\left|v_{\parallel}\right|}A\nonumber \\
 & = & \boxed{\frac{1}{\Lambda_{0}\lambda}\frac{1}{2}\sum_{\sigma}\int_{\vartheta_{min}}^{\vartheta_{max}}d\vartheta\frac{\xi_{0}}{\xi}\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}A}\label{eq:-7}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Section
Bounce-averaged collision operator
\end_layout

\begin_layout Standard
In this section, we will use the expression for the spatial gradient of
 the guiding-center distribution function.
 Using the expression for the dipole magnetic field, we have :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{eqnarray*}
\nabla\overline{F} & = & \frac{\partial\overline{F}}{\partial\psi}\nabla\psi+\frac{\partial\overline{F}}{\partial\vartheta}\nabla\vartheta\\
 & = & \left(\frac{\partial\overline{F}}{\partial\psi}-\tilde{\alpha}\frac{\partial\overline{F}}{\partial\vartheta}\right)\nabla\psi+\frac{B_{\vartheta}}{B}\frac{\partial\overline{F}}{\partial\vartheta}\bhat\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Subsection
Momentum component
\end_layout

\begin_layout Standard
The momentum component of the collision operator reads :
\begin_inset Formula \begin{equation}
\mathcal{C}_{p}=\frac{1}{p^{2}}\frac{\partial}{\partial p}\left[p^{3}\nu\overline{F}+p\mathcal{D}_{\ell}\left(p\frac{\partial\overline{F}}{\partial p}-\bar{\boldsymbol{\rho}}_{gc}\cdot\nabla\overline{F}\right)\right]\end{equation}

\end_inset

Averaging therefore gives :
\begin_inset Formula \begin{eqnarray}
\left\{ \mathcal{C}_{p}\right\}  & = & \frac{1}{p^{2}}\frac{\partial}{\partial p}\left[p^{3}\nu\left\{ \overline{F}\right\} +p\mathcal{D}_{\ell}\left(p\frac{\partial\left\{ \overline{F}\right\} }{\partial p}-\left\{ \bar{\boldsymbol{\rho}}_{gc}\cdot\nabla\overline{F}\right\} \right)\right]\label{eq:-10}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Pitch-angle component
\end_layout

\begin_layout Standard
The pitch-angle component of the collision operator reads :
\begin_inset Formula \begin{equation}
\mathcal{C}_{\xi_{0}}=\frac{\xi}{\xi_{0}}\frac{\partial}{\partial\xi_{0}}\left[\frac{\xi}{\xi_{0}}\left(1-\xi_{0}^{2}\right)\frac{\mathcal{D}_{t}}{p^{2}}\frac{\partial\overline{F}}{\partial\xi_{0}}+\left(\frac{B}{B_{0}}\frac{1-\xi_{0}^{2}}{2\xi}\mathcal{D}^{X}\nabla_{\perp}\ln\frac{B_{0}}{B}+\mathcal{D}_{gc}^{\xi\mathbf{X}}\right)\cdot\nabla\overline{F}\right]\end{equation}

\end_inset

Averaging therefore gives :
\begin_inset Formula \begin{eqnarray}
\left\{ \mathcal{C}_{\xi_{0}}\right\}  & = & \frac{\partial}{\partial\xi_{0}}\left[\frac{\xi^{2}}{\xi_{0}^{2}}\left(1-\xi_{0}^{2}\right)\frac{\mathcal{D}_{t}}{p^{2}}\frac{\partial\left\{ \overline{F}\right\} }{\partial\xi_{0}}+\left\{ \frac{\xi}{\xi_{0}}\left(\frac{B}{B_{0}}\frac{1-\xi_{0}^{2}}{2\xi}\mathcal{D}^{X}\nabla_{\perp}\ln\frac{B_{0}}{B}+\mathcal{D}_{gc}^{\xi\mathbf{X}}\right)\cdot\nabla\overline{F}\right\} \right]\label{eq:-9}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Spatial component
\end_layout

\begin_layout Standard
The spatial component of the collision operator reads, inserting the spatial
 Jacobian 
\begin_inset Formula $\mathcal{V}$
\end_inset

 :
\begin_inset Formula \begin{eqnarray}
\mathcal{C}_{\mathbf{X}} & = & \frac{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}{\rho}\frac{B_{0}\xi}{\xi_{0}}\frac{\partial}{\partial\psi}\left[\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\frac{\xi_{0}}{B_{0}\xi}\mathcal{D}^{X}\nabla\psi\cdot\mathbb{I}_{\perp}\cdot\nabla\overline{F}+\frac{\rho}{B\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}\xi}\frac{\partial\overline{F}}{\partial\xi_{0}}-\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\frac{\xi_{0}}{B_{0}\xi}\left(\nu\overline{F}+\frac{\mathcal{D}_{\ell}}{p}\frac{\partial\overline{F}}{\partial p}\right)\nabla\psi\cdot\bar{\boldsymbol{\rho}}_{gc}\right]\nonumber \\
 &  & +\frac{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}{\rho}\frac{B_{0}\xi}{\xi_{0}}\frac{\partial}{\partial\vartheta}\left[\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\frac{\xi_{0}}{B_{0}\xi}\mathcal{D}^{X}\nabla\vartheta\cdot\mathbb{I}_{\perp}\cdot\nabla\overline{F}+\frac{\rho}{B\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\nabla\vartheta\cdot\mathcal{D}_{gc}^{\mathbf{X}\xi}\frac{\partial\overline{F}}{\partial\xi_{0}}-\frac{\rho}{\left|\widehat{\psi}\cdot\widehat{\rho}\right|}\frac{\xi_{0}}{B_{0}\xi}\left(\nu\overline{F}+\frac{\mathcal{D}_{\ell}}{p}\frac{\partial\overline{F}}{\partial p}\right)\nabla\vartheta\cdot\bar{\boldsymbol{\rho}}_{gc}\right]\label{eq:-8}\end{eqnarray}

\end_inset

Averaging therefore gives :
\begin_inset Formula \begin{equation}
\left\{ \mathcal{C}_{\mathbf{X}}\right\} =\frac{B_{0}}{\Lambda_{0}\lambda}\frac{\partial}{\partial\psi}\left[\frac{\Lambda_{0}\lambda}{B_{0}}\left\{ \mathcal{D}^{X}\nabla\psi\cdot\nabla\overline{F}\right\} +\frac{\Lambda_{0}\lambda}{B\xi_{0}}\left\{ \xi\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}\xi}\frac{\partial\overline{F}}{\partial\xi_{0}}\right\} -\frac{\Lambda_{0}\lambda}{B_{0}}\left\{ \left(\nu\overline{F}+\frac{\mathcal{D}_{\ell}}{p}\frac{\partial\overline{F}}{\partial p}\right)\nabla\psi\cdot\bar{\boldsymbol{\rho}}_{gc}\right\} \right]\end{equation}

