\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{\boldsymbol{\rho}}_{0}/\partial p$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sec:calcdrho0dp"

\end_inset


\end_layout

\begin_layout Standard
From the definition of the zero-order Larmor radius
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{\boldsymbol{\rho}}_{0}=\frac{mc}{e}\sqrt{\frac{2\mu}{mB}}\widehat{\rho}=\rho_{0}\widehat{\rho}\label{eq:zeroordergyroradius}\end{equation}

\end_inset

and from (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:guidingcentermagneticmoment"

\end_inset

) using the relation
\begin_inset Formula \begin{equation}
\frac{\partial\mu}{\partial p}=\frac{2}{p}\mu\label{eq:dmhudp}\end{equation}

\end_inset

one obtains 
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial p} & =\frac{\partial\mu}{\partial p}\frac{\partial\rho_{0}}{\partial\mu}\widehat{\rho}\nonumber \\
 & =\frac{\rho_{0}}{p}\widehat{\rho}\nonumber \\
 & =\frac{\mathbf{\boldsymbol{\rho}}_{0}}{p}\label{eq:drho0dp}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{\boldsymbol{\rho}}_{0}/\partial\xi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sec:calcdrho0dxi"

\end_inset


\end_layout

\begin_layout Standard
From (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:guidingcentermagneticmoment"

\end_inset

)
\begin_inset Formula \begin{equation}
\frac{\partial\mu}{\partial\xi}=-\frac{2\xi}{1-\xi^{2}}\mu\label{eq:dmhudxi}\end{equation}

\end_inset

and 
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\xi} & =\frac{\partial\mu}{\partial\xi}\frac{\partial\rho_{0}}{\partial\mu}\widehat{\rho}\nonumber \\
 & =-\frac{\xi}{1-\xi^{2}}\rho_{0}\widehat{\rho}\nonumber \\
 & =-\frac{\xi}{1-\xi^{2}}\widehat{\rho}\label{eq:drho0dxi}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{\boldsymbol{\rho}}_{0}/\partial\varphi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sec:calcdrho0dphi"

\end_inset


\end_layout

\begin_layout Standard
From (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:zeroordergyroradius"

\end_inset

),
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}=\rho_{0}\frac{\partial\widehat{\rho}}{\partial\varphi}=\rho_{0}\widehat{\bot}\label{eq:drho0dphi}\end{equation}

\end_inset

since 
\begin_inset Formula $\partial\mu/\partial\varphi=0$
\end_inset

, and
\begin_inset Formula \begin{equation}
\frac{\partial^{2}\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi^{2}}=\rho_{0}\frac{\partial\widehat{\bot}}{\partial\varphi}=-\rho_{0}\widehat{\rho}=-\mathbf{\boldsymbol{\rho}}_{0}\label{eq:d2rho0dphi2}\end{equation}

\end_inset

using the definitions of 
\begin_inset Formula $\widehat{\rho}$
\end_inset

 and 
\begin_inset Formula $\widehat{\bot}$
\end_inset

 given in Sec.
\begin_inset CommandInset ref
LatexCommand ref
reference "sub:Definitions"

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\nabla^{**}\mathbf{\boldsymbol{\rho}}_{0}$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sec:calcgradrho0"

\end_inset


\end_layout

\begin_layout Standard
The radial gradient of 
\begin_inset Formula $\mathbf{\boldsymbol{\rho}}_{0}$
\end_inset

 may be expressed as
\begin_inset Formula \begin{align}
\nabla\mathbf{\boldsymbol{\rho}}_{0} & =\nabla\rho_{0}\widehat{\rho}\nonumber \\
 & =\nabla\rho_{0}\widehat{\rho}+\rho_{0}\nabla\widehat{\rho}\label{eq:gradrho0_0}\end{align}

\end_inset


\end_layout

\begin_layout Standard
Using the definition of the Larmor radius in 
\begin_inset Formula $\left(p,\xi\right)$
\end_inset

 coordinates 
\begin_inset Formula \begin{equation}
\rho_{0}=\frac{cp}{eB}\sqrt{1-\xi^{2}}\label{eq:Larmorradius0}\end{equation}

\end_inset

one deduces
\begin_inset Formula \begin{equation}
\nabla\rho_{0}=-\rho_{0}\nabla\ln B\label{eq:-15}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
For calculating
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\nabla\widehat{\rho}$
\end_inset

 in (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:gradrho0_0"

\end_inset

), it is expressed in the form
\end_layout

\begin_layout Standard

\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none
\begin_inset Formula \begin{align}
\nabla\widehat{\rho} & =\nabla\widehat{\rho}\cdot\mathbb{I}\nonumber \\
 & =\nabla\widehat{\rho}\cdot\left(\widehat{b}\widehat{b}+\widehat{\bot}\widehat{\bot}+\widehat{\rho}\widehat{\rho}\right)\nonumber \\
 & =-\left(\nabla\widehat{b}\cdot\widehat{\rho}\right)\widehat{b}-\mathbf{R}\widehat{\bot}\label{eq:-13}\end{align}

\end_inset

where
\begin_inset Formula \begin{align}
\nabla\widehat{\rho}\cdot\widehat{b}\widehat{b} & =\left(\nabla\widehat{\rho}\cdot\widehat{b}\right)\widehat{b}\nonumber \\
 & =-\left(\nabla\widehat{b}\cdot\widehat{\rho}\right)\widehat{b}\label{eq:-12}\end{align}

\end_inset

as 
\begin_inset Formula $\nabla\left(\widehat{b}\cdot\widehat{\rho}\right)=\nabla\widehat{\rho}\cdot\widehat{b}+\nabla\widehat{b}\cdot\widehat{\rho}=0$
\end_inset

,
\begin_inset Formula \begin{align}
\nabla\widehat{\rho}\cdot\widehat{\bot}\widehat{\bot} & =\left(\nabla\widehat{\rho}\cdot\widehat{\bot}\right)\widehat{\bot}\nonumber \\
 & =-\left(\nabla\widehat{\bot}\cdot\widehat{\rho}\right)\widehat{\bot}\nonumber \\
 & =-\mathbf{R}\widehat{\bot}\label{eq:-11}\end{align}

\end_inset

as 
\begin_inset Formula $\nabla\left(\widehat{\bot}\cdot\widehat{\rho}\right)=\nabla\widehat{\rho}\cdot\widehat{\bot}+\nabla\widehat{\bot}\cdot\widehat{\rho}=0$
\end_inset

 and
\begin_inset Formula \begin{equation}
\nabla\widehat{\bot}\cdot\widehat{\rho}=\sin^{2}\varphi\nabla\widehat{1}\cdot\widehat{2}-\cos^{2}\varphi\nabla\widehat{2}\cdot\widehat{1}=\nabla\widehat{1}\cdot\widehat{2}=\mathbf{R}\label{eq:Rgauge0}\end{equation}

\end_inset

using the relation 
\begin_inset Formula $\nabla\left(\widehat{1}\cdot\widehat{2}\right)=\nabla\widehat{1}\cdot\widehat{2}+\nabla\widehat{2}\cdot\widehat{1}=0$
\end_inset

.
\end_layout

\begin_layout Standard

\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none
Finally, since the third term is zero
\begin_inset Formula \begin{align}
\nabla\widehat{\rho}\cdot\widehat{\rho}\widehat{\rho} & =\left(\nabla\widehat{\rho}\cdot\widehat{\rho}\right)\widehat{\rho}\nonumber \\
 & =\left(\frac{1}{2}\nabla\left(\widehat{\rho}\cdot\widehat{\rho}\right)\right)\widehat{\rho}\nonumber \\
 & =\left(\frac{1}{2}\nabla1\right)\widehat{\rho}\nonumber \\
 & =0\label{eq:-5}\end{align}

\end_inset

and 
\begin_inset Formula $\nabla\mathbf{\boldsymbol{\rho}}_{0}$
\end_inset

 may be expressed in the compact form
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\nabla\mathbf{\boldsymbol{\rho}}_{0}=-\nabla\ln B\rho_{0}\widehat{\rho}-\left(\nabla\widehat{b}\cdot\boldsymbol{\rho}_{0}\right)\widehat{b}-\rho_{0}\mathbf{R}\widehat{\bot}\label{eq:gradrho0}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Finally,
\begin_inset Formula \begin{align}
\nabla^{**}\mathbf{\boldsymbol{\rho}}_{0} & =\nabla\mathbf{\boldsymbol{\rho}}_{0}+\mathbf{R}^{*}\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\nonumber \\
 & =\nabla\mathbf{\boldsymbol{\rho}}_{0}+\rho_{0}\mathbf{R}^{*}\widehat{\bot}\nonumber \\
 & =-\nabla\ln B\rho_{0}\widehat{\rho}-\left(\nabla\widehat{b}\cdot\boldsymbol{\rho}_{0}\right)\widehat{b}+\frac{\widehat{b}}{2}\left(\widehat{b}\cdot\nabla\times\widehat{b}\right)\rho_{0}\widehat{\bot}\label{eq:graddoublestarrho0-1}\end{align}

\end_inset


\end_layout

\begin_layout Section
Derivatives of 
\begin_inset Formula $\mathbf{\boldsymbol{\rho}}_{1}$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sec:derivativesrho1"

\end_inset


\end_layout

\begin_layout Standard
The first-order correction of the Larmor radius is given by the relation
 as given in Ref.
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

,
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{\boldsymbol{\rho}}_{1}=-\alpha\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\beta\mathbf{\boldsymbol{\rho}}_{0}-\gamma\widehat{b}\label{eq:firstordergyroradius}\end{equation}

\end_inset

where
\begin_inset Formula \begin{equation}
\alpha=\frac{v_{\Vert}}{\Omega}\mathbf{a}_{2}:\nabla\widehat{b}+\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\cdot\left(\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:alpha}\end{equation}

\end_inset


\begin_inset Formula \begin{align}
\beta & =\mathbf{\boldsymbol{\rho}}_{0}\cdot\left(\frac{1}{2}\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)\nonumber \\
 & +\frac{v_{\Vert}}{2\Omega}\left(\widehat{b}\cdot\nabla\times\widehat{b}-\mathbf{a}_{1}:\nabla\widehat{b}\right)\label{eq:beta}\end{align}

\end_inset


\begin_inset Formula \begin{equation}
\gamma=2\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)-\frac{\mu B}{m\Omega^{2}}\left(\frac{1}{2}\widehat{b}\cdot\nabla\ln B+\mathbf{a}_{2}:\nabla\widehat{b}\right)\label{eq:gamma}\end{equation}

\end_inset

and
\begin_inset Formula \begin{align}
\mathbf{a}_{1} & =-\frac{1}{2}\left(\widehat{\rho}\widehat{\bot}+\widehat{\bot}\widehat{\rho}\right)\label{eq:dyadicmatrices_a1}\end{align}

\end_inset

is the gyroangle-dependent dyadic matrices.
 From (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dyadicmatrices_a1"

\end_inset

), 
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{a}_{1}}{\partial\varphi} & =-\frac{1}{2}\left(\frac{\partial\widehat{\rho}}{\partial\varphi}\widehat{\bot}+\widehat{\rho}\frac{\partial\widehat{\bot}}{\partial\varphi}+\frac{\partial\widehat{\bot}}{\partial\varphi}\widehat{\rho}+\widehat{\bot}\frac{\partial\widehat{\rho}}{\partial\varphi}\right)\nonumber \\
 & =-\left(\widehat{\bot}\widehat{\bot}-\widehat{\rho}\widehat{\rho}\right)\nonumber \\
 & =-4\mathbf{a}_{2}\label{eq:da1dphi}\end{align}

\end_inset

so that
\begin_inset Formula \begin{equation}
\mathbf{a}_{2}=\frac{1}{4}\left(\widehat{\bot}\widehat{\bot}-\widehat{\rho}\widehat{\rho}\right)\label{eq:dyadicmatrices_a2}\end{equation}

\end_inset

and 
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{a}_{2}}{\partial\varphi} & =\frac{1}{4}\left(\frac{\partial\widehat{\bot}}{\partial\varphi}\widehat{\bot}+\widehat{\bot}\frac{\partial\widehat{\bot}}{\partial\varphi}-\frac{\partial\widehat{\rho}}{\partial\varphi}\widehat{\rho}-\widehat{\rho}\frac{\partial\widehat{\rho}}{\partial\varphi}\right)\nonumber \\
 & =\frac{1}{4}\left(-\widehat{\rho}\widehat{\bot}-\widehat{\bot}\widehat{\rho}-\widehat{\bot}\widehat{\rho}-\widehat{\rho}\widehat{\bot}\right)\nonumber \\
 & =-\frac{1}{2}\left(\widehat{\rho}\widehat{\bot}+\widehat{\bot}\widehat{\rho}\right)\nonumber \\
 & =\mathbf{a}_{1}\label{eq:da2dphi}\end{align}

\end_inset

since 
\begin_inset Formula $\partial\widehat{\rho}/\partial\varphi=\widehat{\bot}$
\end_inset

 and 
\begin_inset Formula $\partial\widehat{\mathbf{\bot}}/\partial\varphi=-\widehat{\rho}$
\end_inset

.
 
\end_layout

\begin_layout Subsection
Derivatives of 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\alpha$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:derivativesalpha"

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\alpha/\partial p$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdalphadp"

\end_inset


\end_layout

\begin_layout Standard
From the definition (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:alpha"

\end_inset

) of 
\begin_inset Formula $\alpha$
\end_inset

, 
\begin_inset Formula \begin{equation}
\frac{\partial\alpha}{\partial p}=\frac{\partial v_{\Vert}}{\partial p}\frac{\partial\alpha}{\partial v_{\Vert}}+\frac{\partial\rho_{0}}{\partial p}\frac{\partial\alpha}{\partial\rho_{0}}+\frac{\partial\mu}{\partial p}\frac{\partial\alpha}{\partial\mu}\label{eq:-2}\end{equation}

\end_inset

with
\begin_inset Formula \begin{align}
\frac{\partial\alpha}{\partial v_{\Vert}} & =\frac{1}{\Omega}\mathbf{a}_{2}:\nabla\widehat{b}+\frac{mv_{\Vert}}{\mu B}\rho_{0}\widehat{\bot}\cdot\left(\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dalphadvpar}\\
\frac{\partial\alpha}{\partial\rho_{0}} & =\widehat{\bot}\cdot\left(\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\left(\widehat{b}\cdot\nabla\widehat{b}\right)\right)\label{eq:dalphadrho0}\\
\frac{\partial\alpha}{\partial\mu} & =-\frac{mv_{\Vert}^{2}}{2\mu^{2}B}\rho_{0}\widehat{\bot}\cdot\left(\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dalphadmhu}\end{align}

\end_inset

using 
\begin_inset Formula $\partial\widehat{\rho}/\partial\varphi=\widehat{\bot}$
\end_inset

 , and inserting 
\begin_inset Formula \begin{align}
\frac{\partial v_{\Vert}}{\partial p} & =\frac{\xi}{m}\label{eq:dvpardp}\end{align}

\end_inset

with (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dmhudp"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dp"

\end_inset

), one obtains
\begin_inset Formula \begin{align}
\frac{\partial\alpha}{\partial p} & =\frac{\xi}{m}\frac{\partial\alpha}{\partial v_{\Vert}}+\frac{\rho_{0}}{p}\frac{\partial\alpha}{\partial\rho_{0}}+\frac{2\mu}{p}\frac{\partial\alpha}{\partial\mu}\nonumber \\
 & =\frac{\alpha}{p}\label{eq:dalphadp-1}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\alpha/\partial\xi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdalphadxi"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\alpha}{\partial\xi}=\frac{\partial v_{\Vert}}{\partial\xi}\frac{\partial\alpha}{\partial v_{\Vert}}+\frac{\partial\rho_{0}}{\partial\xi}\frac{\partial\alpha}{\partial\rho_{0}}+\frac{\partial\mu}{\partial\xi}\frac{\partial\alpha}{\partial\mu}\end{equation}

\end_inset

with
\begin_inset Formula \begin{align}
\frac{\partial v_{\Vert}}{\partial\xi} & =\frac{p}{m}=v\label{eq:dvpardxi}\end{align}

\end_inset

and using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dmhudxi"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dxi"

\end_inset

), one obtains
\begin_inset Formula \begin{align}
\frac{\partial\alpha}{\partial\xi} & =\frac{p}{m}\frac{\partial\alpha}{\partial v_{\Vert}}-\frac{\xi}{1-\xi^{2}}\rho_{0}\frac{\partial\alpha}{\partial\rho_{0}}-\frac{2\xi}{1-\xi^{2}}\mu\frac{\partial\alpha}{\partial\mu}\nonumber \\
 & =v\left[\frac{1}{\Omega}\mathbf{a}_{2}:\nabla\widehat{b}+\frac{mv_{\Vert}}{\mu B}\rho_{0}\widehat{\bot}\cdot\left(\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & -\frac{\xi}{1-\xi^{2}}\rho_{0}\widehat{\bot}\cdot\left(\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\left(\widehat{b}\cdot\nabla\widehat{b}\right)\right)\nonumber \\
 & +\frac{\xi}{1-\xi^{2}}\frac{mv_{\Vert}^{2}}{\mu B}\rho_{0}\widehat{\bot}\cdot\left(\widehat{b}\cdot\nabla\widehat{b}\right)\nonumber \\
 & =\frac{1}{\xi}\left[\frac{v_{\Vert}}{\Omega}\mathbf{a}_{2}:\nabla\widehat{b}+\frac{mv_{\Vert}^{2}}{\mu B}\rho_{0}\widehat{\bot}\cdot\left(\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & -\frac{\xi}{1-\xi^{2}}\rho_{0}\widehat{\bot}\cdot\left(\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\left(\widehat{b}\cdot\nabla\widehat{b}\right)\right)\label{eq:dalphadxi}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\alpha/\partial\varphi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdalphadphi"

\end_inset


\end_layout

\begin_layout Standard
Using relations (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dphi"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:d2rho0dphi2"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:da2dphi"

\end_inset

), 
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\alpha}{\partial\varphi} & =\frac{v_{\Vert}}{\Omega}\mathbf{a}_{1}:\nabla\widehat{b}-\mathbf{\boldsymbol{\rho}}_{0}\cdot\left(\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dalphadphi}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation 
\begin_inset Formula $\nabla^{**}\alpha$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcgraddoublestaralpha"

\end_inset


\end_layout

\begin_layout Standard
Since all terms in 
\begin_inset Formula $\alpha$
\end_inset

 are function of 
\begin_inset Formula $\nabla$
\end_inset

, 
\begin_inset Formula $\nabla\alpha$
\end_inset

 which is second order may dropped and 
\begin_inset Formula \begin{align*}
\nabla^{**}\alpha & =\mathbf{R}^{*}\frac{\partial\alpha}{\partial\varphi}=\left[\mathbf{R}+\frac{\widehat{b}}{2}\left(\widehat{b}\cdot\nabla\times\widehat{b}\right)\right]\left(\frac{\partial\alpha}{\partial\varphi}\right)^{2}\end{align*}

\end_inset

which is second order too, so that 
\begin_inset Formula $\nabla^{**}\alpha=0$
\end_inset

.
\end_layout

