\begin_body

\begin_layout Title
Collision operator in LUKE guiding center coordinates
\end_layout

\begin_layout Author
by Yves Peysson (CEA/IRFM)
\end_layout

\begin_layout Section
Collision operator in guiding center coordinates
\end_layout

\begin_layout Subsection
Calculation of the guiding-center Poisson bracket
\end_layout

\begin_layout Standard
In order to calculate coefficients in LUKE code, it is necessary to move
 from the guiding center coordinate system 
\begin_inset Formula $\left(\mathbf{X},\mathcal{E},\mu,\theta\right)$
\end_inset

 defined in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

 to the new guiding center coordinate system 
\begin_inset Formula $\left(\mathbf{X},p,\xi,\varphi\right)$
\end_inset

, and evaluate accordingly all expressions of the guiding-center dynamics.
 
\end_layout

\begin_layout Subsubsection
Definitions
\begin_inset CommandInset label
LatexCommand label
name "sub:Definitions"

\end_inset


\end_layout

\begin_layout Standard
According to Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

, if 
\begin_inset Formula $F$
\end_inset

 and 
\begin_inset Formula $G$
\end_inset

 are functions of the guiding center coordinates 
\begin_inset Formula $\left(\mathbf{X},\mathcal{E},\mu,\theta\right)$
\end_inset

, the Poisson bracket of 
\begin_inset Formula $F$
\end_inset

 and 
\begin_inset Formula $G$
\end_inset

 for a non-uniform magnetic field may be expressed as
\begin_inset Formula \begin{align}
\left\{ F,G\right\} _{gc} & =\frac{\Omega}{B}\left[\frac{\partial F}{\partial\theta}\left(\frac{\partial G}{\partial\mu}+B\frac{\partial G}{\partial\mathcal{E}}\right)-\left(\frac{\partial F}{\partial\mu}+B\frac{\partial F}{\partial\mathcal{E}}\right)\frac{\partial G}{\partial\theta}\right]\nonumber \\
 & +\mathbf{v}_{gc}\cdot\left(\nabla^{*}F\frac{\partial G}{\partial\mathcal{E}}-\frac{\partial F}{\partial\mathcal{E}}\nabla^{*}G\right)-\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\nabla^{*}F\times\nabla^{*}G\label{eq:PoissonbracketEmhu}\end{align}

\end_inset

where the modified gradient operator 
\begin_inset Formula $\nabla^{*}$
\end_inset

 is defined as 
\begin_inset Formula \begin{equation}
\nabla^{*}\equiv\nabla+\left[\mathbf{R}+\frac{\widehat{b}}{2}\left(\widehat{b}\cdot\nabla\times\widehat{b}\right)\right]\frac{\partial}{\partial\theta}=\nabla+\mathbf{R}^{*}\frac{\partial}{\partial\theta}\label{eq:nablastar}\end{equation}

\end_inset

with
\begin_inset Formula \begin{equation}
\mathbf{R}^{*}=\left[\mathbf{R}+\frac{\widehat{b}}{2}\left(\widehat{b}\cdot\nabla\times\widehat{b}\right)\right]\frac{\partial}{\partial\theta}\label{eq:Rstar}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Here, 
\begin_inset Formula \begin{equation}
\mathbf{R}=\nabla\widehat{1}\cdot\widehat{2}\label{eq:Rgauge}\end{equation}

\end_inset

denotes the gyro-gauge vector field used to define the gradient operator
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:nablastar"

\end_inset

), where the rotating unit vectors 
\begin_inset Formula $\left(\widehat{b},\widehat{\bot},\widehat{\rho}\right)$
\end_inset

 are defined in terms of the fixed local unit vectors 
\begin_inset Formula $\left(\widehat{1},\widehat{2},\widehat{b}\right)$
\end_inset

 with 
\begin_inset Formula $\widehat{b}=\widehat{1}\times\widehat{2}$
\end_inset

, 
\begin_inset Formula $\widehat{\rho}=\widehat{b}\times\widehat{\bot}=\widehat{1}\cos\theta-\widehat{2}\sin\theta$
\end_inset

 and 
\begin_inset Formula $\theta$
\end_inset

 is the gyro-angle according to 
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

.
 All gradients are here taken at constant 
\begin_inset Formula $\mu,\mathcal{E}$
\end_inset

 and 
\begin_inset Formula $\varphi$
\end_inset

 until specified.
 
\end_layout

\begin_layout Standard
The gyro-averaged guiding-center velocity is
\begin_inset Formula \begin{equation}
\mathbf{v}_{gc}=v_{\parallel}\widehat{b}+\frac{\widehat{b}}{m\Omega_{\Vert}^{*}}\times\left(\mu\nabla B+mv_{\Vert}^{2}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:guidingcentervelocity}\end{equation}

\end_inset

with 
\begin_inset Formula \begin{equation}
\Omega_{\Vert}^{*}=\frac{eB{}_{\Vert}^{*}}{mc}=\Omega+v_{\Vert}\widehat{b}\cdot\nabla\times\widehat{b}\label{eq:Omegastar}\end{equation}

\end_inset


\begin_inset Formula \begin{equation}
\mathbf{B}{}^{*}=\mathbf{B}+\frac{cp_{\Vert}}{e}\nabla\times\widehat{b}\label{eq:Bstar}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
B{}_{\Vert}^{*}=B{}^{*}\cdot\widehat{b}\label{eq:Bstarpar}\end{equation}

\end_inset


\begin_inset Formula \begin{equation}
\left|v_{\parallel}\right|=\left|\frac{p_{\parallel}}{m}\right|=\sqrt{2\frac{\mathcal{E}-\mu B}{m}}\label{eq:vpar}\end{equation}

\end_inset

where 
\begin_inset Formula $\widehat{b}=\mathbf{B}/\left\Vert \mathbf{B}\right\Vert $
\end_inset

, 
\begin_inset Formula \begin{equation}
\mu=\frac{p_{\bot}^{2}}{2mB}\label{eq:guidingcentermagneticmoment-1}\end{equation}

\end_inset

 is the guiding-center magnetic moment, and 
\begin_inset Formula \begin{equation}
\mathcal{E}=\frac{p^{2}}{2m}=\frac{p_{\Vert}^{2}+p_{\bot}^{2}}{2m}\label{eq:guidingcenterkineticenergy}\end{equation}

\end_inset

is the guiding-center kinetic energy 
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
Following the reference (
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

), the CGS system of units is used for the calculations.
\end_layout

\end_inset

.
 Here, 
\begin_inset Formula $p$
\end_inset

 is the guiding center momentum.
\end_layout

\begin_layout Standard
The cosine of the guiding center pitch-angle in momentum space 
\begin_inset Formula $\xi$
\end_inset

 is defined as 
\begin_inset Formula \begin{equation}
\xi=p_{\parallel}/p=\sqrt{1-\frac{\mu B}{\mathcal{E}}}\label{eq:guidingcenterpitchanglecosine}\end{equation}

\end_inset

from (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:vpar"

\end_inset

), and consequently, it is an implicit function of the position 
\begin_inset Formula $\mathbf{X}$
\end_inset

 since 
\begin_inset Formula $B$
\end_inset

 varies with the spatial position, while both 
\begin_inset Formula $\mu$
\end_inset

 and 
\begin_inset Formula $\mathcal{E}$
\end_inset

 are constants of the motion.
 
\end_layout

\begin_layout Standard
In terms of 
\begin_inset Formula $\left(p,\xi\right)$
\end_inset

, 
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mu=\frac{p^{2}\left(1-\xi^{2}\right)}{2mB}\label{eq:guidingcentermagneticmoment}\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Jacobian of the transformation 
\begin_inset Formula $\left(\mathbf{x},\mathbf{p}\right)\rightarrow\left(\mathbf{X},p,\xi,\varphi\right)$
\end_inset

 
\end_layout

\begin_layout Standard
Using the chain rule for several variables, the transformation 
\begin_inset Formula $\left(p,\xi\right)\rightarrow\left(\mathcal{E},\mu\right)$
\end_inset

 is expressed in the matrix form
\begin_inset Formula \begin{equation}
\left(\begin{array}{c}
\partial/\partial p\\
\partial/\partial\xi\end{array}\right)=\frac{\partial\left(\mathcal{E},\mu\right)}{\partial\left(p,\xi\right)}\left(\begin{array}{c}
\partial/\partial\mathcal{E}\\
\partial/\partial\mu\end{array}\right)\label{eq:}\end{equation}

\end_inset

so that
\begin_inset Formula \begin{equation}
\left(\begin{array}{c}
\partial/\partial\mathcal{E}\\
\partial/\partial\mu\end{array}\right)=\frac{\partial\left(p,\xi\right)}{\partial\left(\mathcal{E},\mu\right)}\left(\begin{array}{c}
\partial/\partial p\\
\partial/\partial\xi\end{array}\right)\label{eq:-1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using the definitions of 
\begin_inset Formula $\mathcal{E}$
\end_inset

 and 
\begin_inset Formula $\mu$
\end_inset

, 
\begin_inset Formula \begin{equation}
\frac{\partial\left(\mathcal{E},\mu\right)}{\partial\left(p,\xi\right)}=\left(\begin{array}{cc}
p/m & \left(1-\xi^{2}\right)p/\left(mB\right)\\
0 & -\xi p^{2}/\left(mB\right)\end{array}\right)\label{eq:L}\end{equation}

\end_inset

and
\begin_inset Formula \begin{equation}
\frac{\partial\left(p,\xi\right)}{\partial\left(\mathcal{E},\mu\right)}=\frac{1}{\det\left(\partial\left(\mathcal{E},\mu\right)/\partial\left(p,\xi\right)\right)}\left(\begin{array}{cc}
-\xi p^{2}/\left(mB\right) & -\left(1-\xi^{2}\right)p/\left(mB\right)\\
0 & p/m\end{array}\right)\label{eq:invL}\end{equation}

\end_inset

where
\begin_inset Formula \begin{equation}
\det\left(\partial\left(\mathcal{E},\mu\right)/\partial\left(p,\xi\right)\right)=-\frac{\xi p^{3}}{m^{2}B}=-\frac{v_{\Vert}}{mB}p^{2}\label{eq:detL}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:detL"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:invL"

\end_inset

) becomes
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula \begin{equation}
\frac{\partial\left(p,\xi\right)}{\partial\left(\mathcal{E},\mu\right)}=\frac{m}{p^{2}\xi}\left(\begin{array}{cc}
p\xi & 1-\xi^{2}\\
0 & -B\end{array}\right)\label{eq:invLbis}\end{equation}

\end_inset

where the Jacobian of 
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
the coordinate transformation 
\begin_inset Formula $\left(X,\mathcal{E},\mu,\theta\right)\rightarrow\left(\mathbf{X},p,\xi,\varphi\right)$
\end_inset

 is
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula \begin{equation}
J_{p\xi}=\left|\det\frac{\partial\left(\mathcal{E},\mu\right)}{\partial\left(p,\xi\right)}\right|=\frac{\left|v_{\Vert}\right|}{mB}p^{2}\label{eq:Jacobian}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using the Jacobian 
\begin_inset Formula $\mathcal{J}$
\end_inset

 of the coordinate transformation 
\begin_inset Formula $\left(\mathbf{x},\mathbf{p}\right)\rightarrow\left(\mathbf{X},\mathcal{E},\mu,\theta\right)$
\end_inset

 in 
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

,
\begin_inset Formula \begin{equation}
\mathcal{J}=\frac{mB{}_{\Vert}^{*}}{\left|v_{\Vert}\right|}\label{eq:JacobianEmhu}\end{equation}

\end_inset

the global Jacobian of coordinate transformation 
\begin_inset Formula $\left(\mathbf{x},\mathbf{p}\right)\rightarrow\left(\mathbf{X},p,\xi,\varphi\right)$
\end_inset

is simply
\begin_inset Formula \begin{equation}
\mathcal{J}_{p\xi}=\frac{mB{}_{\Vert}^{*}}{\left|v_{\Vert}\right|}\frac{\left|v_{\Vert}\right|}{mB}p^{2}=p^{2}\frac{B{}_{\Vert}^{*}}{B}\label{eq:Jacobianpxi}\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Transformation 
\begin_inset Formula $\left(\mathbf{X},\mathcal{E},\mu,\theta\right)\rightarrow\left(\mathbf{X},p,\xi,\varphi\right)$
\end_inset

 of the Poisson bracket
\end_layout

\begin_layout Standard
From the coordinate transformation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:invLbis"

\end_inset

) of an operator 
\begin_inset Formula $A$
\end_inset

, 
\begin_inset Formula \begin{align}
\frac{\partial A}{\partial\mathcal{E}} & =\frac{m}{p^{2}\xi}\left(p\xi\frac{\partial A}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial A}{\partial\xi}\right)\label{eq:dE}\\
\frac{\partial A}{\partial\mu} & =-\frac{m}{p^{2}\xi}\left(B\frac{\partial A}{\partial\xi}\right)\label{eq:dmu}\end{align}

\end_inset

and replacing 
\begin_inset Formula $\theta$
\end_inset

 by 
\begin_inset Formula $\varphi$
\end_inset

, the Poisson bracket (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:PoissonbracketEmhu"

\end_inset

) becomes
\begin_inset Formula \begin{align}
\left\{ F,G\right\} _{gc} & =\frac{eB}{cp^{2}}\left[\frac{\partial F}{\partial\varphi}\left(p\frac{\partial G}{\partial p}-\xi\frac{\partial G}{\partial\mathcal{\xi}}\right)-\left(p\frac{\partial F}{\partial p}-\xi\frac{\partial F}{\partial\mathcal{\xi}}\right)\frac{\partial G}{\partial\varphi}\right]\nonumber \\
 & +\frac{m}{p^{2}\xi}\mathbf{v}_{gc}\cdot\left(\nabla^{*}F\left(p\xi\frac{\partial G}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial G}{\partial\xi}\right)-\left(p\xi\frac{\partial F}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial F}{\partial\xi}\right)\nabla^{*}G\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\nabla^{*}F\times\nabla^{*}G\label{eq:Poissonbracketpxi}\end{align}

\end_inset

where 
\begin_inset Formula \begin{align}
\nabla^{*} & =\left.\nabla\right|_{\mathcal{E},\mu,\varphi}+\mathbf{R}^{*}\frac{\partial}{\partial\varphi}\nonumber \\
 & =\nabla^{**}+\left.\nabla p\right|_{\mathcal{E},\mu,\varphi}\frac{\partial}{\partial p}+\left.\nabla\xi\right|_{\mathcal{E},\mu,\varphi}\frac{\partial}{\partial\xi}\label{eq:-6}\end{align}

\end_inset

with
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula \begin{equation}
\nabla^{**}=\left.\nabla\right|_{p,\xi,\varphi}+\mathbf{R}^{*}\frac{\partial}{\partial\varphi}\label{eq:nabladoublestar}\end{equation}

\end_inset

since 
\begin_inset Formula \begin{equation}
\left.\nabla\right|_{\mathcal{E},\mu,\varphi}=\left.\nabla\right|_{p,\xi,\varphi}+\left.\nabla p\right|_{\mathcal{E},\mu,\varphi}\frac{\partial}{\partial p}+\left.\nabla\xi\right|_{\mathcal{E},\mu,\varphi}\frac{\partial}{\partial\xi}\label{eq:gradientconversion}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
It is worth noting that 
\begin_inset Formula $\mathbf{R}^{*}$
\end_inset

 defined by relation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Rstar"

\end_inset

) remains unaffected by the coordinate transformation, since 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\partial\widehat{b}/\partial p=\partial\widehat{b}/\partial\xi=0$
\end_inset

.

\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
 Considering (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:guidingcenterpitchanglecosine"

\end_inset

), 
\begin_inset Formula \begin{align}
\left.\nabla\xi\right|_{\mathcal{E},\mu,\varphi} & =-\frac{\mu\left.\nabla B\right|_{\mathcal{E},\mu,\varphi}}{2\mathcal{E}\xi}\nonumber \\
 & =-\frac{p^{2}}{2m\mathcal{E}}\left(\frac{1-\xi^{2}}{\xi}\right)\left(\frac{1}{2}\frac{\left.\nabla B\right|_{\mathcal{E},\mu,\varphi}}{B}\right)\nonumber \\
 & =-\frac{\left(1-\xi^{2}\right)}{2\xi}\left.\nabla\ln B\right|_{\mathcal{E},\mu,\varphi}\nonumber \\
 & =-\frac{\left(1-\xi^{2}\right)}{2\xi}\left.\nabla\ln B\right|_{p,\xi,\varphi}\label{eq:gradxi}\end{align}

\end_inset

using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:gradientconversion"

\end_inset

), while 
\begin_inset Formula \begin{equation}
\left.\nabla p\right|_{\mathcal{E},\mu,\varphi}=0\label{eq:gradp}\end{equation}

\end_inset

since 
\begin_inset Formula $\left\Vert \mathbf{p}\right\Vert ^{2}=p^{2}=2m\mathcal{E}$
\end_inset

.
 Consequently, 
\begin_inset Formula \begin{equation}
\nabla^{*}=\nabla^{**}-\frac{\left(1-\xi^{2}\right)}{2\xi}\nabla\ln B\frac{\partial}{\partial\xi}\label{eq:nabladoublestarmod}\end{equation}

\end_inset

with the prescription 
\begin_inset Formula $\nabla=\left.\nabla\right|_{p,\xi,\varphi}$
\end_inset

 except specified.
\end_layout

\begin_layout Standard
The Poisson bracket (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Poissonbracketpxi"

\end_inset

) becomes therefore
\begin_inset Formula \begin{align}
\left\{ F,G\right\} _{gc} & =\frac{eB}{cp^{2}}\left[\frac{\partial F}{\partial\varphi}\left(p\frac{\partial G}{\partial p}-\xi\frac{\partial G}{\partial\mathcal{\xi}}\right)-\left(p\frac{\partial F}{\partial p}-\xi\frac{\partial F}{\partial\mathcal{\xi}}\right)\frac{\partial G}{\partial\varphi}\right]\nonumber \\
 & +\frac{m}{p^{2}\xi}\mathbf{v}_{gc}\cdot\left(\nabla^{**}F\left(p\xi\frac{\partial G}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial G}{\partial\xi}\right)-\left(p\xi\frac{\partial F}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial F}{\partial\xi}\right)\nabla^{**}G\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\nabla^{**}F\times\nabla^{**}G\nonumber \\
 & -\left[\frac{\left(1-\xi^{2}\right)}{2}\right]\left(\widehat{b}\cdot\nabla\ln B\right)\left(\frac{\partial F}{\partial\xi}\frac{\partial G}{\partial p}-\frac{\partial F}{\partial p}\frac{\partial G}{\partial\xi}\right)\nonumber \\
 & +\frac{\left(1-\xi^{2}\right)}{2\xi}\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\left[\frac{\partial G}{\partial\xi}\left(\nabla F\times\nabla\ln B\right)-\left(\nabla G\times\nabla\ln B\right)\frac{\partial F}{\partial\xi}\right]\label{eq:Poissonbracketpxi1}\end{align}

\end_inset

and in the limit of a uniform magnetic field,
\begin_inset Formula \begin{align}
\left\{ F,G\right\} _{gc} & =\frac{eB}{cp^{2}}\left[\frac{\partial F}{\partial\varphi}\left(p\frac{\partial G}{\partial p}-\xi\frac{\partial G}{\partial\mathcal{\xi}}\right)-\left(p\frac{\partial F}{\partial p}-\xi\frac{\partial F}{\partial\mathcal{\xi}}\right)\frac{\partial G}{\partial\varphi}\right]\nonumber \\
 & +\frac{\widehat{b}}{p}\cdot\left(\nabla F\left(p\xi\frac{\partial G}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial G}{\partial\xi}\right)-\left(p\xi\frac{\partial F}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial F}{\partial\xi}\right)\nabla G\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB}\cdot\nabla F\times\nabla G\label{eq:PoissonbracketpxiuniformB}\end{align}

\end_inset

where 
\begin_inset Formula $\mathbf{v}_{gc}=v_{\parallel}\widehat{b}$
\end_inset

, 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\nabla^{**}=\nabla$
\end_inset

 and 
\begin_inset Formula $\mathbf{v}_{gc}\cdot\mathbf{R}^{*}=\mathbf{v}_{gc}\cdot\mathbf{R}=0$
\end_inset

 since 
\begin_inset Formula $\mathbf{R}=0$
\end_inset

.
\end_layout

\begin_layout Subsection
Equations of motion
\end_layout

\begin_layout Standard
The guiding-center Hamiltonian being 
\begin_inset Formula \begin{equation}
H=\frac{p^{2}}{2m}\label{eq:Hamiltonian}\end{equation}

\end_inset

the Poisson bracket 
\begin_inset Formula $\left\{ F,H\right\} _{gc}$
\end_inset

 takes the general form
\begin_inset Formula \begin{equation}
\left\{ F,H\right\} _{gc}=\Omega\frac{\partial F}{\partial\varphi}+\mathbf{v}_{gc}\cdot\nabla^{**}F-\frac{\left(1-\xi^{2}\right)}{2\xi}\left(\mathbf{v}_{gc}\cdot\nabla\ln B\right)\frac{\partial F}{\partial\xi}\label{eq:Hamiltonianpoissonbracket}\end{equation}

\end_inset

so that
\begin_inset Formula \begin{align}
\left\{ \mathbf{X},H\right\} _{gc} & =\mathbf{\dot{X}}=\mathbf{v}_{gc}\label{eq:Xpoint}\\
\left\{ p,H\right\} _{gc} & =\dot{p}=0\label{eq:ppoint}\\
\left\{ \xi,H\right\} _{gc} & =\dot{\xi}=-\frac{\left(1-\xi^{2}\right)}{2\xi}\left(\mathbf{v}_{gc}\cdot\nabla\ln B\right)=-\frac{\left(1-\xi^{2}\right)}{2\xi}\mathbf{v}_{gc}\cdot\nabla\ln B\label{eq:xipoint}\\
\left\{ \varphi,H\right\} _{gc} & =\dot{\varphi}=\Omega+\mathbf{v}_{gc}\cdot\mathbf{R}^{*}\label{eq:phipoint}\end{align}

\end_inset

since 
\begin_inset Formula $\nabla^{**}\mathbf{X}=\mathbb{I}$
\end_inset

 is the identity matrix and 
\begin_inset Formula $\partial\xi/\partial\varphi=0$
\end_inset

.
\end_layout

\begin_layout Standard
Using the definitions (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Xpoint"

\end_inset

-
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:phipoint"

\end_inset

), the guiding-center part (or Vlasov part) of the Fokker-Planck equation
 may be expressed as
\begin_inset Formula \begin{align}
\frac{df}{dt} & =\frac{\partial f}{\partial t}+\mathbf{\dot{X}}\cdot\nabla f+\dot{p}\frac{\partial f}{\partial p}+\dot{\xi}\frac{\partial f}{\partial\xi}+\dot{\varphi}\frac{\partial f}{\partial\varphi}\nonumber \\
 & =\frac{\partial f}{\partial t}+\mathbf{v}_{gc}\cdot\nabla f+\left(\Omega+\mathbf{v}_{gc}\cdot\mathbf{R}^{*}\right)\frac{\partial f}{\partial\varphi}-\frac{\left(1-\xi^{2}\right)}{2\xi}\mathbf{v}_{gc}\cdot\nabla\ln B\frac{\partial f}{\partial\xi}\label{eq:guidingcentervlasov}\end{align}

\end_inset

where 
\begin_inset Formula $f$
\end_inset

 is by definition the guiding-center distribution function.
 
\end_layout

\begin_layout Standard
In the limit of a constant, uniform magnetic field, 
\begin_inset Formula $\mathbf{v}_{gc}=v_{\parallel}\widehat{b}$
\end_inset

, 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\nabla\xi=0$
\end_inset

 and 
\begin_inset Formula $\mathbf{v}_{gc}\cdot\mathbf{R}^{*}=\mathbf{v}_{gc}\cdot\mathbf{R}=0$
\end_inset

 since 
\begin_inset Formula $\mathbf{R}=0$
\end_inset

, the Vlasov terme becomes
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
 
\begin_inset Formula \begin{equation}
\frac{df}{dt}=\frac{\partial f}{\partial t}+v_{\parallel}\widehat{b}\cdot\nabla f+\Omega\frac{\partial f}{\partial\varphi}\label{eq:guidingcentervlasovuniformB}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Guiding-center collision operator
\end_layout

\begin_layout Standard
The general guiding-center Fokker-Planck collision operator may be expressed
 as
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

,
\begin_inset Formula \begin{equation}
\mathcal{C}_{FP}\left[f\right]=-\mathrm{Tr}\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},\mathbf{S}\left(f\right)\right\} _{gc}\label{eq:guidingcentercollop}\end{equation}

\end_inset

where the guiding-center collisional flux has the usual form 
\begin_inset Formula \begin{equation}
\mathbf{S}\left(f\right)=\mathbf{K}f-\mathbb{D}\cdot\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},f\right\} _{gc}\label{eq:guidingcentercollflux}\end{equation}

\end_inset

with 
\begin_inset Formula $\mathbf{K}$
\end_inset

 and 
\begin_inset Formula $\mathbb{D}$
\end_inset

 the guiding-center collisional friction and diffusion respectively.
 The particle position is 
\begin_inset Formula $\mathbf{x}=\mathbf{X}+\mathbf{\boldsymbol{\rho}}$
\end_inset

 in terms of the guiding-center position 
\begin_inset Formula $\mathbf{X}$
\end_inset

 and the gyroradius vector 
\begin_inset Formula $\mathbf{\boldsymbol{\rho}}$
\end_inset

.
 
\end_layout

\begin_layout Subsubsection
Calculations of the derivatives
\end_layout

\begin_layout Standard
Calculations of the Poisson bracket involves to calculate following quantities
\begin_inset Formula \[
\frac{\partial\left(\mathbf{X}+\mathbf{\boldsymbol{\rho}}\right)}{\partial p}=\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial p}=\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial p}+\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial p}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial\left(\mathbf{X}+\mathbf{\boldsymbol{\rho}}\right)}{\partial\xi}=\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\xi}=\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\xi}+\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\xi}\]

\end_inset


\begin_inset Formula \[
\frac{\partial\left(\mathbf{X}+\mathbf{\boldsymbol{\rho}}\right)}{\partial\varphi}=\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\varphi}=\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}+\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\varphi}\]

\end_inset

and 
\begin_inset Formula \begin{align*}
\nabla^{**}\left(\mathbf{X}+\mathbf{\boldsymbol{\rho}}\right) & =\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}=\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}_{0}+\nabla^{**}\mathbf{\boldsymbol{\rho}}_{1}\end{align*}

\end_inset

as well as 
\begin_inset Formula $\partial\mathbf{S}/\partial p$
\end_inset

, 
\begin_inset Formula $\partial\mathbf{S}/\partial\xi$
\end_inset

, 
\begin_inset Formula $\partial\mathbf{S}/\partial\varphi$
\end_inset

 and 
\begin_inset Formula $\nabla^{**}\mathbf{S}$
\end_inset

 for the flux, where the gyroradius vector may be expanded as 
\begin_inset Formula $\mathbf{\boldsymbol{\rho}}=\mathbf{\boldsymbol{\rho}}_{0}+\mathbf{\boldsymbol{\rho}}_{1}$
\end_inset

, as defined in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "bri04"

\end_inset

.
 From calculations given in Appendices (
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:calcdrho0dp"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:calcdrho0dxi"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:calcdrho0dphi"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:calcgradrho0"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "sub:calcdrho1dp"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "sub:calcdrho1dxi"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "sub:calcdrho1dphi"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "sub:calcgraddoublestarrho1"

\end_inset

),
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial p}=\frac{\mathbf{\boldsymbol{\rho}}_{0}}{p}=\rho_{0}\widehat{\rho}\label{eq:drho0dp-1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\xi}=-\frac{\xi}{1-\xi^{2}}\rho_{0}\widehat{\rho}\label{eq:drho0dxi-1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}=\rho_{0}\widehat{\bot}\label{eq:drho0dphi-1}\end{equation}

\end_inset


\begin_inset Formula \begin{align}
\nabla^{**}\mathbf{\boldsymbol{\rho}}_{0} & =-\nabla\ln B\rho_{0}\widehat{\rho}-\left(\nabla\widehat{b}\cdot\boldsymbol{\rho}_{0}\right)\widehat{b}+\frac{\widehat{b}}{2}\left(\widehat{b}\cdot\nabla\times\widehat{b}\right)\rho_{0}\widehat{\bot}\label{eq:graddoublestarrho0}\end{align}

\end_inset

and 
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial p}=-\frac{2}{p}\alpha\rho_{0}\widehat{\bot}-\frac{2}{p}\beta\rho_{0}\widehat{\rho}-\frac{2}{p}\gamma\widehat{b}\label{eq:drho1dp-2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\xi}=-\left(\frac{\partial\alpha}{\partial\xi}-\frac{\xi}{1-\xi^{2}}\alpha\right)\rho_{0}\widehat{\bot}-\left(\frac{\partial\beta}{\partial\xi}-\frac{\xi}{1-\xi^{2}}\beta\right)\rho_{0}\widehat{\rho}-\frac{\partial\gamma}{\partial\xi}\widehat{b}\label{eq:drho1dxi-1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\varphi} & =-\left(\frac{\partial\alpha}{\partial\varphi}+\beta\right)\rho_{0}\widehat{\bot}+\left(\alpha-\frac{\partial\beta}{\partial\varphi}\right)\rho_{0}\widehat{\rho}-\frac{\partial\gamma}{\partial\varphi}\widehat{b}\label{eq:drho1dphi}\end{align}

\end_inset


\begin_inset Formula \begin{equation}
\nabla^{**}\mathbf{\boldsymbol{\rho}}_{1}=0\label{eq:graddoublestarrho1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Finally, for the flux term, 
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{S}}{\partial p} & =\left(\xi\frac{\partial S_{p}}{\partial p}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial p}\right)\widehat{b}\nonumber \\
 & +\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial p}+\xi\frac{\partial S_{\xi}}{\partial p}\right)\widehat{\bot}+\frac{\partial S_{\varphi}}{\partial p}\widehat{\rho}\label{eq:dSdp-1}\end{align}

\end_inset


\begin_inset Formula \begin{align}
\frac{\partial\mathbf{S}}{\partial\xi} & =\left(\xi\frac{\partial S_{p}}{\partial\xi}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial\xi}+S_{p}+\frac{\xi S_{\xi}}{\sqrt{1-\xi^{2}}}\right)\widehat{b}\nonumber \\
 & +\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial\xi}+\xi\frac{\partial S_{\xi}}{\partial\xi}-\frac{\xi S_{p}}{\sqrt{1-\xi^{2}}}+S_{\xi}\right)\widehat{\bot}+\frac{\partial S_{\varphi}}{\partial\xi}\widehat{\rho}\label{eq:dSdxi-1}\end{align}

\end_inset


\begin_inset Formula \begin{align}
\frac{\partial\mathbf{S}}{\partial\varphi} & =\left(\xi\frac{\partial S_{p}}{\partial\varphi}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial\varphi}\right)\widehat{b}+\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial\varphi}+\xi\frac{\partial S_{\xi}}{\partial\varphi}+S_{\varphi}\right)\widehat{\bot}\nonumber \\
 & -\left(\sqrt{1-\xi^{2}}S_{p}+\xi S_{\xi}-\frac{\partial S_{\varphi}}{\partial\varphi}\right)\widehat{\rho}\label{eq:dSdphi}\end{align}

\end_inset

and
\begin_inset Formula \begin{align}
\nabla^{**}\mathbf{S} & =\left[\xi\left(\nabla S_{p}+\mathbf{R}^{*}\frac{\partial S_{p}}{\partial\varphi}\right)-\sqrt{1-\xi^{2}}\left(\nabla S_{\xi}+\mathbf{R}^{*}\frac{\partial S_{\xi}}{\partial\varphi}\right)\right]\widehat{b}\nonumber \\
 & +\left(\sqrt{1-\xi^{2}}\left(\nabla S_{p}+\mathbf{R}^{*}\frac{\partial S_{p}}{\partial\varphi}\right)+\xi\left(\nabla S_{\xi}+\mathbf{R}^{*}\frac{\partial S_{\xi}}{\partial\varphi}\right)+S_{\varphi}\mathbf{R}^{*}\right)\widehat{\bot}\nonumber \\
 & +\left[\nabla S_{\varphi}+\mathbf{R}^{*}\frac{\partial S_{\varphi}}{\partial\varphi}-\sqrt{1-\xi^{2}}S_{p}\mathbf{R}^{*}-\xi S_{\xi}\mathbf{R}^{*}\right]\widehat{\rho}\label{eq:graddoublestarS}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of the Poisson bracket
\end_layout

\begin_layout Standard
The calculation of the Poisson bracket 
\begin_inset Formula $\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},G\right\} _{gc}$
\end_inset

 of a scalar function 
\begin_inset Formula $G$
\end_inset


\begin_inset Formula \begin{align}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},G\right\} _{gc} & =\frac{eB}{cp^{2}}\left[\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial\varphi}\left(p\frac{\partial G}{\partial p}-\xi\frac{\partial G}{\partial\mathcal{\xi}}\right)-\left(p\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial p}-\xi\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial\mathcal{\xi}}\right)\frac{\partial G}{\partial\varphi}\right]\nonumber \\
 & +\frac{m}{p^{2}\xi}\mathbf{v}_{gc}\cdot\left(\nabla^{**}\left(\mathbf{X}+\mathbf{\boldsymbol{\rho}}\right)\left(p\xi\frac{\partial G}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial G}{\partial\xi}\right)-\left(p\xi\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial\xi}\right)\nabla^{**}G\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\nabla^{**}\left(\mathbf{X}+\mathbf{\boldsymbol{\rho}}\right)\times\nabla^{**}G\nonumber \\
 & -\left[\frac{\left(1-\xi^{2}\right)}{2}\right]\left(\widehat{b}\cdot\nabla\ln B\right)\left(\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial\xi}\frac{\partial G}{\partial p}-\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial p}\frac{\partial G}{\partial\xi}\right)\nonumber \\
 & +\frac{\left(1-\xi^{2}\right)}{2\xi}\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\left[\frac{\partial G}{\partial\xi}\left(\nabla^{**}\left(\mathbf{X}+\mathbf{\boldsymbol{\rho}}\right)\times\nabla\ln B\right)-\left(\nabla^{**}G\times\nabla\ln B\right)\frac{\partial\mathbf{X}+\mathbf{\boldsymbol{\rho}}}{\partial\xi}\right]\label{eq:Poissonbracketpxi2}\end{align}

\end_inset

replacing 
\begin_inset Formula $\mathbf{v}_{gc}$
\end_inset

 by its expression (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:guidingcentervelocity"

\end_inset

) and keeping first order terms in 
\begin_inset Formula $\nabla$
\end_inset

, 
\begin_inset Formula \begin{align}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},G\right\} _{gc} & =\frac{eB}{cp^{2}}\left[\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\varphi}\left(p\frac{\partial G}{\partial p}-\xi\frac{\partial G}{\partial\mathcal{\xi}}\right)-\left(p\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial p}-\xi\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\mathcal{\xi}}\right)\frac{\partial G}{\partial\varphi}\right]\nonumber \\
 & +\frac{\widehat{b}}{p}\cdot\left(\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\left(p\xi\frac{\partial G}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial G}{\partial\xi}\right)-\left(p\xi\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\xi}\right)\nabla^{**}G\right)\nonumber \\
 & +\frac{1}{p^{2}\xi}\left(\frac{\widehat{b}}{\Omega_{\Vert}^{*}}\times\left(\mu\nabla B+mv_{\Vert}^{2}\widehat{b}\cdot\nabla\widehat{b}\right)\right)\cdot\left(\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\left(p\xi\frac{\partial G}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial G}{\partial\xi}\right)-\left(p\xi\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\xi}\right)\nabla^{**}G\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\times\nabla^{**}G\nonumber \\
 & -\left[\frac{\left(1-\xi^{2}\right)}{2}\right]\left(\widehat{b}\cdot\nabla\ln B\right)\left(\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\xi}\frac{\partial G}{\partial p}-\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial p}\frac{\partial G}{\partial\xi}\right)\nonumber \\
 & +\frac{\left(1-\xi^{2}\right)}{2\xi}\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\left[\frac{\partial G}{\partial\xi}\left(\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\times\nabla\ln B\right)-\left(\nabla^{**}G\times\nabla\ln B\right)\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\xi}\right]\label{eq:-8}\end{align}

\end_inset

since 
\begin_inset Formula \begin{equation}
p\xi\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\xi}=0\label{eq:-7}\end{equation}

\end_inset


\end_layout

\begin_layout Paragraph
Uniform magnetic field terms
\end_layout

\begin_layout Standard
For the terms independent of the gradient of the magnetic field,
\begin_inset Formula \begin{align}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},G\right\} _{gc}^{U} & =\frac{eB}{cp^{2}}\left[\rho_{0}\left(p\frac{\partial G}{\partial p}-\xi\frac{\partial G}{\partial\mathcal{\xi}}\right)\widehat{\bot}-\frac{1}{\left(1-\xi^{2}\right)}\rho_{0}\frac{\partial G}{\partial\varphi}\widehat{\rho}\right]\nonumber \\
 & +\frac{\widehat{b}}{p}\cdot\left(p\xi\frac{\partial G}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial G}{\partial\xi}\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\mathbb{I}\times\nabla G\label{eq:-14}\end{align}

\end_inset

and replacing 
\begin_inset Formula $\widehat{\bot}$
\end_inset

 and 
\begin_inset Formula $\widehat{b}$
\end_inset

 by 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\widehat{p}$
\end_inset

 and 
\begin_inset Formula $\widehat{\xi}$
\end_inset

 from (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bchapeau"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:perpchapeau"

\end_inset

),
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit

\begin_inset Formula \begin{align}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},G\right\} _{gc}^{U} & =\frac{\partial G}{\partial p}\widehat{p}-\frac{\sqrt{1-\xi^{2}}}{p}\frac{\partial G}{\partial\mathcal{\xi}}\widehat{\xi}-\frac{1}{p\sqrt{1-\xi^{2}}}\frac{\partial G}{\partial\varphi}\widehat{\rho}\nonumber \\
 & -\frac{c}{eB_{\Vert}^{*}}\cdot\widehat{b}\times\nabla G\nonumber \\
 & =\nabla_{p}G-\frac{c}{eB_{\Vert}^{*}}\cdot\widehat{b}\times\nabla G\label{eq:BuniformPoissonbracket}\end{align}

\end_inset

where the expression (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Larmorradius0"

\end_inset

) has been explicitly used, and
\begin_inset Formula \begin{align}
\widehat{b}\cdot\mathbb{I}\times\nabla G & =\widehat{b}\cdot\left(\widehat{b}\widehat{b}+\widehat{\bot}\widehat{\bot}+\widehat{\rho}\widehat{\rho}\right)\times\nabla G\nonumber \\
 & =\left(\widehat{b}\cdot\widehat{b}\right)\left(\widehat{b}\times\nabla G\right)+\left(\widehat{b}\cdot\widehat{\bot}\right)\left(\widehat{\bot}\times\nabla G\right)+\left(\widehat{b}\cdot\widehat{\rho}\right)\left(\widehat{\rho}\times\nabla G\right)\nonumber \\
 & =\left(\widehat{b}\times\nabla G\right)\label{eq:-4}\end{align}

\end_inset


\end_layout

\begin_layout Paragraph
Non-uniform magnetic field terms
\end_layout

\begin_layout Standard
********
\end_layout

\begin_layout Subsubsection
Calculation of the collision operator
\end_layout

\begin_layout Standard
From (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Poissonbracketpxi2"

\end_inset

)
\begin_inset Formula $\mathrm{Tr}\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},\mathbf{S}\right\} _{gc}$
\end_inset

where non-zero terms are only arising from dyadic matrices 
\begin_inset Formula $\widehat{b}\widehat{b}$
\end_inset

, 
\begin_inset Formula $\widehat{\bot}\widehat{\bot}$
\end_inset

 and 
\begin_inset Formula $\widehat{\rho}\widehat{\rho}$
\end_inset

, since the basis 
\begin_inset Formula $\left(\widehat{b},\widehat{\bot},\widehat{\rho}\right)$
\end_inset

 is orthogonal.
 
\begin_inset Formula \begin{align}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},\mathbf{S}\right\} _{gc} & =\frac{eB}{cp^{2}}\left[\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\varphi}\left(p\frac{\partial\mathbf{S}}{\partial p}-\xi\frac{\partial\mathbf{S}}{\partial\mathcal{\xi}}\right)-\left(p\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial p}-\xi\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\mathcal{\xi}}\right)\frac{\partial\mathbf{S}}{\partial\varphi}\right]\nonumber \\
 & +\frac{\widehat{b}}{p}\cdot\left(\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\left(p\xi\frac{\partial\mathbf{S}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{S}}{\partial\xi}\right)-\left(p\xi\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\xi}\right)\nabla^{**}\mathbf{S}\right)\nonumber \\
 & +\frac{1}{p^{2}\xi}\left(\frac{\widehat{b}}{\Omega_{\Vert}^{*}}\times\left(\mu\nabla B+mv_{\Vert}^{2}\widehat{b}\cdot\nabla\widehat{b}\right)\right)\cdot\left(\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\left(p\xi\frac{\partial\mathbf{S}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{S}}{\partial\xi}\right)-\left(p\xi\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\xi}\right)\nabla^{**}\mathbf{S}\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\times\nabla^{**}\mathbf{S}\nonumber \\
 & -\left[\frac{\left(1-\xi^{2}\right)}{2}\right]\left(\widehat{b}\cdot\nabla\ln B\right)\left(\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\xi}\frac{\partial\mathbf{S}}{\partial p}-\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial p}\frac{\partial\mathbf{S}}{\partial\xi}\right)\nonumber \\
 & +\frac{\left(1-\xi^{2}\right)}{2\xi}\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\left[\frac{\partial\mathbf{S}}{\partial\xi}\left(\left(\mathbb{I}+\nabla^{**}\mathbf{\boldsymbol{\rho}}\right)\times\nabla\ln B\right)-\left(\nabla^{**}\mathbf{S}\times\nabla\ln B\right)\frac{\partial\mathbf{\boldsymbol{\rho}}}{\partial\xi}\right]\label{eq:-8}\end{align}

\end_inset


\end_layout

\begin_layout Paragraph
Uniform magnetic field terms
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},\mathbf{S}\right\} _{gc}^{U} & =\frac{eB}{cp^{2}}\left[\rho_{0}\left(p\frac{\partial\mathbf{S}}{\partial p}-\xi\frac{\partial\mathbf{S}}{\partial\mathcal{\xi}}\right)\widehat{\bot}-\frac{1}{\left(1-\xi^{2}\right)}\rho_{0}\frac{\partial\mathbf{S}}{\partial\varphi}\widehat{\rho}\right]\nonumber \\
 & +\frac{\widehat{b}}{p}\cdot\left(p\xi\frac{\partial\mathbf{S}}{\partial p}+\left(1-\xi^{2}\right)\frac{\partial\mathbf{S}}{\partial\xi}\right)\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\mathbb{I}\times\nabla\mathbf{S}\label{eq:-9}\end{align}

\end_inset


\begin_inset Formula \begin{align*}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},\mathbf{S}\right\} _{gc}^{U} & =\sqrt{1-\xi^{2}}\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial p}+\xi\frac{\partial S_{\xi}}{\partial p}\right)\\
 & -\frac{\xi\sqrt{1-\xi^{2}}}{p}\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial\xi}+\xi\frac{\partial S_{\xi}}{\partial\xi}-\frac{\xi S_{p}}{\sqrt{1-\xi^{2}}}+S_{\xi}\right)\\
 & +\xi\left(\xi\frac{\partial S_{p}}{\partial p}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial p}\right)\\
 & +\frac{\left(1-\xi^{2}\right)}{p}\left(\xi\frac{\partial S_{p}}{\partial\xi}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial\xi}+S_{p}+\frac{\xi S_{\xi}}{\sqrt{1-\xi^{2}}}\right)\\
 & +\frac{1}{p\sqrt{1-\xi^{2}}}\left(\sqrt{1-\xi^{2}}S_{p}+\xi S_{\xi}-\frac{\partial S_{\varphi}}{\partial\varphi}\right)-\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\mathbb{I}\times\nabla\mathbf{S}\end{align*}

\end_inset


\begin_inset Formula \begin{align}
\left\{ \mathbf{X}+\mathbf{\boldsymbol{\rho}},\mathbf{S}\right\} _{gc}^{U} & =\frac{1}{p^{2}}\frac{\partial}{\partial p}\left(p^{2}S_{p}\right)-\frac{1}{p}\frac{\partial}{\partial\xi}\left(\sqrt{1-\xi^{2}}S_{\xi}\right)-\frac{1}{p\sqrt{1-\xi^{2}}}\frac{\partial S_{\varphi}}{\partial\varphi}\nonumber \\
 & -\frac{c\widehat{b}}{eB_{\Vert}^{*}}\cdot\mathbb{I}\times\nabla\mathbf{S}\label{eq:BuniformPoissonbracket1}\end{align}

\end_inset

which has the usual divergence form in momentum space.
\end_layout

