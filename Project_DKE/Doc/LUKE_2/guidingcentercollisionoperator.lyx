\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\beta/\partial p$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdbetadp"

\end_inset


\end_layout

\begin_layout Standard
From the definition (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:beta"

\end_inset

) of 
\begin_inset Formula $\beta$
\end_inset

, 
\begin_inset Formula \begin{equation}
\frac{\partial\beta}{\partial p}=\frac{\partial v_{\Vert}}{\partial p}\frac{\partial\beta}{\partial v_{\Vert}}+\frac{\partial\rho_{0}}{\partial p}\frac{\partial\beta}{\partial\rho_{0}}+\frac{\partial\mu}{\partial p}\frac{\partial\beta}{\partial\mu}\label{eq:-2}\end{equation}

\end_inset

with
\begin_inset Formula \begin{align}
\frac{\partial\beta}{\partial v_{\Vert}} & =\mathbf{\boldsymbol{\rho}}_{0}\cdot\frac{mv_{\Vert}}{\mu B}\widehat{b}\cdot\nabla\widehat{b}+\frac{1}{2\Omega}\left(\widehat{b}\cdot\nabla\times\widehat{b}-\mathbf{a}_{1}:\nabla\widehat{b}\right)\label{eq:dbetadvpar}\\
\frac{\partial\beta}{\partial\rho_{0}} & =\widehat{\boldsymbol{\rho}}\cdot\left(\frac{1}{2}\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dbetadrho0}\\
\frac{\partial\beta}{\partial\mu} & =-\mathbf{\boldsymbol{\rho}}_{0}\cdot\frac{mv_{\Vert}^{2}}{2\mu^{2}B}\widehat{b}\cdot\nabla\widehat{b}\label{eq:dbetadmhu}\end{align}

\end_inset

and using the expressions (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dvpardp"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dp"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dmhudp"

\end_inset

), 
\begin_inset Formula \begin{align}
\frac{\partial\beta}{\partial p} & =\frac{\xi}{m}\frac{\partial\beta}{\partial v_{\Vert}}+\frac{\rho_{0}}{p}\frac{\partial\beta}{\partial\rho_{0}}+\frac{2\mu}{p}\frac{\partial\beta}{\partial\mu}\nonumber \\
 & =\frac{\xi}{m}\left[\mathbf{\boldsymbol{\rho}}_{0}\cdot\frac{mv_{\Vert}}{\mu B}\widehat{b}\cdot\nabla\widehat{b}+\frac{1}{2\Omega}\left(\widehat{b}\cdot\nabla\times\widehat{b}-\mathbf{a}_{1}:\nabla\widehat{b}\right)\right]\nonumber \\
 & +\frac{\rho_{0}}{p}\left[\widehat{\boldsymbol{\rho}}\cdot\left(\frac{1}{2}\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & -\frac{1}{p}\mathbf{\boldsymbol{\rho}}_{0}\cdot\frac{mv_{\Vert}^{2}}{\mu B}\widehat{b}\cdot\nabla\widehat{b}\nonumber \\
 & =\frac{1}{p}\mathbf{\boldsymbol{\rho}}_{0}\cdot\left[\frac{1}{2}\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right]\nonumber \\
 & +\frac{1}{p}\left[\frac{v_{\Vert}}{2\Omega}\left(\widehat{b}\cdot\nabla\times\widehat{b}-\mathbf{a}_{1}:\nabla\widehat{b}\right)\right]\nonumber \\
 & =\frac{\beta}{p}\label{eq:dbetadp-1}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\beta/\partial\xi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdbetadxi"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\beta}{\partial\xi}=\frac{\partial v_{\Vert}}{\partial\xi}\frac{\partial\beta}{\partial v_{\Vert}}+\frac{\partial\rho_{0}}{\partial\xi}\frac{\partial\beta}{\partial\rho_{0}}+\frac{\partial\mu}{\partial\xi}\frac{\partial\beta}{\partial\mu}\end{equation}

\end_inset

and using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dmhudxi"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dvpardxi"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dxi"

\end_inset

), one obtains
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\beta}{\partial\xi} & =\frac{p}{m}\frac{\partial\beta}{\partial v_{\Vert}}-\frac{\xi}{1-\xi^{2}}\rho_{0}\frac{\partial\beta}{\partial\rho_{0}}-\frac{2\xi}{1-\xi^{2}}\mu\frac{\partial\beta}{\partial\mu}\nonumber \\
 & =\frac{1}{\xi}\left[\mathbf{\boldsymbol{\rho}}_{0}\cdot\frac{mv_{\Vert}^{2}}{\mu B}\widehat{b}\cdot\nabla\widehat{b}+\frac{v_{\Vert}}{2\Omega}\left(\widehat{b}\cdot\nabla\times\widehat{b}-\mathbf{a}_{1}:\nabla\widehat{b}\right)\right]\nonumber \\
 & -\frac{\xi}{1-\xi^{2}}\mathbf{\boldsymbol{\rho}}_{0}\cdot\left(\frac{1}{2}\nabla\ln B-\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dbetadxi}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\beta/\partial\varphi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdbetadphi"

\end_inset


\end_layout

\begin_layout Standard
Using relations (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dphi"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:da1dphi"

\end_inset

), 
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\beta}{\partial\varphi} & =\rho_{0}\widehat{\bot}\cdot\left(\frac{1}{2}\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)-\frac{v_{\Vert}}{2\Omega}\frac{\partial\mathbf{a}_{1}}{\partial\varphi}:\nabla\widehat{b}\nonumber \\
 & =\rho_{0}\widehat{\bot}\cdot\left(\frac{1}{2}\nabla\ln B+\frac{mv_{\Vert}^{2}}{2\mu B}\widehat{b}\cdot\nabla\widehat{b}\right)+\frac{2v_{\Vert}}{\Omega}\mathbf{a}_{2}:\nabla\widehat{b}\nonumber \\
 & =\alpha+\frac{v_{\Vert}}{\Omega}\mathbf{a}_{2}:\nabla\widehat{b}-\frac{\rho_{0}}{2}\widehat{\bot}\cdot\nabla\ln B\label{eq:dbetadphi}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
