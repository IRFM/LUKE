\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\gamma/\partial p$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdgammadp"

\end_inset


\end_layout

\begin_layout Standard
From the definition (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:gamma"

\end_inset

) of 
\begin_inset Formula $\gamma$
\end_inset

, 
\begin_inset Formula \begin{equation}
\frac{\partial\gamma}{\partial p}=\frac{\partial v_{\Vert}}{\partial p}\frac{\partial\gamma}{\partial v_{\Vert}}+\frac{\partial\rho_{0}}{\partial p}\frac{\partial\gamma}{\partial\rho_{0}}+\frac{\partial\mu}{\partial p}\frac{\partial\gamma}{\partial\mu}\label{eq:-2}\end{equation}

\end_inset

with
\begin_inset Formula \begin{align}
\frac{\partial\gamma}{\partial v_{\Vert}} & =2\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\cdot\left(\frac{1}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dgammadvpar}\\
\frac{\partial\gamma}{\partial\rho_{0}} & =2\widehat{\bot}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dgammadrho0}\\
\frac{\partial\gamma}{\partial\mu} & =-\frac{B}{m\Omega^{2}}\left(\frac{1}{2}\widehat{b}\cdot\nabla\ln B+\mathbf{a}_{2}:\nabla\widehat{b}\right)\label{eq:dgammadmhu}\end{align}

\end_inset

and using the expressions (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dvpardp"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dp"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dmhudp"

\end_inset

), 
\begin_inset Formula \begin{align}
\frac{\partial\gamma}{\partial p} & =\frac{\xi}{m}\frac{\partial\gamma}{\partial v_{\Vert}}+\frac{\rho_{0}}{p}\frac{\partial\gamma}{\partial\rho_{0}}+\frac{2\mu}{p}\frac{\partial\gamma}{\partial\mu}\nonumber \\
 & =\frac{\xi}{m}\left[2\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\cdot\left(\frac{1}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & +\frac{\rho_{0}}{p}\left[2\widehat{\bot}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & -\frac{2}{p}\frac{\mu B}{m\Omega^{2}}\left(\frac{1}{2}\widehat{b}\cdot\nabla\ln B+\mathbf{a}_{2}:\nabla\widehat{b}\right)\nonumber \\
 & =\frac{1}{p}\left[2\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & +\frac{1}{p}\left[2\rho_{0}\widehat{\bot}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & -\frac{2}{p}\frac{\mu B}{m\Omega^{2}}\left(\frac{1}{2}\widehat{b}\cdot\nabla\ln B+\mathbf{a}_{2}:\nabla\widehat{b}\right)\nonumber \\
 & =2\frac{\gamma}{p}\label{eq:dgammadp-1}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\gamma/\partial\xi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdgammadxi"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\gamma}{\partial\xi}=\frac{\partial v_{\Vert}}{\partial\xi}\frac{\partial\gamma}{\partial v_{\Vert}}+\frac{\partial\rho_{0}}{\partial\xi}\frac{\partial\gamma}{\partial\rho_{0}}+\frac{\partial\mu}{\partial\xi}\frac{\partial\gamma}{\partial\mu}\end{equation}

\end_inset

and using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dmhudxi"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dvpardxi"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dxi"

\end_inset

), one obtains
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\gamma}{\partial\xi} & =\frac{p}{m}\frac{\partial\gamma}{\partial v_{\Vert}}-\frac{\xi}{1-\xi^{2}}\rho_{0}\frac{\partial\gamma}{\partial\rho_{0}}-\frac{2\xi}{1-\xi^{2}}\mu\frac{\partial\gamma}{\partial\mu}\nonumber \\
 & =\frac{p}{m}\left[2\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\cdot\left(\frac{1}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\right]\nonumber \\
 & -\frac{\xi}{1-\xi^{2}}\rho_{0}2\widehat{\bot}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\nonumber \\
 & +\frac{2\xi}{1-\xi^{2}}\frac{\mu B}{m\Omega^{2}}\left(\frac{1}{2}\widehat{b}\cdot\nabla\ln B+\mathbf{a}_{2}:\nabla\widehat{b}\right)\nonumber \\
 & =\frac{2}{\xi}\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\nonumber \\
 & -\frac{\xi}{1-\xi^{2}}\left(2\gamma-\rho_{0}2\widehat{\bot}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\right)\nonumber \\
 & =-\frac{2\xi}{1-\xi^{2}}\gamma+\frac{2}{\left(1-\xi^{2}\right)\xi}\rho_{0}\widehat{\bot}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)\label{eq:dgammadxi}\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\partial\gamma/\partial\varphi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdgammadphi"

\end_inset


\end_layout

\begin_layout Standard
Using relations (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:da2dphi"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:d2rho0dphi2"

\end_inset

), 
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\gamma}{\partial\varphi}=-2\mathbf{\boldsymbol{\rho}}_{0}\cdot\left(\frac{v_{\Vert}}{\Omega}\widehat{b}\cdot\nabla\widehat{b}\right)-\frac{\mu B}{m\Omega^{2}}\mathbf{a}_{1}:\nabla\widehat{b}\label{eq:dgammadphi}\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\nabla^{**}\gamma$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcgraddoublestargamma"

\end_inset


\end_layout

\begin_layout Standard
Calculations done for 
\begin_inset Formula $\alpha$
\end_inset

 in (
\begin_inset CommandInset ref
LatexCommand ref
reference "sub:calcgraddoublestaralpha"

\end_inset

) are also valid for 
\begin_inset Formula $\gamma$
\end_inset

 so that 
\begin_inset Formula $\nabla^{**}\gamma=0$
\end_inset

.
\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{\boldsymbol{\rho}}_{1}/\partial p$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdrho1dp"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial p} & =-\frac{\partial\alpha}{\partial p}\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\frac{\partial\beta}{\partial p}\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial p}\widehat{b}-\alpha\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial p}\times\widehat{b}-\beta\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial p}\nonumber \\
 & =-\left(\frac{\partial\alpha}{\partial p}+\frac{\alpha}{\rho_{0}}\frac{\partial\rho_{0}}{\partial p}\right)\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\left(\frac{\partial\beta}{\partial p}+\frac{\beta}{\rho_{0}}\frac{\partial\rho_{0}}{\partial p}\right)\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial p}\widehat{b}\nonumber \\
 & =-2\frac{\alpha}{p}\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-2\frac{\beta}{p}\mathbf{\boldsymbol{\rho}}_{0}-\frac{2\gamma}{p}\widehat{b}\nonumber \\
 & =\frac{2}{p}\mathbf{\boldsymbol{\rho}}_{1}\label{eq:drho1dp-1}\end{align}

\end_inset

using the relation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:drho0dp"

\end_inset

).
\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{\boldsymbol{\rho}}_{1}/\partial\xi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdrho1dxi"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\xi} & =-\frac{\partial\alpha}{\partial\xi}\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\frac{\partial\beta}{\partial\xi}\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial\xi}\widehat{b}-\alpha\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\xi}\times\widehat{b}-\beta\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\xi}\nonumber \\
 & =-\left(\frac{\partial\alpha}{\partial\xi}+\frac{\alpha}{\rho_{0}}\frac{\partial\rho_{0}}{\partial\xi}\right)\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\left(\frac{\partial\beta}{\partial\xi}+\frac{\beta}{\rho_{0}}\frac{\partial\rho_{0}}{\partial\xi}\right)\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial\xi}\widehat{b}\nonumber \\
 & =-\left(\frac{\partial\alpha}{\partial\xi}-\frac{\xi}{1-\xi^{2}}\alpha\right)\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\left(\frac{\partial\beta}{\partial\xi}-\frac{\xi}{1-\xi^{2}}\beta\right)\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial\xi}\widehat{b}\label{eq:drho1dxi}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{\boldsymbol{\rho}}_{1}/\partial\varphi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdrho1dphi"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{\boldsymbol{\rho}}_{1}}{\partial\varphi} & =-\frac{\partial\alpha}{\partial\varphi}\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\frac{\partial\beta}{\partial\varphi}\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial\varphi}\widehat{b}-\alpha\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\times\widehat{b}-\beta\frac{\partial\mathbf{\boldsymbol{\rho}}_{0}}{\partial\varphi}\nonumber \\
 & =-\frac{\partial\alpha}{\partial\varphi}\rho_{0}\widehat{\rho}\times\widehat{b}-\frac{\partial\beta}{\partial\varphi}\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial\varphi}\widehat{b}-\alpha\rho_{0}\widehat{\bot}\times\widehat{b}-\beta\rho_{0}\widehat{\bot}\nonumber \\
 & =-\frac{\partial\alpha}{\partial\varphi}\rho_{0}\widehat{\bot}-\frac{\partial\beta}{\partial\varphi}\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial\varphi}\widehat{b}+\alpha\mathbf{\boldsymbol{\rho}}_{0}-\beta\rho_{0}\widehat{\bot}\nonumber \\
 & =-\left(\frac{\partial\alpha}{\partial\varphi}+\beta\right)\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}+\left(\alpha-\frac{\partial\beta}{\partial\varphi}\right)\mathbf{\boldsymbol{\rho}}_{0}-\frac{\partial\gamma}{\partial\varphi}\widehat{b}\label{eq:drho1dphi-2}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\nabla^{**}\mathbf{\boldsymbol{\rho}}_{1}$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcgraddoublestarrho1"

\end_inset


\end_layout

\begin_layout Standard
Using the expressions of 
\begin_inset Formula $\nabla^{**}\alpha$
\end_inset

, 
\begin_inset Formula $\nabla^{**}\beta$
\end_inset

, 
\begin_inset Formula $\nabla^{**}\gamma$
\end_inset

 and keeping only first order terms in 
\begin_inset Formula $\nabla$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\nabla^{**} & \mathbf{\boldsymbol{\rho}}_{1}=-\nabla^{**}\alpha\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}-\nabla^{**}\beta\mathbf{\boldsymbol{\rho}}_{0}-\nabla^{**}\gamma\widehat{b}-\alpha\nabla^{**}\mathbf{\boldsymbol{\rho}}_{0}\times\widehat{b}\nonumber \\
 & -\alpha\mathbf{\boldsymbol{\rho}}_{0}\times\nabla^{**}\widehat{b}-\beta\nabla^{**}\mathbf{\boldsymbol{\rho}}_{0}-\gamma\nabla^{**}\widehat{b}\nonumber \\
 & =0\label{eq:gradientdoublestarrho1}\end{align}

\end_inset


\end_layout

\begin_layout Section
Derivatives of 
\begin_inset Formula $\mathbf{S}$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sec:derivativesS"

\end_inset


\end_layout

\begin_layout Standard
The particle flux 
\begin_inset Formula $\mathbf{S}$
\end_inset

 is momentum space may be expressed as 
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{S}=S_{p}\widehat{p}+S_{\xi}\widehat{\xi}+S_{\varphi}\widehat{\varphi}\label{eq:-10}\end{equation}

\end_inset

where the local orthogonal basis 
\begin_inset Formula $\left(\widehat{p},\widehat{\xi},\widehat{\varphi}\right)$
\end_inset

 may be related to
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\left(\widehat{b},\widehat{\bot},\widehat{\rho}\right)$
\end_inset

 by the relation
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
 
\begin_inset Formula \begin{align}
\widehat{p} & =\xi\widehat{b}+\sqrt{1-\xi^{2}}\widehat{\bot}\label{eq:pchapeau}\\
\widehat{\xi} & =-\sqrt{1-\xi^{2}}\widehat{b}+\xi\widehat{\bot}\label{eq:xichapeau-2}\\
\widehat{\varphi} & =\widehat{\rho}\label{eq:phichapeau}\end{align}

\end_inset


\end_layout

\begin_layout Standard
It can be easily checked that 
\begin_inset Formula \begin{equation}
\widehat{\varphi}\times\widehat{p}=\widehat{\rho}\times\widehat{p}=\widehat{\xi}\label{eq:-3}\end{equation}

\end_inset

and from (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bchapeau"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:perpchapeau"

\end_inset

),
\begin_inset Formula \begin{align}
\widehat{b} & =\xi\widehat{p}-\sqrt{1-\xi^{2}}\widehat{\xi}\label{eq:bchapeau}\\
\widehat{\bot} & =\sqrt{1-\xi^{2}}\widehat{p}+\xi\widehat{\xi}\label{eq:perpchapeau}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{S}/\partial p$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdSdp"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{S}}{\partial p} & =\frac{\partial S_{p}}{\partial p}\widehat{p}+\frac{\partial S_{\xi}}{\partial p}\widehat{\xi}+\frac{\partial S_{\varphi}}{\partial p}\widehat{\varphi}\nonumber \\
 & =\left(\xi\frac{\partial S_{p}}{\partial p}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial p}\right)\widehat{b}\nonumber \\
 & +\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial p}+\xi\frac{\partial S_{\xi}}{\partial p}\right)\widehat{\bot}+\frac{\partial S_{\varphi}}{\partial p}\widehat{\rho}\label{eq:dSdp-1}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{S}/\partial\xi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdSdxi"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{S}}{\partial\xi} & =\frac{\partial S_{p}}{\partial\xi}\widehat{p}+S_{p}\frac{\partial\widehat{p}}{\partial\xi}+\frac{\partial S_{\xi}}{\partial\xi}\widehat{\xi}+S_{\xi}\frac{\partial\widehat{\xi}}{\partial\xi}+\frac{\partial S_{\varphi}}{\partial\xi}\widehat{\varphi}\nonumber \\
 & =\frac{\partial S_{p}}{\partial\xi}\widehat{p}+S_{p}\left(\widehat{b}-\frac{\xi}{\sqrt{1-\xi^{2}}}\widehat{\bot}\right)+\frac{\partial S_{\xi}}{\partial\xi}\widehat{\xi}+S_{\xi}\left(\frac{\xi}{\sqrt{1-\xi^{2}}}\widehat{b}+\widehat{\bot}\right)+\frac{\partial S_{\varphi}}{\partial\xi}\widehat{\rho}\nonumber \\
 & =\left(\xi\frac{\partial S_{p}}{\partial\xi}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial\xi}+S_{p}+\frac{\xi S_{\xi}}{\sqrt{1-\xi^{2}}}\right)\widehat{b}\nonumber \\
 & +\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial\xi}+\xi\frac{\partial S_{\xi}}{\partial\xi}-\frac{\xi S_{p}}{\sqrt{1-\xi^{2}}}+S_{\xi}\right)\widehat{\bot}+\frac{\partial S_{\varphi}}{\partial\xi}\widehat{\rho}\label{eq:dSdxi-1}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\partial\mathbf{S}/\partial\varphi$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcdSdphi"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\frac{\partial\mathbf{S}}{\partial\varphi} & =\frac{\partial S_{p}}{\partial\varphi}\widehat{p}+\frac{\partial S_{\xi}}{\partial\varphi}\widehat{\xi}+\frac{\partial S_{\varphi}}{\partial\varphi}\widehat{\varphi}+S_{p}\frac{\partial\widehat{p}}{\partial\varphi}+S_{\xi}\frac{\partial\widehat{\xi}}{\partial\varphi}+S_{\varphi}\frac{\partial\widehat{\varphi}}{\partial\varphi}\nonumber \\
 & =\left(\xi\frac{\partial S_{p}}{\partial\varphi}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial\varphi}\right)\widehat{b}+\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial\varphi}+\xi\frac{\partial S_{\xi}}{\partial\varphi}\right)\widehat{\bot}+\frac{\partial S_{\varphi}}{\partial\varphi}\widehat{\rho}\nonumber \\
 & -\left(\sqrt{1-\xi^{2}}S_{p}+\xi S_{\xi}\right)\widehat{\rho}+S_{\varphi}\widehat{\bot}\nonumber \\
 & =\left(\xi\frac{\partial S_{p}}{\partial\varphi}-\sqrt{1-\xi^{2}}\frac{\partial S_{\xi}}{\partial\varphi}\right)\widehat{b}+\left(\sqrt{1-\xi^{2}}\frac{\partial S_{p}}{\partial\varphi}+\xi\frac{\partial S_{\xi}}{\partial\varphi}+S_{\varphi}\right)\widehat{\bot}\nonumber \\
 & -\left(\sqrt{1-\xi^{2}}S_{p}+\xi S_{\xi}-\frac{\partial S_{\varphi}}{\partial\varphi}\right)\widehat{\rho}\label{eq:dSdphi-1}\end{align}

\end_inset

using the relations
\begin_inset Formula \begin{align}
\frac{\partial\widehat{p}}{\partial\varphi} & =-\sqrt{1-\xi^{2}}\widehat{\rho}\label{eq:dpchapeaudphi}\\
\frac{\partial\widehat{\xi}}{\partial\varphi} & =-\xi\widehat{\rho}\label{eq:dxichapeaudphi}\\
\frac{\partial\widehat{\varphi}}{\partial\varphi} & =\widehat{\bot}\label{eq:dphichapeaudphi}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\nabla^{**}\mathbf{S}$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sub:calcgraddoublestarS"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align}
\nabla^{**}\mathbf{S} & =\nabla^{**}\left(S_{p}\widehat{p}\right)+\nabla^{**}\left(S_{\xi}\widehat{\xi}\right)+\nabla^{**}\left(S_{\varphi}\widehat{\varphi}\right)\nonumber \\
 & =\nabla^{**}S_{p}\widehat{p}+\nabla^{**}S_{\xi}\widehat{\xi}+\nabla^{**}S_{\varphi}\widehat{\varphi}\nonumber \\
 & +S_{p}\nabla^{**}\widehat{p}+S_{\xi}\nabla^{**}\widehat{\xi}+S_{\varphi}\nabla^{**}\widehat{\varphi}\nonumber \\
 & =\nabla S_{p}\widehat{p}+\nabla S_{\xi}\widehat{\xi}+\nabla S_{\varphi}\widehat{\varphi}\nonumber \\
 & +\mathbf{R}^{*}\frac{\partial S_{p}}{\partial\varphi}\widehat{p}+\mathbf{R}^{*}\frac{\partial S_{\xi}}{\partial\varphi}\widehat{\xi}+\mathbf{R}^{*}\frac{\partial S_{\varphi}}{\partial\varphi}\widehat{\varphi}\nonumber \\
 & +S_{p}\mathbf{R}^{*}\frac{\partial\widehat{p}}{\partial\varphi}+S_{\xi}\mathbf{R}^{*}\frac{\partial\widehat{\xi}}{\partial\varphi}+S_{\varphi}\mathbf{R}^{*}\frac{\partial\widehat{\varphi}}{\partial\varphi}\nonumber \\
 & =\left[\xi\left(\nabla S_{p}+\mathbf{R}^{*}\frac{\partial S_{p}}{\partial\varphi}\right)-\sqrt{1-\xi^{2}}\left(\nabla S_{\xi}+\mathbf{R}^{*}\frac{\partial S_{\xi}}{\partial\varphi}\right)\right]\widehat{b}\nonumber \\
 & +\left(\sqrt{1-\xi^{2}}\left(\nabla S_{p}+\mathbf{R}^{*}\frac{\partial S_{p}}{\partial\varphi}\right)+\xi\left(\nabla S_{\xi}+\mathbf{R}^{*}\frac{\partial S_{\xi}}{\partial\varphi}\right)+S_{\varphi}\mathbf{R}^{*}\right)\widehat{\bot}\nonumber \\
 & +\left[\nabla S_{\varphi}+\mathbf{R}^{*}\frac{\partial S_{\varphi}}{\partial\varphi}-\sqrt{1-\xi^{2}}S_{p}\mathbf{R}^{*}-\xi S_{\xi}\mathbf{R}^{*}\right]\widehat{\rho}\label{eq:graddoublestarS-1}\end{align}

\end_inset

using relations (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dpchapeaudphi"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dxichapeaudphi"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:dphichapeaudphi"

\end_inset

).
\end_layout

\end_body
