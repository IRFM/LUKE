\begin_layout Section
\start_of_appendix
Calculation of 
\begin_inset Formula $\mathbb{W}_{\mathbf{XX}}$
\end_inset


\begin_inset CommandInset label
LatexCommand label
name "sec:WXX"

\end_inset


\end_layout

\begin_layout Standard
Using the expression for 
\begin_inset Formula $W$
\end_inset

,denoting 
\begin_inset Formula $x^{i}\equiv\left(\mathbf{X}\right)$
\end_inset

 the spatial coordinates and shortening the spatial coefficients 
\begin_inset Formula $W_{x^{i}}$
\end_inset

 as 
\begin_inset Formula $W_{i}$
\end_inset

, the spatial gradient reads 
\begin_inset Formula $\bnabla\equiv\bnabla x^{i}\left(\partial/\partial x^{i}\right)$
\end_inset

 and we have
\begin_inset Formula \begin{align}
W_{12}= & \pd{}{x^{1}}\left(\frac{e}{c}A_{2}+mv_{\|}b_{2}-\frac{\mu B}{\Omega}R_{2}^{*}\right)-\pd{}{x^{2}}\left(\frac{e}{c}A_{1}+mv_{\|}b_{1}-\frac{\mu B}{\Omega}R_{1}^{*}\right)\nonumber \\
= & \left[\bnabla\btimes\left(\frac{e}{c}\mathbf{A}+mv_{\|}\bhat-\frac{\mu B}{\Omega}\mathbf{R}^{*}\right)\right]_{3}\nonumber \\
= & \left[\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right]_{3}\\
W_{13}= & \pd{}{x^{1}}\left(\frac{e}{c}A_{3}+mv_{\|}b_{3}-\frac{\mu B}{\Omega}R_{3}^{*}\right)-\pd{}{x^{3}}\left(\frac{e}{c}A_{1}+mv_{\|}b_{1}-\frac{\mu B}{\Omega}R_{1}^{*}\right)\nonumber \\
= & -\left[\bnabla\btimes\left(\frac{e}{c}\mathbf{A}+mv_{\|}\bhat-\frac{\mu B}{\Omega}\mathbf{R}^{*}\right)\right]_{2}\nonumber \\
= & -\left[\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right]_{2}\\
W_{23}= & \pd{}{x^{2}}\left(\frac{e}{c}A_{3}+mv_{\|}b_{3}-\frac{\mu B}{\Omega}R_{3}^{*}\right)-\pd{}{x^{3}}\left(\frac{e}{c}A_{2}+mv_{\|}b_{2}-\frac{\mu B}{\Omega}R_{2}^{*}\right)\nonumber \\
= & \left[\bnabla\btimes\left(\frac{e}{c}\mathbf{A}+mv_{\|}\bhat-\frac{\mu B}{\Omega}\mathbf{R}^{*}\right)\right]_{1}\nonumber \\
= & \left[\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right]_{1}\end{align}

\end_inset

with 
\begin_inset Formula $W_{11}=W_{22}=W_{33}=0$
\end_inset

 and defining 
\begin_inset Formula $\mathbf{B}^{*}\equiv\bnabla\btimes\left[\mathbf{A}+\left(v_{\|}/\Omega\right)\mathbf{B}\right]\equiv\mathbf{B}+B\left(v_{\|}/\Omega\right)\bnabla\btimes\bhat$
\end_inset

.
 We can therefore deduce
\begin_inset Formula \begin{align}
W_{ij}= & \epsilon^{ijk}\left[\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right]_{k}\nonumber \\
= & -\epsilon^{ikl}\left[\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right]_{k}\delta_{lj}\nonumber \\
= & \left(-\left[\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right]\btimes\mathbb{I}\right)_{ij}\end{align}

\end_inset

Using 
\begin_inset Formula $\mathbf{B}^{*}\equiv\bnabla\btimes\left[\mathbf{A}+\left(v_{\|}/\Omega\right)\mathbf{B}\right]$
\end_inset

, we finally have the expression
\begin_inset Formula \begin{equation}
\mathbb{W}_{\mathbf{XX}}=-\left(\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right)\btimes\mathbb{I}\end{equation}

\end_inset


\end_layout

\begin_layout Section
Inverse of a 4 by 4 antisymmetric matrix
\begin_inset CommandInset label
LatexCommand label
name "sec:Inverse44"

\end_inset


\end_layout

\begin_layout Standard
Let us consider the following antisymmetric matrix
\begin_inset Formula \begin{equation}
\mathbb{A}=\left(\begin{array}{cccc}
0 & a & b & c\\
-a & 0 & d & e\\
-b & -d & 0 & f\\
-c & -e & -f & 0\end{array}\right)\end{equation}

\end_inset

The cofactors of 
\begin_inset Formula $\mathbb{A}$
\end_inset

 read
\begin_inset Formula \begin{equation}
C_{ij}=\left(-1\right)^{i+j}\det\mathbb{M}_{ij}\end{equation}

\end_inset

where 
\begin_inset Formula $\mathbb{M}_{ij}$
\end_inset

 is the submatrix of 
\begin_inset Formula $\mathbb{A}$
\end_inset

 where the row 
\begin_inset Formula $i$
\end_inset

 and column 
\begin_inset Formula $j$
\end_inset

 have been omitted.
 The determinant of an odd-order antisymmetric matrix is always zero, therefore
\begin_inset Formula \begin{equation}
C_{ii}=0\end{equation}

\end_inset

Due to antisymmetry, we also have
\begin_inset Formula \begin{equation}
C_{ji}=-C_{ij}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $C_{12}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
C_{12}=-\left|\begin{array}{ccc}
-a & d & e\\
-b & 0 & f\\
-c & -f & 0\end{array}\right|=-bef+cdf+af^{2}=f\left(af-be+cd\right)\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $C_{13}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
C_{13}=\left|\begin{array}{ccc}
-a & 0 & e\\
-b & -d & f\\
-c & -e & 0\end{array}\right|=be^{2}-cde-aef=-e\left(af-be+cd\right)\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $C_{14}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
C_{14}=-\left|\begin{array}{ccc}
-a & 0 & d\\
-b & -d & 0\\
-c & -e & -f\end{array}\right|=adf-bde+cd^{2}=d\left(af-be+cd\right)\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $C_{23}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
C_{23}=-\left|\begin{array}{ccc}
0 & a & c\\
-b & -d & f\\
-c & -e & 0\end{array}\right|=acf-bce+c^{2}d=c\left(af-be+cd\right)\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $C_{24}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
C_{24}=\left|\begin{array}{ccc}
0 & a & b\\
-b & -d & 0\\
-c & -e & -f\end{array}\right|=b^{2}e-bcd-abf=-b\left(af-be+cd\right)\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $C_{34}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
C_{34}=-\left|\begin{array}{ccc}
0 & a & b\\
-a & 0 & d\\
-c & -e & -f\end{array}\right|=acd-abe+a^{2}f=a\left(af-be+cd\right)\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\det\mathbb{A}$
\end_inset


\end_layout

\begin_layout Standard
Developing the first row of the determinant gives
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\det\mathbb{A}=aC_{12}+bC_{13}+cC_{14}=\left(af-be+cd\right)^{2}\end{equation}

\end_inset

the determinant is nonnegative, which is consistent with properties of antisymme
tric matrices.
\end_layout

\begin_layout Subsection
Expression for 
\begin_inset Formula $\mathbb{A}^{-1}$
\end_inset


\end_layout

\begin_layout Standard
The inverse matrix is proportional to the transpose cofactor matrix, i.e.
\begin_inset Formula \begin{equation}
\left(\mathbb{A}^{-1}\right)_{ij}=\frac{1}{\det\mathbb{A}}C_{ji}\end{equation}

\end_inset


\begin_inset Formula $\mathbb{A}^{-1}$
\end_inset

 therefore reads
\begin_inset Formula \begin{equation}
\mathbb{A}^{-1}=\frac{1}{af-be+cd}\left(\begin{array}{cccc}
0 & -f & e & -d\\
f & 0 & -c & b\\
-e & c & 0 & -a\\
d & -b & a & 0\end{array}\right)\end{equation}

\end_inset

the term 
\begin_inset Formula $af-be+cd$
\end_inset

 will be called the inverse matrix denominator in this document.
\end_layout

