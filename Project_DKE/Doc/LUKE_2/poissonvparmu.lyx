\begin_layout Title
Calculation of the guiding-center Poisson bracket in 
\begin_inset Formula $\left(\mathbf{X},v_{\|},\mu,\varphi\right)$
\end_inset

 coordinates
\end_layout

\begin_layout Section
Guiding-center Lagrangian matrix in 
\begin_inset Formula $\left(\mathbf{X},v_{\|},\mu,\varphi\right)$
\end_inset

 coordinates
\end_layout

\begin_layout Standard
The guiding-center Lagrangian reads
\begin_inset Formula \begin{equation}
\Gamma=\left(\frac{e}{c}\mathbf{A}+mv_{\|}\bhat\right)\bdot\extd\mathbf{X}+\frac{\mu B}{\Omega}\left(\extd\varphi-\mathbf{R}^{*}\bdot\extd\mathbf{X}\right)-\left(\frac{1}{2}mv_{\|}^{2}+\mu B\right)\extd t\equiv\Gamma_{\alpha}\extd z^{\alpha}-H\extd t\end{equation}

\end_inset

where 
\begin_inset Formula $z^{\alpha}\equiv\left(\mathbf{X},\mu,v_{\|},\mu\right)$
\end_inset

, 
\begin_inset Formula $\mathbf{A}$
\end_inset

 is the magnetic vector potential, 
\begin_inset Formula $\mathbf{R}^{*}=\mathbf{R}+\frac{1}{2}\left(\bhat\bdot\bnabla\btimes\bhat\right)\bhat$
\end_inset

 the modified gyro-gauge vector and 
\begin_inset Formula $\Omega\equiv eB/mc$
\end_inset

 is the particle gyro-frequency.
 We immediately deduce the expressions for the symplectic part of the guiding-ce
nter Lagrangian 
\begin_inset Formula $\left(\Gamma_{\alpha}\right)$
\end_inset

:
\begin_inset Formula \begin{align}
\boldsymbol{\Gamma}_{\mathbf{X}}= & \frac{e}{c}\mathbf{A}+mv_{\|}\bhat-\frac{\mu B}{\Omega}\mathbf{R}^{*}\\
\Gamma_{v_{\|}}= & 0\\
\Gamma_{\mu}= & 0\\
\Gamma_{\varphi}= & \frac{\mu B}{\Omega}\end{align}

\end_inset

We then perform the exterior derivative of 
\begin_inset Formula $\left(\Gamma_{\alpha}\right)$
\end_inset

 in order to obtain the following guiding-center 2-form:
\begin_inset Formula \begin{equation}
W\equiv\extd\Gamma\equiv\frac{1}{2}W_{\alpha\beta}\extd z^{\alpha}\wedge\extd z^{\beta}\equiv\pd{\Gamma_{\beta}}{z^{\alpha}}\extd z^{\alpha}\wedge\extd z^{\beta}\equiv\frac{1}{2}\left(\pd{\Gamma_{\beta}}{z^{\alpha}}-\pd{\Gamma_{\alpha}}{z^{\beta}}\right)\extd z^{\alpha}\wedge\extd z^{\beta}\end{equation}

\end_inset

We note here that the coefficients 
\begin_inset Formula $W_{\alpha\beta}$
\end_inset

 are antisymmetric, i.e.
 
\begin_inset Formula $W_{\alpha\beta}=-W_{\beta\alpha}$
\end_inset

.
 These read
\begin_inset Formula \begin{align}
\mathbb{W}_{\mathbf{XX}}= & -\left(\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right)\btimes\mathbb{I}\\
\mathbf{W}_{\mathbf{X}v_{\|}}= & -m\bhat\\
\mathbf{W}_{\mathbf{X}\mu}= & \frac{B}{\Omega}\mathbf{R}^{*}\\
\mathbf{W}_{\mathbf{X}\varphi}= & 0\\
W_{v_{\|}\mu}= & 0\\
W_{v_{\|}\varphi}= & 0\\
W_{\mu\varphi}= & \frac{B}{\Omega}\end{align}

\end_inset

with 
\begin_inset Formula $W_{v_{\|}v_{\|}}=W_{\mu\mu}=W_{\varphi\varphi}=0$
\end_inset

, and defining 
\begin_inset Formula $\mathbf{B}^{*}\equiv\bnabla\btimes\left[\mathbf{A}+\left(v_{\|}/\Omega\right)\mathbf{B}\right]\equiv\mathbf{B}+B\left(v_{\|}/\Omega\right)\bnabla\btimes\bhat$
\end_inset

.
 The calculation for 
\begin_inset Formula $\mathbb{W}_{\mathbf{XX}}$
\end_inset

 is detailled in appendix 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:WXX"

\end_inset

.
\end_layout

\begin_layout Section
Calculation of the Poisson matrix
\end_layout

\begin_layout Standard
The Poisson matrix is the inverse of the Lagrangian matrix.
 According to Littlejohn
\begin_inset CommandInset citation
LatexCommand cite
key "Little81"

\end_inset

, if a 
\begin_inset Formula $\left(2N\times2N\right)$
\end_inset

 antisymmetric matrix has the following expression
\begin_inset Formula \begin{equation}
\mathbb{W}\equiv\left(\begin{array}{ccc}
\mathbb{X} & \mathbf{Y} & 0\\
-\mathbf{Y}^{T} & 0 & z\\
0 & -z & 0\end{array}\right)\end{equation}

\end_inset

where 
\begin_inset Formula $\mathbb{X}$
\end_inset

 is a 
\begin_inset Formula $\left(2N-2\right)\times\left(2N-2\right)$
\end_inset

 antisymmetric matrix, 
\begin_inset Formula $\mathbf{Y}$
\end_inset

 is a 
\begin_inset Formula $\left(2N-2\right)$
\end_inset

 column vector and 
\begin_inset Formula $z$
\end_inset

 a scalar will have the following inverse expression
\begin_inset Formula \begin{equation}
\mathbb{W}^{-1}=\left(\begin{array}{ccc}
\mathbb{X}^{-1} & 0 & \frac{1}{z}\left(\mathbb{X}^{-1}\bdot\mathbf{Y}\right)\\
0 & 0 & -\frac{1}{z}\\
-\frac{1}{z}\left(\mathbb{X}^{-1}\bdot\mathbf{Y}\right)^{T} & \frac{1}{z} & 0\end{array}\right)\end{equation}

\end_inset

we can verify that the product of these two matrices gives identity.
 In the case of the Lagrangian matrix, we have
\begin_inset Formula \begin{equation}
\mathbb{X}=\left(\begin{array}{cc}
\mathbb{W}_{\mathbf{XX}} & -m\bhat\\
m\bhat^{T} & 0\end{array}\right)\end{equation}

\end_inset


\begin_inset Formula \begin{equation}
\mathbf{Y}=\left(\begin{array}{c}
\frac{B}{\Omega}\mathbf{R}^{*}\\
0\end{array}\right)\end{equation}

\end_inset


\begin_inset Formula \begin{equation}
z=\frac{B}{\Omega}\end{equation}

\end_inset

In order to calculate the Poisson matrix, we therefore need to calculate
 
\begin_inset Formula $\mathbb{X}^{-1}$
\end_inset

.
 Using the expression found in appendix 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:Inverse44"

\end_inset

, we can calculate the inverse matrix denominator 
\begin_inset Formula $D$
\end_inset


\begin_inset Formula \begin{align}
D= & -mb_{3}W_{12}+mb_{2}W_{13}-mb_{1}W_{23}\nonumber \\
= & -m\bhat\bdot\left(\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right)\nonumber \\
= & -\frac{m^{2}\Omega}{B}B_{\|}^{*}+\frac{m\mu B}{\Omega}\bhat\bdot\bnabla\btimes\mathbf{R}^{*}\nonumber \\
= & -m^{2}\Omega_{\|}^{*}+\frac{m\mu B}{\Omega}\bhat\bdot\bnabla\btimes\mathbf{R}^{*}\end{align}

\end_inset

the inverse matrix 
\begin_inset Formula $\mathbb{X}^{-1}$
\end_inset

 will therefore read
\begin_inset Formula \begin{align}
\mathbb{X}^{-1}= & \frac{1}{D}\left(\begin{array}{cccc}
0 & mb_{1} & -mb_{2} & -W_{23}\\
-mb_{1} & 0 & mb_{3} & W_{13}\\
mb_{2} & -mb_{3} & 0 & -W_{12}\\
W_{23} & -W_{13} & W_{12} & 0\end{array}\right)\nonumber \\
= & \frac{1}{D}\left(\begin{array}{cc}
-m\bhat\btimes\mathbb{I} & -\left(\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right)\\
\left(\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right)^{T} & 0\end{array}\right)\end{align}

\end_inset

we can therefore calculate
\begin_inset Formula \begin{align}
\mathbb{X}^{-1}\bdot\mathbf{Y}= & \frac{1}{D}\left(\begin{array}{c}
-\frac{mB}{\Omega}\bhat\btimes\mathbf{R}^{*}\\
m\mathbf{B}^{*}\bdot\mathbf{R}^{*}-\frac{\mu B^{2}}{\Omega^{2}}\mathbf{R}^{*}\bdot\bnabla\btimes\mathbf{R}^{*}\end{array}\right)\end{align}

\end_inset

The Poisson matrix reads
\begin_inset Formula \begin{align}
\mathbb{J}= & \mathbb{W}^{-1}\nonumber \\
= & \left(\begin{array}{cccc}
-\frac{m}{D}\bhat\btimes\mathbb{I} & -\frac{1}{D}\left(\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right) & 0 & -\frac{m}{D}\bhat\btimes\mathbf{R}^{*}\\
\frac{1}{D}\left(\frac{m\Omega}{B}\mathbf{B}^{*}-\frac{\mu B}{\Omega}\bnabla\btimes\mathbf{R}^{*}\right)^{T} & 0 & 0 & \frac{m\Omega}{BD}\mathbf{B}^{*}\bdot\mathbf{R}^{*}-\frac{\mu B}{\Omega D}\mathbf{R}^{*}\bdot\bnabla\btimes\mathbf{R}^{*}\\
0 & 0 & 0 & -\frac{\Omega}{B}\\
-\frac{m}{D}\left(\bhat\btimes\mathbf{R}^{*}\right)^{T} & -\left(\frac{m\Omega}{BD}\mathbf{B}^{*}\bdot\mathbf{R}^{*}-\frac{\mu B}{\Omega D}\mathbf{R}^{*}\bdot\bnabla\btimes\mathbf{R}^{*}\right) & \frac{\Omega}{B} & 0\end{array}\right)\end{align}

\end_inset

Since terms containing 
\begin_inset Formula $\bnabla\btimes\mathbf{R}^{*}$
\end_inset

 are of second order in 
\begin_inset Formula $\epsilon_{B}$
\end_inset

, they can be neglected and therefore
\begin_inset Formula \begin{equation}
\mathbb{J}=\left(\begin{array}{cccc}
\frac{1}{m\Omega_{\|}^{*}}\bhat\btimes\mathbb{I} & \frac{1}{mB_{\|}^{*}}\mathbf{B}^{*} & 0 & -\frac{1}{m\Omega_{\|}^{*}}\bhat\btimes\mathbf{R}^{*}\\
-\frac{1}{mB_{\|}^{*}}\left(\mathbf{B}^{*}\right)^{T} & 0 & 0 & -\frac{1}{mB_{\|}^{*}}\mathbf{B}^{*}\bdot\mathbf{R}^{*}\\
0 & 0 & 0 & -\frac{\Omega}{B}\\
\frac{1}{m\Omega_{\|}^{*}}\left(\bhat\btimes\mathbf{R}^{*}\right)^{T} & \frac{1}{mB_{\|}^{*}}\mathbf{B}^{*}\bdot\mathbf{R}^{*} & \frac{\Omega}{B} & 0\end{array}\right)\end{equation}

\end_inset

The Poisson bracket therefore reads
\begin_inset Formula \begin{align}
\left\{ F,G\right\} _{gc}\equiv & \pd F{z^{\alpha}}J_{\alpha\beta}\pd G{z^{\beta}}\nonumber \\
= & \bnabla F\bdot\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\bnabla G+\frac{\mathbf{B}^{*}}{mB_{\|}^{*}}\bdot\left(\bnabla F\pd G{v_{\|}}-\pd F{v_{\|}}\bnabla G\right)\nonumber \\
 & -\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mathbf{R}^{*}\bdot\left(\bnabla F\pd G{\varphi}-\pd F{\varphi}\bnabla G\right)-\frac{\mathbf{B}^{*}}{mB_{\|}^{*}}\bdot\mathbf{R}^{*}\left(\pd F{v_{\|}}\pd G{\varphi}-\pd F{\varphi}\pd G{v_{\|}}\right)\nonumber \\
 & -\frac{\Omega}{B}\left(\pd F{\mu}\pd G{\varphi}-\pd F{\varphi}\pd G{\mu}\right)\nonumber \\
= & \left(\bnabla F+\mathbf{R}^{*}\pd F{\varphi}\right)\bdot\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\left(\bnabla G+\mathbf{R}^{*}\pd G{\varphi}\right)\nonumber \\
 & +\frac{\mathbf{B}^{*}}{mB_{\|}^{*}}\bdot\left[\left(\bnabla F+\mathbf{R}^{*}\pd F{\varphi}\right)\pd G{v_{\|}}-\pd F{v_{\|}}\left(\bnabla G+\mathbf{R}^{*}\pd G{\varphi}\right)\right]\nonumber \\
 & +\frac{\Omega}{B}\left(\pd F{\varphi}\pd G{\mu}-\pd F{\mu}\pd G{\varphi}\right)\nonumber \\
= & \frac{\Omega}{B}\left(\pd F{\varphi}\pd G{\mu}-\pd F{\mu}\pd G{\varphi}\right)+\frac{\mathbf{B}^{*}}{mB_{\|}^{*}}\bdot\left(\bnabla^{*}F\pd G{v_{\|}}-\pd F{v_{\|}}\bnabla^{*}G\right)-\frac{\bhat}{m\Omega_{\|}^{*}}\bdot\bnabla^{*}F\btimes\bnabla^{*}G\end{align}

\end_inset

where we defined 
\begin_inset Formula $\bnabla^{*}\equiv\bnabla+\mathbf{R}^{*}\partial/\partial\varphi$
\end_inset

 and 
\begin_inset Formula $\bnabla^{*}F\bdot\bhat\btimes\bnabla^{*}G=\epsilon^{ijk}\left(\partial_{i}^{*}F\right)b_{j}\left(\partial_{k}^{*}G\right)=-\bhat\bdot\bnabla^{*}F\btimes\bnabla^{*}G$
\end_inset

.
\end_layout

\begin_layout Section
Poisson bracket in 
\begin_inset Formula $\left(\mathbf{X},\mathcal{E},\mu,\varphi\right)$
\end_inset

 coordinates
\end_layout

\begin_layout Standard
The particle energy 
\begin_inset Formula $\mathcal{E}$
\end_inset

 reads
\begin_inset Formula \begin{equation}
\mathcal{E}\equiv\frac{1}{2}mv_{\|}^{2}+\mu B\end{equation}

\end_inset

We therefore have
\begin_inset Formula \begin{equation}
\extd\mathcal{E}=\mu\bnabla B\bdot\extd\mathbf{X}+mv_{\|}\extd v_{\|}+B\extd\mu\end{equation}

\end_inset

We readily deduce the following poisson brackets, using 
\begin_inset Formula $\left\{ z^{\alpha},z^{\beta}\right\} \equiv J_{\alpha\beta}$
\end_inset


\begin_inset Formula \begin{align}
\left\{ \mathbf{X},\mathcal{E}\right\} _{gc}= & \left\{ \mathbf{X},\mathbf{X}\right\} _{gc}\bdot\mu\bnabla B+mv_{\|}\left\{ \mathbf{X},v_{\|}\right\} _{gc}+B\left\{ \mathbf{X},\mu\right\} _{gc}\nonumber \\
= & \frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mu\bnabla B+\frac{v_{\|}}{B_{\|}^{*}}\mathbf{B}^{*}\label{eq:poissonXE}\end{align}

\end_inset


\begin_inset Formula \begin{align}
\left\{ v_{\|},\mathcal{E}\right\} _{gc}= & \left\{ v_{\|},\mathbf{X}\right\} _{gc}\bdot\mu\bnabla B+B\left\{ v_{\|},\mu\right\} _{gc}\nonumber \\
= & \frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mu\bnabla B+\frac{v_{\|}}{B_{\|}^{*}}\mathbf{B}^{*}\label{eq:poissonvparE}\end{align}

\end_inset


\begin_inset Formula \begin{align}
\left\{ \mu,\mathcal{E}\right\} _{gc}= & \left\{ \mu,\mathbf{X}\right\} _{gc}\bdot\mu\bnabla B+mv_{\|}\left\{ \mu,v_{\|}\right\} _{gc}\nonumber \\
= & 0\label{eq:poissonmuE}\end{align}

\end_inset


\begin_inset Formula \begin{align}
\left\{ \varphi,\mathcal{E}\right\} _{gc}= & \left\{ \varphi,\mathbf{X}\right\} _{gc}\bdot\mu\bnabla B+mv_{\|}\left\{ \varphi,v_{\|}\right\} _{gc}+B\left\{ \varphi,\mu\right\} _{gc}\nonumber \\
= & \Omega+\left(\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mu\bnabla B+\frac{v_{\|}}{B_{\|}^{*}}\mathbf{B}^{*}\right)\bdot\mathbf{R}^{*}\label{eq:poissonvarphiE}\end{align}

\end_inset

The remaining coordinate Poisson brackets remain unchanged, i.e.
\begin_inset Formula \begin{align}
\left\{ \mathbf{X},\mathbf{X}\right\} _{gc}= & \frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mathbb{I}\\
\left\{ \mathbf{X},\mu\right\} _{gc}= & 0\\
\left\{ \mathbf{X},\varphi\right\} _{gc}= & -\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mathbf{R}^{*}\\
\left\{ \mu,\varphi\right\} _{gc}= & -\frac{\Omega}{B}\end{align}

\end_inset

Since 
\begin_inset Formula $\bnabla\btimes\bhat=\left(\bhat\bdot\bnabla\btimes\bhat\right)\bhat+\bhat\btimes\left(\bhat\bdot\bnabla\bhat\right)$
\end_inset

, we can rewrite 
\begin_inset Formula $\mathbf{B}^{*}$
\end_inset

 as
\begin_inset Formula \begin{equation}
\mathbf{B}^{*}=B_{\|}^{*}\bhat+\frac{v_{\|}}{\Omega}\bhat\btimes\left(\bhat\bdot\bnabla\bhat\right)\end{equation}

\end_inset

We thus define 
\begin_inset Formula $\mathbf{v}_{gc}$
\end_inset

 as
\begin_inset Formula \begin{equation}
\mathbf{v}_{gc}\equiv\frac{v_{\|}}{B_{\|}^{*}}\mathbf{B}^{*}+\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mu\bnabla B=v_{\|}\bhat+\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\left(\mu\bnabla B+mv_{\|}^{2}\bhat\bdot\bnabla\bhat\right)\end{equation}

\end_inset

The new guiding-center Poisson bracket therefore reads
\begin_inset Formula \begin{align}
\left\{ F,G\right\} _{gc}= & \bnabla F\bdot\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\bnabla G+\mathbf{v}_{gc}\bdot\left(\bnabla F\pd G{\mathcal{E}}-\pd F{\mathcal{E}}\bnabla G\right)\nonumber \\
 & -\frac{\bhat}{m\Omega_{\|}^{*}}\btimes\mathbf{R}^{*}\bdot\left(\bnabla F\pd G{\varphi}-\pd F{\varphi}\bnabla G\right)-\mathbf{v}_{gc}\bdot\mathbf{R}^{*}\left(\pd F{\mathcal{E}}\pd G{\varphi}-\pd F{\varphi}\pd G{\mathcal{E}}\right)\nonumber \\
 & -\frac{\Omega}{B}\left(\pd F{\mu}\pd G{\varphi}-\pd F{\varphi}\pd G{\mu}\right)-\Omega\left(\pd F{\mathcal{E}}\pd G{\varphi}-\pd F{\varphi}\pd G{\mathcal{E}}\right)\nonumber \\
= & \frac{\Omega}{B}\left[\pd F{\varphi}\left(\pd G{\mu}+B\pd G{\mathcal{E}}\right)-\left(\pd F{\mu}+B\pd F{\mathcal{E}}\right)\pd G{\varphi}\right]\nonumber \\
 & +\mathbf{v}_{gc}\bdot\left(\bnabla^{*}F\pd G{\mathcal{E}}-\pd F{\mathcal{E}}\bnabla^{*}G\right)\nonumber \\
 & -\frac{\bhat}{m\Omega_{\|}^{*}}\bdot\bnabla^{*}F\btimes\bnabla^{*}G\label{eq:poissonE}\end{align}

\end_inset

We therefore obtain the expression found in Brizard
\begin_inset CommandInset citation
LatexCommand cite
key "Bri04"

\end_inset

.
\end_layout

