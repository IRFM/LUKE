\begin_inset Formula \begin{multline*}
C_{37}=\int_{0}^{\frac{\pi}{2}}\frac{\cos^{3}2\tilde{\phi}}{C^{7}}d\tilde{\phi}=\int_{0}^{\frac{\pi}{2}}\left(\frac{\left(k^{2}-2\right)^{3}}{k^{6}C^{7}}+6\frac{\left(k^{2}-2\right)^{2}}{k^{6}C^{5}}+12\frac{k^{2}-2}{k^{6}C^{3}}+\frac{8}{k^{6}C}\right)d\tilde{\phi}\\
