\begin_layout Standard
We therefore obtain a form of the total magnetic field which depends only
 on 
\begin_inset Formula $R,Z,\epsilon,R_{c},Z_{c},I$
\end_inset

.The expression of the total magnetic field becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
B_{R}=\frac{\mu_{0}IR_{c}^{2}\left(Z-Z_{c}\right)}{2\pi}\left(-C_{13}+\frac{\epsilon^{2}}{4}\left(\frac{R_{c}}{\tilde{R}^{5}}\left(6RC_{25}+11R_{c}C_{15}\right)-\frac{15}{8}\frac{R_{c}^{2}}{\tilde{R}^{7}}\left(R^{2}C_{37}+RR_{c}C_{27}+\left(R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{17}\right)\right)\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
B_{Z}=\frac{\mu_{0}IR_{c}^{2}}{2\pi}\left(R_{c}\left(C_{03}+\frac{\epsilon^{2}}{4}\left(-\frac{R_{c}}{\tilde{R}^{5}}\left(3RC_{15}+8R_{c}C_{05}\right)+\frac{15}{8}\frac{R_{c}^{2}}{\tilde{R}^{7}}\left(R^{2}C_{27}+RR_{c}C_{17}+\left(R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{07}\right)\right)\right)\right.\\
\left.-R\left(-C_{13}+\frac{\epsilon^{2}}{4}\left(3\frac{R_{c}}{\tilde{R}^{5}}\left(RC_{25}+3R_{c}C_{15}\right)-\frac{15}{8}\frac{R_{c}^{2}}{\tilde{R}^{7}}\left(R^{2}C_{37}+RR_{c}C_{27}+\left(R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{17}\right)\right)\right)\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
We then have the final expression :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{R} & = & \frac{\mu_{0}IR_{c}^{2}\left(Z-Z_{c}\right)}{2\pi}\left(-C_{13}+\frac{\epsilon^{2}}{4\tilde{R}^{5}}\left(\vphantom{\frac{R_{c}^{2}}{\tilde{R}^{2}}}R_{c}\left(6RC_{25}+11R_{c}C_{15}\right)\right.\right.\\
 &  & \left.\left.-\frac{15}{8}\frac{R_{c}^{2}}{\tilde{R}^{2}}\left(R^{2}C_{37}+RR_{c}C_{27}+\left(R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{17}\right)\right)\right)\end{array}}\label{eq:BR}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{Z} & = & \frac{\mu_{0}IR_{c}^{2}}{2\pi}\left(R_{c}C_{03}+RC_{13}+\frac{\epsilon^{2}}{4\tilde{R}^{5}}\left(\vphantom{\frac{R_{c}^{2}}{\tilde{R}^{2}}}-R_{c}\left(8R_{c}^{2}C_{05}+12RR_{c}C_{15}+3R^{2}C_{25}\right)\right.\right.\\
 &  & \left.\left.+\frac{15}{8}\frac{R_{c}^{2}}{\tilde{R}^{2}}\left(R^{3}C_{37}+2R^{2}R_{c}C_{27}+R\left(2R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{17}+R_{c}\left(R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{07}\right)\right)\right)\end{array}}\label{eq:BZ}\end{equation}

\end_inset


\end_layout

