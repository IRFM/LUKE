\begin_layout Title
Calculation of the magnetic flux ccordinate of a current-driven toric surface
\end_layout

\begin_layout Author
François-Xavier DUTHOIT
\end_layout

\begin_layout Standard
Here, we express the total magnetic vector potential of a current-driven
 toric surface as the sum of thin magnetic coils and using toroidal coordinates
 
\begin_inset Formula $\left(r,\tilde{\theta},\varphi\right)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
\tilde{R_{p}} & = & R_{c}+a_{c}\cos\tilde{\theta}\\
\tilde{Z_{p}} & = & Z_{c}+a_{c}\sin\tilde{\theta}\end{array}}\label{eq:}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using 
\begin_inset Formula $\epsilon=\frac{a_{c}}{R_{c}}$
\end_inset

 as a small parameter, we get :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
\tilde{R_{p}} & = & R_{c}\left(1+\epsilon\cos\tilde{\theta}\right)\\
\tilde{Z_{p}} & = & Z_{c}\left(1+\epsilon\frac{R_{c}}{Z_{c}}\sin\tilde{\theta}\right)\end{array}}\label{eq:-1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The expression of the total magnetic vector potential reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{ccc}
A_{R} & = & \int_{0}^{2\pi}\tilde{A_{R}}a_{c}d\tilde{\theta}=R_{c}\epsilon\int_{0}^{2\pi}\tilde{A_{R}}d\tilde{\theta}\\
A_{\varphi} & = & \int_{0}^{2\pi}\tilde{A_{\varphi}}a_{c}d\tilde{\theta}=R_{c}\epsilon\int_{0}^{2\pi}\tilde{A_{\varphi}}d\tilde{\theta}\end{array}\label{eq:-3}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using the expressions previously calculated for the magnetic vector potential
 produced by a thin wire driven by a current of 
\begin_inset Formula $\frac{I}{2\pi a_{c}}=\frac{I}{2\pi R_{c}\epsilon}$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{ccc}
\tilde{A_{R}} & = & \frac{\mu_{0}\tilde{R_{p}}}{4\pi}\frac{I}{2\pi R_{c}\epsilon}\int_{-\pi}^{\pi}\frac{\sin\left(\varphi-\phi\right)}{\tilde{D}}d\phi\\
\tilde{A_{\varphi}} & = & \frac{\mu_{0}\tilde{R_{p}}}{4\pi}\frac{I}{2\pi R_{c}\epsilon}\int_{-\pi}^{\pi}\frac{\cos\left(\varphi-\phi\right)}{\tilde{D}}d\phi\end{array}\label{eq:-4}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\tilde{D}^{-1}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
\tilde{D}^{-1}=\left(R^{2}+\left(Z-\tilde{Z_{p}}\right)^{2}+\tilde{R_{p}}^{2}-2R\tilde{R_{p}}\cos\left(\varphi-\phi\right)\right)^{-\frac{1}{2}}\\
=\left(D^{2}-2\epsilon R_{c}\left(\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\cos\tilde{\theta}+\left(Z-Z_{c}\right)\sin\tilde{\theta}\right)+\epsilon^{2}R_{c}^{2}\right)^{-\frac{1}{2}}\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline}
\tilde{D}^{-1}=D^{-1}\left(1+\epsilon\frac{R_{c}}{D^{2}}\left(\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\cos\tilde{\theta}+\left(Z-Z_{c}\right)\sin\tilde{\theta}\right)\right.\\
\left.+\epsilon^{2}\frac{R_{c}^{2}}{D^{2}}\left(\frac{3}{8}\frac{\left(\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\cos\tilde{\theta}+\left(Z-Z_{c}\right)\sin\tilde{\theta}\right)^{2}}{D^{2}}-\frac{1}{2}\right)\right)\label{eq:-5-2}\end{multline}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\tilde{R_{p}}\tilde{D}^{-1}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
\tilde{R_{p}}\tilde{D}^{-1}=\frac{R_{c}}{D}\left(1+\epsilon\left(\cos\tilde{\theta}+\frac{R_{c}}{D^{2}}\left(\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\cos\tilde{\theta}+\left(Z-Z_{c}\right)\sin\tilde{\theta}\right)\right)\right.\\
+\epsilon^{2}\left(\cos\tilde{\theta}\frac{R_{c}}{D^{2}}\left(\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\cos\tilde{\theta}+\left(Z-Z_{c}\right)\sin\tilde{\theta}\right)\right.\\
\left.\left.+\frac{R_{c}^{2}}{D^{2}}\left(\frac{3}{8}\frac{\left(\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\cos\tilde{\theta}+\left(Z-Z_{c}\right)\sin\tilde{\theta}\right)^{2}}{D^{2}}-\frac{1}{2}\right)\right)\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
Eliminating non quadratic terms, the expression becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
\tilde{R_{p}}\tilde{D}^{-1}=\frac{R_{c}}{D}\left(1+\epsilon^{2}\left(\frac{R_{c}}{D^{2}}\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\cos^{2}\tilde{\theta}\right.\right.\\
\left.\left.+\frac{R_{c}^{2}}{D^{2}}\left(\frac{3}{8}\frac{\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)^{2}\cos^{2}\tilde{\theta}+\left(Z-Z_{c}\right)^{2}\sin^{2}\tilde{\theta}}{D^{2}}-\frac{1}{2}\right)\right)\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
R_{c}\int_{0}^{2\pi}\tilde{R_{p}}\tilde{D}^{-1}\epsilon d\tilde{\theta}=R_{c}\epsilon\left(2\pi\frac{R_{c}}{D}+\frac{\epsilon^{2}}{2}\left(\pi\frac{R_{c}^{2}}{D^{3}}\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)\right.\right.\\
\left.\left.+\frac{R_{c}^{3}}{D^{3}}\left(\frac{3\pi}{8}\frac{\left(R\cos\left(\varphi-\phi\right)-R_{c}\right)^{2}+\left(Z-Z_{c}\right)^{2}}{D^{2}}-2\pi\right)\right)\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline}
R_{c}\int_{0}^{2\pi}\tilde{R_{p}}\tilde{D}^{-1}\epsilon d\tilde{\theta}=R_{c}\epsilon\left(2\pi\frac{R_{c}}{D}+\frac{\epsilon^{2}}{2}\left(\pi R_{c}^{2}\left(\frac{R\cos\left(\varphi-\phi\right)-3R_{c}}{D^{3}}\right)\right.\right.\\
\left.\left.+R_{c}^{3}\frac{3\pi}{8}\frac{R^{2}\cos^{2}\left(\varphi-\phi\right)-RR_{c}\cos\left(\varphi-\phi\right)+R_{c}^{2}+\left(Z-Z_{c}\right)^{2}}{D^{5}}\right)\right)\label{eq:-6-1}\end{multline}

\end_inset


\end_layout

\begin_layout Standard
The expression of 
\begin_inset Formula $\mathbf{A}$
\end_inset

 therefore becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
A_{R}=\frac{\mu_{0}IR_{c}}{4\pi}\int_{-\pi}^{\pi}\sin\left(\varphi-\phi\right)\left(\frac{1}{D}+\frac{\epsilon^{2}}{4}\left(R_{c}\left(\frac{R\cos\left(\varphi-\phi\right)-3R_{c}}{D^{3}}\right)\right.\right.\\
\left.\left.+R_{c}^{2}\frac{3}{8}\frac{R^{2}\cos^{2}\left(\varphi-\phi\right)-RR_{c}\cos\left(\varphi-\phi\right)+R_{c}^{2}+\left(Z-Z_{c}\right)^{2}}{D^{5}}\right)\right)d\phi\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
A_{\varphi}=\frac{\mu_{0}IR_{c}}{4\pi}\int_{-\pi}^{\pi}\cos\left(\varphi-\phi\right)\left(\frac{1}{D}+\frac{\epsilon^{2}}{4}\left(R_{c}\left(\frac{R\cos\left(\varphi-\phi\right)-3R_{c}}{D^{3}}\right)\right.\right.\\
\left.\left.+R_{c}^{2}\frac{3}{8}\frac{R^{2}\cos^{2}\left(\varphi-\phi\right)-RR_{c}\cos\left(\varphi-\phi\right)+R_{c}^{2}+\left(Z-Z_{c}\right)^{2}}{D^{5}}\right)\right)d\phi\end{multline*}

\end_inset


\end_layout

\begin_layout Subsection
Elliptic integral calculations
\end_layout

\begin_layout Standard
The integrals, applying the same transformation 
\begin_inset Formula $\varphi-\phi=2\tilde{\phi}-\pi$
\end_inset

, 
\begin_inset Formula $\tilde{R}^{2}=\left(R+R_{c}\right)^{2}+\left(Z-Z_{c}\right)^{2}$
\end_inset

 and 
\begin_inset Formula $k^{2}=\frac{4RR_{c}}{\tilde{R}^{2}}$
\end_inset

 are all functions of the complete elliptic integrals of the first and second
 kind.
 We define 
\begin_inset Formula $C=\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}=\frac{D}{\tilde{R}}$
\end_inset

.
 We start from the expressions :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
C_{0-1}=\int_{0}^{\frac{\pi}{2}}Cd\tilde{\phi}=E\left(k^{2}\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
C_{01}=\int_{0}^{\frac{\pi}{2}}\frac{d\tilde{\phi}}{C}=K\left(k^{2}\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
C_{03}=\int_{0}^{\frac{\pi}{2}}\frac{d\tilde{\phi}}{C^{3}}=-\frac{1}{k^{2}-1}E\left(k^{2}\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
C_{05}=\int_{0}^{\frac{\pi}{2}}\frac{d\tilde{\phi}}{C^{5}}=\frac{1}{3}\left(\frac{1}{k^{2}-1}K\left(k^{2}\right)+\frac{k^{2}-2}{\left(k^{2}-1\right)^{2}}E\left(k^{2}\right)\right)\]

\end_inset


\end_layout

\begin_layout Subsubsection

\family roman
\series medium
