\begin_inset Formula $C_{23}=\int_{0}^{\frac{\pi}{2}}\frac{\cos^{2}2\tilde{\phi}}{C^{3}}d\tilde{\phi}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
C_{23}=\int_{0}^{\frac{\pi}{2}}\frac{\cos^{2}2\tilde{\phi}}{C^{3}}d\tilde{\phi}=\int_{0}^{\frac{\pi}{2}}\left(\frac{\left(k^{2}-2\right)^{2}}{k^{4}C^{3}}+4\frac{k^{2}-2}{k^{4}C}+4\frac{C}{k^{4}}\right)d\tilde{\phi}\\
=\frac{1}{k^{4}}\left(\left(k^{2}-2\right)^{2}C_{03}+4\left(k^{2}-2\right)C_{01}+4C_{0-1}\right)\end{multline*}

\end_inset


\end_layout

