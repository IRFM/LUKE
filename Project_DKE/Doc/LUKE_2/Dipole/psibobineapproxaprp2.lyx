\begin_inset Formula $C_{15}=\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{C^{5}}d\tilde{\phi}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
C_{15}=\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{C^{5}}d\tilde{\phi}=\int_{0}^{\frac{\pi}{2}}\left(\frac{k^{2}-2}{k^{2}C^{5}}+\frac{2}{k^{2}C^{3}}\right)d\tilde{\phi}\\
=\frac{1}{k^{2}}\left(\left(k^{2}-2\right)C_{05}+2C_{03}\right)\\
=\left(\frac{1}{3}\frac{k^{2}-2}{k^{2}\left(k^{2}-1\right)}K\left(k^{2}\right)+\frac{k^{4}-10k^{2}+10}{3k^{2}\left(k^{2}-1\right)^{2}}E\left(k^{2}\right)\right)\end{multline*}

\end_inset


\end_layout

