\begin_inset Formula $C_{13}=\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{C^{3}}d\tilde{\phi}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
C_{13}=\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{C^{3}}d\tilde{\phi}=\int_{0}^{\frac{\pi}{2}}\left(\frac{k^{2}-2}{k^{2}C^{3}}+\frac{2}{k^{2}C}\right)d\tilde{\phi}=\frac{1}{k^{2}}\left(\left(k^{2}-2\right)C_{03}+2C_{01}\right)\]

\end_inset


\end_layout

