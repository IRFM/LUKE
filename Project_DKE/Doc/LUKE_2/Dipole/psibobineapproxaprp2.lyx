\noun off
\color none
\begin_inset Formula \begin{equation}
\boxed{\psi=\frac{\mu_{0}Ik^{2}}{4\pi}\left(-C_{11}\tilde{R}+\frac{\epsilon^{2}}{4\tilde{R}}\left(R_{c}\left(RC_{23}+3R_{c}C_{13}\right)-\frac{3R_{c}^{2}}{8\tilde{R}^{2}}\left(R^{2}C_{35}+RR_{c}C_{25}+\left(R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{15}\right)\right)\right)}\label{eq:psifinal}\end{equation}

\end_inset


