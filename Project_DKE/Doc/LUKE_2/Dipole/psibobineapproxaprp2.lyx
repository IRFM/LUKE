\begin_inset Formula $C_{35}=\int_{0}^{\frac{\pi}{2}}\frac{\cos^{3}2\tilde{\phi}}{C^{5}}d\tilde{\phi}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
C_{35}=\int_{0}^{\frac{\pi}{2}}\frac{\cos^{3}2\tilde{\phi}}{C^{5}}d\tilde{\phi}=\int_{0}^{\frac{\pi}{2}}\left(\frac{\left(k^{2}-2\right)^{3}}{k^{6}C^{5}}+6\frac{\left(k^{2}-2\right)^{2}}{k^{6}C^{3}}+12\frac{k^{2}-2}{k^{6}C}+8\frac{C}{k^{6}}\right)d\tilde{\phi}\\
=\frac{1}{k^{6}}\left(\left(k^{2}-2\right)^{3}C_{05}+6\left(k^{2}-2\right)^{2}C_{03}+12\left(k^{2}-2\right)C_{01}+8C_{0-1}\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
We therefore obtain a form of the total magnetic vector potential which
 depends only on 
\begin_inset Formula $R,Z,\epsilon,R_{c},Z_{c},I$
\end_inset

.
 The expression of the flux coordinate becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\psi=RA_{\varphi}=\frac{\mu_{0}IRR_{c}}{\pi}\left(-\frac{C_{11}}{\tilde{R}}+\frac{\epsilon^{2}}{4}\left(\frac{R_{c}}{\tilde{R}^{3}}\left(RC_{23}+3R_{c}C_{13}\right)+\frac{3R_{c}^{2}}{8\tilde{R}^{5}}\left(-R^{2}C_{35}-RR_{c}C_{25}-\left(R_{c}^{2}+\left(Z-Z_{c}\right)^{2}\right)C_{15}\right)\right)\right)\]

\end_inset


\end_layout

\begin_layout Standard

\family roman
\series medium
\shape up
\size normal
