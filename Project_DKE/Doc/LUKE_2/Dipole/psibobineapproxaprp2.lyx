Calculation of 
\begin_inset Formula $C_{11}=\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{C}d\tilde{\phi}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
C_{11}=\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{C}d\tilde{\phi}=\int_{0}^{\frac{\pi}{2}}\left(\frac{k^{2}-2}{k^{2}C}+2\frac{C}{k^{2}}\right)d\tilde{\phi}=\frac{1}{k^{2}}\left(\left(k^{2}-2\right)C_{01}+2C_{0-1}\right)\]

\end_inset


\end_layout

