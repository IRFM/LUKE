\begin_layout Section
Magnetic dipole and single coil magnetic fields in LUKE coordinates
\end_layout

\begin_layout Subsection
Single coil field
\end_layout

\begin_layout Standard
The aim here is to calculate the field produced by a single magnetic coil,
 subject to a current 
\begin_inset Formula $I$
\end_inset

, with the following equation 
\begin_inset Formula $\Gamma_{0}$
\end_inset

 in cylindrical 
\begin_inset Formula $\left(R,\varphi,Z\right)$
\end_inset

 coordinates (
\begin_inset Formula $\phi\in\left[-\pi,\pi\right]$
\end_inset

 and 
\begin_inset Formula $R_{p}\geq0$
\end_inset

) :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{L}=R_{p}\cos\left(\varphi-\phi\right)\hat{R}-R_{p}\sin\left(\varphi-\phi\right)\hat{\varphi}+Z_{p}\hat{Z}\label{eq:coilvectorcyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We therefore have :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{d\mathbf{L}=R_{p}\sin\left(\varphi-\phi\right)d\phi\hat{R}+R_{p}\cos\left(\varphi-\phi\right)d\phi\hat{\varphi}}\label{eq:coilelemvectorcyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using the cylindrical position vector 
\begin_inset Formula $\mathbf{r}=R\hat{R}+Z\hat{Z}$
\end_inset

, we get :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\boxed{D^{2}=\left|\mathbf{r}-\mathbf{L}\right|^{2}=\left|\mathbf{r}\right|^{2}+\left|\mathbf{L}\right|^{2}-2\mathbf{r}\cdot\mathbf{L}=R^{2}+\left(Z-Z_{p}\right)^{2}+R_{p}^{2}-2RR_{p}\cos\left(\varphi-\phi\right)}\]

\end_inset


\end_layout

\begin_layout Standard
We will also need the derivatives of 
\begin_inset Formula $\frac{1}{D}$
\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial}{\partial R}\frac{1}{D}=\frac{R_{p}\cos\left(\varphi-\phi\right)-R}{D^{3}}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial}{\partial Z}\frac{1}{D}=-\frac{Z-Z_{p}}{D^{3}}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial}{\partial\varphi}\frac{1}{D}=-\frac{RR_{p}\sin\left(\varphi-\phi\right)}{D^{3}}\]

\end_inset


\end_layout

\begin_layout Standard
The vector potential becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\mathbf{A}\left(M\right)=\frac{\mu_{0}}{4\pi}\int_{\Gamma_{0}}\frac{Id\mathbf{L}}{\left|\mathbf{r}-\mathbf{L}\right|}=\frac{\mu_{0}IR_{p}}{4\pi}\left(\int_{-\pi}^{\pi}\frac{\sin\left(\varphi-\phi\right)}{D}d\phi\hat{R}+\int_{-\pi}^{\pi}\frac{\cos\left(\varphi-\phi\right)}{D}d\phi\hat{\varphi}\right)}\label{eq:vectorpotdipolecyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
It is important to note that although 
\begin_inset Formula $\varphi$
\end_inset

 appears in the integrand, the vector potential and magnetic field do not
 depend on this coordinate.
 This is due to the fact that the integrand is summated over a period.
 We can therefore deduce the magnetic field, using the curl in cylindrical
 coordinates :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{B}=\nabla\times\mathbf{A}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
B_{R}=-\frac{\partial A_{\varphi}}{\partial Z}=\frac{\mu_{0}IR_{p}}{4\pi}\int_{-\pi}^{\pi}\frac{\left(Z-Z_{p}\right)\cos\left(\varphi-\phi\right)}{D^{3}}d\phi\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
B_{\varphi}=\frac{\partial A_{R}}{\partial Z}=-\frac{\mu_{0}IR_{p}}{4\pi}\int_{-\pi}^{\pi}\frac{\left(Z-Z_{p}\right)\sin\left(\varphi-\phi\right)}{D^{3}}d\phi\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\begin{array}{ccc}
B_{Z} & = & \frac{1}{R}\left(\frac{\partial}{\partial R}\left(RA_{\varphi}\right)-\frac{\partial A_{R}}{\partial\varphi}\right)\\
 & = & \frac{\mu_{0}IR_{p}}{4\pi R}\int_{-\pi}^{\pi}\left(\frac{\cos\left(\varphi-\phi\right)}{D}+\frac{R\left(R_{p}\cos\left(\varphi-\phi\right)-R\right)\cos\left(\varphi-\phi\right)}{D^{3}}-\frac{\cos\left(\varphi-\phi\right)}{D}+\frac{RR_{p}\sin^{2}\left(\varphi-\phi\right)}{D^{3}}\right)d\phi\\
 & = & \frac{\mu_{0}IR_{p}}{4\pi}\int_{-\pi}^{\pi}\frac{R_{p}-R\cos\left(\varphi-\phi\right)}{D^{3}}d\phi\end{array}\]

\end_inset


\end_layout

\begin_layout Standard
The parity in 
\begin_inset Formula $\varphi-\phi$
\end_inset

 of the integrals gives 
\begin_inset Formula $B_{\varphi}=0$
\end_inset

.
 The expression of the magnetic field then reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{R} & = & \frac{\mu_{0}IR_{p}}{4\pi}\int_{-\pi}^{\pi}\frac{\left(Z-Z_{p}\right)\cos\left(\varphi-\phi\right)}{D^{3}}d\phi\\
B_{\varphi} & = & 0\\
B_{Z} & = & \frac{\mu_{0}IR_{p}}{4\pi}\int_{-\pi}^{\pi}\frac{R_{p}-R\cos\left(\varphi-\phi\right)}{D^{3}}d\phi\end{array}}\label{eq:bcoilcyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
In order to express the single coil magnetic field with respect to the complete
 elliptic integrals, we introduce 
\begin_inset Formula $\tilde{R}^{2}=\left(R+R_{p}\right)^{2}+\left(Z-Z_{p}\right)^{2}$
\end_inset

, 
\begin_inset Formula $\varphi-\phi=2\tilde{\phi}-\pi$
\end_inset

 and 
\begin_inset Formula $k^{2}=\frac{4RR_{p}}{\tilde{R}^{2}}$
\end_inset

.
 The expression of 
\begin_inset Formula $D$
\end_inset

 becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\boxed{D=\sqrt{\tilde{R}^{2}-2RR_{p}\left(1+\cos\left(2\tilde{\phi}-\pi\right)\right)}=\tilde{R}\sqrt{1-k^{2}\cos^{2}\left(\tilde{\phi}-\frac{\pi}{2}\right)}=\tilde{R}\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}}\]

\end_inset


\end_layout

\begin_layout Standard
We apply the transformation to 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilcyl"

\end_inset

, and the use of periodicity and parity gives :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\begin{array}{ccc}
B_{R} & = & \frac{\mu_{0}IR_{p}\left(Z-Z_{p}\right)}{2\pi\tilde{R}^{3}}\int_{\frac{\varphi}{2}}^{\frac{\varphi}{2}+\pi}\frac{\cos\left(2\tilde{\phi}-\pi\right)}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}d\tilde{\phi}=-\frac{\mu_{0}IR_{T}\left(Z-Z_{p}\right)}{\pi\tilde{R}^{3}}\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}d\tilde{\phi}\\
B_{\varphi} & = & 0\\
B_{Z} & = & \frac{\mu_{0}IR_{p}}{2\pi\tilde{R}^{3}}\int_{\frac{\varphi}{2}}^{\frac{\varphi}{2}+\pi}\frac{R_{p}-R\cos\left(2\tilde{\phi}-\pi\right)}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}d\tilde{\phi}=\frac{\mu_{0}IR_{p}}{\pi\tilde{R}^{3}}\int_{0}^{\frac{\pi}{2}}\frac{R_{p}+R\cos2\tilde{\phi}}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}d\tilde{\phi}\end{array}\]

\end_inset


\end_layout

\begin_layout Standard
We must now calculate the integrals 
\begin_inset Formula $F\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\frac{1}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}d\tilde{\phi}$
\end_inset

 and 
\begin_inset Formula $G\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}d\tilde{\phi}$
\end_inset

.
 First, we start from the derivation of the following expression :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\begin{array}{ccc}
\frac{d}{d\tilde{\phi}}\left(\frac{k^{2}\sin\tilde{\phi}\cos\tilde{\phi}}{\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}}\right) & = & \frac{k^{2}\cos^{2}\tilde{\phi}-k^{2}\sin^{2}\tilde{\phi}}{\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}}+\frac{k^{4}\sin^{2}\tilde{\phi}\cos^{2}\tilde{\phi}}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}\\
 & = & \frac{k^{2}\cos^{2}\tilde{\phi}-k^{2}\sin^{2}\tilde{\phi}+k^{4}\sin^{4}\tilde{\phi}}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}\\
 & = & \sqrt{1-k^{2}\sin^{2}\tilde{\phi}}+\frac{k^{2}-1}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}\end{array}\]

\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\left[\frac{k^{2}\sin\tilde{\phi}\cos\tilde{\phi}}{\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}}\right]_{0}^{\frac{\pi}{2}}=0$
\end_inset

, we therefore have :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
F\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\frac{1}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}d\tilde{\phi}=\frac{1}{1-k^{2}}\int_{0}^{\frac{\pi}{2}}\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}d\tilde{\phi}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
F\left(k^{2}\right)=\frac{E\left(k^{2}\right)}{1-k^{2}}\label{eq:-8}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Introducing 
\begin_inset Formula $K$
\end_inset

 and 
\begin_inset Formula $E$
\end_inset

, the complete elliptic integrals of the first and second kind respectively.
 Their expression is as follows :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
K\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\frac{1}{\sqrt{1-k^{2}\sin^{2}t}}dt\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
E\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\sqrt{1-k^{2}\sin^{2}t}dt\]

\end_inset


\end_layout

\begin_layout Standard
The expression of 
\begin_inset Formula $G$
\end_inset

 becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
G\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\frac{1-2\sin^{2}\tilde{\phi}}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}=\frac{1}{k^{2}}\int_{0}^{\frac{\pi}{2}}\left(\frac{k^{2}-2}{\left(1-k^{2}\sin^{2}\tilde{\phi}\right)^{\frac{3}{2}}}+\frac{2}{\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}}\right)d\tilde{\phi}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
G\left(k^{2}\right)=\frac{\left(k^{2}-2\right)F\left(k^{2}\right)+2K\left(k^{2}\right)}{k^{2}}=\frac{1}{k^{2}}\left(\frac{k^{2}-2}{1-k^{2}}E\left(k^{2}\right)+2K\left(k^{2}\right)\right)\label{eq:-9}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The expressions of the magnetic field become :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
B_{R}=-\frac{\mu_{0}IR_{p}\left(Z-Z_{p}\right)}{\pi\tilde{R}^{3}}G\left(k^{2}\right)=-\frac{2\mu_{0}IR_{p}\left(Z-Z_{p}\right)}{\pi\tilde{R}^{3}k^{2}}\left(\frac{1}{2}\frac{k^{2}-2}{1-k^{2}}E\left(k^{2}\right)+K\left(k^{2}\right)\right)\label{eq:-10}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
B_{Z}=\frac{\mu_{0}IR_{p}}{\pi\tilde{R}^{3}}\left(R_{p}F\left(k^{2}\right)+RG\left(k^{2}\right)\right)=\frac{2\mu_{0}IRR_{p}}{\pi\tilde{R}^{3}k^{2}}\left(\left(\frac{R_{p}}{2R}\frac{k^{2}}{1-k^{2}}+\frac{1}{2}\frac{k^{2}-2}{1-k^{2}}\right)E\left(k^{2}\right)+K\left(k^{2}\right)\right)\label{eq:-11}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using the expression of 
\begin_inset Formula $k^{2}$
\end_inset

, we can deduce the following relations :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\tilde{R}^{3}k^{2}=4RR_{p}\tilde{R}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{1}{2}\frac{k^{2}-2}{1-k^{2}}=\frac{2RR_{p}-\tilde{R}^{2}}{\tilde{R}^{2}-4RR_{p}}=-\frac{R_{p}^{2}+R^{2}+\left(Z-Z_{p}\right)^{2}}{\left(R_{p}-R\right)^{2}+\left(Z-Z_{p}\right)^{2}}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{R_{p}}{2R}\frac{k^{2}}{1-k^{2}}+\frac{1}{2}\frac{k^{2}-2}{1-k^{2}}=\frac{2R_{p}^{2}}{\left(R_{p}-R\right)^{2}+Z^{2}}-\frac{R_{p}^{2}+R^{2}+\left(Z-Z_{p}\right)^{2}}{\left(R_{p}-R\right)^{2}+\left(Z-Z_{p}\right)^{2}}=\frac{R_{p}^{2}-R^{2}-\left(Z-Z_{p}\right)^{2}}{\left(R_{p}-R\right)^{2}+\left(Z-Z_{p}\right)^{2}}\]

\end_inset


\end_layout

\begin_layout Standard
We can therefore write :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{R} & = & \frac{\mu_{0}I}{2\pi}\frac{1}{\sqrt{\left(R_{p}+R\right)^{2}+\left(Z-Z_{p}\right)^{2}}}\frac{Z-Z_{p}}{R}\left(\frac{R_{p}^{2}+R^{2}+\left(Z-Z_{p}\right)^{2}}{\left(R_{p}-R\right)^{2}+Z^{2}}E\left(k^{2}\right)-K\left(k^{2}\right)\right)\\
B_{\varphi} & = & 0\\
B_{Z} & = & \frac{\mu_{0}I}{2\pi}\frac{1}{\sqrt{\left(R_{p}+R\right)^{2}+\left(Z-Z_{p}\right)^{2}}}\left(\frac{R_{p}^{2}-R^{2}-\left(Z-Z_{p}\right)^{2}}{\left(R_{p}-R\right)^{2}+\left(Z-Z_{p}\right)^{2}}E\left(k^{2}\right)+K\left(k^{2}\right)\right)\end{array}}\label{eq:bcoilellipticcyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Where 
\begin_inset Formula $\boxed{k^{2}=\frac{4RR_{p}}{\left(R_{p}+R\right)^{2}+\left(Z-Z_{p}\right)^{2}}}$
\end_inset

.
\end_layout

\begin_layout Subsection
Single coil flux coordinate
\end_layout

\begin_layout Standard
Similarly to the dipole field flux coordinate, we want to find 
\begin_inset Formula $\psi$
\end_inset

 so that :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{B}=\nabla\times\mathbf{A}=\nabla\psi\times\nabla\varphi\]

\end_inset


\end_layout

\begin_layout Standard
Here, we work in cylindrical 
\begin_inset Formula $\left(R,\varphi,Z\right)$
\end_inset

 coordinates, therefore 
\begin_inset Formula $\nabla\varphi=\frac{1}{R}\hat{\varphi}$
\end_inset

.
 Using the cylindrical expressions of the gradient and curl and taking into
 account that 
\begin_inset Formula $\frac{\partial A_{R}}{\partial\varphi}=\frac{\partial A_{\varphi}}{\partial\varphi}=A_{Z}=0$
\end_inset

 , we get :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\begin{array}{ccc}
B_{R}=-\frac{\partial A_{\varphi}}{\partial Z} & = & -\frac{1}{R}\frac{\partial\psi}{\partial Z}\\
B_{\varphi}=\frac{\partial A_{R}}{\partial Z} & = & 0\\
B_{Z}=\frac{1}{R}\frac{\partial RA_{\varphi}}{\partial R} & = & \frac{1}{R}\frac{\partial\psi}{\partial R}\end{array}\]

\end_inset


\end_layout

\begin_layout Standard
From the expression of 
\begin_inset Formula $B_{R}$
\end_inset

, we can deduce :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\psi=RA_{\varphi}+F\left(R\right)\]

\end_inset


\end_layout

\begin_layout Standard
Where 
\begin_inset Formula $F$
\end_inset

 is an unknown function of 
\begin_inset Formula $R$
\end_inset

.
 Replacing 
\begin_inset Formula $\psi$
\end_inset

 in the expression of 
\begin_inset Formula $B_{Z}$
\end_inset

, we have :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial RA_{\varphi}}{\partial R}=\frac{\partial RA_{\varphi}}{\partial R}+\frac{dF}{dR}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{dF}{dR}=0\]

\end_inset


\end_layout

\begin_layout Standard
We can deduce :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\psi\left(R,Z\right)=RA_{\varphi}}\label{eq:psiaphicyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\psi\left(R,Z\right)=R\frac{\mu_{0}IR_{p}}{4\pi\tilde{R}}\int_{-\pi}^{\pi}\frac{\cos\left(\varphi-\phi\right)}{D}d\phi}\label{eq:psicoilcyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The expression of 
\begin_inset Formula $\psi$
\end_inset

 therefore becomes, using the same transformation 
\begin_inset Formula $\tilde{R}^{2}=\left(R_{p}+R\right)^{2}+\left(Z-Z_{p}\right)^{2}$
\end_inset

, 
\begin_inset Formula $k^{2}=\frac{4RR_{p}}{\tilde{R}^{2}}$
\end_inset

 and 
\begin_inset Formula $\varphi-\phi=2\tilde{\phi}-\pi$
\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\psi\left(R,Z\right)=-R\frac{\mu_{0}IR_{p}}{\pi\tilde{R}}\int_{0}^{\frac{\pi}{2}}\frac{\cos2\tilde{\phi}}{\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}}d\tilde{\phi}=-R\frac{\mu_{0}IR_{p}}{\pi\tilde{R}}\left(\frac{k^{2}-2}{\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}}+2\sqrt{1-k^{2}\sin^{2}\tilde{\phi}}\right)d\tilde{\phi}\]

\end_inset


\end_layout

\begin_layout Standard
We therefore have :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\psi\left(R,Z\right)=-\frac{\mu_{0}IRR_{p}}{2\pi\tilde{R}}\frac{\left(k^{2}-2\right)K\left(k^{2}\right)+2E\left(k^{2}\right)}{k^{2}}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\psi\left(R,Z\right)=-\frac{\mu_{0}I}{4\pi}\sqrt{\left(R_{p}+R\right)^{2}+\left(Z-Z_{p}\right)^{2}}\left(\left(k^{2}-2\right)K\left(k^{2}\right)+2E\left(k^{2}\right)\right)}\label{eq:psicoilellipticcyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Where 
\begin_inset Formula $\boxed{k^{2}=\frac{4RR_{p}}{\left(R_{p}+R\right)^{2}+\left(Z-Z_{p}\right)^{2}}}$
\end_inset

.
 
\end_layout

\begin_layout Subsection
Magnetic dipole field
\end_layout

\begin_layout Standard
The magnetic dipole field is the approximation of a single coil field with
 
\begin_inset Formula $R_{p}\ll1$
\end_inset

 and 
\begin_inset Formula $Z_{p}=0$
\end_inset

.
 The final expression of the dipole magnetic field then reads, with 
\begin_inset Formula $M=IR_{p}^{2}$
\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{R} & = & \frac{\mu_{0}M}{4\pi}\frac{3RZ}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}\\
B_{\varphi} & = & 0\\
B_{Z} & = & \frac{\mu_{0}M}{4\pi}\frac{2Z^{2}-R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}\end{array}}\label{eq:bdipolecyl}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
This expression can be derived either from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilcyl"

\end_inset

 or from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilellipticcyl"

\end_inset

.
 The calculations are given in the appendix.
 The expression for the flux coordinate reads, using 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psidipolesph"

\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\psi\left(R,Z\right)=\frac{\mu_{0}M}{4\pi}\frac{R^{2}}{\left(R^{2}+\left(Z-Z_{p}\right)^{2}\right)^{\frac{3}{2}}}}\label{eq:psidipolecyl}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
LUKE coordinates for the magnetic equilibrium
\end_layout

\begin_layout Standard
The LUKE coordinates are the standard toroidal 
\begin_inset Formula $\left(r,\theta,\varphi\right)$
\end_inset

 coordinates with cartesian 
\begin_inset Formula $\left(x=r\cos\theta,y=r\sin\theta\right)$
\end_inset

 coordinates in the poloidal plane.
 We name the torus axis radius coordinates 
\begin_inset Formula $\left(R_{p},Z_{p}\right)$
\end_inset

.
 We can therefore see that :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\boxed{\begin{array}{c}
R=x+R_{p}\\
Z=y+Z_{p}\end{array}}\]

\end_inset


\end_layout

\begin_layout Standard
For a dipole magnetic field, 
\begin_inset Formula $R_{p}$
\end_inset

 is arbitrarily chosen.
\end_layout

\begin_layout Subsubsection
Single coil magnetic field
\end_layout

\begin_layout Standard
Using LUKE coordinates, the expressions become :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{x} & = & \frac{\mu_{0}I}{2\pi}\frac{1}{\sqrt{\left(x+2R_{p}\right)^{2}+y^{2}}}\frac{y}{x+R_{p}}\left(\frac{R_{p}^{2}+\left(x+R_{p}\right)^{2}+y^{2}}{x^{2}+y^{2}}E\left(k^{2}\right)-K\left(k^{2}\right)\right)\\
B_{y} & = & \frac{\mu_{0}I}{2\pi}\frac{1}{\sqrt{\left(x+2R_{p}\right)^{2}+y^{2}}}\left(\frac{R_{p}^{2}-\left(x+R_{p}\right)^{2}-y^{2}}{x^{2}+y^{2}}E\left(k^{2}\right)+K\left(k^{2}\right)\right)\end{array}}\label{eq:bcoilluke}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The expression of the flux coordinate becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\psi\left(x,y\right)=-\frac{\mu_{0}I}{4\pi}\sqrt{\left(x+2R_{p}\right)^{2}+y^{2}}\left(\left(k^{2}-2\right)K\left(k^{2}\right)+2E\left(k^{2}\right)\right)}\label{eq:psicoilluke}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Where 
\begin_inset Formula $\boxed{k^{2}=\frac{4R_{p}\left(x+R_{p}\right)}{\left(x+2R_{p}\right)^{2}+y^{2}}}$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Magnetic dipole field
\end_layout

\begin_layout Standard
Here the expression is a direct transformation of 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bdipolecyl"

\end_inset

, with 
\begin_inset Formula $Z_{p}=0$
\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{x} & = & \frac{\mu_{0}M}{4\pi}\frac{3\left(x+R_{p}\right)y}{\left(\left(x+R_{p}\right)^{2}+y^{2}\right)^{\frac{5}{2}}}\\
B_{y} & = & \frac{\mu_{0}M}{4\pi}\frac{2y^{2}-\left(x+R_{p}\right)^{2}}{\left(\left(x+R_{p}\right)^{2}+y^{2}\right)^{\frac{5}{2}}}\end{array}}\label{eq:bdipoleluke}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The flux coordinate is determined similarly with 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psidipolecyl"

\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\psi=\frac{\mu_{0}M}{4\pi}\frac{\left(x+R_{p}\right)^{2}}{\left(\left(x+R_{p}\right)^{2}+y^{2}\right)^{\frac{3}{2}}}}\label{eq:psidipoleluke}\end{equation}

\end_inset


\end_layout

\begin_layout Section
Collisionless motion in a dipole magnetic field
\end_layout

\begin_layout Subsection
\begin_inset Formula $\xi_{0}$
\end_inset

 dependance of the magnetic bounce angle
\end_layout

\begin_layout Standard
We define 
\begin_inset Formula $\xi=\frac{p_{\parallel}}{p}$
\end_inset

 as the pitch-angle cosine of the particle in motion along the field line.
 In a collisionless motion, the energy 
\begin_inset Formula $\varepsilon=\frac{p^{2}}{2m}$
\end_inset

 of the particle remains constant, therefore so does the kinetic momentum
 amplitude 
\begin_inset Formula $p$
\end_inset

.
 Conservation of the magnetic moment gives :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mu=\frac{p_{\perp}^{2}}{2mB}=\frac{p^{2}\left(1-\xi^{2}\right)}{2mB}=\mu_{0}=\frac{p^{2}\left(1-\xi_{0}^{2}\right)}{2mB_{0}}\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $\xi_{0}$
\end_inset

 and 
\begin_inset Formula $B_{0}$
\end_inset

 are respectively the minimum field in the field line and the pitch-angle
 at that point.
 We can deduce the following relation :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\xi\left(\vartheta,\xi_{0}\right)=\sqrt{1-\frac{B\left(\vartheta\right)}{B_{0}}\left(1-\xi_{0}^{2}\right)}}\label{eq:xi}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We have a reversal of the particle motion (bounce) at 
\begin_inset Formula $\xi=0$
\end_inset

 ; the magnetic field at that point reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
B\left(\vartheta_{b}\right)=B_{0}\frac{1}{1-\xi_{0}^{2}}\label{eq:bdipolethetab}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Along a field line distant of 
\begin_inset Formula $\rho_{0}$
\end_inset

 at the field equator, we have 
\begin_inset Formula $\rho=\rho_{0}\sin^{2}\vartheta$
\end_inset

.
 The amplitude of the magnetic field reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
B\left(\vartheta\right)=\frac{\mu_{0}M}{4\pi}\frac{\sqrt{1+3\cos^{2}\vartheta}}{\left(\rho_{0}\sin^{2}\vartheta\right)^{3}}=\frac{\mu_{0}M}{4\pi\rho_{0}^{3}}\frac{\sqrt{1+3\cos^{2}\vartheta}}{\sin^{6}\vartheta}\]

\end_inset


\end_layout

\begin_layout Standard
This expression is defined for 
\begin_inset Formula $\vartheta\in\left]0,\pi\right[$
\end_inset

.
 
\begin_inset Formula $\cos^{2}\vartheta$
\end_inset

 is minimum and 
\begin_inset Formula $\sin^{6}\vartheta$
\end_inset

 is maximum at 
\begin_inset Formula $\vartheta=\frac{\pi}{2}$
\end_inset

, therefore the minimum magnetic field reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
B_{0}=\frac{\mu_{0}M}{4\pi\rho_{0}^{3}}\label{eq:bdipolemax}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We can deduce the magnetic field amplitude along the field line :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{B=B_{0}\frac{\sqrt{1+3\cos^{2}\vartheta}}{\sin^{6}\vartheta}}\label{eq:bdipoleamplfieldline}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The bounce angle boundaries 
\begin_inset Formula $\vartheta_{b}$
\end_inset

 and 
\begin_inset Formula $\pi-\vartheta_{b}$
\end_inset

 are therefore solely dependent on 
\begin_inset Formula $\xi_{0}$
\end_inset

.
 They are solutions of the equation :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\xi_{0}^{2}=1-\frac{\sin^{6}\vartheta_{b}}{\sqrt{1+3\cos^{2}\vartheta_{b}}}}\label{eq:xi0-varthetab}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\sin\vartheta_{b}$
\end_inset

 and 
\begin_inset Formula $\cos\vartheta_{b}$
\end_inset

 are monotonous and positive on the interval 
\begin_inset Formula $\vartheta_{b}\in\left[0,\frac{\pi}{2}\right]$
\end_inset

, therefore the expression of 
\begin_inset Formula $\xi_{0}$
\end_inset

 is also monotonous with 
\begin_inset Formula $\xi_{0}\left(0\right)=1$
\end_inset

 and 
\begin_inset Formula $\xi_{0}\left(\frac{\pi}{2}\right)=0$
\end_inset

.
 The expression is therefore bijective between the intervals 
\begin_inset Formula $\vartheta_{b}\in\left[0,\frac{\pi}{2}\right]$
\end_inset

 and 
\begin_inset Formula $\xi_{0}\in\left[0,1\right]$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\left(1-\xi_{0}^{2}\right)^{2}=\frac{\left(1-\cos^{2}\vartheta_{b}\right)^{6}}{1+3\cos^{2}\vartheta_{b}}=\frac{\left(1-\cos^{2}\vartheta_{b}\right)^{6}}{4-3\left(1-\cos^{2}\vartheta_{b}\right)}\]

\end_inset


\end_layout

\begin_layout Standard
In order to reverse the expression, we must find the unique root on the
 interval 
\begin_inset Formula $\left[0,1\right]$
\end_inset

 (guaranteed by the bijectivity) of the polynomial :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
P\left(x\right)=x^{6}+3yx-4y\label{eq:-14}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
With 
\begin_inset Formula $y\in\left[0,1\right]$
\end_inset

.
\end_layout

\begin_layout Standard
The taylor expansion of 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:xi0-varthetab"

\end_inset

 for strongly trapped particles 
\begin_inset Formula $\left(\varepsilon=\vartheta_{b}-\frac{\pi}{2}\ll1\right)$
\end_inset

 is :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
1-\xi_{0}^{2}=\left(1-\frac{\varepsilon^{2}}{2}\right)\left(1+3\varepsilon^{2}\right)^{-\frac{1}{2}}=1-\frac{9\varepsilon^{2}}{2}+\mathcal{O}\left(\varepsilon^{4}\right)\]

\end_inset


\end_layout

\begin_layout Standard
We therefore have at this limit :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\vartheta_{b}=\left\{ \begin{array}{c}
\frac{\pi}{2}-\frac{\sqrt{2}}{3}\xi_{0}+\mathcal{O}\left(\xi_{0}^{2}\right),\vartheta_{b}<\frac{\pi}{2}\\
\frac{\pi}{2}+\frac{\sqrt{2}}{3}\xi_{0}+\mathcal{O}\left(\xi_{0}^{2}\right),\vartheta_{b}>\frac{\pi}{2}\end{array}\right.}\label{eq:-15}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The evolution of 
\begin_inset Formula $\vartheta_{b}$
\end_inset

 with respect to 
\begin_inset Formula $\xi_{0}$
\end_inset

 is fairly consistent : at 
\begin_inset Formula $\xi_{0}=0$
\end_inset

, the particle never leaves the equator (
\begin_inset Formula $\vartheta_{b}=\pi-\vartheta_{b}=\frac{\pi}{2}$
\end_inset

) and at 
\begin_inset Formula $\xi_{0}\rightarrow1$
\end_inset

, the particle has such a small magnetic moment that it reaches the origin
 of the magnetic field (
\begin_inset Formula $\vartheta_{b}\rightarrow0$
\end_inset

 and 
\begin_inset Formula $\pi-\vartheta_{b}\rightarrow\pi$
\end_inset

).
 Since there is a symmetry at 
\begin_inset Formula $\vartheta_{b}=\frac{\pi}{2}$
\end_inset

, we will henceforth work on the interval 
\begin_inset Formula $\vartheta_{b}\in\left]0,\frac{\pi}{2}\right]$
\end_inset

.
 The evolution is shown on figure 
