\begin_layout Subsection*
Calculation of the dipole magnetic field from the approximation of the single
 coil magnetic field
\end_layout

\begin_layout Standard
In order to calculate the dipole field approximation, we can start either
 from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilcyl"

\end_inset

 or 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilellipticcyl"

\end_inset

, using the approximation 
\begin_inset Formula $R_{p}\ll1$
\end_inset

 and 
\begin_inset Formula $Z_{p}=0$
\end_inset

.
 If we start from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilcyl"

\end_inset

, we use the Taylor development of 
\begin_inset Formula $D^{-3}$
\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{1}{\left(R^{2}+Z^{2}+R_{p}^{2}-2RR_{p}\cos\left(\varphi-\phi\right)\right)^{\frac{3}{2}}}=\frac{1}{\left(R^{2}+Z^{2}\right)^{\frac{3}{2}}}+\frac{3R\cos\left(\varphi-\phi\right)}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}R_{p}+\mathcal{O}\left(R_{p}^{2}\right)\]

\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\int_{-\pi}^{\pi}\cos\left(\varphi-\phi\right)d\phi=0$
\end_inset

 and 
\begin_inset Formula $\int_{-\pi}^{\pi}\cos^{2}\left(\varphi-\phi\right)d\phi=\pi$
\end_inset

, the approximated magnetic field given in 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilcyl"

\end_inset

 becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\boxed{B_{R}\simeq\frac{\mu_{0}IR_{p}^{2}}{4\pi}\frac{3\pi RZ}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}=\frac{\mu_{0}IR_{p}^{2}}{4}\frac{3RZ}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\boxed{B_{Z}\simeq\frac{\mu_{0}IR_{p}^{2}}{4\pi}\left(\frac{2\pi}{\left(R^{2}+Z^{2}\right)^{\frac{3}{2}}}-\frac{3\pi R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}\right)=\frac{\mu_{0}IR_{p}^{2}}{4}\frac{2Z^{2}-R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}}\]

\end_inset


\end_layout

\begin_layout Standard
If we start from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilellipticcyl"

\end_inset

 and take into account the taylor expansions of 
\begin_inset Formula $K$
\end_inset

 and 
\begin_inset Formula $E$
\end_inset

 at zero :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
K\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\left(1+k^{2}\frac{\sin^{2}t}{2}+k^{4}\frac{3\sin^{4}t}{4}+\mathcal{O}\left(k^{6}\right)\right)dt=\frac{\pi}{2}\left(1+\frac{k^{2}}{4}+\frac{9k^{4}}{64}\right)+\mathcal{O}\left(k^{6}\right)\label{eq:taylorKk2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
E\left(k^{2}\right)=\int_{0}^{\frac{\pi}{2}}\left(1-k^{2}\frac{\sin^{2}t}{2}-k^{4}\frac{\sin^{4}t}{4}+\mathcal{O}\left(k^{6}\right)\right)dt=\frac{\pi}{2}\left(1-\frac{k^{2}}{4}-\frac{3k^{4}}{64}\right)+\mathcal{O}\left(k^{6}\right)\label{eq:taylorEk2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We then use the taylor expansion of 
\begin_inset Formula $k^{2}$
\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
k^{2}=\frac{4RR_{p}}{R^{2}+Z^{2}}\left(1-\frac{2RR_{p}}{R^{2}+Z^{2}}\right)+\mathcal{O}\left(R_{p}^{3}\right)\label{eq:taylork2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Inserting 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylork2"

\end_inset

 into 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorKk2"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorEk2"

\end_inset

, we obtain :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{2}{\pi}K\left(k^{2}\right)=1+\frac{RR_{p}}{R^{2}+Z^{2}}\left(1-\frac{2RR_{p}}{R^{2}+Z^{2}}\right)+\frac{9}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}=1+\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{1}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}+\mathcal{O}\left(R_{p}^{3}\right)\label{eq:taylorK}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{2}{\pi}E\left(k^{2}\right)=1-\frac{RR_{p}}{R^{2}+Z^{2}}\left(1-\frac{2RR_{p}}{R^{2}+Z^{2}}\right)-\frac{3}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}=1-\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{5}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}+\mathcal{O}\left(R_{p}^{3}\right)\label{eq:taylorE}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We then calculate the taylor expansions of the following expressions :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{ccc}
\frac{1}{\sqrt{\left(R_{p}+R\right)^{2}+Z^{2}}} & = & \frac{1}{\sqrt{R^{2}+Z^{2}}}\left(1-\frac{RR_{p}}{R^{2}+Z^{2}}+\left(\frac{3}{2}\frac{R^{2}}{R^{2}+Z^{2}}-\frac{1}{2}\right)\frac{R_{p}^{2}}{R^{2}+Z^{2}}\right)+\mathcal{O}\left(R_{p}^{3}\right)\\
 & = & \frac{1}{\sqrt{R^{2}+Z^{2}}}\left(1-\frac{R}{R^{2}+Z^{2}}R_{p}+\frac{1}{2}\frac{2R^{2}-Z^{2}}{\left(R^{2}+Z^{2}\right)^{2}}R_{p}^{2}\right)+\mathcal{O}\left(R_{p}^{3}\right)\end{array}\label{eq:taylorsqrt-1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{ccc}
\frac{R_{p}^{2}+R^{2}+Z^{2}}{\left(R_{p}-R\right)^{2}+Z^{2}} & = & 1+\frac{2RR_{p}}{R^{2}+Z^{2}}+\left(1-1+\frac{4R^{2}}{R^{2}+Z^{2}}\right)\frac{R_{p}^{2}}{R^{2}+Z^{2}}+\mathcal{O}\left(R_{p}^{3}\right)\\
 & = & 1+\frac{2RR_{p}}{R^{2}+Z^{2}}+\frac{4R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}+\mathcal{O}\left(R_{p}^{3}\right)\end{array}\label{eq:taylorEcoeffBR}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{ccc}
\frac{R_{p}^{2}-R^{2}-Z^{2}}{\left(R_{p}-R\right)^{2}+Z^{2}} & = & -1-\frac{2RR_{p}}{R^{2}+Z^{2}}+\left(1+1-\frac{4R^{2}}{R^{2}+Z^{2}}\right)\frac{R_{p}^{2}}{R^{2}+Z^{2}}+\mathcal{O}\left(R_{p}^{3}\right)\\
 & = & -1-\frac{2RR_{p}}{R^{2}+Z^{2}}+2\frac{\left(Z^{2}-R^{2}\right)R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}+\mathcal{O}\left(R_{p}^{3}\right)\end{array}\label{eq:taylorEcoeffBZ}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We finally insert 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorK"

\end_inset

, 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorE"

\end_inset

, 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorsqrt-1"

\end_inset

, 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorEcoeffBR"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorEcoeffBZ"

\end_inset

 into the expression of the magnetic field found in 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bcoilellipticcyl"

\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
B_{R}\simeq\frac{\mu_{0}I}{2\pi}\frac{Z}{R}\frac{1}{\sqrt{R^{2}+Z^{2}}}\frac{\pi}{2}\left(1-\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{1}{2}\frac{\left(2R^{2}-Z^{2}\right)R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\left(\vphantom{\left(1+\frac{2RR_{p}}{R^{2}+Z^{2}}+\frac{4R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)}\right.\\
\left.\left(1+\frac{2RR_{p}}{R^{2}+Z^{2}}+\frac{4R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\left(1-\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{5}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)-1-\frac{RR_{p}}{R^{2}+Z^{2}}-\frac{1}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{B_{R}\simeq\frac{\mu_{0}I}{4}\frac{1}{\sqrt{R^{2}+Z^{2}}}\frac{Z}{R}\left(\frac{3R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)=\frac{\mu_{0}IR_{p}^{2}}{4}\frac{3RZ}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}}\label{eq:-28}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
B_{Z}\simeq\frac{\mu_{0}I}{2\pi}\frac{1}{\sqrt{R^{2}+Z^{2}}}\frac{\pi}{2}\left(1-\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{1}{2}\frac{\left(2R^{2}-Z^{2}\right)R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\left(\vphantom{\left(-1-\frac{2RR_{p}}{R^{2}+Z^{2}}+2\frac{\left(Z^{2}-R^{2}\right)R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)}\right.\\
\left.\left(-1-\frac{2RR_{p}}{R^{2}+Z^{2}}+2\frac{\left(Z^{2}-R^{2}\right)R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\left(1-\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{5}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)+1+\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{1}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{B_{Z}\simeq\frac{\mu_{0}I}{4}\frac{1}{\sqrt{R^{2}+Z^{2}}}\left(-\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}+\frac{2Z^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)=\frac{\mu_{0}IR_{p}^{2}}{4}\frac{2Z^{2}-R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}}\label{eq:-29}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We therefore in both cases obtain the same expressions than 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bdipolecyl"

\end_inset

, using 
\begin_inset Formula $M=I\pi R_{p}^{2}$
\end_inset

.
\end_layout

\begin_layout Subsection*
Calculation of the dipole flux coordinate from the approximation of the
 single coil flux coordinate
\end_layout

\begin_layout Standard
In order to calculate the dipole flux coordinate approximation, we can start
 either from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psicoilcyl"

\end_inset

 or 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psicoilellipticcyl"

\end_inset

, using the approximation 
\begin_inset Formula $R_{p}\ll1$
\end_inset

 and 
\begin_inset Formula $Z_{p}=0$
\end_inset

.
 If we start from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psicoilcyl"

\end_inset

, we use the Taylor development of 
\begin_inset Formula $D^{-1}$
\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{1}{\sqrt{R^{2}+Z^{2}+R_{p}^{2}-2RR_{p}\cos\left(\varphi-\phi\right)}}=\frac{1}{\sqrt{R^{2}+Z^{2}}}+\frac{R\cos\left(\varphi-\phi\right)}{\left(R^{2}+Z^{2}\right)^{\frac{3}{2}}}R_{p}+\mathcal{O}\left(R_{p}^{2}\right)\]

\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\int_{-\pi}^{\pi}\cos\left(\varphi-\phi\right)d\phi=0$
\end_inset

 and 
\begin_inset Formula $\int_{-\pi}^{\pi}\cos^{2}\left(\varphi-\phi\right)d\phi=\pi$
\end_inset

, the approximated flux coordinate given in 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psicoilcyl"

\end_inset

 becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\boxed{\psi\simeq\frac{\mu_{0}IR_{p}^{2}}{4\pi}\frac{\pi R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{3}{2}}}=\frac{\mu_{0}IR_{p}^{2}}{4}\frac{R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{3}{2}}}}\]

\end_inset


\end_layout

\begin_layout Standard
If we start from 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psicoilellipticcyl"

\end_inset

, we calculate the taylor expansions of the following expressions :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{ccc}
\sqrt{\left(R_{p}+R\right)^{2}+Z^{2}} & = & \sqrt{R^{2}+Z^{2}}\left(1+\frac{RR_{p}}{R^{2}+Z^{2}}+\left(-\frac{1}{2}\frac{R^{2}}{R^{2}+Z^{2}}-\frac{1}{2}\right)\frac{R_{p}^{2}}{R^{2}+Z^{2}}\right)+\mathcal{O}\left(R_{p}^{3}\right)\\
 & = & \sqrt{R^{2}+Z^{2}}\left(1+\frac{R}{R^{2}+Z^{2}}R_{p}-\frac{1}{2}\frac{2R^{2}+Z^{2}}{\left(R^{2}+Z^{2}\right)^{2}}R_{p}^{2}\right)+\mathcal{O}\left(R_{p}^{3}\right)\end{array}\label{eq:taylorsqrt}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We then insert 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorK"

\end_inset

, 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorE"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:taylorsqrt"

\end_inset

 into the expression of the flux coordinate found in 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:psicoilellipticcyl"

\end_inset

 :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{multline*}
\psi\simeq-\frac{\mu_{0}I}{4\pi}\frac{\pi}{2}\left(1+\frac{RR_{p}}{R^{2}+Z^{2}}-\frac{1}{2}\frac{\left(2R^{2}+Z^{2}\right)R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\left(\vphantom{\left(1+\frac{2RR_{p}}{R^{2}+Z^{2}}+\frac{4R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)}\right.\\
\left.\left(\frac{4RR_{p}}{R^{2}+Z^{2}}-\frac{8R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}-2\right)\left(1+\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{1}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)+2\left(1-\frac{RR_{p}}{R^{2}+Z^{2}}+\frac{5}{4}\frac{R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\psi\simeq\frac{\mu_{0}I}{8}\sqrt{R^{2}+Z^{2}}\left(\frac{2R^{2}R_{p}^{2}}{\left(R^{2}+Z^{2}\right)^{2}}\right)=\frac{\mu_{0}IR_{p}^{2}}{4}\frac{R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{3}{2}}}}\label{eq:-3}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We therefore in both cases obtain the same expressions than 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bdipolecyl"

\end_inset

, using 
\begin_inset Formula $M=I\pi R_{p}^{2}$
\end_inset

.
\end_layout

\begin_layout Subsection*
Link between cylindrical and spherical expressions of the dipole magnetic
 field
\end_layout

\begin_layout Standard
Here, we want to prove that the conversion of 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bdipolecyl"

\end_inset

 to spherical 
\begin_inset Formula $\left(\rho,\vartheta,\varphi\right)$
\end_inset

 coordinates gives the expression previously calculated at 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bdipolesph"

\end_inset

.
 Discarding the 
\begin_inset Formula $\varphi$
\end_inset

 coordinate since 
\begin_inset Formula $B_{\varphi}=0$
\end_inset

 and none of the expressions depend on 
\begin_inset Formula $\varphi$
\end_inset

, we start from the relations :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\begin{array}{c}
\rho=\sqrt{R^{2}+Z^{2}}\\
\vartheta=\arctan\frac{Z}{R}\end{array}\Leftrightarrow\begin{array}{c}
R=\rho\sin\vartheta\\
Z=\rho\cos\vartheta\end{array}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\hat{\rho}=\sin\vartheta\hat{R}+\cos\vartheta\hat{Z}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\hat{\vartheta}=\cos\vartheta\hat{R}-\sin\vartheta\hat{Z}\]

\end_inset


\end_layout

\begin_layout Standard
We therefore have :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
B_{R}=\frac{\mu_{0}M}{4\pi}\frac{3RZ}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}=\frac{\mu_{0}M}{4\pi\rho^{3}}3\sin\vartheta\cos\vartheta\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
B_{Z}=\frac{\mu_{0}M}{4\pi}\frac{2Z^{2}-R^{2}}{\left(R^{2}+Z^{2}\right)^{\frac{5}{2}}}=\frac{\mu_{0}M}{4\pi\rho^{3}}\left(2\cos^{2}\vartheta-\sin^{2}\vartheta\right)\]

\end_inset


\end_layout

\begin_layout Standard
We can therefore deduce :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{B_{\rho}=B_{R}\sin\vartheta+B_{Z}\cos\vartheta=\frac{\mu_{0}M}{4\pi\rho^{3}}\left(3\sin^{2}\vartheta\cos\vartheta+2\cos^{3}\vartheta-\sin^{2}\vartheta\cos\vartheta\right)=\frac{\mu_{0}M}{4\pi\rho^{3}}2\cos\vartheta}\label{eq:-1}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{B_{\vartheta}=B_{R}\cos\vartheta-B_{Z}\sin\vartheta=\frac{\mu_{0}M}{4\pi\rho^{3}}\left(3\sin\vartheta\cos^{2}\vartheta-2\cos^{2}\vartheta\sin\vartheta+\sin^{3}\vartheta\right)=\frac{\mu_{0}M}{4\pi\rho^{3}}\sin\vartheta}\label{eq:-2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We therefore obtain the same expression as 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bdipolesph"

\end_inset

.
\end_layout

\begin_layout Subsection*
A vector derivation of the combined gradient and curvature drift
\end_layout

\begin_layout Standard
We start here with a particle moving in a magnetic field 
\begin_inset Formula $\mathbf{B}=B\mathbf{b}$
\end_inset

 with velocity 
\begin_inset Formula $\mathbf{v}=v_{\parallel}\mathbf{b}+\mathbf{v}_{\perp}$
\end_inset

.
 The equation of motion of the particle reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
m\frac{d\mathbf{v}}{dt}=-\mu\nabla B+q\mathbf{v}_{\perp}\times\mathbf{B}\label{eq:eqmotion}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We express 
\begin_inset Formula $\mathbf{v}_{\perp}$
\end_inset

 as a gyrokinetic component and a drift velocity :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{v}_{\perp}=\mathbf{v}_{\perp0}+\mathbf{v}_{d}\]

\end_inset


\end_layout

\begin_layout Standard
We assume that the variation of 
\begin_inset Formula $\mathbf{v}_{d}$
\end_inset

 is small compared to 
\begin_inset Formula $v_{\parallel}$
\end_inset

, i.e.
 
\begin_inset Formula $\left|\frac{d\mathbf{v}_{d}}{dt}\right|\ll\left|\frac{dv_{\parallel}}{dt}\right|$
\end_inset

.
 The gyrokinetic component is solution to the equation :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
m\frac{d\mathbf{v}_{\perp0}}{dt}=q\mathbf{v}_{\perp0}\times\mathbf{B}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:eqmotion"

\end_inset

 therefore becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
m\frac{d\mathbf{v}_{\parallel}}{dt}=-\mu\nabla B+q\mathbf{v}_{d}\times\mathbf{B}\]

\end_inset


\end_layout

\begin_layout Standard
The cross product of 
\begin_inset Formula $\mathbf{b}$
\end_inset

 with the equation gives :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
m\mathbf{b}\times\frac{d\mathbf{v}_{\parallel}}{dt}=-\mu\mathbf{b}\times\nabla B+q\mathbf{b}\times\left(\mathbf{v}_{d}\times\mathbf{B}\right)\]

\end_inset


\end_layout

\begin_layout Standard
Using the formula for a double cross product 
\begin_inset Formula $\mathbf{b}\times\left(\mathbf{v}_{d}\times\mathbf{B}\right)=\left(\mathbf{v}_{d}\cdot\mathbf{b}\right)\mathbf{B}-\left(\mathbf{b\cdot B}\right)\mathbf{v}_{d}=B\mathbf{v}_{d}$
\end_inset

, the equation becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{v}_{d}=\frac{m}{qB}\mathbf{b}\times\frac{d\mathbf{v}_{\parallel}}{dt}+\frac{\mu}{qB}\mathbf{b}\times\nabla B\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{d\mathbf{v}_{\parallel}}{dt}=\frac{dv_{\parallel}}{dt}\mathbf{b}+\frac{v_{\parallel}^{2}}{R}\mathbf{n}$
\end_inset

 where 
\begin_inset Formula $\mathbf{n}=\frac{\mathbf{R}}{R}$
\end_inset

 is the curve radius of the magnetic field.
 The equation becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{v}_{d}=\frac{mv_{\parallel}^{2}}{qB}\frac{\mathbf{b}\times\mathbf{n}}{R}+\frac{\mu}{qB}\mathbf{b}\times\nabla B\label{eq:vdcurveradius}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The Ampere theorem for a magnetic field structure without current is 
\begin_inset Formula $\nabla\times\mathbf{B}=0$
\end_inset

, so we can write :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\nabla\times\mathbf{B}=B\nabla\times\mathbf{b}-\mathbf{b}\times\nabla B=0\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\nabla\times\mathbf{b}=\frac{1}{R}\mathbf{b}\times\mathbf{n}$
\end_inset

 is the 
\begin_inset Quotes eld
\end_inset

vorticity
\begin_inset Quotes erd
\end_inset

 of the magnetic field.
 We can therefore see that :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{1}{R}\mathbf{b}\times\mathbf{n}=\frac{\mathbf{b}\times\nabla B}{B}\]

\end_inset


\end_layout

\begin_layout Standard
We can therefore write 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:vdcurveradius"

\end_inset

 as :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{v}_{d}=\frac{\frac{1}{2}mv_{\perp}^{2}+mv_{\parallel}^{2}}{qB}\frac{\mathbf{B}\times\nabla B}{B^{2}}\]

\end_inset


\end_layout

\begin_layout Standard
using 
\begin_inset Formula $\xi=\frac{p_{\parallel}}{p}=\frac{v_{\parallel}}{v}$
\end_inset

, the expression becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\mathbf{v}_{d}=\frac{mv^{2}}{2qB}\left(1+\xi^{2}\right)\frac{\mathbf{B}\times\nabla B}{B^{2}}}\label{eq:vdvector}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We note that in the general case, both gradient and curvature drifts contribute
 to the particle motion.
 We can see that 
\begin_inset Formula $\left|\frac{d\mathbf{v}_{d}}{dt}\right|$
\end_inset

 is of a higher order in 
\begin_inset Formula $\xi$
\end_inset

 than 
\begin_inset Formula $\left|\frac{dv_{\parallel}}{dt}\right|=v\left|\frac{d\xi}{dt}\right|$
\end_inset

.
 The assumption 
\begin_inset Formula $\left|\frac{d\mathbf{v}_{d}}{dt}\right|\ll\left|\frac{dv_{\parallel}}{dt}\right|$
\end_inset

 we made earlier is therefore consistent.
\end_layout

\begin_layout Subsection*
Calculation of 
\begin_inset Formula $f\left(0\right)$
\end_inset


\end_layout

\begin_layout Standard
The goal here is to perform the Taylor expansion of the bounce time scale
 function at 
\begin_inset Formula $\xi_{0}=0\Leftrightarrow\vartheta_{b}=\frac{\pi}{2}$
\end_inset

.
 Let us introduce the small parameter 
\begin_inset Formula $\varepsilon=\frac{\pi}{2}-\vartheta_{b}$
\end_inset

.
 The expression of 
\begin_inset Formula $f$
\end_inset

 becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(\varepsilon\right)=\int_{\frac{\pi}{2}-\varepsilon}^{\frac{\pi}{2}}\frac{\sin\vartheta\sqrt{1+3\cos^{2}\vartheta}}{\sqrt{1-\frac{\sqrt{1+3\cos^{2}\vartheta}}{\sin^{6}\vartheta}\frac{\cos^{6}\varepsilon}{\sqrt{1+3\sin^{2}\varepsilon}}}}d\vartheta\]

\end_inset


\end_layout

\begin_layout Standard
In order to have a finite boundary integral, we do the following variable
 change :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\vartheta=\varepsilon\left(t-1\right)+\frac{\pi}{2}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
d\vartheta=\varepsilon dt\]

\end_inset


\end_layout

\begin_layout Standard
The expression then reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(\varepsilon\right)=\varepsilon\int_{0}^{1}\frac{\cos\left(\varepsilon\left(t-1\right)\right)\sqrt{1+3\sin^{2}\left(\varepsilon\left(t-1\right)\right)}}{\sqrt{1-\frac{\sqrt{1+3\sin^{2}\left(\varepsilon\left(t-1\right)\right)}}{\cos^{6}\left(\varepsilon\left(t-1\right)\right)}\frac{\cos^{6}\varepsilon}{\sqrt{1+3\sin^{2}\varepsilon}}}}dt\]

\end_inset


\end_layout

\begin_layout Standard
We then use the following Taylor expansions at second order :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\cos\left(\varepsilon\left(t-1\right)\right)\sqrt{1+3\sin^{2}\left(\varepsilon\left(t-1\right)\right)}=\left(1-\frac{\varepsilon^{2}\left(t-1\right)^{2}}{2}\right)\left(1+\frac{3\varepsilon^{2}\left(t-1\right)^{2}}{2}\right)=1+\varepsilon^{2}\left(t-1\right)^{2}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\sqrt{1+3\sin^{2}\left(\varepsilon\left(t-1\right)\right)}}{\cos^{6}\left(\varepsilon\left(t-1\right)\right)}=\left(1+\frac{3\varepsilon^{2}\left(t-1\right)^{2}}{2}\right)\left(1+3\varepsilon^{2}\left(t-1\right)^{2}\right)=1+\frac{9\varepsilon^{2}\left(t-1\right)^{2}}{2}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\cos^{6}\varepsilon}{\sqrt{1+3\sin^{2}\varepsilon}}=\left(1-3\varepsilon^{2}\right)\left(1-\frac{3\varepsilon^{2}}{2}\right)=1-\frac{9\varepsilon^{2}}{2}\]

\end_inset


\end_layout

\begin_layout Standard
We can therefore deduce :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(\varepsilon\right)=\varepsilon\int_{0}^{1}\frac{1+\varepsilon^{2}\left(t-1\right)^{2}}{\sqrt{1-\left(1-\frac{9\varepsilon^{2}}{2}\left(1-\left(t-1\right)^{2}\right)\right)}}dt\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(\varepsilon\right)=\frac{\sqrt{2}}{3}\left(\int_{0}^{1}\frac{dt}{\sqrt{1-\left(t-1\right)^{2}}}+\varepsilon^{2}\int_{0}^{1}\frac{\left(t-1\right)^{2}}{\sqrt{1-\left(t-1\right)^{2}}}dt\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(\varepsilon\right)=\frac{\sqrt{2}}{3}\left[\arcsin\left(t-1\right)\right]_{0}^{1}+\frac{\sqrt{2}\varepsilon^{2}}{6}\left[\arcsin\left(t-1\right)-\left(t-1\right)\sqrt{1-\left(t-1\right)^{2}}\right]_{0}^{1}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{f\left(\varepsilon\right)=\frac{\pi\sqrt{2}}{6}+\frac{\pi\sqrt{2}}{12}\varepsilon^{2}+\mathcal{O}\left(\varepsilon^{2}\right)}\label{eq:f0}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We can therefore see that 
\begin_inset Formula $f\left(0\right)=\frac{\pi\sqrt{2}}{6}\simeq0.74$
\end_inset

 and that there is a local minimum in 
\begin_inset Formula $\xi_{0}=0$
\end_inset

.
\end_layout

\begin_layout Subsection*
Calculation of 
\begin_inset Formula $f\left(1\right)$
\end_inset


\end_layout

\begin_layout Standard
The evaluation of 
\begin_inset Formula $f$
\end_inset

 at 
\begin_inset Formula $\xi_{0}=1$
\end_inset

 has the following expression :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(1\right)=\int_{0}^{\frac{\pi}{2}}\sin\vartheta\sqrt{1+3\cos^{2}\vartheta}d\vartheta\]

\end_inset


\end_layout

\begin_layout Standard
Here, we use the following variable change :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
x=\cos\vartheta\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
dx=-\sin\vartheta d\vartheta\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(1\right)=\int_{0}^{1}\sqrt{1+3x^{2}}dx\]

\end_inset


\end_layout

\begin_layout Standard
We then use the following antiderivative :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\int\sqrt{a^{2}+x^{2}}dx=\frac{x}{2}\sqrt{a^{2}+x^{2}}+\frac{a^{2}}{2}\ln\left|x+\sqrt{a^{2}+x^{2}}\right|\]

\end_inset


\end_layout

\begin_layout Standard
The expression becomes :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
f\left(1\right)=\sqrt{3}\left[\frac{x}{2}\sqrt{\frac{1}{3}+x^{2}}+\frac{1}{6}\ln\left|x+\sqrt{\frac{1}{3}+x^{2}}\right|\right]_{0}^{1}=1+\frac{\sqrt{3}}{6}\ln\left(1+\frac{2}{\sqrt{3}}\right)-\frac{\sqrt{3}}{6}\ln\left(\frac{1}{\sqrt{3}}\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{f\left(1\right)=1+\frac{\sqrt{3}}{6}\ln\left(2+\sqrt{3}\right)\simeq1.38}\label{eq:f1}\end{equation}

\end_inset


\end_layout

