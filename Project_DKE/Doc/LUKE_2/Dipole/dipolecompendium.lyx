\begin_layout Section
Magnetic field produced by a magnetic dipole
\end_layout

\begin_layout Subsection
Expression of the magnetic field
\end_layout

\begin_layout Standard
The expression of the vector potential for a magnetic dipole 
\begin_inset Formula $\mathbf{M}$
\end_inset

 reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{A}\left(\mathbf{r}\right)=\frac{\mu_{0}}{4\pi}\frac{\mathbf{M}\times\mathbf{r}}{r^{3}}=-\frac{\mu_{0}}{4\pi}\mathbf{M}\times\nabla\frac{1}{r}\]

\end_inset


\end_layout

\begin_layout Standard
This expression is derived from the approximation of the vector potential
 produced by a coil of radius 
\begin_inset Formula $a$
\end_inset

, with 
\begin_inset Formula $r\gg a$
\end_inset

.
 Since 
\begin_inset Formula $\nabla\times\frac{\mathbf{M}}{r}=\nabla\frac{1}{r}\times\mathbf{M}$
\end_inset

, we have :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{A\left(r\right)}=\frac{\mu_{0}}{4\pi}\nabla\times\frac{\mathbf{M}}{r}\]

\end_inset


\end_layout

\begin_layout Standard
To calculate the magnetic field, we take the curl of the above expression.
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{B}\left(\mathbf{r}\right)=\nabla\times\mathbf{A}\left(\mathbf{r}\right)=\frac{\mu_{0}}{4\pi}\nabla\times\left(\nabla\times\frac{\mathbf{M}}{r}\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{B\left(r\right)}=\frac{\mu_{0}}{4\pi}\left(\nabla\left(\nabla\cdot\frac{\mathbf{M}}{r}\right)-\mathbf{M}\Delta\frac{1}{r}\right)\]

\end_inset


\end_layout

\begin_layout Standard
The Laplacian in spherical coordinates reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\Delta f=\nabla^{2}f=\nabla\cdot\left(\nabla f\right)=\frac{1}{r^{2}}\frac{\partial}{\partial r}\left(r^{2}\frac{\partial f}{\partial r}\right)+\frac{1}{r^{2}\sin\vartheta}\frac{\partial}{\partial\vartheta}\left(\sin\vartheta\frac{\partial f}{\partial\vartheta}\right)+\frac{1}{r^{2}\sin^{2}\vartheta}\frac{\partial^{2}f}{\partial\varphi^{2}}\]

\end_inset


\end_layout

\begin_layout Standard
We therefore deduce that 
\begin_inset Formula $\Delta\frac{1}{r}=\frac{1}{r^{2}}\frac{d}{dr}\left(r^{2}\frac{d}{dr}\frac{1}{r}\right)=0$
\end_inset

.
 Therefore the magnetic field derives from a scalar potential :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{B\left(r\right)}=-\nabla\Phi_{m}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\Phi_{m}=-\frac{\mu_{0}}{4\pi}\nabla\cdot\frac{\mathbf{M}}{r}=-\frac{\mu_{0}}{4\pi}\left(\mathbf{M}\cdot\nabla\frac{1}{r}\right)\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\Phi_{m}=\frac{\mu_{0}}{4\pi}\frac{\mathbf{M\cdot r}}{r^{3}}}\label{eq:}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
This ensures we can do a formal analogy with the electric field produced
 by an electric dipole.
 The Magnetic field reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\mathbf{B}\left(\mathbf{r}\right)=\frac{\mu_{0}}{4\pi}\frac{3\left(\mathbf{M}\cdot\mathbf{r}\right)\mathbf{r}-r^{2}\mathbf{M}}{r^{5}}}\label{eq:bdipolevector}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
In the spherical 
\begin_inset Formula $\left(\rho,\vartheta,\varphi\right)$
\end_inset

 coordinates, the magnetic field has the following expression :
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none
 
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
B_{\rho} & = & \frac{\mu_{0}M}{4\pi}\frac{2\cos\vartheta}{\rho^{3}}\\
B_{\vartheta} & = & \frac{\mu_{0}M}{4\pi}\frac{\sin\vartheta}{\rho^{3}}\\
B_{\varphi} & = & 0\end{array}}\label{eq:bdipolesph}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The field amplitude can be deduced from this expression :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{B\left(\rho,\vartheta\right)=\frac{\mu_{0}M}{4\pi\rho^{3}}\sqrt{1+3\cos^{2}\vartheta}}\label{eq:bdipoleampl}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Magnetic field gradient
\end_layout

\begin_layout Standard
The magnetic field gradient in spherical coordinates reads :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\nabla B=\frac{\partial B}{\partial\rho}\hat{\rho}+\frac{1}{\rho}\frac{\partial B}{\partial\vartheta}\hat{\vartheta}+\frac{1}{\rho\sin\vartheta}\frac{\partial B}{\partial\varphi}\hat{\varphi}\]

\end_inset


\end_layout

\begin_layout Standard
The magnetic dipole gradient therefore has the following expression :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\begin{array}{ccc}
\left(\nabla B\right)_{\rho} & = & -3\frac{\mu_{0}M}{4\pi\rho^{4}}\sqrt{1+3\cos^{2}\vartheta}\\
\left(\nabla B\right)_{\vartheta} & = & -3\frac{\mu_{0}M}{4\pi\rho^{4}}\frac{\sin\vartheta\cos\vartheta}{\sqrt{1+3\cos^{2}\vartheta}}\\
\left(\nabla B\right)_{\varphi} & = & 0\end{array}}\label{eq:bdipolegrad}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Magnetic field line equations
\end_layout

\begin_layout Standard
The magnetic field lines are locally tangent to the magnetic field.
 They are therefore given by the relation :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{B}\times d\mathbf{s}=\left(B_{\rho}\hat{\rho}+B_{\vartheta}\hat{\vartheta}\right)\times\left(d\rho\hat{\rho}+\rho d\vartheta\hat{\vartheta}\right)=0\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\left(B_{\rho}\rho d\vartheta-B_{\vartheta}d\rho\right)\hat{\varphi}=0\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\mu_{0}M}{4\pi}\frac{\sin\vartheta}{\rho^{3}}d\rho=\frac{\mu_{0}M}{4\pi}\frac{2\cos\vartheta}{\rho^{3}}\rho d\vartheta\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{d\rho}{\rho}=\frac{2\cos\vartheta d\vartheta}{\sin\vartheta}\]

\end_inset


\end_layout

\begin_layout Standard
The integration reference is taken at 
\begin_inset Formula $\rho=\rho_{0}$
\end_inset

 and 
\begin_inset Formula $\vartheta=\frac{\pi}{2}$
\end_inset

.
 Furthermore, 
\begin_inset Formula $\vartheta\in\left]0,\pi\right[$
\end_inset

 so 
\begin_inset Formula $\sin\vartheta$
\end_inset

 is always positive.
 Integration of the equation gives :
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\ln\frac{\rho}{\rho_{0}}=2\ln\sin\vartheta\]

\end_inset


\end_layout

\begin_layout Standard
The field line equation can therefore be written as :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\boxed{\rho=\rho_{0}\sin^{2}\vartheta}\label{eq:bdipolefieldline}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The field lines are represented on figure 
\begin_inset CommandInset ref
LatexCommand ref
reference "fig:Magnetic-dipole-field"

\end_inset

.
\end_layout

