\begin_layout Section
Summary
\end_layout

\begin_layout Standard
The present work featured first-order corrections in the light of the bounce-cen
ter transformation, and explicit calculations of bounce-center coordinates
 using the deeply-trapped approximation.
\end_layout

\begin_layout Section
\start_of_appendix
Bounce-center transformation
\end_layout

\begin_layout Standard
The bounce-center Lagrangian 
\begin_inset Formula $\ov{\Gamma}\equiv\epsilon_{\mathrm{d}}^{-1}\ov{\Gamma}_{0}+\ov{\Gamma}_{1}+\ldots=\exp\left(\epsilon_{\mathrm{d}}\mathcal{L}_{1}+\ldots\right)\Gamma$
\end_inset

 is obtained at first-order using the Lie operator 
\begin_inset Formula $\mathcal{L}_{1}A\equiv\cont 1\bdot\exd A+\exd\left(\cont 1\bdot A\right)$
\end_inset

, where 
\begin_inset Formula $\cont 1$
\end_inset

 is the inner product with the generating vector 
\begin_inset Formula $\mathsf{G}_{1}$
\end_inset

.
 Identifying like-order terms gives
\begin_inset Formula \begin{align*}
\ov{\Gamma}_{0}= & \Gamma_{0}=\frac{q}{c}\psi\exd\phi\\
\ov{\Gamma}_{1}= & \Gamma_{1}-\cont 1\cdot\exd\Gamma_{0}+\exd\ov S_{1}\\
= & \frac{q}{c}\left(\mathsf{G}_{1}^{\psi}\exd\phi-\mathsf{G}_{1}^{\phi}\exd\psi\right)+ap_{\|}\exd\psi\\
 & +p_{\|}\left(\pd sJ\exd J+\pd s{\zeta}\exd\zeta\right)+\exd\ov S_{1}-H\exd t\end{align*}

\end_inset

where we have rolled all exact derivatives in the gauge function 
\begin_inset Formula $\ov S_{1}$
\end_inset

.
 This function ensures the bounce independance of the first-order bounce-center
 Lagrangian.
 The bounce-center Lagrangian then reads
\begin_inset Formula \begin{equation}
\ov{\Gamma}=\frac{q}{c\epsilon_{\mathrm{d}}}\ov{\psi}\exd\ov{\phi}+\ov J\exd\ov{\zeta}-\ov H\exd t.\label{eq:bc_Gamma}\end{equation}

\end_inset

We therefore have the following relations, using the axissymetry property
 to eliminate derivatives in 
\begin_inset Formula $\phi$
\end_inset

,
\begin_inset Formula \begin{align}
\mathsf{G}_{1}^{\psi}= & \frac{c}{q}\pd{\ov S_{1}}{\phi}\equiv0\label{eq:Gpsi}\\
\mathsf{G}_{1}^{\phi}= & \frac{c}{q}\left(\pd{\ov S_{1}}{\psi}-ap_{\|}\right)\label{eq:Gphi}\end{align}

\end_inset

with the defining equations for the gauge function
\begin_inset Formula \begin{align}
\pd{\ov S_{1}}J= & -p_{\|}\pd sJ,\label{eq:bc_dS1dJ}\\
\pd{\ov S_{1}}{\zeta}= & J-p_{\|}\pd s{\zeta}.\label{eq:bc_dS1dzeta}\end{align}

\end_inset


\end_layout

\begin_layout Standard
Integrating the expressions for the bounce-center gyrogauge function gives
 us
\begin_inset Formula \begin{multline*}
\ov S_{1}=\frac{J}{2}\sin2\zeta+\epsilon_{\mathrm{t}}\frac{J^{2}}{24m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\sin\zeta\cos\zeta\left[2\left(-41\cos2\zeta+\frac{13}{4}\cos4\zeta\right)\right.\\
\left.+\left(-41\sin2\zeta+\frac{13}{8}\sin4\zeta\right)\left(3\tan\zeta-\cot\zeta\right)\right]+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right).\end{multline*}

\end_inset

Since 
\begin_inset Formula $\omega_{\mathrm{b}}\propto\psi$
\end_inset

 and 
\begin_inset Formula $r_{\mathrm{e}}\propto\psi^{-1}$
\end_inset

, we have
\begin_inset Formula \begin{multline*}
\pd{\ov S_{1}}{\psi}=\epsilon_{\mathrm{t}}\frac{J^{2}}{24\psi m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\sin\zeta\cos\zeta\left[2\left(-41\cos2\zeta+\frac{13}{4}\cos4\zeta\right)\right.\\
\left.+\left(-41\sin2\zeta+\frac{13}{8}\sin4\zeta\right)\left(3\tan\zeta-\cot\zeta\right)\right]+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right).\end{multline*}

\end_inset


\end_layout

