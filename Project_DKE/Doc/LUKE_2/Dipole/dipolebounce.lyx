\begin_layout Standard
In the vicinity of the equator, we find 
\begin_inset Formula \begin{equation}
\left|\xi\right|(\theta,\xi_{\mathrm{e}})\;\equiv\;\sqrt{1\;-\;\frac{B(\theta)}{B_{\mathrm{e}}}\;\left(1-\xi_{\mathrm{e}}^{2}\right)}\;=\;\frac{3}{\sqrt{2}}\;\sqrt{\sigma_{\mathrm{b}}^{2}\;-\;\sigma^{2}}\;+\;{\cal O}\left(\sigma_{\mathrm{b}}^{2}\right),\label{eq:xi_deep}\end{equation}

\end_inset

 so that the bounce action (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:J_def"

\end_inset

) becomes 
\begin_inset Formula \begin{equation}
J\;=\;\frac{3r_{\mathrm{e}}p}{\pi\sqrt{2}}\;\int_{-\sigma_{\mathrm{b}}}^{\sigma_{\mathrm{b}}}\;\sqrt{\sigma_{b}^{2}-\sigma^{2}}\; d\sigma\;+\;{\cal O}\left(\sigma_{\mathrm{b}}^{3}\right).\label{eq:J_deep_def}\end{equation}

\end_inset

 The integration is easily carried out and we obtain (to lowest order in
 
\begin_inset Formula $\xi_{\mathrm{e}}$
\end_inset

) 
\begin_inset Formula \begin{equation}
J\;=\;\frac{3r_{\mathrm{e}}p}{2\sqrt{2}}\;\sigma_{\mathrm{b}}^{2}\;=\;\frac{r_{\mathrm{e}}p}{3\sqrt{2}}\;\xi_{\mathrm{e}}^{2}.\label{eq:J_deep}\end{equation}

\end_inset

 From this expression, we use Eq.
\begin_inset space ~
\end_inset

(
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:omega_b"

\end_inset

) to compute the bounce frequency 
\begin_inset Formula \begin{equation}
\omega_{\mathrm{b}}\;=\;\left(\pd J{{\cal E}}\right)^{-1}\;=\;\frac{3\, p}{\sqrt{2}\, mr_{\mathrm{e}}}\;+\;{\cal O}\left(\xi_{\mathrm{e}}^{2}\right),\label{eq:omegab_deep}\end{equation}

\end_inset

 where we used 
\begin_inset Formula $\partial(p\,\xi_{\mathrm{e}}^{2})/\partial{\cal E}=m\,(2-\xi_{\mathrm{e}}^{2})/p$
\end_inset

.
 When we combine these two expressions, we find that harmonic bounce oscillator
 energy 
\begin_inset Formula \begin{equation}
J\,\omega_{\mathrm{b}}\;=\;\frac{p^{2}}{2m}\;\xi_{\mathrm{e}}^{2}\;\equiv\;{\cal E}\;-\;\mu\, B_{\mathrm{e}}\label{eq:JOmega}\end{equation}

\end_inset

 is simply the relative energy as measured from the minimum-B potential
 
\begin_inset Formula $\mu\, B_{\mathrm{e}}$
\end_inset

.
\end_layout

\begin_layout Standard
Next, we compute the lowest-order expression for the bounce angle 
\begin_inset Formula $\zeta$
\end_inset

 from Eq.
\begin_inset space ~
\end_inset

(
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:zeta_def"

\end_inset

).
 First, using Eq.
\begin_inset space ~
\end_inset

(
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:xi_deep"

\end_inset

), we compute 
\begin_inset Formula \[
\int_{\theta_{\mathrm{b}}^{-}}^{\theta}\;\frac{\sqrt{1+3\,\cos^{2}\theta^{\prime}}\;\sin\theta^{\prime}}{|\xi|(\theta^{\prime},\xi_{\mathrm{e}})}\; d\theta^{\prime}\;=\;\frac{\sqrt{2}}{3}\;\int_{-\,\sigma_{\mathrm{b}}}^{\sigma}\;\frac{d\sigma^{\prime}}{\sqrt{\sigma_{\mathrm{b}}^{2}-\sigma^{\prime2}}}\;=\;\frac{\sqrt{2}}{3}\left[\;\pi\;-\;\arccos\left(\frac{\sigma}{\sigma_{\mathrm{b}}}\right)\;\right],\]

\end_inset

 and thus we find 
\begin_inset Formula \begin{equation}
\zeta\;=\;\left\{ \begin{array}{lr}
2\pi\;-\;\arccos\left(\sigma/\sigma_{\mathrm{b}}\right)\hspace{1in} & (p_{\|}>0)\\
\\\arccos\left(\sigma/\sigma_{\mathrm{b}}\right) & (p_{\|}<0)\end{array}\right.\label{eq:zeta_deep}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Lastly, the parallel momentum 
\begin_inset Formula $p_{\|}$
\end_inset

 and the parallel field-line coordinate 
\begin_inset Formula $s$
\end_inset

 are expressed (to lowest order in 
\begin_inset Formula $\xi_{\mathrm{e}}$
\end_inset

) in terms of the action-angle coordinates 
\begin_inset Formula $(J,\zeta)$
\end_inset

 as 
\begin_inset Formula \begin{equation}
p_{\|}\;=\;-\;\sqrt{\frac{6pJ}{\sqrt{2}r_{\mathrm{e}}}}\;\sin\zeta\;\equiv\;-\;\sqrt{2m\omega_{\mathrm{b}}J}\;\sin\zeta,\label{eq:ppar_deep}\end{equation}

\end_inset

 and 
\begin_inset Formula \begin{equation}
s\;=\;\sqrt{\frac{2\sqrt{2}r_{\mathrm{e}}J}{3p}}\;\cos\zeta\;\equiv\;\sqrt{\frac{2J}{m\omega_{\mathrm{b}}}}\;\cos\zeta\label{eq:s_deep}\end{equation}

\end_inset

 where we have used the bounce frequency (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:omegab_deep"

\end_inset

) for deeply-trapped particles.
 We note that the transformation from 
\begin_inset Formula $(p_{\|},s)$
\end_inset

 to 
\begin_inset Formula $(J,\zeta)$
\end_inset

 is a canonical transformation since 
\begin_inset Formula \[
\left\{ s,\; p_{\|}\right\} \;\equiv\;\pd s{\zeta}\,\pd{p_{\|}}J\;-\;\pd sJ\,\pd{p_{\|}}s\;=\;\cos^{2}\zeta\;+\;\sin^{2}\zeta\;=\;1.\]

\end_inset


\end_layout

\begin_layout Subsection
Anharmonic Corrections
\end_layout

\begin_layout Standard
In this section, we will obtain the expressions for the bounce coordinates
 through the Lie transform method.
 Using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:-13"

\end_inset

), we can invert the expansion and deduce :
\begin_inset Formula \begin{equation}
\sigma\;=\;\frac{s}{r_{\mathrm{e}}}\;-\;\frac{1}{3}\left(\frac{s}{r_{\mathrm{e}}}\right)^{3}\;+\;{\cal O}\left(\left(\frac{s}{r_{\mathrm{e}}}\right)^{5}\right)\end{equation}

\end_inset

 The Hamiltonian will have a lowest-order expression and a higher-order
 correction which will break the bounce action invariance.
 Using Lie transforms, we will perform the transformation to new bounce
 coordinates 
\begin_inset Formula $\left(\ov J,\ov{\zeta}\right)$
\end_inset

 in order to restore the action invariance.
 The expression of the Hamiltonian reads :
\begin_inset Formula \begin{equation}
H\;\equiv\;\frac{p_{\parallel}^{2}}{2m}\;+\;\mu B\;\equiv\; H_{0}\;+\;\delta H\left(J,\zeta\right)\end{equation}

\end_inset

 Using the expansion for 
\begin_inset Formula $B/B_{\mathrm{e}}$
\end_inset

 in (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:-12"

\end_inset

), we find :
\begin_inset Formula \begin{equation}
\mu B\;=\;\frac{p^{2}\left(1-\xi_{\mathrm{e}}^{2}\right)}{2m}\,\frac{B}{B_{\mathrm{e}}}\;=\;\mu B_{\mathrm{e}}\left(1\;+\;\frac{9}{2}\sigma^{2}\;+\;\frac{63}{8}\sigma^{4}\right)\;+\;{\cal O}\left(\sigma^{6}\right)\end{equation}

\end_inset

 Inserting the expression for 
\begin_inset Formula $\sigma$
\end_inset

 gives :
\begin_inset Formula \begin{eqnarray}
\mu B & = & \mu B_{\mathrm{e}}\left[1\;+\;\frac{9}{2}\left(\frac{s}{r_{\mathrm{e}}}\right)^{2}\left(1\;-\;\frac{2}{3}\left(\frac{s}{r_{\mathrm{e}}}\right)^{2}\right)\;+\;\frac{63}{8}\left(\frac{s}{r_{\mathrm{e}}}\right)^{4}\right]\;+\;{\cal O}\left(\left(\frac{s}{r_{\mathrm{e}}}\right)^{6}\right)\nonumber \\
 & = & \mu B_{\mathrm{e}}\left[1\;+\;\frac{9}{2}\left(\frac{s}{r_{\mathrm{e}}}\right)^{2}\;+\;\frac{39}{8}\left(\frac{s}{r_{\mathrm{e}}}\right)^{4}\right]\;+\;{\cal O}\left(\left(\frac{s}{r_{\mathrm{e}}}\right)^{6}\right)\label{eq:-18}\end{eqnarray}

\end_inset

 Using the expression for the lowest-order bounce frequency 
\begin_inset Formula $\omega_{\mathrm{b}}=3p/mr_{\mathrm{e}}\sqrt{2}$
\end_inset

 and remembering that 
\begin_inset Formula $\sigma\sim s/r_{\mathrm{e}}={\cal O}\left(\sigma_{\mathrm{b}}\right)$
\end_inset

, the expression becomes :
\begin_inset Formula \begin{eqnarray}
\mu B & = & \mu B_{\mathrm{e}}\;+\;\frac{1}{2}m\omega_{\mathrm{b}}^{2}s^{2}\left[1\;-\;\xi_{\mathrm{e}}^{2}\;+\;\frac{13}{12}\left(\frac{s}{\rho_{\mathrm{e}}}\right)^{2}\right]+{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\nonumber \\
 & = & \mu B_{\mathrm{e}}\;+\;\frac{1}{2}m\omega_{\mathrm{b}}^{2}s^{2}\left[1\;-\;\frac{9}{2}\sigma_{\mathrm{b}}^{2}\;+\;\frac{13}{12}\left(\frac{s}{\rho_{\mathrm{e}}}\right)^{2}\right]+{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\label{eq:-17}\end{eqnarray}

\end_inset

 We therefore have the following expression for the Hamiltonian perturbation
 :
\begin_inset Formula \begin{eqnarray}
\delta H & = & \frac{1}{2}m\omega_{\mathrm{b}}^{2}s^{2}\left[-\frac{9}{2}\sigma_{\mathrm{b}}^{2}\;+\;\frac{13}{12}\left(\frac{s}{r_{\mathrm{e}}}\right)^{2}\right]+{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\nonumber \\
 & = & \omega_{\mathrm{b}}J\cos^{2}\zeta\left[-\frac{3\sqrt{2}}{r_{\mathrm{e}}p}J\;+\;\frac{13J}{6m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\cos^{2}\zeta\right]+{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\nonumber \\
 & = & \frac{J^{2}}{mr_{\mathrm{e}}^{2}}\left[-9\cos^{2}\zeta\;+\;\frac{13}{6}\cos^{4}\zeta\right]+{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\label{eq:-16}\end{eqnarray}

\end_inset

 We then use the following cosine expansions :
\begin_inset Formula \begin{equation}
\cos^{2}\zeta=\frac{1}{2}+\frac{1}{2}\cos2\zeta\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\cos^{4}\zeta=\frac{3}{8}+\frac{1}{2}\cos2\zeta+\frac{1}{8}\cos4\zeta\end{equation}

\end_inset

 The Hamiltonian perturbation becomes :
\begin_inset Formula \begin{equation}
\delta H=\frac{J^{2}}{mr_{\mathrm{e}}^{2}}\left(-\frac{59}{16}\;-\;\frac{41}{12}\,\cos2\zeta\;+\;\frac{13}{48}\,\cos4\zeta\right)+{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\end{equation}

\end_inset

 This perturbation will be considered small if the following ratio is small
 :
\begin_inset Formula \begin{equation}
\frac{J^{2}/mr_{\mathrm{e}}^{2}}{J\omega_{\mathrm{b}}}\;=\;\frac{J\omega_{\mathrm{b}}}{m\omega_{\mathrm{b}}^{2}r_{\mathrm{e}}^{2}}\;=\;\frac{1}{2}\frac{s_{+}^{2}}{r_{\mathrm{e}}^{2}}\end{equation}

\end_inset

 Since 
\begin_inset Formula $s_{+}$
\end_inset

 is small compared to the field line equatorial radius, due to the deeply
 trapped approximation, the Hamiltonian perturbation 
\begin_inset Formula $\delta H\;\equiv\; H_{1}$
\end_inset

 is therefore small.
 Using the Lie transform formalism, we build a new bounce-angle independent
 Hamiltonian.
 Its expression reads, using 
\begin_inset Formula $\epsilon$
\end_inset

 to indicate first-order terms :
\begin_inset Formula \begin{equation}
\ov H\;\equiv\;\ov H_{0}\;+\;\epsilon\ov H_{1}\;+\;{\cal O}\left(\epsilon^{2}\right)\;=\;\mathsf{T}_{\epsilon}^{-1}H\;=\; H_{0}\;+\;\epsilon H_{1}\;-\;\epsilon\left\{ S_{1},H_{0}\right\} \;+\;{\cal O}\left(\epsilon^{2}\right)\end{equation}

\end_inset

 where 
\begin_inset Formula $S_{1}\left(J,\zeta\right)$
\end_inset

 is a gauge function designed to restore the bounce-angle independence.
 The Poisson bracket reads :
\begin_inset Formula \begin{equation}
\left\{ S_{1},H_{0}\right\} \;=\;\pd{S_{1}}{\zeta}\,\pd{H_{0}}J\;-\;\pd{S_{1}}J\,\pd{H_{0}}{\zeta}\;=\;\omega_{\mathrm{b}}\pd{S_{1}}{\zeta}\end{equation}

\end_inset

 We therefore have the following identities :
\begin_inset Formula \begin{equation}
\ov H_{0}\;=\; H_{0}\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\ov H_{1}\;=\; H_{1}\;-\;\omega_{\mathrm{b}}\pd{S_{1}}{\zeta}\end{equation}

\end_inset

 Since 
\begin_inset Formula $\ov H_{1}$
\end_inset

 must be bounce-angle independent, if we denote 
\begin_inset Formula $\left\langle H_{1}\right\rangle $
\end_inset

 the bounce-averaged component of the first-order perturbation and 
\begin_inset Formula $\wt H_{1}$
\end_inset

 the explicitly bounce-angle dependent component, we have :
\begin_inset Formula \begin{equation}
\ov H_{1}\;=\;\left\langle H_{1}\right\rangle \;=\;-\frac{59}{16}\,\frac{J^{2}}{mr_{\mathrm{e}}^{2}}\;+\;{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
S_{1}\;=\;\frac{1}{\omega_{\mathrm{b}}}\int\;\wt H_{1}d\zeta=\frac{J^{2}}{24m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(-41\,\sin2\zeta\;+\;\frac{13}{8}\,\sin4\zeta\right)+{\cal O}\left(\sigma_{\mathrm{b}}^{6}\right)\end{equation}

\end_inset

 From the expression for 
\begin_inset Formula $S_{1}$
\end_inset

, we can deduce the new expressions for the bounce action and angle, at
 first order in the Hamiltonian perturbation :
\begin_inset Formula \begin{eqnarray}
\ov J\;=\; J\;+\;\epsilon\left\{ S_{1},J\right\} \;+\;{\cal O}\left(\epsilon^{2}\right) & = & J\;+\;\epsilon\pd{S_{1}}{\zeta}\;+\;{\cal O}\left(\epsilon^{2}\right)\nonumber \\
 & = & J\;+\;\epsilon\frac{J^{2}}{12m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(-41\,\cos2\zeta\;+\;\frac{13}{4}\,\cos4\zeta\right)\;+\;{\cal O}\left(\epsilon^{2}\right)\label{eq:-14}\end{eqnarray}

\end_inset

 
\begin_inset Formula \begin{eqnarray}
\ov{\zeta}=\zeta\;+\;\epsilon\left\{ S_{1},\zeta\right\} \;+\;{\cal O}\left(\epsilon^{2}\right) & = & \zeta\;-\;\epsilon\pd{S_{1}}J\;+\;{\cal O}\left(\epsilon^{2}\right)\nonumber \\
 & = & \zeta\;+\;\epsilon\frac{J}{12m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(41\,\sin2\zeta\;-\;\frac{13}{8}\,\sin4\zeta\right)\;+\;{\cal O}\left(\epsilon^{2}\right)\label{eq:-15}\end{eqnarray}

\end_inset

 The new Hamiltonian reads, at first order in the perturbation :
\begin_inset Formula \begin{equation}
\ov H\;=\; J\omega_{\mathrm{b}}\;+\;\mu B_{\mathrm{e}}\;-\;\epsilon\frac{59}{8}\,\frac{J}{mr_{\mathrm{e}}^{2}}\;+\;{\cal O}\left(\epsilon^{2}\right)\end{equation}

\end_inset

 We therefore have 
\begin_inset Formula $\partial\ov H/\partial\zeta\;=\;{\cal O}\left(\epsilon^{2}\right)$
\end_inset

.
 We can then deduce 
\begin_inset Formula $\partial\ov H/\partial\ov{\zeta}\;=\;{\cal O}\left(\epsilon^{2}\right)$
\end_inset

 and hence :
\begin_inset Formula \begin{equation}
\dot{\ov J}\;\equiv\;-\pd{\ov H}{\ov{\zeta}}\;=\;{\cal O}\left(\epsilon^{2}\right)\end{equation}

\end_inset

 The bounce action is therefore an adiabatic invariant at first order in
 the Hamiltonian perturbation.
 Another way to see this is to calculate 
\begin_inset Formula $\dot{\ov J}$
\end_inset

 using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:-14"

\end_inset

).
 We then have :
\begin_inset Formula \begin{equation}
\dot{\ov J}\;=\;\dot{J}\;+\;\epsilon\frac{J}{6m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left[\dot{J}\left(-41\,\cos2\zeta+\frac{13}{4}\,\cos4\zeta\right)\;-\;\dot{\zeta}\left(-41\,\sin2\zeta+\frac{13}{2}\,\sin4\zeta\right)\right]\;+\;{\cal O}\left(\epsilon^{2}\right)\label{eq:-19}\end{equation}

\end_inset

 The derivatives 
\begin_inset Formula $\dot{J}$
\end_inset

 and 
\begin_inset Formula $\dot{\zeta}$
\end_inset

 are taken from Hamilton's equations.
 They read :
\begin_inset Formula \begin{equation}
\dot{J}\;=\;-\pd H{\zeta}\;=\;\epsilon\frac{J^{2}}{6mr_{\mathrm{e}}^{2}}\left(-41\,\sin2\zeta+\frac{13}{2}\,\sin4\zeta\right)\;+\;{\cal O}\left(\epsilon^{2}\right)\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\dot{\zeta}\;=\;\pd HJ=\;\omega_{\mathrm{b}}\;-\;\epsilon\frac{59}{8}\frac{J}{mr_{\mathrm{e}}^{2}}\;+\;{\cal O}\left(\epsilon^{2}\right)\end{equation}

\end_inset

 Inserting these expressions into (
