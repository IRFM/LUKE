\begin_layout Standard
A trapped particle orbit can be represented in terms of the canonical action-ang
le coordinates 
\begin_inset Formula $\left(J,\zeta\right)$
\end_inset

, where the bounce action coordinate 
\begin_inset Formula \begin{equation}
J\equiv\frac{1}{2\pi}\oint p_{\|}ds=\frac{r_{\mathrm{e}}p}{\pi}\int_{\theta_{\mathrm{b}}^{-}}^{\theta_{\mathrm{b}}^{+}}|\xi|\left(\theta,\xi_{\mathrm{e}}\right)\sqrt{1+3\cos^{2}\theta}\sin\theta d\theta\label{eq:J_def}\end{equation}

\end_inset

is a function of 
\begin_inset Formula $(r_{\mathrm{e}},p,\xi_{\mathrm{e}})$
\end_inset

.
 The conjugate bounce angle 
\begin_inset Formula \begin{equation}
\zeta\equiv\pi+{\rm sgn}(p_{\|})\frac{r_{\mathrm{e}}\omega_{\mathrm{b}}}{p/m}\int_{\theta_{\mathrm{b}}^{-}}^{\theta}\frac{\sqrt{1+3\cos^{2}\theta^{\prime}}\sin\theta^{\prime}}{|\xi|\left(\theta^{\prime},\xi_{\mathrm{e}}\right)}d\theta^{\prime}\label{eq:zeta_def}\end{equation}

\end_inset

on the other hand, is defined to be 
\begin_inset Formula $\zeta\equiv\pi$
\end_inset

 at 
\begin_inset Formula $\theta=\theta_{\mathrm{b}}^{-}<\pi/2$
\end_inset

, where the bounce frequency 
\begin_inset Formula $\omega_{\mathrm{b}}$
\end_inset

 is defined from the relation 
\begin_inset Formula \begin{equation}
\omega_{\mathrm{b}}^{-1}\equiv\pd J{\mathcal{E}}=\frac{1}{2\pi}\oint\frac{mds}{p_{\|}}=\frac{mr_{\mathrm{e}}}{\pi p}\int_{\theta_{\mathrm{b}}^{-}}^{\theta_{\mathrm{b}}^{+}}\frac{\sqrt{1+3\cos^{2}\theta}\sin\theta}{|\xi|\left(\theta,\xi_{\mathrm{e}}\right)}d\theta.\label{eq:omega_b}\end{equation}

\end_inset

When the integral in Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:omega_b"

\end_inset

 is computed numerically as a function of 
\begin_inset Formula $\xi_{\mathrm{e}}$
\end_inset

, we obtain the following expression for the bounce period 
\begin_inset Formula \begin{equation}
\tau_{\mathrm{b}}\equiv\frac{2\pi}{\omega_{\mathrm{b}}}=\left(2\pi\frac{\sqrt{2}}{3}\right)\frac{r_{\mathrm{e}}}{v}f\left(\xi_{\mathrm{e}}\right),\label{eq:tau_b_xi}\end{equation}

\end_inset

where the normalized function 
\begin_inset Formula $f\left(\xi_{\mathrm{e}}\right)$
\end_inset

 is shown in Fig.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "fig:f_xi"

\end_inset

.
 It is immediately clear that, in the deeply-trapped approximation 
\begin_inset Formula $\xi_{\mathrm{e}}\ll1$
\end_inset

, the function 
\begin_inset Formula $f\left(\xi_{\mathrm{e}}\right)$
\end_inset

 is replaced by unity in Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:tau_b_xi"

\end_inset

, and the bounce period becomes independent of the equatorial pitch-angle
 coordinate: 
\begin_inset Formula $\tau_{\mathrm{b}}\propto r_{\mathrm{e}}/v$
\end_inset

.
\end_layout

