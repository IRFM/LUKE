\begin_layout Standard
Lastly, it is worth pointing out that when the bounce period 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:tau_b_xi"

\end_inset

 is compared with the equatorial gyrofrequency 
\begin_inset Formula $\omega_{\mathrm{g}}\equiv qB_{\mathrm{e}}/mc$
\end_inset

 and the equatorial bounce-averaged drift period 
\begin_inset Formula \begin{equation}
\tau_{\mathrm{d}}\equiv\frac{2\pi}{\omega_{\mathrm{d}}}=\left(\frac{4\pi}{3}\right)\frac{r_{\mathrm{e}}^{2}}{\rho_{\mathrm{e}}v}\sqrt{1-\xi_{\mathrm{e}}^{2}}g\left(\xi_{\mathrm{e}}\right),\label{eq:tau_d_xi}\end{equation}

\end_inset

where 
\begin_inset Formula $\rho_{\mathrm{e}}\equiv v\sqrt{1-\xi_{\mathrm{e}}}/\omega_{\mathrm{g}}$
\end_inset

 denotes the equatorial Larmor radius and the normalized function 
\begin_inset Formula $g\left(\xi_{\mathrm{e}}\right)$
\end_inset

 is shown in Fig.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "fig:g_xi"

\end_inset

, we obtain three well-separated orbital time scales 
\begin_inset Formula $\tau_{\mathrm{g}}\ll\tau_{\mathrm{b}}\ll\tau_{\mathrm{d}}$
\end_inset

 when 
\begin_inset Formula $\epsilon\equiv\rho_{\mathrm{e}}/r_{\mathrm{e}}\ll1$
\end_inset

 for all values of 
\begin_inset Formula $\xi_{\mathrm{e}}$
\end_inset

.
 Note that, by using Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:phi_dot"

\end_inset

, the bounce-averaged drift frequency 
\begin_inset Formula $\langle\dot{\phi}\rangle_{\mathrm{b}}$
\end_inset

 can be expressed as 
\begin_inset Formula \begin{equation}
\langle\dot{\phi}\rangle_{\mathrm{b}}\equiv\frac{1}{\tau_{\mathrm{b}}}\oint\frac{ds}{v_{\|}}\dot{\phi}=\frac{c\mu}{q}\left\langle \pd B{\psi}\right\rangle _{\mathrm{b}},\end{equation}

\end_inset

where the bounce average of the second term in Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:phi_dot"

\end_inset

 vanishes identically.
 For deeply-trapped particles 
\begin_inset Formula $(\xi_{\mathrm{e}}\ll1)$
\end_inset

, the bounce-averaged drift frequency is approximately given as 
\begin_inset Formula \begin{equation}
\langle\dot{\phi}\rangle_{\mathrm{b}}\simeq\frac{c\mu}{q}\pd{B_{\mathrm{e}}}{\psi_{\mathrm{e}}}=3\frac{c\mu}{qr_{\mathrm{e}}^{2}}\simeq\frac{3}{2}\frac{\rho_{\mathrm{e}}v}{r_{\mathrm{e}}^{2}}\equiv\frac{2\pi}{\tau_{\mathrm{d}}},\label{eq:phi_dot_ave}\end{equation}

\end_inset

from which we obtain Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:tau_d_xi"

\end_inset

 in the deeply-trapped limit (where 
\begin_inset Formula $g\rightarrow1$
\end_inset

).
\end_layout

\begin_layout Subsection
Lowest-order calculations
\end_layout

\begin_layout Standard
We will now calculate explicit expressions for the bounce angle-action coordinat
es in the deeply-trapped approximation.
 In the vicinity of the equator, we find 
\begin_inset Formula \begin{equation}
\left|\xi\right|\left(\theta,\xi_{\mathrm{e}}\right)\equiv\sqrt{1-\frac{B\left(\theta\right)}{B_{\mathrm{e}}}\left(1-\xi_{\mathrm{e}}^{2}\right)}=\frac{3}{\sqrt{2}}\sqrt{\sigma_{\mathrm{b}}^{2}-\sigma^{2}}+\mathcal{O}\left(\sigma_{\mathrm{b}}^{2}\right),\label{eq:xi_deep}\end{equation}

\end_inset

so that the bounce action 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:J_def"

\end_inset

 becomes 
\begin_inset Formula \begin{equation}
J=\frac{3r_{\mathrm{e}}p}{\pi\sqrt{2}}\int_{-\sigma_{\mathrm{b}}}^{\sigma_{\mathrm{b}}}\sqrt{\sigma_{b}^{2}-\sigma^{2}}d\sigma+\mathcal{O}\left(\sigma_{\mathrm{b}}^{3}\right).\label{eq:J_deep_def}\end{equation}

\end_inset

The integration is easily carried out and we obtain (to lowest order in
 
\begin_inset Formula $\xi_{\mathrm{e}}$
\end_inset

) 
\begin_inset Formula \begin{equation}
J=\frac{3r_{\mathrm{e}}p}{2\sqrt{2}}\sigma_{\mathrm{b}}^{2}=\frac{r_{\mathrm{e}}p}{3\sqrt{2}}\xi_{\mathrm{e}}^{2}.\label{eq:J_deep}\end{equation}

\end_inset

From this expression, we use Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:omega_b"

\end_inset

 to compute the bounce frequency 
\begin_inset Formula \begin{equation}
\omega_{\mathrm{b}}=\left(\pd J{\mathcal{E}}\right)^{-1}=\frac{3p}{\sqrt{2}mr_{\mathrm{e}}}+\mathcal{O}\left(\xi_{\mathrm{e}}^{2}\right),\label{eq:omegab_deep}\end{equation}

\end_inset

where we used 
\begin_inset Formula $\partial\left(p\xi_{\mathrm{e}}^{2}\right)/\partial\mathcal{E}=m\left(2-\xi_{\mathrm{e}}^{2}\right)/p$
\end_inset

.
 When we combine these two expressions, we find that harmonic bounce oscillator
 energy 
\begin_inset Formula \begin{equation}
J\omega_{\mathrm{b}}=\frac{p^{2}}{2m}\xi_{\mathrm{e}}^{2}\equiv\mathcal{E}-\mu B_{\mathrm{e}}\label{eq:JOmega}\end{equation}

\end_inset

 is simply the relative energy as measured from the minimum-
\begin_inset Formula $B$
\end_inset

 potential 
\begin_inset Formula $\mu B_{\mathrm{e}}$
\end_inset

.
 The lowest-order Hamiltonian therefore reads
\begin_inset Formula \begin{equation}
H_{0}=\mu B_{\mathrm{e}}+J\omega_{\mathrm{b}}\label{eq:H0}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Next, we compute the lowest-order expression for the bounce angle 
\begin_inset Formula $\zeta$
\end_inset

 from Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:zeta_def"

\end_inset

.
 First, using Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:xi_deep"

\end_inset

, we compute 
\begin_inset Formula \begin{equation}
\int_{\theta_{\mathrm{b}}^{-}}^{\theta}\frac{\sqrt{1+3\cos^{2}\theta^{\prime}}\sin\theta^{\prime}}{|\xi|\left(\theta^{\prime},\xi_{\mathrm{e}}\right)}d\theta^{\prime}=\frac{\sqrt{2}}{3}\int_{-\sigma_{\mathrm{b}}}^{\sigma}\frac{d\sigma^{\prime}}{\sqrt{\sigma_{\mathrm{b}}^{2}-\sigma^{\prime2}}}=\frac{\sqrt{2}}{3}\left[\pi-\arccos\left(\frac{\sigma}{\sigma_{\mathrm{b}}}\right)\right],\end{equation}

\end_inset

and thus we find 
\begin_inset Formula \begin{equation}
\zeta=\begin{cases}
2\pi-\arccos\left(\sigma/\sigma_{\mathrm{b}}\right) & \left(p_{\|}>0\right)\\
\arccos\left(\sigma/\sigma_{\mathrm{b}}\right) & \left(p_{\|}<0\right)\end{cases}\label{eq:zeta_deep}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Lastly, the parallel momentum 
\begin_inset Formula $p_{\|}$
\end_inset

 and the parallel field-line coordinate 
\begin_inset Formula $s$
\end_inset

 are expressed (to lowest order in 
\begin_inset Formula $\xi_{\mathrm{e}}$
\end_inset

) in terms of the action-angle coordinates 
\begin_inset Formula $\left(J,\zeta\right)$
\end_inset

 as 
\begin_inset Formula \begin{equation}
p_{\|}=-\sqrt{2m\omega_{\mathrm{b}}J}\sin\zeta,\label{eq:ppar_deep}\end{equation}

\end_inset

and 
\begin_inset Formula \begin{equation}
s=\sqrt{\frac{2J}{m\omega_{\mathrm{b}}}}\cos\zeta\label{eq:s_deep}\end{equation}

\end_inset

where we have used the bounce frequency 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:omegab_deep"

\end_inset

 for deeply-trapped particles.
 We note that the transformation from 
\begin_inset Formula $\left(p_{\|},s\right)$
\end_inset

 to 
\begin_inset Formula $\left(J,\zeta\right)$
\end_inset

 is a canonical transformation since the canonical Poisson bracket reads
 
\begin_inset Formula \begin{equation}
\left\{ s,p_{\|}\right\} _{J,\zeta}\equiv\pd s{\zeta}\pd{p_{\|}}J-\pd sJ\pd{p_{\|}}{\zeta}=\cos^{2}\zeta+\sin^{2}\zeta=1.\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Anharmonic Corrections
\end_layout

\begin_layout Standard
In this section, we will obtain the expressions for the bounce coordinates
 through the Lie transform method.
 First, since 
\begin_inset Formula $\left|\sigma\right|\leq\sigma_{\mathrm{b}}$
\end_inset

, all expansions can performed according to the parameter 
\begin_inset Formula \begin{equation}
\epsilon_{\mathrm{t}}\equiv\left(\frac{s_{\mathrm{b}}}{r_{\mathrm{e}}}\right)^{2}\end{equation}

\end_inset

Inverting Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:s_sigma"

\end_inset

, we obtain
\begin_inset Formula \begin{equation}
\sigma=\frac{s}{r_{\mathrm{e}}}-\frac{1}{3}\left(\frac{s}{r_{\mathrm{e}}}\right)^{3}+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{\frac{5}{2}}\right)\label{eq:sigma_s}\end{equation}

\end_inset

The Hamiltonian 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:H"

\end_inset

 will have a lowest-order expression 
\begin_inset Formula $H_{0}$
\end_inset

 and a higher-order correction 
\begin_inset Formula $\delta H$
\end_inset

 which will break the bounce action invariance, i.e.
\begin_inset Formula \begin{equation}
H\equiv\frac{p_{\parallel}^{2}}{2m}+\mu B\equiv H_{0}+\delta H\left(J,\zeta\right),\end{equation}

\end_inset

with
\begin_inset Formula \[
\dot{J}\equiv-\pd H{\zeta}=-\pd{\delta H}{\zeta}\neq0.\]

\end_inset


\end_layout

\begin_layout Standard
Using Lie transforms, we will perform the transformation to new bounce coordinat
es 
\begin_inset Formula $\left(\wh J,\wh{\zeta}\right)$
\end_inset

 in order to restore the action invariance.
 Using the expansion for 
\begin_inset Formula $B/B_{\mathrm{e}}$
\end_inset

 in 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:B_sigma"

\end_inset

 and inserting the expression 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:sigma_s"

\end_inset

 for 
\begin_inset Formula $\sigma$
\end_inset

, we find
\begin_inset Formula \begin{equation}
\mu B\equiv\frac{p^{2}\left(1-\xi_{\mathrm{e}}^{2}\right)}{2m}\frac{B}{B_{\mathrm{e}}}=\mu B_{\mathrm{e}}\left[1+\frac{9}{2}\left(\frac{s}{r_{\mathrm{e}}}\right)^{2}+\frac{39}{8}\left(\frac{s}{r_{\mathrm{e}}}\right)^{4}\right]+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{3}\right).\label{eq:muBs}\end{equation}

\end_inset

We will henceforth omit contributions of order higher than 
\begin_inset Formula $\epsilon_{\mathrm{t}}^{2}$
\end_inset

.
 Using the lowest-order bounce frequency 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:omegab_deep"

\end_inset

, the expression 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:muBs"

\end_inset

 becomes
\begin_inset Formula \begin{equation}
\mu B=\mu B_{\mathrm{e}}+\frac{1}{2}m\omega_{\mathrm{b}}^{2}s^{2}\left[1-\xi_{\mathrm{e}}^{2}+\frac{13}{12}\left(\frac{s}{\rho_{\mathrm{e}}}\right)^{2}\right].\end{equation}

\end_inset

We therefore have the following expression for the Hamiltonian perturbation,
\begin_inset Formula \begin{equation}
\delta H=\frac{1}{2}m\omega_{\mathrm{b}}^{2}s^{2}\left[-\xi_{\mathrm{e}}^{2}+\frac{13}{12}\left(\frac{s}{r_{\mathrm{e}}}\right)^{2}\right].\end{equation}

\end_inset

Inserting the expressions 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:J_deep"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:s_deep"

\end_inset

 respectively for 
\begin_inset Formula $\xi_{\mathrm{e}}\left(J\right)$
\end_inset

 and 
\begin_inset Formula $s\left(J,\zeta\right)$
\end_inset

 gives
\begin_inset Formula \begin{equation}
\delta H=J\omega_{\mathrm{b}}\cos^{2}\zeta\left[-\frac{9J}{m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}+\frac{13J}{6m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\cos^{2}\zeta\right]\end{equation}

\end_inset

Expanding the trigonometric functions shows the bounce-angle independant
 and explicit bounce-angle dependant components for the Hamiltonian perturbation
:
\begin_inset Formula \begin{equation}
\delta H=\frac{J^{2}}{mr_{\mathrm{e}}^{2}}\left(-\frac{59}{16}-\frac{41}{12}\cos2\zeta+\frac{13}{48}\cos4\zeta\right).\label{eq:deltaH}\end{equation}

\end_inset

This perturbation will be considered small if
\begin_inset Formula \begin{equation}
\frac{J^{2}/mr_{\mathrm{e}}^{2}}{J\omega_{\mathrm{b}}}=\frac{J\omega_{\mathrm{b}}}{m\omega_{\mathrm{b}}^{2}r_{\mathrm{e}}^{2}}=\frac{1}{2}\frac{s_{\mathrm{b}}^{2}}{r_{\mathrm{e}}^{2}}\ll1,\end{equation}

\end_inset

which is satisfied in the deeply trapped approximation.
 Lie transform perturbation analysis analogous to the bounce-center transformati
on can therefore be used with 
\begin_inset Formula $\epsilon_{\mathrm{t}}\equiv\left(s_{\mathrm{b}}/r_{\mathrm{e}}\right)^{2}$
\end_inset

 as the small parameter.
 The coordinate transformation 
\begin_inset Formula $Z^{\alpha}\equiv\left(J,\zeta\right)\rightarrow\wh Z^{\alpha}\equiv\left(\wh J,\wh{\zeta}\right)$
\end_inset

 reads
\begin_inset Formula \begin{equation}
\wh Z^{\alpha}=Z^{\alpha}+\epsilon_{\mathrm{t}}\left\{ \wh S_{1},Z^{\alpha}\right\} _{J,\zeta}+\ldots\end{equation}

\end_inset

where 
\begin_inset Formula $\wh S_{1}\left(J,\zeta\right)$
\end_inset

 is a gauge function designed to restore the bounce-angle independence.
 Note that unlike the bounce-center transformation 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:bc_zalpha"

\end_inset

, the flux coordinates 
\begin_inset Formula $\left(\psi,\phi\right)$
\end_inset

 are frozen, i.e.
 only the parallel motion in phase space is considered.
 Using the Lie transform formalism, we build a new bounce-angle independent
 Hamiltonian
\begin_inset Formula \begin{equation}
\wh H\equiv\wh H_{0}+\epsilon_{\mathrm{t}}\wh H_{1}+\ldots=\mathsf{T}_{\epsilon}^{-1}H=H_{0}+\epsilon_{\mathrm{t}}\left(H_{1}-\left\{ \wh S_{1},H_{0}\right\} _{J,\zeta}\right)+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right).\end{equation}

\end_inset

The Poisson bracket reads
\begin_inset Formula \begin{equation}
\left\{ \wh S_{1},H_{0}\right\} _{J,\zeta}=\pd{\wh S_{1}}{\zeta}\pd{H_{0}}J-\pd{\wh S_{1}}J\pd{H_{0}}{\zeta}=\omega_{\mathrm{b}}\pd{\wh S_{1}}{\zeta}.\end{equation}

\end_inset

We therefore have the following identities,
\begin_inset Formula \begin{equation}
\wh H_{0}=H_{0}=\mu B_{\mathrm{e}}+\wh J\omega_{\mathrm{b}},\end{equation}

\end_inset

 and
\begin_inset Formula \begin{equation}
\wh H_{1}=H_{1}-\omega_{\mathrm{b}}\pd{\wh S_{1}}{\zeta}.\end{equation}

\end_inset

Since 
\begin_inset Formula $\wh H_{1}$
\end_inset

 must be bounce-angle independent, if we denote 
\begin_inset Formula $\left\langle H_{1}\right\rangle _{\mathrm{b}}$
\end_inset

 the bounce-averaged component of the first-order perturbation and 
\begin_inset Formula $\wt H_{1}$
\end_inset

 the explicitly bounce-angle dependent component, we have
\begin_inset Formula \begin{equation}
\wh H_{1}=\left\langle H_{1}\right\rangle _{\mathrm{b}}=-\frac{59}{16}\frac{J^{2}}{mr_{\mathrm{e}}^{2}},\end{equation}

\end_inset

 and
\begin_inset Formula \begin{equation}
\wh S_{1}=\frac{1}{\omega_{\mathrm{b}}}\int\wt H_{1}d\zeta=\frac{J^{2}}{24m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(-41\sin2\zeta+\frac{13}{8}\sin4\zeta\right).\label{eq:S1hat}\end{equation}

\end_inset

From 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:S1hat"

\end_inset

, new expressions 
\begin_inset Formula $\left(\wh J,\wh{\zeta}\right)$
\end_inset

 for the bounce action and angle are obtained, at first order in the Hamiltonian
 perturbation.
 These read
\begin_inset Formula \begin{align}
\wh J=J+\epsilon_{\mathrm{t}}\left\{ \wh S_{1},J\right\} _{J,\zeta}= & J+\epsilon_{\mathrm{t}}\pd{\wh S_{1}}{\zeta}\nonumber \\
= & J+\epsilon_{\mathrm{t}}\frac{J^{2}}{12m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(-41\cos2\zeta+\frac{13}{4}\cos4\zeta\right),\label{eq:Jhat}\end{align}

\end_inset

 and
\begin_inset Formula \begin{align}
\wh{\zeta}=\zeta+\epsilon_{\mathrm{t}}\left\{ \wh S_{1},\zeta\right\} _{J,\zeta}= & \zeta-\epsilon_{\mathrm{t}}\pd{\wh S_{1}}J\nonumber \\
= & \zeta+\epsilon_{\mathrm{t}}\frac{J}{12m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(41\sin2\zeta-\frac{13}{8}\sin4\zeta\right).\label{eq:zetahat}\end{align}

\end_inset

The new Hamiltonian reads, at first order in the perturbation :
\begin_inset Formula \begin{equation}
\wh H=\mu B_{\mathrm{e}}+\wh J\omega_{\mathrm{b}}-\epsilon_{\mathrm{t}}\frac{59}{16}\frac{\wh J^{2}}{mr_{\mathrm{e}}^{2}}\label{eq:Hhat}\end{equation}

\end_inset

In order to prove that the bounce action is an adiabatic invariant at first
 order in the Hamiltonian perturbation, we calculate 
\begin_inset Formula $\dot{\wh J}$
\end_inset

:
\begin_inset Formula \begin{equation}
\dot{\wh J}=\left\{ \wh J,H\right\} _{J,\zeta}=\dot{J}+\epsilon_{\mathrm{t}}\frac{J}{6m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left[\dot{J}\left(-41\cos2\zeta+\frac{13}{4}\cos4\zeta\right)-\dot{\zeta}J\left(-41\sin2\zeta+\frac{13}{2}\sin4\zeta\right)\right]\label{eq:dotJhat}\end{equation}

\end_inset

The derivatives 
\begin_inset Formula $\dot{J}$
\end_inset

 and 
\begin_inset Formula $\dot{\zeta}$
\end_inset

 are taken from Hamilton's equations:
\begin_inset Formula \begin{equation}
\dot{J}=-\pd H{\zeta}=\epsilon_{\mathrm{t}}\frac{J^{2}}{6mr_{\mathrm{e}}^{2}}\left(-41\sin2\zeta+\frac{13}{2}\sin4\zeta\right)\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\dot{\zeta}=\pd HJ=\omega_{\mathrm{b}}-\epsilon_{\mathrm{t}}\frac{59}{8}\frac{J}{mr_{\mathrm{e}}^{2}}\end{equation}

\end_inset

Inserting these expressions into 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dotJhat"

\end_inset

 gives
\begin_inset Formula \begin{equation}
\dot{\wh J}=\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right).\end{equation}

\end_inset

Parallel coordinates are also given first-order corrections:
\begin_inset Formula \begin{align}
\wh{p_{\|}}= & p_{\|}+\epsilon_{\mathrm{t}}\left\{ \wh S_{1},p_{\|}\right\} _{J,\zeta}\nonumber \\
= & p_{\|}\left[1+\epsilon_{\mathrm{t}}\frac{J}{12m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(\frac{1}{2}\left[-41\cos2\zeta+\frac{13}{4}\cos4\zeta\right]-\left[-41\sin2\zeta+\frac{13}{8}\sin4\zeta\right]\cot\zeta\right)\right]\label{eq:pparhat}\end{align}

\end_inset


\begin_inset Formula \begin{align}
\widehat{s}= & s+\epsilon_{\mathrm{t}}\left\{ \wh S_{1},s\right\} _{J,\zeta}\nonumber \\
= & s\left[1+\epsilon_{\mathrm{t}}\frac{J}{12m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(\frac{1}{2}\left[-41\cos2\zeta+\frac{13}{4}\cos4\zeta\right]+\left[-41\sin2\zeta+\frac{13}{8}\sin4\zeta\right]\tan\zeta\right)\right]\label{eq:shat}\end{align}

\end_inset

We can verify that 
\begin_inset Formula $\left(\wh s,\wh{p_{\|}}\right)\to\left(\wh J,\wh{\zeta}\right)$
\end_inset

 is a canonical transformation at first order in 
\begin_inset Formula $\epsilon_{\mathrm{t}}$
\end_inset

, writing
\begin_inset Formula \begin{align}
\left\{ \wh s,\wh{p_{\|}}\right\} _{J,\zeta}= & \pd{\wh s}{\zeta}\pd{\wh{p_{\|}}}J-\pd{\wh s}J\pd{\wh{p_{\|}}}{\zeta}\nonumber \\
= & \sin^{2}\zeta+\cos^{2}\zeta=1+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right).\label{eq:shatpparhat_canonical}\end{align}

\end_inset

Inserting the expressions for 
\begin_inset Formula $\wh J\left(J,\zeta\right)$
\end_inset

 and 
\begin_inset Formula $\wh{\zeta}\left(J,\zeta\right)$
\end_inset

, the parallel coordinates read
\begin_inset Formula \begin{align}
\wh{p_{\|}}= & -\sqrt{2\wh Jm\omega_{\mathrm{b}}}\sin\wh{\zeta}+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right)\label{eq:ppar_deephat}\\
\widehat{s}= & \sqrt{\frac{2\wh J}{m\omega_{\mathrm{b}}}}\cos\wh{\zeta}+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right)\label{eq:s_deephat}\end{align}

\end_inset

We therefore retain harmonic oscillator expressions for parallel coordinates,
 but with an anharmonic Hamiltonian.
 Furthermore, one can immediately verify that
\begin_inset Formula \begin{align}
\left\{ \wh s,\wh{p_{\|}}\right\} _{\wh J,\wh{\zeta}}= & \pd{\wh s}{\wh{\zeta}}\pd{\wh{p_{\|}}}{\wh J}-\pd{\wh s}{\wh J}\pd{\wh{p_{\|}}}{\wh{\zeta}}\nonumber \\
= & \sin^{2}\wh{\zeta}+\cos^{2}\wh{\zeta}=1+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{2}\right).\label{eq:shatpparhat_canonicalhat}\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Bounce-center coordinates
\end_layout

\begin_layout Standard
The first-order generating vector for the bounce-center transformation is
 calculated using the expressions for the deeply-trapped action-angle coordinate
s.
 Since 
\begin_inset Formula $\psi$
\end_inset

 (due to the axisymmetric dipole magnetic field) and 
\begin_inset Formula $\mathcal{E}$
\end_inset

 (due to energy conservation) are exact invariants and 
\begin_inset Formula $\mu$
\end_inset

 (due to guiding-center motion) is an adiabatic invariant and using the
 axisymmetry of the problem, we can readily deduce
\begin_inset Formula \begin{equation}
\dot{\wh J}\left(\psi,\phi,\mu,\mathcal{E}\right)\equiv\dot{\psi}\pd{\wh J}{\psi}+\dot{\phi}\pd{\wh J}{\phi}+\dot{\mathcal{E}}\pd{\wh J}{\mathcal{E}}+\dot{\mu}\pd{\wh J}{\mu}\equiv0.\label{eq:Jhatdot}\end{equation}

\end_inset

The expression for 
\begin_inset Formula $\mathsf{G}_{1}^{J}$
\end_inset

 taken from Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:G1alpha"

\end_inset

 therefore becomes
\begin_inset Formula \begin{equation}
\mathsf{G}_{1}^{J}=0.\label{eq:G1J}\end{equation}

\end_inset

Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:phi_dot"

\end_inset

 is used to obtain the expression for 
\begin_inset Formula $\mathsf{G}_{1}^{\phi}$
\end_inset

.
 Since at constant 
\begin_inset Formula $\wh J$
\end_inset

, 
\begin_inset Formula $\omega_{\mathrm{b}}^{-1}d\wh{\zeta}=md\wh s/\wh p_{\|}$
\end_inset

, the expression becomes
\begin_inset Formula \begin{equation}
\mathsf{G}_{1}^{\phi}=\frac{c\mu}{q\omega_{\mathrm{b}}}\int\left(\left\langle \pd B{\psi}\right\rangle _{\mathrm{b}}-\pd B{\psi}\right)d\wh{\zeta}-\frac{c}{q}a\wh{p_{\|}}\label{eq:G1phi_deep}\end{equation}

\end_inset

where 
\begin_inset Formula $\left\langle \;\right\rangle _{\mathrm{b}}$
\end_inset

 denotes the bounce-averaging with respect to the bounce-angle 
\begin_inset Formula $\wh{\zeta}$
\end_inset

.
 The flux derivative 
\begin_inset Formula $\partial B/\partial\psi$
\end_inset

 is obtained through Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:B_sigma"

\end_inset

 by replacing 
\begin_inset Formula $\sigma$
\end_inset

 with 
\begin_inset Formula $\wh s$
\end_inset

.
 It reads
\begin_inset Formula \begin{equation}
\pd B{\psi}=\frac{3}{r_{\mathrm{e}}^{2}}\left(1+\frac{15}{2}\left(\frac{\wh s}{r_{\mathrm{e}}}\right)^{2}+\ldots\right).\end{equation}

\end_inset

The flux component 
\begin_inset Formula $a$
\end_inset

 of the unitary dipole vector expands as
\begin_inset Formula \begin{equation}
a=\frac{\widehat{s}}{\psi}+\mathcal{O}\left(\epsilon_{\mathrm{t}}^{\frac{3}{2}}\right).\end{equation}

\end_inset

Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:G1phi_deep"

\end_inset

 becomes, with 
\begin_inset Formula $\psi=B_{\mathrm{e}}r_{\mathrm{e}}^{2}$
\end_inset

,
\begin_inset Formula \begin{equation}
\mathsf{G}_{1}^{\phi}=\frac{c}{2q\psi\omega_{\mathrm{b}}}\left[\frac{45}{2}\frac{\mu B_{\mathrm{e}}}{m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\left(m\omega_{\mathrm{b}}\wh s^{2}-\frac{\wh{p_{\|}}^{2}}{m\omega_{\mathrm{b}}}\right)-\wh s\wh{p_{\|}}\right].\label{eq:G1phishatpparhat}\end{equation}

\end_inset

Using the explicit expressions 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:ppar_deephat"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:s_deephat"

\end_inset

, we find
\begin_inset Formula \begin{equation}
\mathsf{G}_{1}^{\phi}=\frac{c\wh J}{q\psi\omega_{\mathrm{b}}}\left(\frac{45}{4}\frac{\mu B_{\mathrm{e}}}{m\omega_{\mathrm{b}}r_{\mathrm{e}}^{2}}\cos2\wh{\zeta}+\sin2\wh{\zeta}\right).\label{eq:G1phiJhatzetahat}\end{equation}

\end_inset

Note that the bounce-averaged first-order correction 
\begin_inset Formula $\left\langle \mathsf{G}_{1}^{\phi}\right\rangle _{\mathrm{b}}=0$
\end_inset

, as expected.
\end_layout

