******* a finir******Averaging therefore gives :
\begin_inset Formula \begin{eqnarray}
\left\langle \mathcal{C}_{p}\right\rangle _{\mathcal{O}} & = & \frac{1}{p^{2}}\frac{B^{\theta}}{B}\left|\frac{\xi}{\xi_{0}}\right|\frac{\partial}{\partial p}\left[p^{2}\left(-\left\langle \mathcal{K}_{gc}^{p}\right\rangle _{\mathcal{O}}\overline{F}+\left\{ \mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\psi\right\} \frac{\partial\overline{F}}{\partial\psi}+\left\{ \mathcal{D}_{gc}^{pp}\right\} \frac{\partial\overline{F}}{\partial p}\right.\right.\nonumber \\
 &  & \left.\left.+\left[\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{p\xi}\right\} +\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\Psi\right\} \right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\label{eq:-10}\end{eqnarray}

