\begin_body

\begin_layout Title
Bounce-averaged collision guiding-center operator in the low collisionality
 approximation and axisymmetric geometry
\end_layout

\begin_layout Author
François-Xavier DUTHOIT
\end_layout

\begin_layout Standard
\begin_inset FormulaMacro
\renewcommand{\bhat}{\widehat{\mathsf{b}}}
\end_inset


\begin_inset FormulaMacro
\renewcommand{\extd}{\mathsf{d}}
\end_inset


\end_layout

\begin_layout Section
Coordinate transformation for the guiding-center collision operator
\end_layout

\begin_layout Subsection
\begin_inset Formula $\xi\rightarrow\xi_{0}$
\end_inset

 Coordinate transformation
\end_layout

\begin_layout Standard
Due to the conservation of the magnetic moment, we have the following relation,
 zero indices indicating the values at the minimum field point :
\begin_inset Formula \begin{equation}
1-\xi^{2}=\Psi\left(1-\xi_{0}^{2}\right)\end{equation}

\end_inset

where 
\begin_inset Formula $\Psi=B/B_{0}$
\end_inset

.
 
\begin_inset Formula $\xi_{0}$
\end_inset

 is defined as a positive variable for trapped particles ; i.e.
 
\begin_inset Formula $\xi_{0}=\sqrt{1-\Psi^{-1}\left(1-\xi^{2}\right)}$
\end_inset

.
 We can therefore deduce, noting 
\begin_inset Formula $\nabla$
\end_inset

 the spatial gradient operator :
\begin_inset Formula \begin{equation}
\extd\xi_{0}\equiv\nabla\xi_{0}\cdot\extd\mathbf{X}+\frac{\partial\xi_{0}}{\partial\xi}\extd\xi=\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\extd\mathbf{X}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\extd\xi\end{equation}

\end_inset

The Jacobian for the transformation reads :
\begin_inset Formula \begin{equation}
J=\left|\frac{\partial\xi_{0}}{\partial\xi}\right|^{-1}=\Psi\frac{\xi_{0}}{\left|\xi\right|}\end{equation}

\end_inset

The guiding-center Jacobian therefore reads :
\begin_inset Formula \begin{equation}
\boxed{\mathcal{J}_{gc}=p^{2}\Psi\frac{\xi_{0}}{\left|\xi\right|}}\end{equation}

\end_inset

The spatial Jacobian 
\begin_inset Formula $\mathcal{V}$
\end_inset

 in 
\begin_inset Formula $\left(\psi,s,\phi\right)$
\end_inset

 coordinates reads, defining 
\begin_inset Formula $\psi$
\end_inset

 as the poloidal flux coordinate, 
\begin_inset Formula $s$
\end_inset

 as the coordinate along the poloidal field line and 
\begin_inset Formula $B_{P}$
\end_inset

 the poloidal magnetic field :
\begin_inset Formula \begin{equation}
\mathcal{V}=\left(\nabla\psi\times\nabla\phi\cdot\nabla s\right)^{-1}=\frac{1}{B_{P}}=\boxed{\frac{1}{B_{0}\Psi}\frac{B}{B_{P}}}\end{equation}

\end_inset

We can note that in magnetic configurations where 
\begin_inset Formula $\mathbf{B}\cdot\nabla\phi=0$
\end_inset

, we have 
\begin_inset Formula $B=B_{P}$
\end_inset

.
 We can also deduce the total Jacobian :
\begin_inset Formula \begin{equation}
\boxed{\mathcal{J}_{gc}\mathcal{V}=\frac{p^{2}}{B_{0}}\frac{B}{B_{P}}\frac{\xi_{0}}{\left|\xi\right|}}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Guiding-center coefficients
\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{K}_{gc}^{\xi_{0}}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{K}_{gc}^{\xi_{0}}$
\end_inset

 reads :
\begin_inset Formula \begin{eqnarray}
\mathcal{K}_{gc}^{\xi_{0}} & = & \nabla\xi_{0}\cdot\mathcal{K}_{gc}^{\mathbf{X}}+\frac{\partial\xi_{0}}{\partial\xi}\mathcal{K}_{gc}^{\xi}\nonumber \\
 & = & \boxed{\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{K}_{gc}^{\xi}}\label{eq:-3}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\mathbf{X}}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\mathbf{X}}$
\end_inset

 reads :
\begin_inset Formula \begin{eqnarray}
\mathcal{D}_{gc}^{\xi_{0}\mathbf{X}} & = & \nabla\xi_{0}\cdot\mathcal{D}_{gc}^{\mathbf{XX}}+\frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi\mathbf{X}}\nonumber \\
 & = & \boxed{\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}}\label{eq:-5}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}p}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}p}$
\end_inset

 reads :
\begin_inset Formula \begin{eqnarray}
\mathcal{D}_{gc}^{\xi_{0}p} & = & \nabla\xi_{0}\cdot\mathcal{D}_{gc}^{\mathbf{X}p}+\frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi p}\nonumber \\
 & = & \boxed{\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi p}}\label{eq:}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsubsection
Calculation of 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\xi_{0}}$
\end_inset


\end_layout

\begin_layout Standard
The expression for 
\begin_inset Formula $\mathcal{D}_{gc}^{\xi_{0}\xi_{0}}$
\end_inset

 reads, at first order in 
\begin_inset Formula $\epsilon_{B}$
\end_inset

 :
\begin_inset Formula \begin{eqnarray}
\mathcal{D}_{gc}^{\xi_{0}\xi_{0}} & = & \nabla\xi_{0}\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\xi_{0}+\mathcal{D}_{gc}^{\xi\xi}\left(\frac{\partial\xi_{0}}{\partial\xi}\right)^{2}+2\frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\xi_{0}\nonumber \\
 & \simeq & \mathcal{D}_{gc}^{\xi\xi}\left(\frac{\partial\xi_{0}}{\partial\xi}\right)^{2}+2\frac{\partial\xi_{0}}{\partial\xi}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\xi_{0}\nonumber \\
 & = & \boxed{\mathcal{D}_{gc}^{\xi\xi}\left(\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\right)^{2}+\frac{1-\xi_{0}^{2}}{\xi_{0}}\frac{1}{\Psi^{2}}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\Psi}\label{eq:-1}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Collision operator
\end_layout

\begin_layout Standard
The expression for the guiding-center collision operator in 
\begin_inset Formula $\left(\mathbf{x},p,\xi_{0}\right)$
\end_inset

 coordinates reads :
\begin_inset Formula \begin{eqnarray}
C_{gc}\left[\overline{F}\right] & = & -\frac{1}{\mathcal{V}\mathcal{J}_{gc}}\frac{\partial}{\partial z^{\alpha}}\left[\mathcal{V}\mathcal{J}_{gc}\left(\mathcal{K}_{gc}^{\alpha}\overline{F}-\mathcal{D}_{gc}^{\alpha\beta}\frac{\partial\overline{F}}{\partial z^{\beta}}\right)\right]\nonumber \\
 & = & -\frac{1}{p^{2}}\frac{\partial}{\partial p}\left[p^{2}\left(\mathcal{K}_{gc}^{p}\overline{F}-\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\overline{F}-\mathcal{D}_{gc}^{pp}\frac{\partial\overline{F}}{\partial p}-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\Psi+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{p\xi}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\nonumber \\
 &  & -\frac{\left|\xi\right|}{\xi_{0}}\frac{\partial}{\partial\xi_{0}}\left[\frac{\xi_{0}}{\left|\xi\right|}\left(\left[-\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{K}_{gc}^{\xi}\right]\overline{F}-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\right]\cdot\nabla\overline{F}\right.\right.\nonumber \\
 &  & \left.\left.-\left[-\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi p}\right]\frac{\partial\overline{F}}{\partial p}-\left[\frac{1}{\Psi^{2}}\frac{\xi^{2}}{\xi_{0}^{2}}\mathcal{D}_{gc}^{\xi\xi}+\frac{1-\xi_{0}^{2}}{\xi_{0}}\frac{1}{\Psi^{2}}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\Psi\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\nonumber \\
 &  & -\frac{1}{\Psi}\frac{\left|\xi\right|}{\xi_{0}}\nabla\cdot\left[\Psi\frac{\xi_{0}}{\left|\xi\right|}\left(\mathcal{K}_{gc}^{\mathbf{X}}\overline{F}-\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\overline{F}-\mathcal{D}_{gc}^{\mathbf{X}p}\frac{\partial\overline{F}}{\partial p}-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\Psi+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\mathbf{X}\xi}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\label{eq:-2}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Section
Bounce-averaging operation
\end_layout

\begin_layout Subsection
Bounce time
\end_layout

\begin_layout Standard
The bounce time 
\begin_inset Formula $\tau_{b}$
\end_inset

 is defined as half a bounce period.
 Its expression reads, 
\begin_inset Formula $v_{s}$
\end_inset

 being the velocity along the poloidal field line :
\begin_inset Formula \begin{equation}
\tau_{b}\left(\psi,\xi_{0}\right)=\int_{s_{min}}^{s_{max}}\frac{ds}{\left|v_{s}\right|}=\int_{s_{min}}^{s_{max}}\frac{ds}{\left|v_{\parallel}\right|}\frac{B}{B_{P}}=\frac{1}{v\xi_{0}}\int_{s_{min}}^{s_{max}}ds\frac{B}{B_{P}}\frac{\xi_{0}}{\left|\xi\right|}\end{equation}

\end_inset

We normalize the bounce time as follows :
\begin_inset Formula \begin{equation}
\tau_{b}\left(\psi,\xi_{0}\right)=\frac{\Lambda_{0}}{v\xi_{0}}\lambda\left(\psi,\xi_{0}\right)\end{equation}

\end_inset

where
\begin_inset Formula \begin{equation}
\lambda\left(\psi,\xi_{0}\right)=\frac{1}{\Lambda_{0}\left(\psi\right)}\int_{s_{min}}^{s_{max}}ds\frac{B}{B_{P}}\frac{\xi_{0}}{\left|\xi\right|}\end{equation}

\end_inset

is the normalized bounce time with respect to particles with parallel momentum
 only, so that 
\begin_inset Formula $\lambda\left(\psi,\pm1\right)=1$
\end_inset

.
 
\begin_inset Formula $\Lambda_{0}$
\end_inset

 corresponds to the connection length, defined as the length of the magnetic
 poloidal field line at 
\begin_inset Formula $\psi$
\end_inset

.
 It reads :
\begin_inset Formula \begin{equation}
\Lambda_{0}\left(\psi\right)\equiv\oint_{L}\frac{B}{B_{P}}ds\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Bounce average
\end_layout

\begin_layout Standard
We introduce the following expression for the bounce-average :
\begin_inset Formula \begin{equation}
\left\{ A\right\} =\frac{1}{\tau_{b}}\left[\frac{1}{2}\sum_{\sigma}\right]_{T}\int_{s_{min}}^{s_{max}}\frac{ds}{\left|v_{s}\right|}A\end{equation}

\end_inset

where 
\begin_inset Formula $\left[\frac{1}{2}\sum_{\sigma}\right]_{T}$
\end_inset

 applies to trapped particles, 
\begin_inset Formula $\sigma=\frac{\xi_{0}}{\left|\xi_{0}\right|}$
\end_inset

 being the pitch-angle sign.
 The expression becomes :
\begin_inset Formula \begin{eqnarray}
\left\{ A\right\}  & = & \frac{1}{\tau_{b}}\left[\frac{1}{2}\sum_{\sigma}\right]_{T}\int_{s_{min}}^{s_{max}}\frac{ds}{\left|v_{\parallel}\right|}\frac{B}{B_{P}}A\nonumber \\
 & = & \boxed{\frac{1}{\Lambda_{0}\lambda}\left[\frac{1}{2}\sum_{\sigma}\right]_{T}\int_{s_{min}}^{s_{max}}ds\frac{B}{B_{P}}\frac{\xi_{0}}{\left|\xi\right|}A}\label{eq:-7}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Section
Bounce-averaged collision operator
\end_layout

\begin_layout Standard
In this section, we will use the expression for the spatial gradient of
 the guiding-center distribution function.
 Using the axisymmetry and low collisonality properties, we have 
\begin_inset Formula $\frac{\partial\overline{F}}{\partial s}=\frac{\partial\overline{F}}{\partial\phi}=0$
\end_inset

.
 We therefore have :
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\nabla\overline{F}\equiv\frac{\partial\overline{F}}{\partial\psi}\nabla\psi+\frac{\partial\overline{F}}{\partial s}\nabla s+\frac{\partial\overline{F}}{\partial\phi}\nabla\phi=\frac{\partial\overline{F}}{\partial\psi}\nabla\psi\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Momentum component
\end_layout

\begin_layout Standard
The momentum component of the collision operator reads :
\begin_inset Formula \begin{equation}
\mathcal{C}_{p}=-\frac{1}{p^{2}}\frac{\partial}{\partial p}\left[p^{2}\left(\mathcal{K}_{gc}^{p}\overline{F}-\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\overline{F}-\mathcal{D}_{gc}^{pp}\frac{\partial\overline{F}}{\partial p}-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\Psi+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{p\xi}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\end{equation}

\end_inset

Averaging therefore gives :
\begin_inset Formula \begin{eqnarray}
\left\{ \mathcal{C}_{p}\right\}  & = & \frac{1}{p^{2}}\frac{\partial}{\partial p}\left[p^{2}\left(-\left\{ \mathcal{K}_{gc}^{p}\right\} \overline{F}+\left\{ \mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\psi\right\} \frac{\partial\overline{F}}{\partial\psi}+\left\{ \mathcal{D}_{gc}^{pp}\right\} \frac{\partial\overline{F}}{\partial p}\right.\right.\nonumber \\
 &  & \left.\left.+\left[\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{p\xi}\right\} +\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\Psi\right\} \right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\label{eq:-10}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Pitch-angle component
\end_layout

\begin_layout Standard
The pitch-angle component of the collision operator reads :
\begin_inset Formula \begin{eqnarray}
\mathcal{C}_{\xi_{0}} & = & -\frac{\left|\xi\right|}{\xi_{0}}\frac{\partial}{\partial\xi_{0}}\left[\frac{\xi_{0}}{\left|\xi\right|}\left(\left[\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{K}_{gc}^{\xi}\right]\overline{F}\right.\right.\nonumber \\
 &  & -\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\right]\cdot\nabla\overline{F}\nonumber \\
 &  & -\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi p}\right]\frac{\partial\overline{F}}{\partial p}\nonumber \\
 &  & \left.\left.-\left[\frac{1}{\Psi^{2}}\frac{\xi^{2}}{\xi_{0}^{2}}\mathcal{D}_{gc}^{\xi\xi}+\frac{1-\xi_{0}^{2}}{\xi_{0}}\frac{1}{\Psi^{2}}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\Psi\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\label{eq:-4}\end{eqnarray}

\end_inset

Averaging therefore gives :
\begin_inset Formula \begin{eqnarray}
\left\{ \mathcal{C}_{\xi_{0}}\right\}  & = & \frac{1}{\lambda}\frac{\partial}{\partial\xi_{0}}\left[\lambda\left(\left[-\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\nabla\Psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}\right\} -\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{K}_{gc}^{\xi}\right\} \right]\overline{F}\right.\right.\nonumber \\
 &  & +\left[\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\psi\right\} +\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\psi\right\} \right]\frac{\partial\overline{F}}{\partial\psi}\nonumber \\
 &  & +\left[\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi p}\right\} +\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}\right\} \right]\frac{\partial\overline{F}}{\partial p}\nonumber \\
 &  & \left.\left.+\left[\left\{ \frac{1}{\Psi^{2}}\frac{\xi^{2}}{\xi_{0}^{2}}\mathcal{D}_{gc}^{\xi\xi}\right\} +\frac{1-\xi_{0}^{2}}{\xi_{0}}\left\{ \frac{1}{\Psi^{2}}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\Psi\right\} \right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\label{eq:-6}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Subsection
Spatial component
\end_layout

\begin_layout Standard
The spatial component of the collision operator reads, inserting the spatial
 Jacobian 
\begin_inset Formula $\mathcal{V}$
\end_inset

 :
\begin_inset Formula \begin{eqnarray}
\mathcal{C}_{\mathbf{X}} & = & -B_{0}\frac{B_{P}}{B}\frac{\left|\xi\right|}{\xi_{0}}\frac{\partial}{\partial\psi}\left[\frac{1}{B_{0}}\frac{B}{B_{P}}\frac{\xi_{0}}{\left|\xi\right|}\left(\nabla\psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}\overline{F}-\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\overline{F}-\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}\frac{\partial\overline{F}}{\partial p}\right.\right.\nonumber \\
 &  & \left.\left.-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\Psi+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}\xi}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\nonumber \\
 &  & -\frac{B_{P}}{B}\frac{\left|\xi\right|}{\xi_{0}}\frac{\partial}{\partial s}\left[\frac{B}{B_{P}}\frac{\xi_{0}}{\left|\xi\right|}\left(\nabla s\cdot\mathcal{K}_{gc}^{\mathbf{X}}\overline{F}-\nabla s\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\overline{F}-\nabla s\cdot\mathcal{D}_{gc}^{\mathbf{X}p}\frac{\partial\overline{F}}{\partial p}\right.\right.\nonumber \\
 &  & \left.\left.-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla s\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\Psi+\frac{1}{\Psi}\frac{\xi}{\xi_{0}}\nabla s\cdot\mathcal{D}_{gc}^{\mathbf{X}\xi}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\label{eq:-8}\end{eqnarray}

\end_inset

Averaging therefore gives :
\begin_inset Formula \begin{eqnarray}
\left\{ \mathcal{C}_{\mathbf{X}}\right\}  & = & \frac{B_{0}}{\Lambda_{0}\lambda}\frac{\partial}{\partial\psi}\left[\frac{\Lambda_{0}\lambda}{B_{0}}\left(-\left\{ \nabla\psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}\right\} \overline{F}+\left\{ \nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\psi\right\} \frac{\partial\overline{F}}{\partial\psi}+\left\{ \nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}\right\} \frac{\partial\overline{F}}{\partial p}\right.\right.\nonumber \\
 &  & \left.\left.+\left[\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\Psi\right\} +\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}\xi}\right\} \right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\label{eq:-9}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Section
Expression in LUKE formalism
\end_layout

\begin_layout Standard
The simulation code LUKE notes the Fokker-Planck equation as :
\begin_inset Formula \begin{equation}
\frac{df^{\left(0\right)}}{dt}=\frac{\partial f^{\left(0\right)}}{\partial t}+\nabla^{\left(0\right)}\cdot\mathbf{S}^{\left(0\right)}=s_{+}^{\left(0\right)}-s_{-}^{\left(0\right)}\end{equation}

\end_inset

where all quantities are calculated in bounce-averaged 
\begin_inset Formula $\left(\psi,p,\xi_{0}\right)$
\end_inset

 space.
 
\begin_inset Formula $f^{\left(0\right)}$
\end_inset

 is the bounce-averaged distribution function, 
\begin_inset Formula $\mathbf{S}^{\left(0\right)}=\mathbf{F}^{\left(0\right)}f^{\left(0\right)}-\mathbb{D}^{\left(0\right)}\cdot\nabla^{\left(0\right)}f^{\left(0\right)}$
\end_inset

 the bounce-averaged flux and 
\begin_inset Formula $s_{+}^{\left(0\right)}$
\end_inset

 and 
\begin_inset Formula $s_{-}^{\left(0\right)}$
\end_inset

 the respective external sources and sinks.
 The phase-space gradient operator 
\begin_inset Formula $\nabla^{\left(0\right)}$
\end_inset

 is defined as follows :
\begin_inset Formula \begin{equation}
\nabla^{\left(0\right)}=\left(\begin{array}{c}
\left|\nabla\psi\right|_{0}\frac{\partial}{\partial\psi}\\
\frac{\partial}{\partial p}\\
-\frac{\sqrt{1-\xi_{0}^{2}}}{p}\frac{\partial}{\partial\xi_{0}}\end{array}\right)\end{equation}

\end_inset

This leads to the following expression for the flux divergence, inserting
 the guiding-center bounce-average Jacobian 
\begin_inset Formula $\mathcal{J}=\Lambda_{0}\lambda p^{2}/B_{0}$
\end_inset

 :
\begin_inset Formula \begin{equation}
\nabla^{\left(0\right)}\cdot\mathbf{S}^{\left(0\right)}=\frac{B_{0}}{\Lambda_{0}\lambda}\frac{\partial}{\partial\psi}\left(\frac{\Lambda_{0}\lambda}{B_{0}}\left|\nabla\psi\right|_{0}S_{\psi}^{\left(0\right)}\right)+\frac{1}{p^{2}}\frac{\partial}{\partial p}\left(p^{2}S_{p}^{\left(0\right)}\right)-\frac{1}{\lambda p}\frac{\partial}{\partial\xi_{0}}\left(\lambda\sqrt{1-\xi_{0}^{2}}S_{\xi}^{\left(0\right)}\right)\end{equation}

\end_inset

with the following definitions :
\begin_inset Formula \begin{eqnarray}
S_{\psi}^{\left(0\right)} & = & F_{\psi}^{\left(0\right)}f^{\left(0\right)}-\left|\nabla\psi\right|_{0}D_{\psi\psi}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial\psi}-D_{\psi p}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial p}+\frac{\sqrt{1-\xi_{0}^{2}}}{p}D_{\psi\xi}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial\xi_{0}}\\
S_{p}^{\left(0\right)} & = & F_{p}^{\left(0\right)}f^{\left(0\right)}-\left|\nabla\psi\right|_{0}D_{p\psi}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial\psi}-D_{pp}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial p}+\frac{\sqrt{1-\xi_{0}^{2}}}{p}D_{p\xi}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial\xi_{0}}\\
S_{\xi}^{\left(0\right)} & = & F_{\xi}^{\left(0\right)}f^{\left(0\right)}-\left|\nabla\psi\right|_{0}D_{\xi\psi}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial\psi}-D_{\xi p}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial p}+\frac{\sqrt{1-\xi_{0}^{2}}}{p}D_{\xi\xi}^{\left(0\right)}\frac{\partial f^{\left(0\right)}}{\partial\xi_{0}}\end{eqnarray}

\end_inset

We can therefore deduce the following expression for the drag vector components,
 using the previous expressions for the collision operator 
\begin_inset Formula $\left\{ C\left[f^{\left(0\right)}\right]\right\} \equiv-\nabla^{\left(0\right)}\cdot\mathbf{S}^{\left(0\right)}$
\end_inset

:
\begin_inset Formula \begin{eqnarray}
F_{\psi}^{\left(0\right)} & = & \frac{1}{\left|\nabla\psi\right|_{0}}\left\{ \nabla\psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}\right\} \\
F_{p}^{\left(0\right)} & = & \left\{ \mathcal{K}_{gc}^{p}\right\} \\
F_{\xi}^{\left(0\right)} & = & -\frac{p}{\sqrt{1-\xi_{0}^{2}}}\left[\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\nabla\Psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}\right\} +\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{K}_{gc}^{\xi}\right\} \right]\end{eqnarray}

\end_inset

The diffusion tensor components read :
\begin_inset Formula \begin{eqnarray}
D_{\psi\psi}^{\left(0\right)} & = & \frac{1}{\left|\nabla\psi\right|_{0}^{2}}\left\{ \nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\psi\right\} \\
D_{\psi p}^{\left(0\right)} & = & \frac{1}{\left|\nabla\psi\right|_{0}}\left\{ \nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}\right\} \\
D_{\psi\xi}^{\left(0\right)} & = & -\frac{p}{\sqrt{1-\xi_{0}^{2}}}\frac{1}{\left|\nabla\psi\right|_{0}}\left[\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\Psi\right\} +\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\nabla\psi\cdot\mathcal{D}_{gc}^{\mathbf{X}\xi}\right\} \right]\\
D_{pp}^{\left(0\right)} & = & \left\{ \mathcal{D}_{gc}^{pp}\right\} \\
D_{p\xi}^{\left(0\right)} & = & -\frac{p}{\sqrt{1-\xi_{0}^{2}}}\left[\left\{ \frac{1}{\Psi}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{p\xi}\right\} +\frac{1-\xi_{0}^{2}}{2\xi_{0}}\left\{ \frac{1}{\Psi}\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\Psi\right\} \right]\\
D_{\xi\xi}^{\left(0\right)} & = & \frac{p^{2}}{1-\xi_{0}^{2}}\left[\left\{ \frac{1}{\Psi^{2}}\frac{\xi^{2}}{\xi_{0}^{2}}\mathcal{D}_{gc}^{\xi\xi}\right\} +\frac{1-\xi_{0}^{2}}{\xi_{0}}\left\{ \frac{1}{\Psi^{2}}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\Psi\right\} \right]\end{eqnarray}

\end_inset


