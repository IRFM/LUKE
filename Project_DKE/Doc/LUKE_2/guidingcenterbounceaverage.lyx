 & \left.\left(-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\Psi+\frac{1}{\Psi}\left(\frac{\xi}{\xi_{0}}+\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial\xi}\right)\mathcal{D}_{gc}^{p\xi}+\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial p}\mathcal{D}_{gc}^{pp}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\end{align}

