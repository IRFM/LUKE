C_{gc}\left[\overline{F}\right] & = & -\frac{1}{\mathcal{J}}\frac{\partial}{\partial z^{\alpha}}\left[\mathcal{J}\left(\mathcal{K}_{gc}^{\alpha}\overline{F}-\mathcal{D}_{gc}^{\alpha\beta}\frac{\partial\overline{F}}{\partial z^{\beta}}\right)\right]\nonumber \\
 & = & -\frac{1}{p^{2}}\frac{B^{\theta}}{B}\left|\frac{\xi}{\xi_{0}}\right|\frac{\partial}{\partial p}\left[p^{2}\frac{B}{B^{\theta}}\left|\frac{\xi_{0}}{\xi}\right|\left(\mathcal{K}_{gc}^{p}\overline{F}-\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\overline{F}-\mathcal{D}_{gc}^{pp}\frac{\partial\overline{F}}{\partial p}\right.\right.\nonumber \\
 &  & \left.\left(-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\mathcal{D}_{gc}^{p\mathbf{X}}\cdot\nabla\Psi+\frac{1}{\Psi}\left(\frac{\xi}{\xi_{0}}+\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial\xi}\right)\mathcal{D}_{gc}^{p\xi}+\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial p}\mathcal{D}_{gc}^{pp}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\nonumber \\
 &  & -\frac{B^{\theta}}{B}\left|\frac{\xi}{\xi_{0}}\right|\frac{\partial}{\partial\xi_{0}}\left[\frac{B}{B^{\theta}}\left|\frac{\xi_{0}}{\xi}\right|\left(\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{K}_{gc}^{\mathbf{X}}+\frac{1}{\Psi}\left(\frac{\xi}{\xi_{0}}+\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial\xi}\right)\mathcal{K}_{gc}^{\xi}+\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial p}\mathcal{K}_{gc}^{p}\right]\overline{F}\right.\right.\nonumber \\
 &  & -\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{XX}}+\frac{1}{\Psi}\left(\frac{\xi}{\xi_{0}}+\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial\xi}\right)\mathcal{D}_{gc}^{\xi\mathbf{X}}+\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial p}\mathcal{D}_{gc}^{p\mathbf{X}}\right]\cdot\nabla\overline{F}\nonumber \\
 &  & -\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\nabla\Psi\cdot\mathcal{D}_{gc}^{\mathbf{X}p}+\frac{1}{\Psi}\left(\frac{\xi}{\xi_{0}}+\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial\xi}\right)\mathcal{D}_{gc}^{\xi p}+\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial p}\mathcal{D}_{gc}^{pp}\right]\frac{\partial\overline{F}}{\partial p}\nonumber \\
 &  & \left.\left.-\left[\mathcal{D}_{gc}^{\xi\xi}\left[\frac{1}{\Psi^{2}}\left(\frac{\xi}{\xi_{0}}\right)^{2}+\frac{1}{\Psi^{2}}\frac{\xi}{\xi_{0}}\frac{1-\xi_{0}^{2}}{\xi_{0}}\frac{\partial\Psi}{\partial\xi}\right]+\frac{1-\xi_{0}^{2}}{\xi_{0}}\frac{1}{\Psi^{2}}\frac{\xi}{\xi_{0}}\mathcal{D}_{gc}^{\xi\mathbf{X}}\cdot\nabla\Psi+\frac{1}{\Psi^{2}}\frac{1-\xi_{0}^{2}}{\xi_{0}}\frac{\xi}{\xi_{0}}\frac{\partial\Psi}{\partial p}\mathcal{D}_{gc}^{\xi p}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\nonumber \\
 &  & -\frac{B^{\theta}}{\Psi}\left|\frac{\xi}{\xi_{0}}\right|\nabla\cdot\left[\frac{\Psi}{B^{\theta}}\left|\frac{\xi_{0}}{\xi}\right|\left(\mathcal{K}_{gc}^{\mathbf{X}}\overline{F}-\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\overline{F}-\mathcal{D}_{gc}^{\mathbf{X}p}\frac{\partial\overline{F}}{\partial p}\right.\right.\nonumber \\
 &  & \left.\left.-\left[\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\mathcal{D}_{gc}^{\mathbf{XX}}\cdot\nabla\Psi+\frac{1}{\Psi}\left(\frac{\xi}{\xi_{0}}+\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial\xi}\right)\mathcal{D}_{gc}^{\mathbf{X}\xi}+\frac{1}{\Psi}\frac{1-\xi_{0}^{2}}{2\xi_{0}}\frac{\partial\Psi}{\partial p}\mathcal{D}_{gc}^{\mathbf{X}p}\right]\frac{\partial\overline{F}}{\partial\xi_{0}}\right)\right]\end{eqnarray}

