\begin_layout Standard
The discretization of the Fokker-Planck equation requires values of the
 distribution function on the flux grid, which is obtained by interpolation.
 The interpolation coefficients which by definition must lie between 
\begin_inset Formula $0$
\end_inset

 and 
\begin_inset Formula $1$
\end_inset

 are 
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{l}
f_{l,i+++,j+}^{(k)}=\left(1-\delta_{\psi,l,i+++,j+}\right)f_{l+,i+++,j+}^{(k)}+\delta_{\psi,l,i+++,j+}f_{l-,i+++,j+}^{(k)}\\
f_{l,i-,j+}^{(k)}=\left(1-\delta_{\psi,l,i-,j+}\right)f_{l+,i-,j+}^{(k)}+\delta_{\psi,l,i-,j+}f_{l-,i-,j+}^{(k)}\\
f_{l,i+,j+++}^{(k)}=\left(1-\delta_{\psi,l,i+,j+++}\right)f_{l+,i+,j+++}^{(k)}+\delta_{\psi,l,i+,j+++}f_{l-,i+,j+++}^{(k)}\\
f_{l,i+,j-}^{(k)}=\left(1-\delta_{\psi,l,i+,j-}\right)f_{l+,i+,j-}^{(k)}+\delta_{\psi,l,i+,j-}f_{l-,i+,j-}^{(k)}\\
f_{l,i+,j+}^{(k)}=\left(1-\delta_{\psi,l,i+,j+}\right)f_{l+,i+,j+}^{(k)}+\delta_{\psi,l,i+,j+}f_{l-,i+,j+}^{(k)}\end{array}\label{eq:interp_l}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\begin{array}{l}
f_{l+++,i,j+}^{(k)}=\left(1-\delta_{p,l+++,i,j+}\right)f_{l+++,i+,j+}^{(k)}+\delta_{p,l+++,i,j+}f_{l+++,i-,j+}^{(k)}\\
f_{l-,i,j+}^{(k)}=\left(1-\delta_{p,l-,i,j+}\right)f_{l-,i+,j+}^{(k)}+\delta_{p,l-,i,j+}f_{l-,i-,j+}^{(k)}\\
f_{l+,i,j+++}^{(k)}=\left(1-\delta_{p,l+,i,j+++}\right)f_{l+,i+,j+++}^{(k)}+\delta_{p,l+,i,j+++}f_{l+,i-,j+++}^{(k)}\\
f_{l+,i,j-}^{(k)}=\left(1-\delta_{p,l+,i,j-}\right)f_{l+,i+,j-}^{(k)}+\delta_{p,l+,i,j-}f_{l+,i-,j-}^{(k)}\\
f_{l+,i,j+}^{(k)}=\left(1-\delta_{p,l+,i,j+}\right)f_{l+,i+,j+}^{(k)}+\delta_{p,l+,i,j+}f_{l+,i-,j+}^{(k)}\end{array}\label{eq:interp_i}\end{equation}

