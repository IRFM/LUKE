\layout Paragraph

Traitement de l'operateur diffusion quasilineaire (ondes RF)
\layout Standard

Operateur QL et tenseur de diffusion
\layout Standard

L'operateur de diffusion quasilineaire a ete developpe par Kennel et Engelmann
 .
 Un traitement relativiste effectue par Lerche propose un operateur qui
 peut etre reecrit sous la forme
\layout Standard


\begin_inset Formula \[
Q(f_{0})=\lim_{V\rightarrow\infty}\frac{\pi}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\sum_{n=-\infty}^{+\infty}\mathcal{L}\left[p_{\bot}^{2}D_{\mathbf{k}}^{(n)}\delta(\omega-k_{\Vert}v_{\Vert}-n\Omega)\mathcal{L}(f_{0})\right]\]

\end_inset 

 ou 
\begin_inset Formula $\mathcal{L}$
\end_inset 

 est un operateur differentiel dans l'espace des moments defini par 
\begin_inset Formula \[
\mathcal{L}(\mathcal{A})=\frac{1}{p}\frac{\partial\mathcal{A}}{\partial p}+\frac{1}{p^{2}\xi}\left(\frac{k_{\Vert}v_{\Vert}}{\omega}-\xi^{2}\right)\frac{\partial\mathcal{A}}{\partial\xi}\]

\end_inset 

 qui peut etre sous la forme de la divergence d'un flux 
\begin_inset Formula \[
\mathcal{L}(\mathcal{A})=\frac{1}{p^{2}}\left[\frac{\partial}{\partial p}\left(p\mathcal{A}\right)+\frac{\partial}{\partial\xi}\left(\frac{1}{\xi}\left[\frac{k_{\Vert}v_{\Vert}}{\omega}-\xi^{2}\right]\mathcal{A}\right)\right]\]

\end_inset 

 
\begin_inset Formula $D_{\mathbf{k}}$
\end_inset 

 etant le coefficient de diffusion quasilineaire, qui prend en compte l'intensit
e et la polarisation du champ electrique de l'onde RF.
 Il est defini par 
\begin_inset Formula \[
D_{\mathbf{k}}^{(n)}=q_{e}^{2}\left|E_{\mathbf{k},+}e^{-i\alpha}J_{n-1}\left(\frac{k_{\bot}v_{\bot}}{\Omega}\right)+E_{\mathbf{k},-}e^{+i\alpha}J_{n+1}\left(\frac{k_{\bot}v_{\bot}}{\Omega}\right)+\frac{p_{\Vert}}{p_{\bot}}E_{\mathbf{k},\Vert}J_{n}\left(\frac{k_{\bot}v_{\bot}}{\Omega}\right)\right|^{2}\]

\end_inset 

 avec les notations suivantes: le champ electrique est decompose en ses
 composantes de Fourier 
\begin_inset Formula \[
\overrightarrow{E}(\overrightarrow{x},t)=\iiint\frac{d^{3}k}{(2\pi)^{3}}e^{i\mathbf{k}\cdot\mathbf{x}}\overrightarrow{E}_{\mathbf{k}}\left(\mathbf{k},t\right)\]

\end_inset 

 qui sont exprimees en fonction des coordonnees de champ tournant 
\begin_inset Formula \[
\left\{ \begin{array}{l}
E_{\mathbf{k},\pm}=\frac{1}{2}\left(E_{\mathbf{k},x}\pm iE_{\mathbf{k},y}\right)\\
E_{\mathbf{k},\Vert}=E_{\mathbf{k},z}\end{array}\right.\]

\end_inset 

 l'angle 
\begin_inset Formula $\alpha$
\end_inset 

 decrivant la projection de la composante transverse du vecteur d'onde dans
 le plan 
\begin_inset Formula $(x,y)$
\end_inset 

: 
\begin_inset Formula \begin{eqnarray*}
k_{x} & = & k_{\bot}\cos\alpha\\
k_{y} & = & k_{\bot}\sin\alpha\\
k_{z} & = & k_{\Vert}\end{eqnarray*}

\end_inset 


\layout Standard

En permutant les operateurs differentiels dans l'espace des moments et l'operate
ur integral dans l'espace des vecteurs d'onde 
\begin_inset Formula $k$
\end_inset 

, 
\begin_inset Formula $Q(f_{0})$
\end_inset 

 devient 
\begin_inset Formula \begin{eqnarray*}
Q(f_{0}) & = & \sum_{n=-\infty}^{+\infty}\frac{1}{p^{2}}\frac{\partial}{\partial p}\left(p\lim_{V\rightarrow\infty}\frac{\pi}{V}\int\frac{d^{3}k}{(2\pi)^{3}}p_{\bot}^{2}D_{\mathbf{k}}^{(n)}\delta(\omega-k_{\Vert}v_{\Vert}-n\Omega)\mathcal{L}(f_{0})\right)\\
 &  & +\frac{1}{p^{2}}\frac{\partial}{\partial\xi}\left(\frac{1}{\xi}\lim_{V\rightarrow\infty}\frac{\pi}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\left[\frac{k_{\Vert}v_{\Vert}}{\omega}-\xi^{2}\right]p_{\bot}^{2}D_{\mathbf{k}}^{(n)}\delta(\omega-k_{\Vert}v_{\Vert}-n\Omega)\mathcal{L}(f_{0})\right)\end{eqnarray*}

\end_inset 


\layout Standard

En exprimant la condition de resonance 
\begin_inset Formula \[
k_{\Vert}v_{\Vert}=\omega-n\Omega\]

\end_inset 

 on obtient un operateur quasilineaire sous la forme de la divergence d'un
 flux 
\begin_inset Formula \[
Q(f_{0})=-\nabla\cdot\mathbf{S}^{\text{RF}}=-\frac{1}{p^{2}}\frac{\partial}{\partial p}\left(p^{2}S_{p}^{\text{RF}}\right)+\frac{1}{p}\frac{\partial}{\partial\xi}\left(\sqrt{1-\xi^{2}}S_{\xi}^{\text{RF}}\right)\]

\end_inset 

 pour lequel les contributions de chaque rayon sont separees 
\begin_inset Formula \begin{eqnarray*}
S_{p}^{\text{RF}} & = & \sum_{n=-\infty}^{+\infty}\sum_{b}-p(1-\xi^{2})D_{b,n}^{\text{RF}}(p,\xi)\mathcal{L}(f_{0})\\
S_{\xi}^{\text{RF}} & = & \sum_{n=-\infty}^{+\infty}\sum_{b}p\frac{\sqrt{1-\xi^{2}}}{\xi}\left[1-\xi^{2}-\frac{n\Omega}{\omega_{b}}\right]D_{b,n}^{\text{RF}}(p,\xi)\mathcal{L}(f_{0})\end{eqnarray*}

\end_inset 

 et 
\begin_inset Formula \[
D_{b,n}^{\text{RF}}(p,\xi)=\lim_{V\rightarrow\infty}\frac{\pi}{V}\int\frac{d^{3}k}{(2\pi)^{3}}D_{\mathbf{k}}^{b(n)}\delta(\omega_{b}-k_{\Vert}v_{\Vert}-n\Omega)\]

\end_inset 


\layout Standard

De plus, les flux quasilineaires sont purement diffusifs et ils peuvent
 etre exprimes sous la forme 
\begin_inset Formula \[
\mathbf{S}^{\text{RF}}=-\overline{\overline{D}}_{\mathbf{p}}^{\text{RF}}\cdot\nabla_{\mathbf{p}}f_{0}\]

\end_inset 

 avec 
\begin_inset Formula \[
\left\{ \begin{array}{l}
D_{pp}^{\text{RF}}=\sum_{n=-\infty}^{+\infty}\sum_{b}(1-\xi^{2})D_{b,n}^{\text{RF}}(p,\xi)\\
D_{p\xi}^{\text{RF}}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\frac{\sqrt{1-\xi^{2}}}{\xi}\left[1-\xi^{2}-\frac{n\Omega}{\omega_{b}}\right]D_{b,n}^{\text{RF}}(p,\xi)\\
D_{\xi p}^{\text{RF}}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\frac{\sqrt{1-\xi^{2}}}{\xi}\left[1-\xi^{2}-\frac{n\Omega}{\omega_{b}}\right]D_{b,n}^{\text{RF}}(p,\xi)\\
D_{\xi\xi}^{\text{RF}}=\sum_{n=-\infty}^{+\infty}\sum_{b}\frac{1}{\xi^{2}}\left[1-\xi^{2}-\frac{n\Omega}{\omega_{b}}\right]^{2}D_{b,n}^{\text{RF}}(p,\xi)\end{array}\right.\]

\end_inset 


\layout Standard

A partir de ces expressions il est facile de determiner la moyenne des coefficie
nts sur la periode de rebond, 
\begin_inset Formula \[
\left\{ \begin{array}{l}
D_{pp}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}(1-\xi_{0}^{2})\left\{ \Psi D_{(n)}^{\text{RF}}(p,\xi)\right\} \\
D_{p\xi}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\frac{\sqrt{1-\xi_{0}^{2}}}{\xi_{0}}\left[1-\xi_{0}^{2}-\frac{n\Omega_{0}}{\omega_{b}}\right]\left\{ \Psi D_{(n)}^{\text{RF}}(p,\xi)\right\} \\
D_{\xi p}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\frac{\sqrt{1-\xi_{0}^{2}}}{\xi_{0}}\left[1-\xi_{0}^{2}-\frac{n\Omega_{0}}{\omega_{b}}\right]\left\{ \Psi D_{(n)}^{\text{RF}}(p,\xi)\right\} \\
D_{\xi\xi}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}\frac{1}{\xi_{0}^{2}}\left[1-\xi_{0}^{2}-\frac{n\Omega_{0}}{\omega_{b}}\right]^{2}\left\{ \Psi D_{(n)}^{\text{RF}}(p,\xi)\right\} \end{array}\right.\]

\end_inset 

 ou l'on introduit la frequence cyclotronique au demi-plan 
\begin_inset Formula $\theta=0$
\end_inset 

: 
\begin_inset Formula \[
\Omega_{0}=\frac{q_{e}B_{0}}{\gamma m_{e}}=\frac{\Omega}{\Psi}\]

\end_inset 


\layout Standard

On peut finalement reecrire, 
\begin_inset Formula \[
\left\{ Q(f_{0})\right\} =\left\{ -\nabla\cdot\mathbf{S}^{\text{RF}}\right\} =-\frac{1}{p^{2}}\frac{\partial}{\partial p}\left(p^{2}S_{p}^{\text{RF}(0)}\right)+\frac{1}{\lambda\left(\xi_{0}\right)p}\frac{\partial}{\partial\xi}\left(\sqrt{1-\xi^{2}}\lambda\left(\xi_{0}\right)S_{\xi}^{\text{RF}(0)}\right)\]

\end_inset 

 avec 
\begin_inset Formula \[
\mathbf{S}^{\text{RF}(0)}=-\overline{\overline{D}}_{\mathbf{p}}^{\text{RF}(0)}\cdot\nabla_{p,\xi_{0}}f_{0}^{(0)}\]

\end_inset 

 et 
\begin_inset Formula \[
\left\{ \begin{array}{l}
D_{pp}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}(1-\xi_{0}^{2})D_{b,n}^{\text{RF}(0)}(p,\xi_{0})\\
D_{p\xi}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\frac{\sqrt{1-\xi_{0}^{2}}}{\xi_{0}}\left[1-\xi_{0}^{2}-\frac{n\Omega_{0}}{\omega}\right]D_{b,n}^{\text{RF}(0)}(p,\xi_{0})\\
D_{\xi p}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\frac{\sqrt{1-\xi_{0}^{2}}}{\xi_{0}}\left[1-\xi_{0}^{2}-\frac{n\Omega_{0}}{\omega_{b}}\right]D_{b,n}^{\text{RF}(0)}(p,\xi_{0})\\
D_{\xi\xi}^{\text{RF}(0)}=\sum_{n=-\infty}^{+\infty}\sum_{b}\frac{1}{\xi_{0}^{2}}\left[1-\xi_{0}^{2}-\frac{n\Omega_{0}}{\omega_{b}}\right]^{2}D_{b,n}^{\text{RF}(0)}(p,\xi_{0})\end{array}\right.\]

\end_inset 

 ou par definition 
\begin_inset Formula \[
D_{b,n}^{\text{RF}(0)}(p,\xi_{0})=\left\{ \Psi D_{b,n}^{\text{RF}}(p,\xi)\right\} \]

\end_inset 


\layout Standard

La discretisation des elements du tenseur quasi-lineaire est alors immediate,
 et les coefficients qui interviennent dans la matrice 
\begin_inset Formula $\overline{\overline{M}}^{\left(0\right)}$
\end_inset 

sont 
\begin_inset Formula \[
\overline{\overline{D}}_{\mathbf{p}}^{\text{RF}(0)}\rightarrow\left\{ \begin{array}{l}
D_{pp,i+1,j+1/2}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}(1-\xi_{0j+1/2}^{2})D_{b,n,i+1,j+1/2}^{\text{ RF}(0)}\\
D_{pp,i,j+1/2}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}(1-\xi_{0j+1/2}^{2})D_{b,n,i,j+1/2}^{\text{RF}(0)}\\
D_{p\xi,i+1,j+1/2}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\sqrt{1-\xi_{0j+1/2}^{2}}/\xi_{0j+1/2}\left[1-\xi_{0j+1/2}^{2}-n\Omega_{0}/\omega_{b}\right]D_{b,n,i+1,j+1/2}^{\text{RF}(0)}\\
D_{\xi p,i+1/2,j+1}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\sqrt{1-\xi_{0j+1}^{2}}/\xi_{0j+1}\left[1-\xi_{0j+1}^{2}-n\Omega_{0}/\omega_{b}\right]D_{b,n,i+1/2,j+1}^{\text{RF}(0)}\\
D_{p\xi,i+1/2,j+1/2}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\sqrt{1-\xi_{0j+1/2}^{2}}/\xi_{0j+1/2}\left[1-\xi_{0j+1/2}^{2}-n\Omega_{0}/\omega_{b}\right]D_{b,n,i+1/2,j+1/2}^{\text{RF}(0)}\\
D_{\xi p,i+1/2,j+1/2}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\sqrt{1-\xi_{0j+1/2}^{2}}/\xi_{0j+1/2}\left[1-\xi_{0j+1/2}^{2}-n\Omega_{0}/\omega_{b}\right]D_{b,n,i+1/2,j+1/2}^{\text{RF}(0)}\\
D_{p\xi,i,j+1/2}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\sqrt{1-\xi_{0j+1/2}^{2}}/\xi_{0j+1/2}\left[1-\xi_{0j+1/2}^{2}-n\Omega_{0}/\omega_{b}\right]D_{b,n,i,j+1/2}^{\text{RF}(0)}\\
D_{\xi p,i+1/2,j}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}-\sqrt{1-\xi_{0j}^{2}}/\xi_{0j}\left[1-\xi_{0j}^{2}-n\Omega_{0}/\omega_{b}\right]D_{b,n,i+1/2,j}^{\text{RF}(0)}\\
D_{\xi\xi,i+1/2,j+1}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}1/\xi_{0j+1}^{2}\left[1-\xi_{0j+1}^{2}-n\Omega_{0}/\omega_{b}\right]^{2}D_{b,n,i+1/2,j+1}^{\text{RF}(0)}\\
D_{\xi\xi,i+1/2,j}^{\text{RF}\left(0\right)}=\sum_{n=-\infty}^{+\infty}\sum_{b}1/\xi_{0j}^{2}\left[1-\xi_{0j}^{2}-n\Omega_{0}/\omega_{b}\right]^{2}D_{b,n,i+1/2,j}^{\text{RF}(0)}\end{array}\right.\]

\end_inset 

 et 
\begin_inset Formula \[
\overline{\overline{F}}_{p}^{\text{RF}(0)}\rightarrow\left\{ \begin{array}{l}
F_{p,i+1,j+1/2}^{\text{RF}(0)}=0\\
F_{p,i,j+1/2}^{\left(0\right)}=0\\
F_{\xi,i+1/2,j+1}^{\left(0\right)}=0\\
F_{\xi,i+1/2,j}^{\left(0\right)}=0\end{array}\right.\]

\end_inset 


\layout Standard

Sous cette forme, le calcul garde une tres grande generalite, quelque soit
 le type d'onde.
\layout Standard

Application au cas de l'onde a la frequence hybride basse (LH)
\layout Standard

L'onde hybride est absorbee par amortissement Landau a 
\begin_inset Formula $n=0$
\end_inset 

 (mode quasi-electrostatique).
 La longueur d'onde perpendiculaire 
\begin_inset Formula $2\pi/k_{\bot}$
\end_inset 

 etant nettement plus grande que le rayon de Larmor, on peut prendre 
\begin_inset Formula \[
J_{0}\left(\frac{k_{\bot}v_{\bot}}{\Omega}\right)\simeq1\]

\end_inset 

 de sorte que 
\begin_inset Formula \[
D_{\mathbf{k}}^{\text{LH}}\simeq q_{e}^{2}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\left|E_{\mathbf{k},\Vert}\right|^{2}\]

\end_inset 

 et 
\begin_inset Formula \begin{eqnarray*}
D^{\text{LH}}(p,\xi) & = & \frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\left|E_{\mathbf{k},\Vert}\right|^{2}\delta(\omega-k_{\Vert}v_{\Vert})\\
 & = & \frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\frac{v_{Te}}{\left|v_{\Vert}\right|}\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\left|E_{\mathbf{k},\Vert}\right|^{2}\delta\left(k_{\Vert}-\frac{\omega}{v_{\Vert}}\right)\frac{1}{v_{Te}}\end{eqnarray*}

\end_inset 


\layout Standard

On considere un rayon LH a une position polo\i \"{\i}
dale particuliere 
\begin_inset Formula $\theta=\theta_{b}$
\end_inset 

, avec un spectre du champ electrique uniforme en 
\begin_inset Formula $k_{\Vert}$
\end_inset 

 entre deux limites 
\begin_inset Formula $k_{\min}$
\end_inset 

 et 
\begin_inset Formula $k_{\max}$
\end_inset 

 typiquement fixees par les conditions d'accessibilite et d'amortissement
 Landau lineaire fort.
 Dans ces conditions, on peut modeliser le champ electrique par 
\begin_inset Formula \[
\left|E_{\mathbf{k},\Vert}\right|^{2}(k_{\Vert},\overline{k}_{\bot})=\left|E_{\mathbf{k},\Vert,0}\right|^{2}(\mathbf{k}_{\bot})H(k_{\Vert}-k_{\min})H(k_{\max}-k_{\Vert})2\pi\Delta\theta\delta(\theta-\theta_{b})\]

\end_inset 

 avec 
\begin_inset Formula \[
\left\{ \begin{array}{l}
v_{\min}=\frac{\omega}{k_{\max}}\\
v_{\max}=\frac{\omega}{k_{\min}}\end{array}\right.\]

\end_inset 

 de sorte que 
\begin_inset Formula \[
D^{\text{LH}}(p,\xi)=\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\frac{v_{Te}}{\left|v_{\Vert}\right|}H(v_{\Vert}-v_{\min})H(v_{\max}-v_{\Vert})2\pi\delta(\theta-\theta_{b})D_{0}^{\text{LH}}\]

\end_inset 

 avec 
\begin_inset Formula \[
D_{0}^{\text{LH}}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\left|E_{\mathbf{k},\Vert,0}\right|^{2}(\mathbf{k}_{\bot})\frac{1}{v_{Te}}\]

\end_inset 


\layout Standard

Le coefficient de diffusion quasilineaire pour l'onde hybride devient alors
 
\begin_inset Formula \begin{eqnarray*}
D^{\text{LH}(0)}(p,\xi_{0}) & \equiv & \left\{ \Psi D^{\text{LH}}(p,\xi)\right\} \\
 & = & \left\{ \Psi\frac{\xi^{2}}{1-\xi^{2}}\frac{v_{Te}}{v\left|\xi\right|}H(v\xi-v_{\min})H(v_{\max}-v\xi)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{LH}}\right\} \\
 & = & \frac{\xi_{0}^{2}}{1-\xi_{0}^{2}}\frac{v_{Te}}{v\left|\xi_{0}\right|}\left\{ \frac{\xi}{\xi_{0}}H(v\xi-v_{\min})H(v_{\max}-v\xi)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{LH}}\right\} \\
 & = & \frac{\xi_{0}^{2}}{1-\xi_{0}^{2}}\frac{v_{Te}}{v\left|\xi_{0}\right|}\frac{1}{\lambda\left(\xi_{0}\right)}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}\int_{-\theta_{c}}^{\theta_{c}}\frac{d\theta}{2\pi}H\left(v\xi-v_{\min}\right)H(v_{\max}-v\xi)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{LH}}\end{eqnarray*}

\end_inset 

 et finalement 
\begin_inset Formula \begin{eqnarray*}
D^{\text{LH}(0)}(p,\xi_{0}) & \equiv & \left\{ \Psi D^{\text{LH}}(p,\xi)\right\} \\
 & = & \frac{\xi_{0}^{2}}{1-\xi_{0}^{2}}\frac{v_{Te}}{v\left|\xi_{0}\right|}\frac{1}{\lambda\left(\xi_{0}\right)}\\
 &  & \times\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}H\left(|\theta_{b}|-\theta_{c}\left(\xi_{0}\right)\right)H\left(v\xi_{b}\left(\xi_{0}\right)-v_{\min,b}\right)H\left(v_{\max,b}-v\xi_{b}\left(\xi_{0}\right)\right)D_{0,b}^{\text{LH}}\end{eqnarray*}

\end_inset 

 avec 
\begin_inset Formula \[
D_{0,b}^{\text{LH}}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta_{b}}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\left|E_{\mathbf{k},\Vert,0,b}\right|^{2}(\mathbf{k}_{\bot})\frac{1}{v_{Te}}\]

\end_inset 


\layout Standard

Pour rappel, les elements du tenseur quasilineaire concernant l'onde hybride
 peuvent egalement etre exprimes comme suit, sous une forme couramment utilisee
 dans la litterature mais qui ne sera pas utilisee ici 
\begin_inset Formula \[
\left\{ \begin{array}{l}
D_{pp}^{\text{LH}(0)}=\xi_{0}^{2}D^{\text{LH}}\\
D_{p\xi}^{\text{LH}(0)}=-\xi_{0}\sqrt{1-\xi_{0}^{2}}D^{\text{LH}}\\
D_{\xi p}^{\text{LH}(0)}=-\xi_{0}\sqrt{1-\xi_{0}^{2}}D^{\text{LH}}\\
D_{\xi\xi}^{\text{LH}(0)}=\left(1-\xi_{0}^{2}\right)D^{\text{LH}}\end{array}\right.\]

\end_inset 

 avec 
\begin_inset Formula \[
D^{\text{LH}}\left(\xi_{0}\right)=\frac{v_{Te}}{v\left|\xi_{0}\right|}\frac{1}{\lambda\left(\xi_{0}\right)}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}H(|\theta_{b}|<\theta_{c}\left(\xi_{0}\right))H(v\xi_{b}\left(\xi_{0}\right)-v_{\min,b})H(v_{\max,b}-v\xi_{b}\left(\xi_{0}\right))D_{0,b}^{\text{LH}}\]

\end_inset 


\layout Standard

Application au cas de l'onde cyclotronique electronique (EC)
\layout Standard

Cas du mode X
\layout Standard

On considere la diffusion quasilineaire a l'harmonique 
\begin_inset Formula $n$
\end_inset 

 par l'onde EC avec une polarisation de mode X de sorte que la composante
 predominante du champ electrique soit 
\begin_inset Formula $E_{\mathbf{k},-}$
\end_inset 

.
 Pour les electrons, 
\begin_inset Formula \[
\Omega=\frac{-\omega_{ce}}{\gamma}<0\]

\end_inset 

 avec 
\begin_inset Formula \[
\omega_{ce}=\frac{q_{e}B}{m_{e}}\]

\end_inset 

 il faut en realite prendre un harmonique 
\begin_inset Formula $n<0$
\end_inset 

.
 Dans ce paragraphe, 
\begin_inset Formula $n$
\end_inset 

 correspond en fait a sa valeur absolue.
 En notant que 
\begin_inset Formula $\left|J_{-n}\right|=\left|J_{n}\right|$
\end_inset 

 , on a alors 
\begin_inset Formula \[
D_{\mathbf{k}}^{\text{EC-X}(n)}\simeq q_{e}^{2}\left|E_{\mathbf{k},-}\right|^{2}J_{n-1}^{2}\]

\end_inset 


\layout Standard

On se limite aux cas 
\begin_inset Formula \[
\frac{k_{\bot}v_{\bot}}{\Omega}\simeq n\frac{v_{\bot}}{c}<1\]

\end_inset 

 de sorte que 
\begin_inset Formula \[
J_{n}(z)\simeq\frac{(z/2)^{n}}{n!}\]

\end_inset 

 et 
\begin_inset Formula \begin{eqnarray*}
D_{\mathbf{k}}^{\text{EC-X}(n)} & \simeq & \frac{1}{(n-1)!^{2}}\left(\frac{k_{\bot}v_{\bot}}{2\Omega}\right)^{2(n-1)}q_{e}^{2}\left|E_{\mathbf{k},-}\right|^{2}\\
 & = & \frac{1}{(n-1)!^{2}}\left(N_{\bot}\frac{\gamma v_{\bot}}{c}\frac{\omega}{2\omega_{ce}}\right)^{2(n-1)}q_{e}^{2}\left|E_{\mathbf{k},-}\right|^{2}\end{eqnarray*}

\end_inset 


\layout Standard

Ainsi, le coefficient de diffusion quasilineaire pour l'onde EC en mode
 X devient 
\begin_inset Formula \begin{eqnarray*}
D^{\text{EC-X}(n)}(p,\xi) & = & \left(\frac{p_{\bot}}{p_{Te}}\right)^{2(n-1)}\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\frac{1}{(n-1)!^{2}}\\
 &  & \times\left(N_{\bot}\frac{p_{Te}}{m_{e}c}\frac{\omega}{2\omega_{ce}}\right)^{2(n-1)}\left|E_{\mathbf{k},-}\right|^{2}\delta\left(\omega-k_{\Vert}v_{\Vert}-\frac{n\omega_{ce}}{\gamma}\right)\\
 & = & \left(\frac{p_{\bot}}{p_{Te}}\right)^{2(n-1)}\frac{v_{Te}}{\left|v_{\Vert}\right|}\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\frac{1}{(n-1)!^{2}}\\
 &  & \times\left(N_{\bot}\frac{p_{Te}}{m_{e}c}\frac{\omega}{2\omega_{ce}}\right)^{2(n-1)}\left|E_{\mathbf{k},-}\right|^{2}\delta\left(k_{\Vert}-\frac{\omega}{v_{\Vert}}+\frac{n\omega_{ce}}{\gamma v_{\Vert}}\right)\frac{1}{v_{Te}}\end{eqnarray*}

\end_inset 


\layout Standard

On considere un rayon EC a une position polo\i \"{\i}
dale particuliere 
\begin_inset Formula $\theta=\theta_{b}$
\end_inset 

, avec un spectre du champ electrique gaussien en 
\begin_inset Formula $k_{\Vert}$
\end_inset 

 centre autour de 
\begin_inset Formula $k_{\Vert,0}$
\end_inset 

 avec une demi-largeur 
\begin_inset Formula $\Delta k_{\Vert}$
\end_inset 

 a valeur 
\begin_inset Formula $1/e$
\end_inset 

.
 Dans ces conditions, on peut modeliser le champ electrique par 
\begin_inset Formula \[
\left|E_{\mathbf{k},-}\right|^{2}(k_{\Vert},\overline{k}_{\bot})=\left|E_{\mathbf{k},-,0}\right|^{2}(\overline{k}_{\bot})\exp\left(-\frac{\left(k_{\Vert}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\Delta\theta\delta(\theta-\theta_{b})\]

\end_inset 

 de sorte que 
\begin_inset Formula \[
D^{\text{EC-X}(n)}(p,\xi)=\left(\frac{p_{\bot}}{p_{Te}}\right)^{2(n-1)}\frac{v_{Te}}{\left|v_{\Vert}\right|}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\]

\end_inset 

 avec 
\begin_inset Formula \[
D_{0}^{\text{EC-X}(n)}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\frac{1}{(n-1)!^{2}}\left(N_{\bot}\frac{p_{Te}}{m_{e}c}\frac{\omega}{2\omega_{ce}}\right)^{2(n-1)}\left|E_{\mathbf{k},-,0}\right|^{2}(\overline{k}_{\bot})\frac{1}{v_{Te}}\]

\end_inset 

 et 
\begin_inset Formula \[
k_{\Vert,\text{res}}=\frac{\omega}{v_{\Vert}}\left(1-\frac{n\omega_{ce}}{\gamma\omega}\right)\]

\end_inset 


\layout Standard

Le coefficient de diffusion quasilineaire pour l'onde EC en mode X devient
 alors 
\begin_inset Formula \begin{eqnarray*}
D_{(0)}^{\text{EC-X}(n)}(p,\xi_{0}) & \equiv & \left\{ \Psi D^{\text{EC-X}(n)}(p,\xi)\right\} \\
 & = & \left\{ \Psi\left(\frac{p_{\bot}}{p_{Te}}\right)^{2(n-1)}\frac{v_{Te}}{\left|v_{\Vert}\right|}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v|\xi_{0}|}\\
 &  & \times\left\{ \frac{\xi_{0}}{\xi}\Psi^{n}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v|\xi_{0}|}\\
 &  & \frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}\int_{-\theta_{c}}^{\theta_{c}}\frac{d\theta}{2\pi}\frac{\xi_{0}^{2}}{\xi^{2}}\Psi^{n}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\end{eqnarray*}

\end_inset 

 et finalement 
\begin_inset Formula \begin{eqnarray*}
D_{(0)}^{\text{EC-X}(n)}(p,\xi_{0}) & \equiv & \left\{ \Psi D^{\text{EC-X}(n)}(p,\xi)\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v|\xi_{0}|}\\
\times\frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}H(|\theta_{b}| & < & \theta_{c})\frac{\xi_{0}^{2}}{\xi_{b}^{2}}\Psi_{b}^{n}\exp\left(-\frac{\left(k_{\Vert,\text{res},b}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)D_{0,b}^{\text{EC-X}(n)}\end{eqnarray*}

\end_inset 

 avec 
\begin_inset Formula \[
D_{0,b}^{\text{EC-X}(n)}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta_{b}}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\frac{1}{(n-1)!^{2}}\left(N_{\bot,b}\frac{p_{Te}}{m_{e}c}\frac{\omega_{b}}{2\omega_{ce}}\right)^{2(n-1)}\left|E_{\mathbf{k},-,0,b}\right|^{2}(\overline{k}_{\bot})\frac{1}{v_{Te}}\]

\end_inset 


\layout Standard

Cas du mode O
\layout Standard

On considere la diffusion quasilineaire a l'harmonique 
\begin_inset Formula $n$
\end_inset 

 par l'onde EC avec une polarisation de mode O de sorte que la composante
 predominante du champ electrique soit 
\begin_inset Formula $E_{\mathbf{k},\Vert}$
\end_inset 

.
 On a alors 
\begin_inset Formula \[
D_{\mathbf{k}}^{\text{EC-O}(n)}\simeq q_{e}^{2}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\left|E_{\mathbf{k},\Vert}\right|^{2}J_{n}^{2}\]

\end_inset 


\layout Standard

On se limite egalement aux cas 
\begin_inset Formula \[
\frac{k_{\bot}v_{\bot}}{\Omega}\simeq n\frac{v_{\bot}}{c}<1\]

\end_inset 

 de sorte que 
\begin_inset Formula \[
J_{n}(z)\simeq\frac{(z/2)^{n}}{n!}\]

\end_inset 

 et 
\begin_inset Formula \begin{eqnarray*}
D_{\mathbf{k}}^{\text{EC-O}(n)} & \simeq & \frac{1}{n!^{2}}\left(\frac{k_{\bot}v_{\bot}}{2\Omega}\right)^{2n}q_{e}^{2}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\left|E_{\mathbf{k},\Vert}\right|^{2}\\
 & = & \frac{1}{n!^{2}}\left(N_{\bot}\frac{\gamma v_{\bot}}{c}\frac{\omega}{2\omega_{ce}}\right)^{2n}q_{e}^{2}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\left|E_{\mathbf{k},\Vert}\right|^{2}\end{eqnarray*}

\end_inset 


\layout Standard

Ainsi, le coefficient de diffusion quasilineaire pour l'onde EC en mode
 O devient 
\begin_inset Formula \begin{eqnarray*}
D^{\text{EC-O}(n)}(p,\xi) & = & \left(\frac{p_{\bot}}{p_{Te}}\right)^{2n}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\\
 &  & \times\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\frac{1}{n!^{2}}\left(N_{\bot}\frac{p_{Te}}{m_{e}c}\frac{\omega}{2\omega_{ce}}\right)^{2n}\left|E_{\mathbf{k},\Vert}\right|^{2}\delta\left(\omega-k_{\Vert}v_{\Vert}-\frac{n\omega_{ce}}{\gamma}\right)\\
 & = & \left(\frac{p_{\bot}}{p_{Te}}\right)^{2n}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\frac{v_{Te}}{\left|v_{\Vert}\right|}\\
 &  & \times\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}}{V}\int\frac{d^{3}k}{(2\pi)^{3}}\frac{1}{n!^{2}}\left(N_{\bot}\frac{p_{Te}}{m_{e}c}\frac{\omega}{2\omega_{ce}}\right)^{2n}\left|E_{\mathbf{k},\Vert}\right|^{2}\delta\left(k_{\Vert}-\frac{\omega}{v_{\Vert}}+\frac{n\omega_{ce}}{\gamma v_{\Vert}}\right)\frac{1}{v_{Te}}\end{eqnarray*}

\end_inset 


\layout Standard

On considere un rayon EC a une position polo\i \"{\i}
dale particuliere 
\begin_inset Formula $\theta=\theta_{b}$
\end_inset 

, avec un spectre du champ electrique gaussien en 
\begin_inset Formula $k_{\Vert}$
\end_inset 

 centre autour de 
\begin_inset Formula $k_{\Vert,0}$
\end_inset 

 avec une demi-largeur 
\begin_inset Formula $\Delta k_{\Vert}$
\end_inset 

 a la valeur 
\begin_inset Formula $1/e$
\end_inset 

.
 Dans ces conditions, on peut modeliser le champ electrique par 
\begin_inset Formula \[
\left|E_{\mathbf{k},\Vert}\right|^{2}(k_{\Vert},\overline{k}_{\bot})=\left|E_{\mathbf{k},\Vert,0}\right|^{2}(\overline{k}_{\bot})\exp\left(-\frac{\left(k_{\Vert}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\Delta\theta\delta(\theta-\theta_{b})\]

\end_inset 

 de sorte que 
\begin_inset Formula \[
D^{\text{EC-O}(n)}(p,\xi)=\left(\frac{p_{\bot}}{p_{Te}}\right)^{2n}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\frac{v_{Te}}{\left|v_{\Vert}\right|}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\]

\end_inset 

 avec 
\begin_inset Formula \[
D_{0}^{\text{EC-O}(n)}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\frac{1}{n!^{2}}\left(N_{\bot}\frac{p_{Te}}{m_{e}c}\frac{\omega}{2\omega_{ce}}\right)^{2n}\left|E_{\mathbf{k},\Vert,0}\right|^{2}(\overline{k}_{\bot})\frac{1}{v_{Te}}\]

\end_inset 

 et 
\begin_inset Formula \[
k_{\Vert,\text{res}}=\frac{\omega}{v_{\Vert}}\left(1-\frac{n\omega_{ce}}{\gamma\omega}\right)\]

\end_inset 


\layout Standard

Le coefficient de diffusion quasilineaire pour l'onde EC en mode O devient
 alors 
\begin_inset Formula \begin{eqnarray*}
D_{(0)}^{\text{EC-O}(n)}(p,\xi_{0}) & \equiv & \left\{ \Psi D^{\text{EC-O}(n)}(p,\xi)\right\} \\
 & = & \left\{ \Psi\left(\frac{p_{\bot}}{p_{Te}}\right)^{2n}\frac{p_{\Vert}^{2}}{p_{\bot}^{2}}\frac{v_{Te}}{\left|v_{\Vert}\right|}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-O}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2n}\xi_{0}^{2}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v|\xi_{0}|}\\
 &  & \times\left\{ \frac{\xi}{\xi_{0}}\Psi^{n}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-O}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2n}\xi_{0}^{2}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v|\xi_{0}|}\\
 &  & \frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}\int_{-\theta_{c}}^{\theta_{c}}\frac{d\theta}{2\pi}\Psi^{n}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-O}(n)}\end{eqnarray*}

\end_inset 

 et finalement 
\begin_inset Formula \begin{eqnarray*}
D_{(0)}^{\text{EC-O}(n)}(p,\xi_{0}) & \equiv & \left\{ \Psi D^{\text{EC-O}(n)}(p,\xi)\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2n}\xi_{0}^{2}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v|\xi_{0}|}\\
\times\frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}H(|\theta_{b}| & < & \theta_{c})\Psi_{b}^{n}\exp\left(-\frac{\left(k_{\Vert,\text{res},b}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)D_{0,b}^{\text{EC-O}(n)}\end{eqnarray*}

\end_inset 

 avec 
\begin_inset Formula \[
D_{0,b}^{\text{EC-O}(n)}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta_{b}}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\frac{1}{n!^{2}}\left(N_{\bot,b}\frac{p_{Te}}{m_{e}c}\frac{\omega_{b}}{2\omega_{ce}}\right)^{2n}\left|E_{\mathbf{k},\Vert,0,b}\right|^{2}(\overline{k}_{\bot})\frac{1}{v_{Te}}\]

\end_inset 









