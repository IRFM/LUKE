\layout Standard

Cas du mode X
\layout Standard


\begin_inset Formula \[ 
D^{\text{EC-X}(n)}(p,\xi)=\left(\frac{p_{\bot}}{p_{Te}}\right)^{2(n-1)}\frac{v_{Te}}{\left|v_{\Vert}\right|}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\]
\end_inset 

 avec 
\begin_inset Formula \[ 
D_{0}^{\text{EC-X}(n)}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\frac{1}{(n-1)!^{2}}\left(N_{\bot}\frac{p_{Te}}{m_{e}c}\frac{\omega}{2\omega_{ce}}\right)^{2(n-1)}\left|E_{\mathbf{k},-,0}\right|^{2}(\overline{k}_{\bot})\frac{1}{v_{Te}}\]
\end_inset 

 et 
\begin_inset Formula \[ 
k_{\Vert,\text{res}}=\frac{\omega}{v_{\Vert}}\left(1-\frac{n\omega_{ce}}{\gamma\omega}\right)\]
\end_inset 


\layout Standard

Les coefficients de diffusion quasilineaire pour l'onde EC en mode X deviennent
 alors 
\begin_inset Formula \begin{eqnarray*} 
\widetilde{D}_{(0)}^{\text{EC-X}(n)}(p,\xi_{0}) & \equiv & \sigma\left\{ \frac{\sigma\xi}{\xi_{0}}D^{\text{EC-X}(n)}(p,\xi)\right\} \\
 & = & \sigma\left\{ \frac{\sigma\xi}{\xi_{0}}\left(\frac{p_{\bot}}{p_{Te}}\right)^{2(n-1)}\frac{v_{Te}}{\left|v_{\Vert}\right|}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v\xi_{0}}\\
 &  & \times\left\{ \sigma\Psi^{(n-1)}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v\xi_{0}}\\
 &  & \frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}\int_{-\theta_{c}}^{\theta_{c}}\frac{d\theta}{2\pi}\sigma\frac{\xi_{0}}{\xi}\Psi^{(n-1)}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\end{eqnarray*}
\end_inset 

 et finalement 
\begin_inset Formula \begin{eqnarray*} 
\widetilde{D}_{(0)}^{\text{EC-X}(n)}(p,\xi_{0}) & \equiv & \left\{ \frac{\sigma\xi}{\xi_{0}}D^{\text{EC-X}(n)}(p,\xi)\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v\xi_{0}}\\
\times\frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}H(|\theta_{b}| & < & \theta_{c})\sigma\frac{\xi_{0}}{\xi_{b}}\Psi_{b}^{(n-1)}\exp\left(-\frac{\left(k_{\Vert,\text{res},b}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)D_{0,b}^{\text{EC-X}(n)}\end{eqnarray*}
\end_inset 

 avec 
\begin_inset Formula \[ 
D_{0,b}^{\text{EC-X}(n)}=\lim_{V\rightarrow\infty}\frac{\pi q_{e}^{2}\Delta\theta_{b}}{V}\int\frac{d^{2}k_{\bot}}{(2\pi)^{3}}\frac{1}{(n-1)!^{2}}\left(N_{\bot,b}\frac{p_{Te}}{m_{e}c}\frac{\omega_{b}}{2\omega_{ce}}\right)^{2(n-1)}\left|E_{\mathbf{k},-,0,b}\right|^{2}(\overline{k}_{\bot})\frac{1}{v_{Te}}\]
\end_inset 


\layout Standard

De meme
\layout Standard


\begin_inset Formula \begin{eqnarray*} 
\widetilde{D}_{F(0)}^{\text{EC-X}(n)}(p,\xi_{0}) & \equiv & \sigma\left\{ \left(\Psi(\theta)-1\right)\frac{\sigma\xi_{0}}{\xi}D^{\text{EC-X}(n)}(p,\xi)\right\} \\
 & = & \sigma\left\{ \frac{\left(\Psi(\theta)-1\right)\sigma\xi_{0}}{\xi}\left(\frac{p_{\bot}}{p_{Te}}\right)^{2(n-1)}\frac{v_{Te}}{\left|v_{\Vert}\right|}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v\xi_{0}}\\
 &  & \times\left\{ \sigma\frac{\xi_{0}^{2}}{\xi^{2}}\left(\Psi-1\right)\Psi^{(n-1)}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v\xi_{0}}\\
 &  & \frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}\int_{-\theta_{c}}^{\theta_{c}}\frac{d\theta}{2\pi}\sigma\frac{\xi_{0}^{3}}{\xi^{3}}\left(\Psi-1\right)\Psi^{(n-1)}\exp\left(-\frac{\left(k_{\Vert,\text{res}}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)2\pi\delta(\theta-\theta_{b})D_{0}^{\text{EC-X}(n)}\end{eqnarray*}
\end_inset 

 et finalement 
\begin_inset Formula \begin{eqnarray*} 
\widetilde{D}_{F(0)}^{\text{EC-X}(n)}(p,\xi_{0}) & \equiv & \left\{ \left(\Psi(\theta)-1\right)\frac{\sigma\xi_{0}}{\xi}D^{\text{EC-X}(n)}(p,\xi)\right\} \\
 & = & \left(\frac{p}{p_{Te}}\right)^{2(n-1)}\left(1-\xi_{0}^{2}\right)^{(n-1)}\frac{v_{Te}}{v\xi_{0}}\\
\times\frac{1}{\lambda}\left[\frac{1}{2}\sum_{\sigma=\pm1}\right]_{T}H(|\theta_{b}| & < & \theta_{c})\sigma\frac{\xi_{0}^{3}}{\xi_{b}^{3}}\left(\Psi_{b}-1\right)\Psi_{b}^{(n-1)}\exp\left(-\frac{\left(k_{\Vert,\text{res},b}-k_{\Vert,0}\right)^{2}}{\Delta k_{\Vert}^{2}}\right)D_{0,b}^{\text{EC-X}(n)}\end{eqnarray*}
\end_inset 


