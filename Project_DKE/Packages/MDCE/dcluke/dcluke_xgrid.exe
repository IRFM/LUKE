"$LUKE_matlabroot"matlab -nodesktop -r "luke_root = getenv('LUKE_path');addpath([luke_root,'Project_DKE/DKE']);setpath_luke_jd(luke_root);disp([' Path set to ',luke_root]);luke_datapath = getenv('LUKE_datapath');cd(luke_datapath);dcluke_id = getenv('LUKE_timeid');load(['input_dcluke_',dcluke_id,'.mat']);noms = fieldnames(data.appdata);for  k = 1:length(noms),setappdata(0,noms{k},data.appdata.(noms{k}));end;cd(data.dir);diary(data.diaryfile);clear resultat;try,[resultat{1:nargout(data.commande)}] =  feval(data.commande,data.entrees{:});etat_sortie = 0;catch,etat_sortie = 1;end;etat_error = lasterr;save(data.outputdata,'resultat','etat_sortie','etat_error');diary off;exit;"
