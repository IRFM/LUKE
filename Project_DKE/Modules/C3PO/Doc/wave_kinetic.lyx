\begin_layout Standard
We now derive the second order Vlasov equation for the wave 
\begin_inset Formula $\left[\check{f}_{e}^{\left(2\right)},\check{\mathbf{E}}^{\left(2\right)},\mathbf{\check{B}}^{\left(2\right)}\right]$
\end_inset

 , starting from the second order Vlasov equation:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathcal{L}f_{e}^{\left(2\right)}=-\mathbf{F}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\mathbf{F}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}\label{eq:Vlasov2app}\end{equation}

\end_inset

 This equation is linear in second order quantities, so we can construct
 a second order solution a sum of three elements 
\begin_inset Formula $\left[f_{e}^{\left(2\right)},\mathbf{E}^{\left(2\right)},\mathbf{B}^{\left(2\right)}\right]$
\end_inset

, 
\begin_inset Formula $\left[\widetilde{f}_{e}^{\left(2\right)},\widetilde{\mathbf{E}}^{\left(2\right)},\mathbf{\widetilde{B}}^{\left(2\right)}\right]$
\end_inset

 and 
\begin_inset Formula $\left[\check{f}_{e}^{\left(2\right)},\check{\mathbf{E}}^{\left(2\right)},\mathbf{\check{B}}^{\left(2\right)}\right]$
\end_inset

, where 
\begin_inset Formula $\left[\check{f}_{e}^{\left(2\right)},\check{\mathbf{E}}^{\left(2\right)},\mathbf{\check{B}}^{\left(2\right)}\right]$
\end_inset

 is a purely second order process:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathcal{L}\left(\check{f}_{e}^{\left(2\right)}+f_{e}^{\left(2\right)}+\widetilde{f}_{e}^{\left(2\right)}\right)=-\left(\mathbf{\check{F}}^{\left(2\right)}+\mathbf{F}^{\left(2\right)}+\mathbf{\widetilde{F}}^{\left(2\right)}\right)\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\left(\mathbf{F}^{\left(1\right)}+\mathbf{\widetilde{F}}^{\left(1\right)}\right)\cdot\frac{\partial}{\partial\mathbf{p}}\left(f_{e}^{\left(1\right)}+\widetilde{f}_{e}^{\left(1\right)}\right)\]

\end_inset


\end_layout

\begin_layout Standard
So using the linear propriety it becomes:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathcal{L}\check{f}_{e}^{\left(2\right)}+\mathcal{L}f_{e}^{\left(2\right)}+\mathcal{L}\widetilde{f}_{e}^{\left(2\right)}=-\mathbf{\check{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\mathbf{F}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\mathbf{\widetilde{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
-\mathbf{F}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\mathrm{\mathbf{F}}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\mathbf{\widetilde{F}}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\mathbf{\widetilde{F}}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}\]

\end_inset


\end_layout

\begin_layout Standard
And then:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathcal{L}\check{f}_{e}^{\left(2\right)}+\mathcal{L}f_{e}^{\left(2\right)}+\mathcal{L}\widetilde{f}_{e}^{\left(2\right)}=-\mathbf{\check{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\mathbf{F}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\mathbf{\mathbf{\widetilde{F}}}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
-\left(\mathbf{F}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}+\mathrm{\mathbf{F}}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}\right)-\left(\mathbf{\widetilde{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}+\mathbf{\widetilde{F}}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}\right)\label{eq:Vlasovsum}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Elements 
\begin_inset Formula $\left[f_{e}^{\left(2\right)},\mathbf{E}^{\left(2\right)},\mathbf{B}^{\left(2\right)}\right]$
\end_inset

 and 
\begin_inset Formula $\left[\widetilde{f}_{e}^{\left(2\right)},\widetilde{\mathbf{E}}^{\left(2\right)},\mathbf{\widetilde{B}}^{\left(2\right)}\right]$
\end_inset

 are singularly solution the second order Vlasov equation:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{eqnarray}
\mathcal{L}f_{e}^{\left(2\right)} & = & -\mathbf{F}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\mathbf{F}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}\label{eq:vlasov2Aapp}\\
\mathcal{L}\widetilde{f}_{e}^{\left(2\right)} & = & -\widetilde{\mathbf{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\widetilde{\mathbf{F}}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}\label{eq:vlasov2Bapp}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
So using the equations (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:vlasov2Aapp"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:vlasov2Bapp"

\end_inset

) for simplifying the (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Vlasovsum"

\end_inset

) we obtain:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathcal{L}\check{f}_{e}^{\left(2\right)}=-\check{\mathbf{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\mathbf{F}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\widetilde{\mathbf{F}}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}\label{eq:vlasov2Capp}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
that is the equation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:vlasov2C"

\end_inset

).
 We can represent 
\begin_inset Formula $\check{f}_{e}^{\left(2\right)}$
\end_inset

 as 
\begin_inset Formula $\check{f_{e}}^{\left(2\right)}=\check{f}_{lin}^{\left(2\right)}+\check{f}_{int}^{\left(2\right)}$
\end_inset

, remenbering the linearity of 
\begin_inset Formula $\mathcal{L}$
\end_inset

we have 
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathcal{L}\check{f}_{e}^{\left(2\right)}=\mathcal{L}\left(\check{f}_{lin}^{\left(2\right)}+\check{f}_{int}^{\left(2\right)}\right)=\mathcal{L}\check{f}_{lin}^{\left(2\right)}+\mathcal{L}\check{f}_{int}^{\left(2\right)}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
=-\check{\mathbf{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}-\mathbf{F}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\widetilde{\mathbf{F}}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}\label{eq:vlasov2Capp2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\check{f}_{lin}^{\left(2\right)}$
\end_inset

 satisfies the part of the equation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:vlasov2Capplinear"

\end_inset

) linear in second order quantities:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathcal{L}\check{f}_{lin}^{\left(2\right)}=-\check{\mathbf{F}}^{\left(2\right)}\cdot\frac{\partial f_{e}^{\left(0\right)}}{\partial\mathbf{p}}\label{eq:vlasov2Capplinear}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
While 
\begin_inset Formula $\check{f}_{int}^{\left(2\right)}$
\end_inset

satisfies the bilinear part:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathcal{L}\check{f}_{int}^{\left(2\right)}=-\mathbf{F}^{\left(1\right)}\cdot\frac{\partial\widetilde{f}_{e}^{\left(1\right)}}{\partial\mathbf{p}}-\widetilde{\mathbf{F}}^{\left(1\right)}\cdot\frac{\partial f_{e}^{\left(1\right)}}{\partial\mathbf{p}}\label{eq:vlasoc2Cappbilinear}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
So we have two currents:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{\check{J}}_{lin}^{\left(1\right)}=q_{e}\int\mathbf{v}\check{f}_{lin}^{\left(2\right)}\textrm{d}\mathbf{p}\qquad\mathbf{\check{J}}_{int}^{\left(2\right)}=q_{e}\int\mathbf{v}\check{f}_{int}^{\left(2\right)}\textrm{d}\mathbf{p}\label{eq:current2app}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
So 
\begin_inset Formula $\check{\mathbf{J}}_{lin}^{\left(2\right)}$
\end_inset

 is the second order current due to the linear response of the plasma to
 the field of the scattered wave, and 
\begin_inset Formula $\mathbf{J}_{int}^{\left(2\right)}$
\end_inset

 is the current due to the interaction of the incident wave with the fluctuation
s.
 The electromagnetic field of the scattered wave is then solution of the
 second-order wave equation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wavequation"

\end_inset

):
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\nabla\times\nabla\times\check{\mathbf{E}}^{\left(2\right)}+\varepsilon_{0}\mu_{0}\frac{\partial^{2}\check{\mathbf{E}}^{\left(2\right)}}{\partial\textrm{t}^{2}}=-\mu_{0}\frac{\partial}{\partial\textrm{t}}\left(\check{\mathbf{J}}_{lin}^{\left(2\right)}+\mathbf{\check{J}}_{int}^{\left(2\right)}\right)\label{eq:wavequationapp}\end{equation}

\end_inset


\end_layout

\begin_layout Section*
Appendix D
\end_layout

\begin_layout Standard
We now derive in details the generalized fluid equations (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:continuity"

\end_inset

),(
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:motion"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:energy"

\end_inset

) by the moments analysis of the Vlasov equation:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial f_{e}}{\partial t}+\mathbf{v}\cdot\frac{\partial f_{e}}{\partial\mathbf{r}}+q_{e}\left(\mathbf{E}+\mathbf{v}\times\mathbf{B}\right)\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}=0\label{eq:vlasov}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The moment zero of the Vlasov equation is then:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\frac{\partial f_{e}}{\partial t}\textrm{d}\mathbf{p}+\mathbf{\int v}\cdot\nabla f_{e}\textrm{d}\mathbf{p}+q_{e}\int\left(\mathbf{E}+\mathbf{v}\times\mathbf{B}\right)\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\textrm{d}\mathbf{p}=0\label{eq:0ordervlasov}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We now analyze term by term this equation:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\frac{\partial f_{e}}{\partial t}\textrm{d}\mathbf{p}=\frac{\partial}{\partial t}\int f_{e}\textrm{d}\mathbf{p}=\frac{\partial n_{e}}{\partial t}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{v}\cdot\nabla f_{e}\textrm{d}\mathbf{p}=\nabla\cdot\int\mathbf{v}f_{e}\textrm{d}\mathbf{p}=\nabla\cdot\overline{\mathbf{v}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{E}\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\textrm{d}\mathbf{p}=\int\frac{\partial}{\partial\mathbf{p}}\cdot\left(\mathbf{E}f_{e}\right)\textrm{d}\mathbf{p}=\underset{S_{\infty}}{\int}\mathbf{E}f_{e}\textrm{d}\mathbf{S}=0\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\int\left(\mathbf{v}\times\mathbf{B}\right)\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\textrm{d}\mathbf{p}=\int\frac{\partial}{\partial\mathbf{p}}\left(f_{e}\mathbf{v}\times\mathbf{B}\right)\textrm{d}\mathbf{p}-\int f_{e}\frac{\partial}{\partial\mathbf{p}}\left(\mathbf{v}\times\mathbf{B}\right)\textrm{d}\mathbf{p}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
=\underset{S_{\infty}}{\int}\left(f_{e}\mathbf{v}\times\mathbf{B}\right)\textrm{d}\mathbf{S}=0\end{equation}

\end_inset


\end_layout

\begin_layout Standard
For the two surfaces integrals we have assumed the surface 
\begin_inset Formula $S_{\infty}$
\end_inset

 to the infinity, the surface area increases as 
\begin_inset Formula $v^{2}$
\end_inset

, but a real distribution 
\begin_inset Formula $f_{e}$
\end_inset

 vanishes much faster for 
\begin_inset Formula $v\rightarrow\infty$
\end_inset

 so the intergal on the infinity surfaces also vanishes.
 The second integral of the last term is zero because 
\begin_inset Formula $\partial/\partial\mathbf{p}$
\end_inset

 is perpendicular to 
\begin_inset Formula $\mathbf{v}\times\mathbf{B}$
\end_inset

.
 So the moment zero (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:0ordervlasov"

\end_inset

) is the continuity equation:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial n_{e}}{\partial t}+\nabla\cdot\overline{\mathbf{v}}=0\label{eq:continuityapp}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The moment one of the Vlasov equation is:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{v}\frac{\partial f_{e}}{\partial t}\textrm{d}\mathbf{p}+\mathbf{\int}\mathbf{v}\left(\mathbf{v}\cdot\nabla f_{e}\right)\textrm{d}\mathbf{p}+q_{e}\int\mathbf{v}\left(\mathbf{E}+\mathbf{v}\times\mathbf{B}\right)\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\textrm{d}\mathbf{p}=0\label{eq:1ordervlasov}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Term by term:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{v}\frac{\partial f_{e}}{\partial t}\textrm{d}\mathbf{p}=\frac{\partial}{\partial t}\int\mathbf{v}f_{e}\textrm{d}\mathbf{p}=\frac{\partial\overline{\mathbf{v}}}{\partial t}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{v}\left(\mathbf{v}\cdot\nabla f_{e}\right)\textrm{d}\mathbf{p}=\nabla\cdot\int\mathbf{v}\mathbf{v}f_{e}\textrm{d}\mathbf{p}=\nabla\cdot\overline{\mathbf{vv}}\end{equation}

\end_inset


\begin_inset Formula \[
\int\mathbf{v}\left(\mathbf{E}\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\right)\textrm{d}\mathbf{p}=\int\frac{\partial}{\partial\mathbf{p}}\cdot\left(f_{e}\mathbf{v}\mathbf{E}\right)\textrm{d}\mathbf{p}-\frac{1}{m_{e}}\int f_{e}\mathbf{E}\textrm{d}\mathbf{p}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
=\underset{S_{\infty}}{\int}\left(f_{e}\mathbf{p}\mathbf{E}\right)\textrm{d}\mathbf{S}-\frac{\mathbf{E}}{m_{e}}\int f_{e}\textrm{d}\mathbf{p}=-\frac{n_{e}\mathbf{E}}{m_{e}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\int\mathbf{v}\left(\mathbf{v}\times\mathbf{B}\right)\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\textrm{d}\mathbf{p}=\int\frac{\partial}{\partial\mathbf{p}}\left[f_{e}\mathbf{v}\left(\mathbf{v}\times\mathbf{B}\right)\right]\textrm{d}\mathbf{p}-\frac{1}{m_{e}}\int f_{e}\left(\mathbf{v}\times\mathbf{B}\right)\textrm{d}\mathbf{p}-\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
-\int f_{e}\mathbf{v}\frac{\partial}{\partial\mathbf{p}}\cdot\left(\mathbf{v}\times\mathbf{B}\right)\textrm{d}\mathbf{p}=\underset{S_{\infty}}{\int}\left[f_{e}\mathbf{v}\left(\mathbf{v}\times\mathbf{B}\right)\right]\textrm{d}\mathbf{S}-\frac{1}{m_{e}}\int\mathbf{v}f_{e}\textrm{d}\mathbf{p}\times\mathbf{B}=-\frac{1}{m_{e}}\left(\overline{\mathbf{v}}\times\mathbf{B}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
So the moment one of the Vlasov equation is the equation for motion:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\overline{\mathbf{v}}}{\partial t}+\nabla\cdot\overline{\mathbf{vv}}-\frac{q_{e}}{m_{e}}\left(n_{e}\mathbf{E}+\mathbf{\overline{v}}\times\mathbf{B}\right)=0\label{eq:motionapp}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The second moment is:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{v}\mathbf{v}\frac{\partial f_{e}}{\partial t}\textrm{d}\mathbf{p}+\mathbf{\int\mathbf{v}}\mathbf{v}\left(\mathbf{v}\cdot\nabla f_{e}\right)\textrm{d}\mathbf{p}+q_{e}\int\mathbf{v}\mathbf{v}\left(\mathbf{E}+\mathbf{v}\times\mathbf{B}\right)\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\textrm{d}\mathbf{p}=0\label{eq:2ordervlasov}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Term by term:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{vv}\frac{\partial f_{e}}{\partial t}\textrm{d}\mathbf{p}=\frac{\partial}{\partial t}\int\mathbf{vv}f_{e}\textrm{d}\mathbf{p}=\frac{\partial\overline{\mathbf{vv}}}{\partial t}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\int\mathbf{vv}\left(\mathbf{v}\cdot\nabla f_{e}\right)\textrm{d}\mathbf{p}=\nabla\cdot\int\mathbf{vv}\mathbf{v}f_{e}\textrm{d}\mathbf{p}=\nabla\cdot\overline{\mathbf{vvv}}\end{equation}

\end_inset


\begin_inset Formula \[
\int\mathbf{vv}\left(\mathbf{E}\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\right)\textrm{d}\mathbf{p}=\int\frac{\partial}{\partial\mathbf{p}}\cdot\left(f_{e}\mathbf{vv}\mathbf{E}\right)\textrm{d}\mathbf{p}-\frac{1}{m_{e}}\int f_{e}\mathbf{vE}\textrm{d}\mathbf{p}-\frac{1}{m_{e}}\int f_{e}\mathbf{E}\mathbf{v}\textrm{d}\mathbf{p=}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
=\underset{S_{\infty}}{\int}\left(f_{e}\mathbf{vv}\mathbf{E}\right)\textrm{d}\mathbf{S}-\int\mathbf{v}f_{e}\textrm{d}\mathbf{p}\frac{\mathbf{E}}{m_{e}}-\frac{\mathrm{\mathbf{E}}}{m_{e}}\int\mathbf{v}f_{e}\textrm{d}\mathbf{p}=-\frac{1}{m_{e}}\left(\overline{\mathbf{v}}\mathbf{E}+\mathbf{E}\overline{\mathbf{v}}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\int\mathbf{vv}\left(\mathbf{v}\times\mathbf{B}\right)\cdot\frac{\partial f_{e}}{\partial\mathbf{p}}\textrm{d}\mathbf{p}=\int\frac{\partial}{\partial\mathbf{p}}\left[f_{e}\mathbf{vv}\left(\mathbf{v}\times\mathbf{B}\right)\right]\textrm{d}\mathbf{p}-\frac{1}{m_{e}}\int f_{e}\mathbf{v}\left(\mathbf{v}\times\mathbf{B}\right)\textrm{d}\mathbf{p}-\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
-\frac{1}{m_{e}}\int f_{e}\left(\mathbf{v}\times\mathbf{B}\right)\mathbf{v}\textrm{d}\mathbf{p}-\int f_{e}\mathbf{vv}\frac{\partial}{\partial\mathbf{p}}\cdot\left(\mathbf{v}\times\mathbf{B}\right)=\underset{S_{\infty}}{\int}\left[f_{e}\mathbf{vv}\left(\mathbf{v}\times\mathbf{B}\right)\right]\textrm{d}\mathbf{S}-\frac{1}{m_{e}}\int\mathbf{vv}f_{e}\textrm{d}\mathbf{p}\times\mathbf{B}+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
+\frac{1}{m_{e}}\mathbf{B}\times\int\mathbf{vv}f_{e}\textrm{d}\mathbf{p}=-\frac{1}{m_{e}}\left(\overline{\mathbf{vv}}\times\mathbf{B}-\mathbf{B}\times\overline{\mathbf{vv}}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
So the second moment of the Vlasov equation is the generalized energy transport
 equation:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{\overline{vv}}}{\partial t}+\nabla\cdot\mathbf{\overline{vvv}}-\frac{q_{e}}{m_{e}}\left[\mathbf{\overline{v}E}+\mathbf{E\overline{v}}+\left(\mathbf{\overline{vv}}\times\mathbf{B}\right)-\left(\mathbf{B}\times\mathbf{\overline{vv}}\right)\right]=0\label{eq:energyapp}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
It is interesting to note that starting from this general equation it is
 possible to derive an explicit equation for the energy transport, infact
 the kinetic energy density 
\begin_inset Formula $\varepsilon$
\end_inset

is determined by the sum of the diagonal terms of the diad 
\begin_inset Formula $\mathbf{\overline{vv}}$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\varepsilon=\frac{m_{e}}{2}\int v^{2}f_{e}\textrm{d}\mathbf{p}=\frac{m_{e}}{2}\int\left(v_{1}^{2}+v_{2}^{2}+v_{3}^{2}\right)f_{e}\textrm{d}\mathbf{p}\label{eq:energydensity}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The detailed derivation of the transport equation for 
\begin_inset Formula $\varepsilon$
\end_inset

 starting by the (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:energyapp"

\end_inset

) is described in reference 
\begin_inset CommandInset citation
LatexCommand cite
key "Bitt"

\end_inset

.
\end_layout

\begin_layout Section*
Appendix E
\end_layout

\begin_layout Standard
In this appendix we derive in details the relation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:veltensor2"

\end_inset

) between the tensor 
\begin_inset Formula $\mathbb{T}$
\end_inset

 and the susceptibility tensor 
\begin_inset Formula $\mathbb{X}$
\end_inset

.
 
\begin_inset Formula $\mathbb{T}$
\end_inset

 is the tensor that exprimes the linearized equation for motion in the Fourier
 space with the matricial representetion.
 As we have shown in our model, the linearized equation for motion is the
 first order equation for motion and the first order quantities are due
 to the linear waves and to the linear response of the plasma to these linear
 sollecitations.
 So we rewrite the linearized equation for motion and the first order current:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\frac{\partial\mathbf{u}^{\left(1\right)}}{\partial t}=\frac{q_{e}}{m_{e}}\left(\mathbf{E}^{\left(1\right)}+\mathbf{u}^{\left(1\right)}\times\mathbf{B}^{\left(0\right)}\right)\label{eq:1ordermotionCOLD}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{J}^{\left(1\right)}=q_{e}n_{e}^{\left(0\right)}\mathbf{u}^{\left(1\right)}\label{eq:1ordercurrentCOLD}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
In the Fourier the equation for motion becomes:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
-i\omega\mathbf{u}^{\left(1\right)}-\frac{q_{e}B^{\left(0\right)}}{m_{e}}\left(\mathbf{u}^{\left(1\right)}\times\frac{\mathbf{B}^{\left(0\right)}}{B^{\left(0\right)}}\right)=\frac{q_{e}}{m_{e}}\mathbf{E}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)\]

\end_inset


\end_layout

\begin_layout Standard
And then:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbb{T}\left(\mathbf{k},\omega\right)\cdot\mathbf{u}^{\left(1\right)}=\frac{q_{e}}{m_{e}}\mathbf{E}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)\label{eq:fluidvelapp}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Where 
\begin_inset Formula $\mathbb{T}\left(\mathbf{k},\omega\right)$
\end_inset

 is the tensor:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbb{T}\left(\mathbf{k},\omega\right)=-i\omega\mathbb{I}-\omega_{ce}\left(\underline{\underline{\underline{\varepsilon}}}^{LC}\cdot\frac{\mathbf{B}^{\left(0\right)}}{B^{\left(0\right)}}\right)\label{eq:veltensor}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Where 
\begin_inset Formula $\omega_{pe}=q_{e}B^{\left(0\right)}/m_{e}$
\end_inset

 .The fluid velocity in the Fourier space is the given by the expression:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{u}^{\left(1\right)}=\frac{q_{e}}{m_{e}}\mathbb{T}^{-1}\left(\mathbf{k},\omega\right)\cdot\mathbf{E}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
and the current becomes:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{J}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)=\frac{q_{e}^{2}n_{e}^{\left(0\right)}}{m_{e}}\mathbb{T}^{-1}\left(\mathbf{k},\omega\right)\cdot\mathbf{E}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)\label{eq:currentappA}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Remembering that 
\begin_inset Formula $\mathbf{J}_{\mathbf{k}}^{\left(1\right)}$
\end_inset

is the current due to the linear propagatin of the wave in the medium, from
 the linear response theory we have:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{J}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)=\mathbb{S}\left(\mathbf{k},\omega\right)\cdot\mathbf{E}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)=-i\varepsilon_{0}\omega\mathbb{X}\left(\mathbf{k},\omega\right)\cdot\mathbf{E}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)\label{eq:currentappB}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Equaling the (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:currentappA"

\end_inset

) and the (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:currentappB"

\end_inset

) we obtain:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbb{T}^{-1}\left(\mathbf{k},\omega\right)=-i\frac{\varepsilon_{0}m_{e}\omega}{q_{e}^{2}n_{e}^{\left(0\right)}}\mathbb{X}\left(\mathbf{k,}\omega\right)=-i\frac{\omega}{\omega_{pe}^{2}}\mathbb{X}\left(\mathbf{k},\omega\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Using this results in the (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:fluidvelapp"

\end_inset

) we can exprime the first order fluid velocity in function of the susceptibilit
y tensor:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{u}^{\left(1\right)}=-i\frac{\omega\varepsilon_{0}}{n_{e}^{\left(0\right)}q_{e}}\mathbb{X}\left(\mathbf{k},\omega\right)\cdot\mathbf{E}_{\mathbf{k}}^{\left(1\right)}\left(\mathbf{k},\omega\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
So we have also demonstrated the relation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:1ordervelINC"

\end_inset

).
\end_layout

\begin_layout Section*
Appendix F 
\end_layout

\begin_layout Standard
We now calculate explicitely the mode coupling coefficient for the density
 fluctuations 
\begin_inset Formula $V^{n}\left(\mathbf{\mathbf{k}},\check{\mathbf{k}},\omega_{k}\right)$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
V^{n}\left(\mathbf{k},\check{\mathbf{k}},\omega_{k}\right)=\frac{\omega_{k}}{2}\frac{\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\left(\mathbb{I}-\mathbb{K}\left(\mathbf{k}\right)\right)\cdot\mathbf{e}\left(\mathbf{k}\right)}{\left(\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{M}\cdot\check{\mathbf{e}}\left(\check{\mathbf{k}}\right)\right)^{\frac{1}{2}}\cdot\left(\mathbf{e^{\star}}\left(\mathbf{k}\right)\cdot\mathbb{M}\cdot\mathbf{e}\left(\mathbf{k}\right)\right)^{\frac{1}{2}}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Remembering that 
\begin_inset Formula $\mathbb{K}=\mathbb{I}+\mathbb{X},$
\end_inset

 we can exprime this coefficint in function of the susceptibility tensor:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
V^{n}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)=-\frac{\omega_{k}}{2}\frac{\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{X}\left(\mathbf{k}\right)\cdot\mathbf{e}\left(\mathbf{k}\right)}{\left(\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{M}\cdot\check{\mathbf{e}}\left(\check{\mathbf{k}}\right)\right)^{\frac{1}{2}}\cdot\left(\mathbf{e^{\star}}\left(\mathbf{k}\right)\cdot\mathbb{M}\cdot\mathbf{e}\left(\mathbf{k}\right)\right)^{\frac{1}{2}}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The numerator of the fraction is given by the product:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{X}\left(\mathbf{k}\right)\cdot\mathbf{e}\left(\mathbf{k}\right)=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
=\check{e}_{x}^{\star}e_{x}X_{xx}+\check{e}_{y}^{\star}e_{x}X_{yx}+\check{e}_{z}^{\star}e_{x}X_{zx}+\check{e}_{x}^{\star}e_{y}X_{xy}+\check{e}_{y}^{\star}e_{y}X_{yy}+\check{e}_{z}^{\star}e_{y}X_{zy}+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\check{e}_{x}^{\star}e_{z}X_{xz}+\check{e}_{y}^{\star}e_{z}X_{yz}+\check{e}_{z}^{\star}e_{z}X_{zz}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
=\check{e}_{x}^{\star}\left[e_{x}X_{xx}+e_{y}X_{xy}+e_{z}X_{xz}\right]+\check{e}_{y}^{\star}\left[e_{x}X_{yx}+e_{y}X_{yy}+e_{z}X_{yz}\right]+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
+\check{e}_{z}^{\star}\left[e_{x}X_{zx}+e_{y}X_{zy}+e_{z}X_{zz}\right]\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The two factors of the denominator are:
\begin_inset Formula \[
\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{M}\cdot\check{\mathbf{e}}\left(\check{\mathbf{k}}\right)=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
=\check{e}_{x}^{\star}\check{e}_{x}M_{xx}+\check{e}_{y}^{\star}\check{e}_{x}M_{yx}+\check{e}_{z}^{\star}\check{e}_{x}M_{zx}+\check{e}_{x}^{\star}\check{e}_{y}M_{xy}+\check{e}_{y}^{\star}\check{e}_{y}M_{yy}+\check{e}_{z}^{\star}\check{e}_{y}M_{zx}+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\check{e}_{x}^{\star}\check{e}_{z}M_{xz}+\check{e}_{y}^{\star}\check{e}_{z}M_{yz}+\check{e}_{z}^{\star}\check{e}_{z}M_{zz}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
=\check{e}_{x}^{\star}\left[\check{e}_{x}M_{xx}+\check{e}_{y}M_{xy}+\check{e}_{z}M_{xz}\right]+\check{e}_{y}^{\star}\left[\check{e}_{x}M_{yx}+\check{e}_{y}M_{yy}+\check{e}_{z}M_{yz}\right]+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
+\check{e}_{z}^{\star}\left[\check{e}_{x}M_{zx}+\check{e}_{y}M_{zy}+\check{e}_{z}M_{zz}\right]\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{e}^{\star}\left(\mathbf{k}\right)\cdot\mathbb{M}\cdot\mathbf{e}\left(\mathbf{k}\right)=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
=e_{x}^{\star}e_{x}M_{xx}+e_{y}^{\star}e_{x}M_{yx}+e_{z}^{\star}e_{x}M_{zx}+e_{x}^{\star}e_{y}M_{xy}+e_{y}^{\star}e_{y}M_{yy}+e_{z}^{\star}e_{y}M_{zy}+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+e_{x}^{\star}e_{z}M_{xz}+e_{y}^{\star}e_{z}M_{yz}+e_{z}^{\star}e_{z}M_{zz}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
=e_{x}^{\star}\left[e_{x}M_{xx}+e_{y}M_{xy}+e_{z}M_{xz}\right]+e_{y}^{\star}\left[e_{x}M_{yx}+e_{y}M_{yy}+e_{z}M_{yz}\right]+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
+e_{z}^{\star}\left[e_{x}M_{zx}+e_{y}M_{zy}+e_{z}M_{zz}\right]\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We need an expression for the tensor 
\begin_inset Formula $\mathbb{M}$
\end_inset

 and for the polarization vector.
 Remembering that the dispersion tensor is given by:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbb{D}=\left(\begin{array}{ccc}
K_{xx}-N_{\parallel}^{2} & K_{xy} & K_{xz}+N_{\perp}N_{\parallel}\\
-K_{xy} & K_{yy}-N^{2} & K_{yz}\\
K_{xz}+N_{\perp}N_{\parallel} & -K_{yz} & K_{zz}-N_{\perp}^{2}\end{array}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
And that 
\begin_inset Formula $\mathbb{K}=\mathbb{I}+\mathbb{X}$
\end_inset

, the elements of the tensor 
\begin_inset Formula $\mathbb{M}$
\end_inset

 are:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{eqnarray*}
M_{xx} & = & \frac{\omega_{k}}{2}\frac{\partial D_{xx}}{\partial\omega}=\frac{\omega_{k}}{2}\frac{\partial X_{xx}}{\partial\omega}+N_{\parallel}^{2}\\
M_{xy} & = & \frac{\omega_{k}}{2}\frac{\partial D_{xy}}{\partial\omega}=\frac{\omega_{k}}{2}\frac{\partial X_{xy}}{\partial\omega}\\
M_{xz} & = & \frac{\omega_{k}}{2}\frac{\partial D_{xz}}{\partial\omega}=\frac{\omega_{k}}{2}\frac{\partial X_{xz}}{\partial\omega}-N_{\perp}N_{\parallel}\\
M_{yx} & = & \frac{\omega_{k}}{2}\frac{\partial D_{yx}}{\partial\omega}=-\frac{\omega_{k}}{2}\frac{\partial X_{xy}}{\partial\omega}\\
M_{yy} & = & \frac{\omega_{k}}{2}\frac{\partial D_{yy}}{\partial\omega}=\frac{\omega_{k}}{2}\frac{\partial X_{yy}}{\partial\omega}+N^{2}\\
M_{yz} & = & \frac{\omega_{k}}{2}\frac{\partial D_{yz}}{\partial\omega}=\frac{\omega_{k}}{2}\frac{\partial X_{yz}}{\partial\omega}\\
M_{zx} & = & \frac{\omega_{k}}{2}\frac{\partial D_{zx}}{\partial\omega}=\frac{\omega_{k}}{2}\frac{\partial X_{zx}}{\partial\omega}-N_{\perp}N_{\parallel}\\
M_{zy} & = & \frac{\omega_{k}}{2}\frac{\partial D_{zy}}{\partial\omega}=-\frac{\omega_{k}}{2}\frac{\partial X_{yz}}{\partial\omega}\\
M_{zz} & = & \frac{\omega_{k}}{2}\frac{\partial D_{zz}}{\partial\omega}=\frac{\omega_{k}}{2}\frac{\partial X_{zz}}{\partial\omega}+N_{\perp}^{2}\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
So the tensor 
\begin_inset Formula $\mathbb{M}$
\end_inset

 is:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbb{M}=\frac{\omega_{k}}{2}\frac{\partial\mathbb{D}}{\partial\omega}=\left(\begin{array}{ccc}
\frac{\omega_{k}}{2}\frac{\partial X_{xx}}{\partial\omega}+N_{\parallel}^{2} & \frac{\omega_{k}}{2}\frac{\partial X_{xy}}{\partial\omega} & \frac{\omega_{k}}{2}\frac{\partial X_{xz}}{\partial\omega}-N_{\perp}N_{\parallel}\\
-\frac{\omega_{k}}{2}\frac{\partial X_{xy}}{\partial\omega} & \frac{\omega_{k}}{2}\frac{\partial X_{yy}}{\partial\omega}+N^{2} & \frac{\omega_{k}}{2}\frac{\partial X_{yz}}{\partial\omega}\\
\frac{\omega_{k}}{2}\frac{\partial X_{xz}}{\partial\omega}-N_{\perp}N_{\parallel} & -\frac{\omega_{k}}{2}\frac{\partial X_{yz}}{\partial\omega} & \frac{\omega_{k}}{2}\frac{\partial X_{zz}}{\partial\omega}+N_{\perp}^{2}\end{array}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The derivatives of the elements of the susceptibility tensor 
\begin_inset Formula $\mathbb{X}\left(\mathbf{N},\beta_{Ts},\overline{\omega}_{ps},\overline{\omega}_{cs}\right)$
\end_inset

 respect to the frequency 
\begin_inset Formula $\omega$
\end_inset

 are given by the expressions:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial X_{xx}}{\partial\omega}=\frac{\partial X_{xx}}{\partial\overline{\omega}_{ps}}\frac{\partial\overline{\omega}_{ps}}{\partial\omega}+\frac{\partial X_{xx}}{\partial\overline{\omega}_{cs}}\frac{\partial\overline{\omega}_{cs}}{\partial\omega}=-\frac{\partial X_{xx}}{\partial\overline{\omega}_{ps}}\frac{\overline{\omega}_{ps}}{\omega}-\frac{\partial X_{xx}}{\partial\overline{\omega}_{cs}}\frac{\overline{\omega}_{cs}}{\omega}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial X_{xy}}{\partial\omega}=\frac{\partial X_{xy}}{\partial\overline{\omega}_{ps}}\frac{\partial\overline{\omega}_{ps}}{\partial\omega}+\frac{\partial X_{xy}}{\partial\overline{\omega}_{cs}}\frac{\partial\overline{\omega}_{cs}}{\partial\omega}=-\frac{\partial X_{xy}}{\partial\overline{\omega}_{ps}}\frac{\overline{\omega}_{ps}}{\omega}-\frac{\partial X_{xy}}{\partial\overline{\omega}_{cs}}\frac{\overline{\omega}_{cs}}{\omega}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial X_{xz}}{\partial\omega}=\frac{\partial X_{xz}}{\partial\overline{\omega}_{ps}}\frac{\partial\overline{\omega}_{ps}}{\partial\omega}+\frac{\partial X_{xz}}{\partial\overline{\omega}_{cs}}\frac{\partial\overline{\omega}_{cs}}{\partial\omega}=-\frac{\partial X_{xz}}{\partial\overline{\omega}_{ps}}\frac{\overline{\omega}_{ps}}{\omega}-\frac{\partial X_{xz}}{\partial\overline{\omega}_{cs}}\frac{\overline{\omega}_{cs}}{\omega}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial X_{yy}}{\partial\omega}=\frac{\partial X_{yy}}{\partial\overline{\omega}_{ps}}\frac{\partial\overline{\omega}_{ps}}{\partial\omega}+\frac{\partial X_{yy}}{\partial\overline{\omega}_{cs}}\frac{\partial\overline{\omega}_{cs}}{\partial\omega}=-\frac{\partial X_{yy}}{\partial\overline{\omega}_{ps}}\frac{\overline{\omega}_{ps}}{\omega}-\frac{\partial X_{yy}}{\partial\overline{\omega}_{cs}}\frac{\overline{\omega}_{cs}}{\omega}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial X_{yz}}{\partial\omega}=\frac{\partial X_{yz}}{\partial\overline{\omega}_{ps}}\frac{\partial\overline{\omega}_{ps}}{\partial\omega}+\frac{\partial X_{yz}}{\partial\overline{\omega}_{cs}}\frac{\partial\overline{\omega}_{cs}}{\partial\omega}=-\frac{\partial X_{yz}}{\partial\overline{\omega}_{ps}}\frac{\overline{\omega}_{ps}}{\omega}-\frac{\partial X_{yz}}{\partial\overline{\omega}_{cs}}\frac{\overline{\omega}_{cs}}{\omega}\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\frac{\partial X_{zz}}{\partial\omega}=\frac{\partial X_{zz}}{\partial\overline{\omega}_{ps}}\frac{\partial\overline{\omega}_{ps}}{\partial\omega}+\frac{\partial X_{zz}}{\partial\overline{\omega}_{cs}}\frac{\partial\overline{\omega}_{cs}}{\partial\omega}=-\frac{\partial X_{zz}}{\partial\overline{\omega}_{ps}}\frac{\overline{\omega}_{ps}}{\omega}-\frac{\partial X_{zz}}{\partial\overline{\omega}_{cs}}\frac{\overline{\omega}_{cs}}{\omega}\]

\end_inset


\end_layout

\begin_layout Standard
The kernel of the scattering probability is given by the expression:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
K\left(k_{\perp}^{\sigma},\check{k}_{\perp}^{\sigma},\beta\right)=\frac{2\pi\check{k}_{\perp}^{\sigma}}{v_{G\perp}^{\sigma}}\left|V^{n}\left(\mathbf{k}^{\sigma},\check{\mathbf{k}}^{\sigma},\beta\right)\right|^{2}\end{equation}

\end_inset

Where the group velocity is evaluated for the scattered wave vector.
 The group velocity for the mode 
\begin_inset Formula $\sigma$
\end_inset

 is given by the expression:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{v}_{G}^{\sigma}=\frac{d\mathbf{X}}{dt}=\left.-\frac{\partial\mathcal{D}/\partial\mathbf{k}}{\partial\mathcal{D}/\partial\omega}\right|_{\mathbf{k}=\mathbf{k}^{\sigma}}\end{equation}

\end_inset

 We have demonstrated that the component of the group velocity perpendicular
 to the magnetic field can be calculated using the expression:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
v_{G\perp}=\left.-\frac{\partial\mathcal{D}/\partial k_{\perp}}{\partial\mathcal{D}/\partial\omega}\right|_{k_{\perp}=k_{\perp}^{\sigma}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $k_{\Vert}\simeq k_{\parallel}^{\sigma}$
\end_inset

 .
 So the kernel of the scattering probability becomes:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
K\left(k_{\perp}^{\sigma},\check{k}_{\perp}^{\sigma},\beta\right)=-2\pi\check{k}_{\perp}^{\sigma}\left.\frac{\partial\mathcal{D}/\partial\omega}{\partial\mathcal{D}/\partial k_{\perp}}\right|_{k_{\perp}=k_{\perp}^{\sigma}}\cdot\left|V^{n}\left(\mathbf{k}^{\sigma},\check{\mathbf{k}}^{\sigma},\beta\right)\right|\end{equation}

\end_inset


\end_layout

\begin_layout Section*
Appendix G
\end_layout

\begin_layout Standard
We now calculate explicitely the mode coupling coefficient for the density
 fluctuations 
\begin_inset Formula $\mathbf{V}^{\mathbf{B}}\left(\mathbf{\mathbf{k}},\check{\mathbf{k}},\omega\right)$
\end_inset

, it is important to note that while for density fluctuation the coupling
 coefficient is a scalar, for magnetic field's fluctuations it is a vector.
 We start from the expression, that is the term of the mode coupling equation
 due to the fluctuations of the magnetic field:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
i\frac{\omega_{ce}\check{\omega}_{\check{k}}^{2}}{2\omega_{pe}^{2}}\frac{\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\left(\mathbb{I}-\mathbb{K}\left(\check{\mathbf{k}}\right)\right)\cdot\left(\underline{\underline{\underline{\varepsilon}}}^{LC}\cdot\frac{\delta\mathbf{B}_{\check{\mathbf{k}}-\mathbf{k}}\left(\check{\mathbf{k}}-\mathbf{k}\right)}{B^{\left(0\right)}}\right)\cdot\left(\mathbb{I}-\mathbb{K}\left(\mathbf{k}\right)\right)\cdot\mathbf{e}\left(\mathbf{k}\right)}{\left(\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{M}\cdot\check{\mathbf{e}}\left(\check{\mathbf{k}}\right)\right)^{\frac{1}{2}}\left(\mathbf{e}^{\star}\left(\mathbf{k}\right)\cdot\mathbb{M}\cdot\mathbf{e}\left(\mathbf{k}\right)\right)^{\frac{1}{2}}}=\mathbf{V}^{\mathbf{B}}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)\cdot\frac{\delta\mathbf{B}_{\check{\mathbf{k}}-\mathbf{k}}\left(\mathbf{\check{k}}-\mathbf{k}\right)}{B^{\left(0\right)}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Remembering that 
\begin_inset Formula $\mathbb{K}=\mathbb{I}+\mathbb{X},$
\end_inset

 we can write:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
i\frac{\omega_{ce}\check{\omega}_{\check{k}}^{2}}{2\omega_{pe}^{2}}\frac{\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{X}\left(\check{\mathbf{k}}\right)\cdot\left(\underline{\underline{\underline{\varepsilon}}}^{LC}\cdot\frac{\delta\mathbf{B}_{\check{\mathbf{k}}-\mathbf{k}}\left(\check{\mathbf{k}}-\mathbf{k}\right)}{B^{\left(0\right)}}\right)\cdot\mathbb{X}\left(\mathbf{k}\right)\cdot\mathbf{e}\left(\mathbf{k}\right)}{\left(\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{M}\cdot\check{\mathbf{e}}\left(\check{\mathbf{k}}\right)\right)^{\frac{1}{2}}\left(\mathbf{e}^{\star}\left(\mathbf{k}\right)\cdot\mathbb{M}\cdot\mathbf{e}\left(\mathbf{k}\right)\right)^{\frac{1}{2}}}=\mathbf{V}^{\mathbf{B}}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)\cdot\frac{\delta\mathbf{B}_{\check{\mathbf{k}}-\mathbf{k}}\left(\mathbf{\check{k}}-\mathbf{k}\right)}{B^{\left(0\right)}}\label{eq:modecouplingB}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The denominator of the (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:modecouplingB2"

\end_inset

) is a scalar and it has been calculated in the precedent appendix, so it
 is useful to write this equation in the form:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
i\frac{\omega_{ce}\check{\omega}_{\check{k}}^{2}}{2\omega_{pe}^{2}}\frac{\mathbf{w}^{\mathbf{B}}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)\cdot\frac{\delta\mathbf{B}_{\check{\mathbf{k}}-\mathbf{k}}\left(\check{\mathbf{k}}-\mathbf{k}\right)}{B^{\left(0\right)}}}{\left(\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{M}\cdot\check{\mathbf{e}}\left(\check{\mathbf{k}}\right)\right)^{\frac{1}{2}}\left(\mathbf{e}^{\star}\left(\mathbf{k}\right)\cdot\mathbb{M}\cdot\mathbf{e}\left(\mathbf{k}\right)\right)^{\frac{1}{2}}}=\mathbf{V}^{\mathbf{B}}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)\cdot\frac{\delta\mathbf{B}_{\check{\mathbf{k}}-\mathbf{k}}\left(\mathbf{\check{k}}-\mathbf{k}\right)}{B^{\left(0\right)}}\label{eq:modecouplingB2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
So the mode coupling coefficient is given by the expression:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
i\frac{\omega_{ce}\check{\omega}_{\check{k}}^{2}}{2\omega_{pe}^{2}}\frac{\mathbf{w}^{\mathbf{B}}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)}{\left(\check{\mathbf{e}}^{\star}\left(\check{\mathbf{k}}\right)\cdot\mathbb{M}\cdot\check{\mathbf{e}}\left(\check{\mathbf{k}}\right)\right)^{\frac{1}{2}}\left(\mathbf{e}^{\star}\left(\mathbf{k}\right)\cdot\mathbb{M}\cdot\mathbf{e}\left(\mathbf{k}\right)\right)^{\frac{1}{2}}}=\mathbf{V}^{\mathbf{B}}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)\label{eq:modecouplingcoeffB}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We have just calculated the denominator, so we need an explicit expression
 for 
\begin_inset Formula $\mathbf{W}^{\mathbf{B}}\left(\mathbf{k},\check{\mathbf{k}},\omega\right)$
\end_inset

.
 From this point we use the compact notation 
\begin_inset Formula $\mathbb{X}\left(\mathbf{\mathbf{k}}\right)=\mathbb{X},\mathbb{X}\left(\check{\mathbf{k}}\right)=\check{\mathbb{X}}$
\end_inset

 and 
\begin_inset Formula $\delta\mathbf{B}_{\check{\mathbf{k}}-\mathbf{k}}\left(\mathbf{\check{k}}-\mathbf{k}\right)/B^{\left(0\right)}=\delta\mathbf{B}/B^{\left(0\right)}$
\end_inset

.
 The vector 
\begin_inset Formula $\mathbf{W}^{\mathbf{B}}$
\end_inset

can be derived from the relation:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbf{\mathbf{\check{e}}}^{\star}\cdot\left[\mathbb{\check{X}}\cdot\left(\underline{\underline{\underline{\varepsilon}}}^{LC}\cdot\frac{\delta\mathbf{B}}{B^{\left(0\right)}}\right)\cdot\mathbb{X}\right]\cdot\mathbf{e}=\mathbf{w}^{\mathbf{B}}\cdot\frac{\delta\mathbf{B}}{B^{\left(0\right)}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We now calculate explicitely this quantity and after we derive the components
 of the vector 
\begin_inset Formula $\mathbf{w}^{\mathbf{B}}.$
\end_inset

 
\begin_inset Formula $\underline{\underline{\underline{\varepsilon}}}^{LC}$
\end_inset

 is the Levi-Civita tensor of order 3, the scalar product of this tensor
 with the vector 
\begin_inset Formula $\delta\mathbf{B}/B^{\left(0\right)}$
\end_inset

gives a tensor of order 2:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{eqnarray}
\mathbb{U} & = & \underline{\underline{\underline{\varepsilon}}}^{LC}\cdot\frac{\delta\mathbf{B}}{B^{\left(0\right)}}\\
U_{ij} & = & \varepsilon_{ijk}\frac{\delta B_{k}}{B^{\left(0\right)}}\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
So the elements of 
\begin_inset Formula $\mathbb{U}$
\end_inset

 are:
\begin_inset Formula \begin{eqnarray*}
U_{xx} & = & \varepsilon_{xxx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{xxy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{xxz}\frac{\delta B_{z}}{B^{\left(0\right)}}=0\\
U_{xy} & = & \varepsilon_{xyx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{xyy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{xyz}\frac{\delta B_{z}}{B^{\left(0\right)}}=\frac{\delta B_{z}}{B^{\left(0\right)}}\\
U_{xz} & = & \varepsilon_{xzx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{xzy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{xzz}\frac{\delta B_{z}}{B^{\left(0\right)}}=-\frac{\delta B_{y}}{B^{\left(0\right)}}\\
U_{yx} & = & \varepsilon_{yxx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{yxy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{yxz}\frac{\delta B_{z}}{B^{\left(0\right)}}=-\frac{\delta B_{z}}{B^{\left(0\right)}}\\
U_{yy} & = & \varepsilon_{yyx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{yyy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{yyz}\frac{\delta B_{z}}{B^{\left(0\right)}}=0\\
U_{yz} & = & \varepsilon_{yzx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{yzy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{yzz}\frac{\delta B_{z}}{B^{\left(0\right)}}=\frac{\delta B_{x}}{B^{\left(0\right)}}\\
U_{zx} & = & \varepsilon_{zxx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{zxy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{zxz}\frac{\delta B_{z}}{B^{\left(0\right)}}=\frac{\delta B_{z}}{B^{\left(0\right)}}\\
U_{zy} & = & \varepsilon_{zyx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{zyy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{zyz}\frac{\delta B_{z}}{B^{\left(0\right)}}=-\frac{\delta B_{x}}{B^{\left(0\right)}}\\
U_{zz} & = & \varepsilon_{zzx}\frac{\delta B_{x}}{B^{\left(0\right)}}+\varepsilon_{zzy}\frac{\delta B_{y}}{B^{\left(0\right)}}+\varepsilon_{zzz}\frac{\delta B_{z}}{B^{\left(0\right)}}=0\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
So the tensor 
\begin_inset Formula $\mathbb{U}$
\end_inset

 is:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
\mathbb{U}=\left(\underline{\underline{\underline{\varepsilon}}}^{LC}\cdot\frac{\delta\mathbf{B}}{B^{\left(0\right)}}\right)=\left(\begin{array}{ccc}
0 & \frac{\delta B_{z}}{B^{\left(0\right)}} & -\frac{\delta B_{y}}{B^{\left(0\right)}}\\
-\frac{\delta B_{z}}{B^{\left(0\right)}} & 0 & \frac{\delta B_{x}}{B^{\left(0\right)}}\\
\frac{\delta B_{y}}{B^{\left(0\right)}} & -\frac{\delta B_{x}}{B^{\left(0\right)}} & 0\end{array}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We now have to calculate the tensor 
\begin_inset Formula $\mathbb{W}$
\end_inset

, given by the expression:
\begin_inset Formula \begin{equation}
\mathbb{W}=\check{\mathbb{X}}\cdot\mathbb{U}\cdot\mathbb{X}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The elements of 
\begin_inset Formula $\mathbb{W}$
\end_inset

 are:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{eqnarray*}
W_{xx} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{xy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{xz}\right)X_{xx}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{xx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{xz}\right)X_{yx}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{xx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{xy}\right)X_{zx}\\
W_{xy} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{xy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{xz}\right)X_{xy}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{xx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{xz}\right)X_{yy}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{xx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{xy}\right)X_{zy}\\
W_{xz} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{xy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{xz}\right)X_{xz}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{xx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{xz}\right)X_{yz}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{xx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{xy}\right)X_{zz}\\
W_{yx} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{yy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{yz}\right)X_{xx}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{yx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{yz}\right)X_{yx}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{yx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{yy}\right)X_{zx}\\
W_{yy} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{yy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{yz}\right)X_{xy}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{yx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{yz}\right)X_{yz}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{yx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{yy}\right)X_{zy}\\
W_{yz} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{yy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{yz}\right)X_{xz}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{yx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{yz}\right)X_{yz}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{yx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{yy}\right)X_{zz}\\
W_{zx} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{zy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{zz}\right)X_{xx}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{zx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{zz}\right)X_{yx}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{zx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{zy}\right)X_{zx}\\
W_{zy} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{zy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{zz}\right)X_{xy}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{zx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{zz}\right)X_{yy}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{zx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{zy}\right)X_{zy}\\
W_{zz} & = & \left(-\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{zy}+\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{zz}\right)X_{xz}+\left(\frac{\delta B_{z}}{B^{\left(0\right)}}\check{X}_{zx}-\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{zz}\right)X_{yz}+\left(-\frac{\delta B_{y}}{B^{\left(0\right)}}\check{X}_{zx}+\frac{\delta B_{x}}{B^{\left(0\right)}}\check{X}_{zy}\right)X_{zz}\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
It is useful to write the elements of 
\begin_inset Formula $\mathbb{W}$
\end_inset

 in the form:
\end_layout

\begin_layout Standard
\begin_inset Formula \begin{eqnarray*}
W_{xx} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{xy}X_{zx}-\check{X}_{xz}X_{yx}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{xz}X_{xx}-\check{X}_{xx}X_{zx}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{xx}X_{yx}-\check{X}_{xy}X_{xx}\right)\\
W_{xy} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{xy}X_{zy}-\check{X}_{xz}X_{yy}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{xz}X_{xy}-\check{X}_{xx}X_{zy}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{xx}X_{yy}-\check{X}_{xy}X_{xy}\right)\\
W_{xz} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{xy}X_{zz}-\check{X}_{xz}X_{yz}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{xz}X_{xz}-\check{X}_{xx}X_{zz}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{xx}X_{yz}-\check{X}_{xy}X_{xz}\right)\\
W_{yx} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{yy}X_{zx}-\check{X}_{yz}X_{yx}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{yz}X_{xx}-\check{X}_{yx}X_{zx}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{yx}X_{yx}-\check{X}_{yy}X_{xx}\right)\\
W_{yy} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{yy}X_{zy}-\check{X}_{yz}X_{yy}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{yz}X_{xy}-\check{X}_{yx}X_{zy}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{yx}X_{yy}-\check{X}_{yy}X_{xy}\right)\\
W_{yz} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{yy}X_{zz}-\check{X}_{yz}X_{yz}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{yz}X_{xz}-\check{X}_{yx}X_{zz}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{yx}X_{yz}-\check{X}_{yy}X_{xz}\right)\\
W_{zx} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{zy}X_{zx}-\check{X}_{zz}X_{yx}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{zz}X_{xx}-\check{X}_{zx}X_{zx}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{zx}X_{yx}-\check{X}_{zy}X_{xx}\right)\\
W_{zy} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{zy}X_{zy}-\check{X}_{zz}X_{yy}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{zz}X_{xy}-\check{X}_{zx}X_{zy}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{zx}X_{yy}-\check{X}_{zy}X_{xy}\right)\\
W_{zz} & = & \frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{zy}X_{zz}-\check{X}_{zz}X_{yz}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{zz}X_{xz}-\check{X}_{zx}X_{zz}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{zx}X_{yz}-\check{X}_{zy}X_{xz}\right)\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Using these components of 
\begin_inset Formula $\mathbb{W}$
\end_inset

 we now calculate:
\end_layout

\begin_layout Standard
\begin_inset Formula \[
\mathbf{w}^{\mathbf{B}}\cdot\frac{\delta\mathbf{B}}{B^{\left(0\right)}}=\check{\mathbf{e}}^{\star}\cdot\left[\check{\mathbb{X}}\cdot\left(\underline{\underline{\underline{\varepsilon}}}^{LC}\cdot\frac{\delta\mathbf{B}}{B^{\left(0\right)}}\right)\cdot\mathbb{X}\right]\cdot\mathbf{e}=\check{\mathbf{e}}^{\star}\cdot\mathbb{W}\cdot\mathbf{e}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
=\check{e}_{x}^{\star}e_{x}W_{xx}+\check{e}_{y}^{\star}e_{x}W_{yx}+\check{e}_{z}^{\star}e_{x}W_{zx}+\check{e}_{x}^{\star}e_{y}W_{xy}+\check{e}_{y}^{\star}e_{y}W_{yy}+\check{e}_{z}^{\star}e_{y}W_{zy}+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\check{e}_{x}^{\star}e_{z}W_{xz}+\check{e}_{y}^{\star}e_{z}W_{yz}+\check{e}_{z}^{\star}e_{z}W_{zz}=\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{eqnarray*}
= & \check{e}_{x}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{xy}X_{zx}-\check{X}_{xz}X_{yx}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{xz}X_{xx}-\check{X}_{xx}X_{zx}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{xx}X_{yx}-\check{X}_{xy}X_{xx}\right)\right]e_{x} & +\\
+ & \check{e}_{y}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{yy}X_{zx}-\check{X}_{yz}X_{yx}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{yz}X_{xx}-\check{X}_{yx}X_{zx}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{yx}X_{yx}-\check{X}_{yy}X_{xx}\right)\right]e_{x} & +\\
+ & \check{e}_{z}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{zy}X_{zx}-\check{X}_{zz}X_{yx}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{zz}X_{xx}-\check{X}_{zx}X_{zx}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{zx}X_{yy}-\check{X}_{zy}X_{xx}\right)\right]e_{x} & +\\
