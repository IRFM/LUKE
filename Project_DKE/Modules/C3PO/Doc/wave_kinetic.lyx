\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\frac{\delta B_{z}}{B^{\left(0\right)}}\left[\check{e}_{x}^{\star}e_{x}\left(\check{X}_{xx}X_{yx}-\check{X}_{xy}X_{xx}\right)+\check{e}_{y}^{\star}e_{x}\left(\check{X}_{yx}X_{yx}-\check{X}_{yy}X_{xx}\right)+\check{e}_{z}^{\star}e_{x}\left(\check{X}_{zx}X_{yx}-\check{X}_{zy}X_{xx}\right)+\right.\]

