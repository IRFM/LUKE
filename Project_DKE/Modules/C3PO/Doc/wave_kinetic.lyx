\begin_layout Standard
\begin_inset Formula \[
=\left(e_{x}X_{zx}+e_{y}X_{zy}+e_{z}X_{zz}\right)\left(\check{e}_{x}^{\star}\check{X}_{xy}+\check{e}_{y}\check{X}_{yy}+\check{e}_{z}^{\star}\check{X}_{zy}\right)-\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{equation}
-\left(e_{x}X_{yx}+e_{y}X_{yy}+e_{z}X_{yz}\right)\left(\check{e}_{x}^{\star}\check{X}_{xz}+\check{e}_{y}^{\star}\check{X}_{yz}+\check{e}_{z}^{\star}\check{X}_{zz}\right)\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
w_{y}^{\mathbf{B}}=\check{e}_{x}^{\star}e_{x}\left(\check{X}_{xz}X_{xx}-\check{X}_{xx}X_{zx}\right)+\check{e}_{y}^{\star}e_{x}\left(\check{X}_{yz}X_{xx}-\check{X}_{yx}X_{zx}\right)+\check{e}_{z}^{\star}e_{x}\left(\check{X}_{zz}X_{xx}-\check{X}_{zx}X_{zx}\right)+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\check{e}_{x}^{\star}e_{y}\left(\check{X}_{xz}X_{xy}-\check{X}_{xx}X_{zy}\right)+\check{e}_{y}^{\star}e_{y}\left(\check{X}_{yz}X_{xx}-\check{X}_{yx}X_{zy}\right)+\check{e}_{z}^{\star}e_{y}\left(\check{X}_{zz}X_{xy}-\check{X}_{zx}X_{zy}\right)+\]

