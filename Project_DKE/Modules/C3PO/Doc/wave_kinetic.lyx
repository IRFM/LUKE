\begin_inset Formula \[
=\frac{\delta B_{x}}{B^{\left(0\right)}}\left[\check{e}_{x}^{\star}e_{x}\left(\check{X}_{xy}X_{zx}-\check{X}_{xz}X_{yx}\right)+\check{e}_{y}^{\star}e_{x}\left(\check{X}_{yy}X_{zx}-\check{X}_{yz}X_{yx}\right)+\check{e}_{z}^{\star}e_{x}\left(\check{X}_{zy}X_{zx}-\check{X}_{zz}X_{yx}\right)+\right.\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\check{e}_{x}^{\star}e_{y}\left(\check{X}_{xy}X_{zy}-\check{X}_{xz}X_{yy}\right)+\check{e}_{y}^{\star}e_{y}\left(\check{X}_{yy}X_{zy}-\check{X}_{yz}X_{yy}\right)+\check{e}_{z}^{\star}e_{y}\left(\check{X}_{zy}X_{zy}-\check{X}_{zz}X_{yy}\right)+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\left.+\check{e}_{x}^{\star}e_{z}\left(\check{X}_{xy}X_{zz}-\check{X}_{xz}X_{yz}\right)+\check{e}_{y}^{\star}e_{z}\left(\check{X}_{yy}X_{zz}-\check{X}_{yz}X_{yz}\right)+\check{e}_{z}^{\star}e_{z}\left(\check{X}_{xy}X_{zz}-\check{X}_{zz}X_{yz}\right)\right]+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\frac{\delta B_{y}}{B^{\left(0\right)}}\left[\check{e}_{x}^{\star}e_{x}\left(\check{X}_{xz}X_{xx}-\check{X}_{xx}X_{zx}\right)+\check{e}_{y}^{\star}e_{x}\left(\check{X}_{yz}X_{xx}-\check{X}_{yx}X_{zx}\right)+\check{e}_{z}^{\star}e_{x}\left(\check{X}_{zz}X_{xx}-\check{X}_{zx}X_{zx}\right)+\right.\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
+\check{e}_{x}^{\star}e_{y}\left(\check{X}_{xz}X_{xy}-\check{X}_{xx}X_{zy}\right)+\check{e}_{y}^{\star}e_{y}\left(\check{X}_{yz}X_{xx}+-\check{X}_{yx}X_{zy}\right)+\check{e}_{z}^{\star}e_{y}\left(\check{X}_{zz}X_{xy}-\check{X}_{zx}X_{zy}\right)+\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \[
\left.+\check{e}_{x}^{\star}e_{z}\left(\check{X}_{xz}X_{xz}-\check{X}_{xx}X_{zz}\right)+\check{e}_{y}^{\star}e_{z}\left(\check{X}_{yz}X_{xz}-\check{X}_{yx}X_{zz}\right)+\check{e}_{z}^{\star}e_{z}\left(\check{X}_{zz}X_{xz}-\check{X}_{zx}X_{zz}\right)\right]+\]

