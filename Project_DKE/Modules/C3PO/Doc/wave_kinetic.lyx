\begin_layout Standard
\begin_inset Formula \[
w_{x}^{\mathbf{B}}=\check{e}_{x}^{\star}e_{x}\left(\check{X}_{xy}X_{zx}-\check{X}_{xz}X_{yx}\right)+\check{e}_{y}^{\star}e_{x}\left(\check{X}_{yy}X_{zx}-\check{X}_{yz}X_{yx}\right)+\check{e}_{z}^{\star}e_{x}\left(\check{X}_{zy}X_{zx}-\check{X}_{zz}X_{yx}\right)+\]

