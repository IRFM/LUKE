+ & \check{e}_{y}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{yy}X_{zy}-\check{X}_{yz}X_{yy}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{yz}X_{xy}-\check{X}_{yx}X_{zy}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{yx}X_{yy}-\check{X}_{yy}X_{xy}\right)\right]e_{y} & +\\
+ & \check{e}_{z}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{zy}X_{zy}-\check{X}_{zz}X_{yy}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{zz}X_{xy}-\check{X}_{zx}X_{zy}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{zx}X_{yy}-\check{X}_{zy}X_{xy}\right)\right]e_{y} & +\\
+ & \check{e}_{x}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{xy}X_{zz}-\check{X}_{xz}X_{yz}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{xz}X_{xz}-\check{X}_{xx}X_{zz}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{xx}X_{yz}-\check{X}_{xy}X_{xz}\right)\right]e_{z} & +\\
+ & \check{e}_{y}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{yy}X_{zz}-\check{X}_{yz}X_{yz}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{yz}X_{xz}-\check{X}_{yx}X_{zz}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{yx}X_{yz}-\check{X}_{yy}X_{xz}\right)\right]e_{z} & +\\
+ & \check{e}_{z}^{\star}\left[\frac{\delta B_{x}}{B^{\left(0\right)}}\left(\check{X}_{zy}X_{zz}-\check{X}_{zz}X_{yz}\right)+\frac{\delta B_{y}}{B^{\left(0\right)}}\left(\check{X}_{zz}X_{xz}-\check{X}_{zx}X_{zz}\right)+\frac{\delta B_{z}}{B^{\left(0\right)}}\left(\check{X}_{zx}X_{yz}-\check{X}_{zy}X_{xz}\right)\right]e_{z} & =\end{eqnarray*}

