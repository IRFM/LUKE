\left(\mathbf{k}\times\widehat{\mathbf{b}}\right)\cdot\widehat{\theta} & =\mathbf{k}\cdot\left(\widehat{\mathbf{b}}\times\widehat{\theta}\right)=-\sigma_{B}T\mathbf{k}\cdot\mathbf{\hat{r}}+\sigma_{I}P\sin\alpha\mathbf{k}\cdot\widehat{\phi}\label{eq:kvecbdottheta}\\
\left(\mathbf{k}\times\widehat{\mathbf{b}}\right)\cdot\widehat{\phi} & =\mathbf{k}\cdot\left(\widehat{\mathbf{b}}\times\widehat{\phi}\right)=\sigma_{I}P\mathbf{k}\cdot\widehat{\rho}\label{eq:kvecbdotphi}\end{align}

