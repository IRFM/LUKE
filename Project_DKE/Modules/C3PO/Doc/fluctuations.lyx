\begin_layout Subsection
Conservation of 
\begin_inset Formula $k_{\parallel}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align*}
\check{k}_{\parallel} & =\sigma_{I}P\frac{\check{m}}{r}\cos\alpha+\sigma_{B}T\frac{\check{n}}{R}\\
 & =\sigma_{I}P\cos\alpha\left[\frac{\sigma_{I}P}{\cos\alpha}k_{\parallel}+\chi\sin\beta\frac{\sigma_{B}T}{\cos\alpha}\left(\frac{m}{r}\sin\alpha-k_{\rho}\Vert\nabla\rho\Vert\right)-\chi\cos\beta\left(\frac{\sigma_{I}P}{\cos\alpha}k_{\parallel}-\frac{m}{r}\right)\right]\\
 & +\sigma_{B}T\left[\sigma_{B}Tk_{\parallel}+\chi\sin\beta\sigma_{I}P\left(k_{\rho}\Vert\nabla\rho\Vert-\frac{m}{r}\sin\alpha\right)-\chi\cos\beta\left(\sigma_{B}Tk_{\parallel}-\frac{n}{R}\right)\right]\\
 & =k_{\Vert}\left(\sigma_{I}^{2}P^{2}+\sigma_{B}^{2}T^{2}\right)+\sigma_{I}P\sigma_{B}T\chi\sin\beta\left(\frac{m}{r}\sin\alpha-k_{\rho}\Vert\nabla\rho\Vert+k_{\rho}\Vert\nabla\rho\Vert-\frac{m}{r}\sin\alpha\right)\\
 & -\chi\cos\beta\left[k_{\parallel}\left(\sigma_{I}^{2}P^{2}+\sigma_{B}^{2}T^{2}\right)-\left(\sigma_{I}P\frac{m}{r}\cos\alpha+\sigma_{B}T\frac{n}{R}\right)\right]\\
 & =k_{\parallel}-\chi\cos\beta\left(k_{\parallel}-k_{\parallel}\right)\\
 & =k_{\parallel}\end{align*}

\end_inset


\end_layout

\begin_layout Subsection
Direction of 
\begin_inset Formula $\check{\mathbf{k}}_{\perp}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula \begin{align*}
\mathbf{k}_{\perp}\cdot\check{\mathbf{k}}_{\perp} & =k_{\rho}\check{k}_{\rho}\Vert\nabla\rho\Vert^{2}+\frac{m\check{m}}{r^{2}}+\frac{n\check{n}}{R^{2}}-\frac{\Vert\nabla\rho\Vert\sin\alpha}{r}\left(m\check{k}_{\rho}+\check{m}k_{\rho}\right)-k_{\parallel}^{2}\\
 & =k_{\rho}\Vert\nabla\rho\Vert\left\{ \sigma_{I}P\tan\alpha k_{\parallel}+\chi\sin\beta\left[\frac{\sigma_{B}T}{\cos\alpha}\left(\frac{m}{r}-k_{\rho}\Vert\nabla\rho\Vert\sin\alpha\right)-\sigma_{I}P\frac{n}{R}\right]\right\} \\
 & -k_{\rho}\Vert\nabla\rho\Vert\chi\cos\beta\left(\sigma_{I}P\tan\alpha k_{\parallel}-k_{\rho}\Vert\nabla\rho\Vert\right)\\
 & +\frac{m}{r}\left[\frac{\sigma_{I}P}{\cos\alpha}k_{\parallel}+\chi\sin\beta\frac{\sigma_{B}T}{\cos\alpha}\left(\frac{m}{r}\sin\alpha-k_{\rho}\Vert\nabla\rho\Vert\right)-\chi\cos\beta\left(\frac{\sigma_{I}P}{\cos\alpha}k_{\parallel}-\frac{m}{r}\right)\right]\\
 & +\frac{n}{R}\left[\sigma_{B}Tk_{\parallel}+\chi\sin\beta\sigma_{I}P\left(k_{\rho}\Vert\nabla\rho\Vert-\frac{m}{r}\sin\alpha\right)-\chi\cos\beta\left(\sigma_{B}Tk_{\parallel}-\frac{n}{R}\right)\right]\\
 & -\frac{m}{r}\sin\alpha\left\{ \sigma_{I}P\tan\alpha k_{\parallel}+\chi\sin\beta\left[\frac{\sigma_{B}T}{\cos\alpha}\left(\frac{m}{r}-k_{\rho}\Vert\nabla\rho\Vert\sin\alpha\right)-\sigma_{I}P\frac{n}{R}\right]\right\} \\
 & +\frac{m}{r}\sin\alpha\chi\cos\beta\left(\sigma_{I}P\tan\alpha k_{\parallel}-k_{\rho}\Vert\nabla\rho\Vert\right)\\
 & -k_{\rho}\Vert\nabla\rho\Vert\sin\alpha\left[\frac{\sigma_{I}P}{\cos\alpha}k_{\parallel}+\chi\sin\beta\frac{\sigma_{B}T}{\cos\alpha}\left(\frac{m}{r}\sin\alpha-k_{\rho}\Vert\nabla\rho\Vert\right)-\chi\cos\beta\left(\frac{\sigma_{I}P}{\cos\alpha}k_{\parallel}-\frac{m}{r}\right)\right]-k_{\parallel}^{2}\\
 & =\left[\left(\sigma_{I}P\frac{m}{r}\cos\alpha+\sigma_{B}T\frac{n}{R}\right)k_{\parallel}-k_{\parallel}^{2}\right]+\chi\cos\beta\left[k_{\rho}^{2}\Vert\nabla\rho\Vert^{2}+\frac{m^{2}}{r^{2}}+\frac{n^{2}}{R^{2}}-2k_{\rho}\Vert\nabla\rho\Vert\sin\alpha\right]\\
 & -\chi\cos\beta k_{\parallel}\left(\sigma_{I}P\frac{m}{r}\cos\alpha+\sigma T\frac{n}{R}\right)\\
 & =\left(k_{\parallel}^{2}-k_{\parallel}^{2}\right)+\chi\cos\beta\left(k^{2}-k_{\parallel}^{2}\right)\\
 & =k_{\perp}^{2}\chi\cos\beta\end{align*}

\end_inset


