\noun default
\color inherit

\begin_inset Formula \begin{align}
\mathbf{\nabla}\times\mathbf{\nabla}\times\mathbf{E} & =-\mu_{0}\frac{\partial\mathbf{J}}{\partial t}-\varepsilon_{0}\mu_{0}\dfrac{\partial^{2}\mathbf{E}}{\partial t^{2}}-\mu_{0}\dfrac{\partial^{2}\mathbf{P}}{\partial t^{2}}\label{eq:maxwellE}\end{align}

\end_inset

or
\begin_inset Formula \begin{align}
\mathbf{\nabla}\times\mathbf{\nabla}\times\mathbf{E} & +\frac{1}{c^{2}}\dfrac{\partial^{2}}{\partial t^{2}}\left[\left(\mathbb{I}+\mathbb{X}\right)*\mathbf{E}\right]=-\mu_{0}\frac{\partial\mathbf{J}}{\partial t}\label{eq:MaxwellE1}\end{align}

\end_inset

or
\begin_inset Formula \begin{align}
\mathbf{\nabla}\times\mathbf{\nabla}\times\mathbf{E} & +\frac{1}{c^{2}}\dfrac{\partial^{2}}{\partial t^{2}}\left[\mathbb{K}\left(\mathbf{E}\right)*\mathbf{E}\right]=-\mu_{0}\frac{\partial\mathbf{J}}{\partial t}\label{eq:MaxwellE2}\end{align}

\end_inset

and using 
\begin_inset Formula $\varepsilon_{0}\mu_{0}c^{2}=1$
\end_inset

.
 
