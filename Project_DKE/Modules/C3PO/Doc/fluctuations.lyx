\begin_layout Standard
\begin_inset Formula \begin{equation}
\check{k}_{\perp}^{2}=\check{k_{\rho}^{2}}\Vert\nabla\rho\Vert^{2}-2\check{k_{\rho}}\Vert\nabla\rho\Vert\frac{\check{m}\sin\alpha}{r}+\frac{\check{m}^{2}}{r^{2}}+\frac{\check{n}^{2}}{R^{2}}-k_{\parallel}^{2}\end{equation}

