\begin_layout Subsection
Dispersion relation
\begin_inset CommandInset label
LatexCommand label
name "sub:disperrelation"

\end_inset


\end_layout

\begin_layout Standard
In a cartesian system 
\begin_inset Formula $\left(x,y,z\right)$
\end_inset

 defined such that the background magnetic field is
\begin_inset Formula \begin{equation}
\mathbf{B}_{0}=B_{0}\mathbf{\hat{z}}\end{equation}

\end_inset

 and the wave index of refraction is
\begin_inset Formula \begin{equation}
\mathbf{N}=N_{\Vert}\mathbf{\hat{z}}+N_{\bot}\mathbf{\hat{x}}\label{eq:Nprojection}\end{equation}

\end_inset

 the permittivity tensor can be expressed explicitly as
\begin_inset Formula \begin{equation}
\mathbb{K=}\left(\begin{array}{ccc}
K_{xx} & K_{xy} & K_{xz}\\
-K_{xy} & K_{yy} & K_{yz}\\
K_{xz} & -K_{yz} & K_{zz}\end{array}\right)\end{equation}

\end_inset

 such that the dispersion tensor is 
\begin_inset Formula \begin{equation}
\mathbb{D=}\left(\begin{array}{ccc}
K_{xx}-N_{\Vert}^{2} & K_{xy} & K_{xz}+N_{\bot}N_{\Vert}\\
-K_{xy} & K_{yy}-N^{2} & K_{yz}\\
K_{xz}+N_{\bot}N_{\Vert} & -K_{yz} & K_{zz}-N_{\bot}^{2}\end{array}\right)\end{equation}

\end_inset

 and the dispersion relation becomes
\begin_inset Formula \begin{align}
\mathcal{D}\left(\mathbf{k},\omega\right) & =\left(K_{xx}-N_{\Vert}^{2}\right)\left(K_{yy}-N^{2}\right)\left(K_{zz}-N_{\bot}^{2}\right)\\
 & +2K_{xy}K_{yz}\left(K_{xz}+N_{\bot}N_{\Vert}\right)\nonumber \\
 & -\left(K_{yy}-N^{2}\right)\left(K_{xz}+N_{\bot}N_{\Vert}\right)^{2}\nonumber \\
 & +K_{yz}^{2}\left(K_{xx}-N_{\Vert}^{2}\right)+K_{xy}^{2}\left(K_{zz}-N_{\bot}^{2}\right)\nonumber \end{align}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\mathcal{D}\left(\mathbf{k},\omega\right)$
\end_inset

 is rearranged in powers of 
\begin_inset Formula $N_{\bot}$
\end_inset

 as
\begin_inset Formula \begin{equation}
\mathcal{D}\left(\mathbf{k},\omega\right)=P_{4}N_{\bot}^{4}+P_{3}N_{\bot}^{3}+P_{2}N_{\bot}^{2}+P_{1}N_{\bot}+P_{0}\label{disprel2}\end{equation}

\end_inset

 with 
\begin_inset Formula \begin{equation}
\begin{array}{l}
P_{4}=K_{xx}\\
P_{3}=2K_{xz}N_{\Vert}\\
P_{2}=\left(K_{xx}+K_{zz}\right)N_{\Vert}^{2}-\left(K_{yy}+K_{zz}\right)K_{xx}+K_{xz}^{2}-K_{xy}^{2}\\
P_{1}=2N_{\Vert}\left(K_{xz}N_{\Vert}^{2}+K_{xy}K_{yz}-K_{yy}K_{xz}\right)\\
P_{0}=N_{\Vert}^{4}K_{zz}+\left(K_{xz}^{2}-K_{yz}^{2}-\left[K_{xx}+K_{yy}\right]K_{zz}\right)N_{\Vert}^{2}+K_{yy}K_{xx}K_{zz}\\
\qquad+2K_{xy}K_{yz}K_{xz}+K_{yz}^{2}K_{xx}-K_{yy}K_{xz}^{2}+K_{xy}^{2}K_{zz}\end{array}\label{dispexp}\end{equation}

\end_inset

 The dispersion relation (
\begin_inset CommandInset ref
LatexCommand ref
reference "disprel2"

\end_inset

) can be further expanded as
\begin_inset Formula \begin{align}
\mathcal{D} & =\left(1+X_{xx}\right)N_{\bot}^{4}\nonumber \\
 & +\left(2N_{\Vert}X_{xz}\right)N_{\bot}^{3}\nonumber \\
 & +\left(N_{\Vert}^{2}\left(X_{xx}+X_{zz}+2\right)-2X_{xx}-X_{yy}-X_{zz}\right.\nonumber \\
 & \left.-X_{xx}X_{zz}+X_{xz}^{2}-X_{xx}X_{yy}-X_{xy}^{2}-2\right)N_{\bot}^{2}\nonumber \\
 & +2N_{\Vert}\left(-X_{yy}X_{xz}+X_{xy}X_{yz}-X_{xz}+N_{\Vert}^{2}X_{xz}\right)N_{\bot}\nonumber \\
 & +1+N_{\Vert}^{4}\left(X_{zz}+1\right)\nonumber \\
 & +N_{\Vert}^{2}\left(X_{xz}^{2}-X_{yy}X_{zz}-X_{xx}X_{zz}-2X_{zz}-X_{yy}-X_{yz}^{2}-X_{xx}-2\right)\nonumber \\
 & +X_{yy}X_{zz}+X_{xx}X_{zz}+X_{xx}X_{yy}\nonumber \\
 & +X_{xx}X_{yz}^{2}+X_{yz}^{2}+X_{xx}+X_{xy}^{2}+X_{xy}^{2}X_{zz}-X_{xz}^{2}\nonumber \\
 & -X_{yy}X_{xz}^{2}+X_{yy}+X_{zz}\nonumber \\
 & +X_{xx}X_{yy}X_{zz}+2X_{xy}X_{yz}X_{xz}\label{D}\end{align}

\end_inset


\end_layout

\begin_layout Standard
In preparation for calculating the derivatives, it is useful to split the
 dispersion relation in a sum of products
\begin_inset Formula \begin{equation}
\mathcal{D}=\sum_{k=1}^{k=43}\mathcal{D}^{\left(k\right)}\label{dispexp2}\end{equation}

\end_inset

 where
\begin_inset Formula \begin{equation}
\begin{array}{l}
\mathcal{D}^{\left(1\right)}=N_{\bot}^{4}\\
\mathcal{D}^{\left(2\right)}=X_{xx}N_{\bot}^{4}\\
\mathcal{D}^{\left(3\right)}=2N_{\Vert}X_{xz}N_{\bot}^{3}\\
\mathcal{D}^{\left(4\right)}=N_{\Vert}^{2}X_{xx}N_{\bot}^{2}\\
\mathcal{D}^{\left(5\right)}=N_{\Vert}^{2}X_{zz}N_{\bot}^{2}\\
\mathcal{D}^{\left(6\right)}=2N_{\Vert}^{2}N_{\bot}^{2}\\
\mathcal{D}^{\left(7\right)}=-2X_{xx}N_{\bot}^{2}\\
\mathcal{D}^{\left(8\right)}=-X_{yy}N_{\bot}^{2}\\
\mathcal{D}^{\left(9\right)}=-X_{zz}N_{\bot}^{2}\\
\mathcal{D}^{\left(10\right)}=-X_{xx}X_{zz}N_{\bot}^{2}\end{array}\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\begin{array}{l}
\mathcal{D}^{\left(11\right)}=X_{xz}^{2}N_{\bot}^{2}\\
\mathcal{D}^{\left(12\right)}=-X_{xx}X_{yy}N_{\bot}^{2}\\
\mathcal{D}^{\left(13\right)}=-X_{xy}^{2}N_{\bot}^{2}\\
\mathcal{D}^{\left(14\right)}=-2N_{\bot}^{2}\\
\mathcal{D}^{\left(15\right)}=-2N_{\Vert}X_{yy}X_{xz}N_{\bot}\\
\mathcal{D}^{\left(16\right)}=2N_{\Vert}X_{xy}X_{yz}N_{\bot}\\
\mathcal{D}^{\left(17\right)}=-2N_{\Vert}X_{xz}N_{\bot}\\
\mathcal{D}^{\left(18\right)}=2N_{\Vert}^{3}X_{xz}N_{\bot}\\
\mathcal{D}^{\left(19\right)}=1\\
\mathcal{D}^{\left(20\right)}=N_{\Vert}^{4}X_{zz}\end{array}\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\begin{array}{l}
\mathcal{D}^{\left(21\right)}=N_{\Vert}^{4}\\
\mathcal{D}^{\left(22\right)}=N_{\Vert}^{2}X_{xz}^{2}\\
\mathcal{D}^{\left(23\right)}=-N_{\Vert}^{2}X_{yy}X_{zz}\\
\mathcal{D}^{\left(24\right)}=-N_{\Vert}^{2}X_{xx}X_{zz}\\
\mathcal{D}^{\left(25\right)}=-2N_{\Vert}^{2}X_{zz}\\
\mathcal{D}^{\left(26\right)}=-N_{\Vert}^{2}X_{yy}\\
\mathcal{D}^{\left(27\right)}=-N_{\Vert}^{2}X_{yz}^{2}\\
\mathcal{D}^{\left(28\right)}=-N_{\Vert}^{2}X_{xx}\\
\mathcal{D}^{\left(29\right)}=-2N_{\Vert}^{2}\\
\mathcal{D}^{\left(30\right)}=X_{yy}X_{zz}\end{array}\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\begin{array}{l}
\mathcal{D}^{\left(31\right)}=X_{xx}X_{zz}\\
\mathcal{D}^{\left(32\right)}=X_{xx}X_{yy}\\
\mathcal{D}^{\left(33\right)}=X_{xx}X_{yz}^{2}\\
\mathcal{D}^{\left(34\right)}=X_{yz}^{2}\\
\mathcal{D}^{\left(35\right)}=X_{xx}\\
\mathcal{D}^{\left(36\right)}=X_{xy}^{2}\\
\mathcal{D}^{\left(37\right)}=X_{xy}^{2}X_{zz}\\
\mathcal{D}^{\left(38\right)}=-X_{xz}^{2}\\
\mathcal{D}^{\left(39\right)}=-X_{yy}X_{xz}^{2}\\
\mathcal{D}^{\left(40\right)}=X_{yy}\end{array}\end{equation}

\end_inset

 
\begin_inset Formula \begin{equation}
\begin{array}{l}
\mathcal{D}^{\left(41\right)}=X_{zz}\\
\mathcal{D}^{\left(42\right)}=X_{xx}X_{yy}X_{zz}\\
\mathcal{D}^{\left(43\right)}=2X_{xy}X_{yz}X_{xz}\end{array}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Derivatives of the equilibrium
\end_layout

\begin_layout Standard
Explicitly expression for derivatives of the equilibrium are 
\begin_inset Formula \begin{align}
\frac{\partial\beta_{Ts}}{\partial\rho} & =\frac{\partial}{\partial\rho}\left(\sqrt{\frac{\kappa T_{s}}{m_{s}c^{2}}}\right)=\dfrac{\beta_{Ts}}{2T_{s}}\frac{\partial T_{s}}{\partial\rho}\\
\frac{\partial\overline{\omega}_{ps}}{\partial\rho} & =\frac{\partial}{\partial\rho}\left(\dfrac{1}{\omega}\sqrt{\frac{q_{s}^{2}n_{s}}{\varepsilon_{0}m_{s}}}\right)=\dfrac{\overline{\omega}_{ps}}{2n_{s}}\frac{\partial n_{s}}{\partial\rho}\\
\frac{\partial\overline{\omega}_{cs}}{\partial\rho} & =\frac{\partial}{\partial\rho}\left(\frac{q_{s}B_{0}}{m_{s}\omega}\right)=\dfrac{\overline{\omega}_{cs}}{B_{0}}\frac{\partial B_{0}}{\partial\rho}\\
\frac{\partial\overline{\omega}_{cs}}{\partial\theta} & =\frac{\partial}{\partial\theta}\left(\frac{q_{s}B_{0}}{m_{s}\omega}\right)=\dfrac{\overline{\omega}_{cs}}{B_{0}}\frac{\partial B_{0}}{\partial\theta}\\
\frac{\partial\overline{\omega}_{ps}}{\partial\omega} & =\frac{\partial}{\partial\omega}\left(\dfrac{1}{\omega}\sqrt{\frac{q_{s}^{2}n_{s}}{\varepsilon_{0}m_{s}}}\right)=-\dfrac{\overline{\omega}_{ps}}{\omega}\\
\frac{\partial\overline{\omega}_{cs}}{\partial\omega} & =\frac{\partial}{\partial\omega}\left(\frac{q_{s}B_{0}}{m_{s}\omega}\right)=-\dfrac{\overline{\omega}_{cs}}{\omega}\end{align}

\end_inset


\end_layout

\begin_layout Section
\begin_inset CommandInset label
LatexCommand label
name "sec:Various-properties-of"

\end_inset

Various properties of the coordinates system
\end_layout

\begin_layout Subsection
Alternative calculation of the parallel index of refraction
\end_layout

\begin_layout Standard
The following expression is considered 
\begin_inset Formula \begin{align}
k_{\Vert} & =\dfrac{1}{B}\mathbf{k}\cdot\mathbf{B}\\
 & =\dfrac{1}{B}g^{ij}k_{i}B_{j}\end{align}

\end_inset

 with the metric coefficients
\begin_inset Formula \begin{equation}
g^{ij}=\mathbf{e}^{i}\cdot\mathbf{e}^{j}=\left(\begin{array}{ccc}
\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2} & -\dfrac{\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r} & 0\\
-\dfrac{\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r} & \dfrac{1}{r^{2}} & 0\\
0 & 0 & \dfrac{1}{R^{2}}\end{array}\right)\end{equation}

\end_inset

 The magnetic field in the covariant basis 
\begin_inset Formula \begin{equation}
\mathbf{e}_{i}=\left(\dfrac{\widehat{\mathbf{r}}}{\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha},\dfrac{r\widehat{\mathbf{s}}}{\cos\alpha},R\widehat{\mathbf{\phi}}\right)\end{equation}

\end_inset

 has the following coordinates 
\begin_inset Formula \begin{equation}
B_{j}=\left(\sigma_{I}\dfrac{\sin\alpha B_{P}}{\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha},\sigma_{I}\dfrac{rB_{P}}{\cos\alpha},\sigma_{B}RB_{T}\right)\end{equation}

\end_inset

 such that 
\begin_inset Formula \begin{equation}
k_{\Vert}=\dfrac{1}{B}\left(k_{\psi},m,n\right)\left(\begin{array}{ccc}
\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2} & -\dfrac{\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r} & 0\\
-\dfrac{\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r} & \dfrac{1}{r^{2}} & 0\\
0 & 0 & \dfrac{1}{R^{2}}\end{array}\right)\left(\begin{array}{c}
\sigma_{I}\dfrac{\sin\alpha B_{P}}{\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha}\\
\sigma_{I}\dfrac{rB_{P}}{\cos\alpha}\\
\sigma_{B}RB_{T}\end{array}\right)\end{equation}

\end_inset

 which gives
\begin_inset Formula \begin{equation}
k_{\Vert}=\dfrac{1}{B}\left[\left(k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2}-\dfrac{m\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r}\right)\sigma_{I}\dfrac{\sin\alpha B_{P}}{\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha}+\left(-\dfrac{\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r}k_{\rho}+\dfrac{m}{r^{2}}\right)\sigma_{I}\dfrac{rB_{P}}{\cos\alpha}+\dfrac{n\sigma_{B}}{R^{2}}RB_{T}\right]\end{equation}

\end_inset

 and simplifies to
\begin_inset Formula \begin{equation}
k_{\Vert}=\left[\sigma_{I}\cos\alpha P\dfrac{m}{r}+\sigma_{B}T\dfrac{n}{R}\right]\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $k_{\rho}$
\end_inset

, 
\begin_inset Formula $m$
\end_inset

 and/or 
\begin_inset Formula $n$
\end_inset

 as a function of 
\begin_inset Formula $k_{\Vert}$
\end_inset

 and 
\begin_inset Formula $k_{\bot}$
\end_inset


\end_layout

\begin_layout Standard
Generally, the initial conditions determine 
\begin_inset Formula $m$
\end_inset

 and 
\begin_inset Formula $k_{\Vert}$
\end_inset

.
 Then 
\begin_inset Formula $k_{\bot}$
\end_inset

 is calculated from the dispersion relation.
 We need to express 
\begin_inset Formula $k_{\rho}$
\end_inset

 and 
\begin_inset Formula $n$
\end_inset

 as a function of 
\begin_inset Formula $m$
\end_inset

, 
\begin_inset Formula $k_{\Vert}$
\end_inset

 and 
\begin_inset Formula $k_{\bot}$
\end_inset

.
 We have
\begin_inset Formula \begin{equation}
k_{\bot}^{2}=k_{\rho}^{2}\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2}-2k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert \dfrac{m\sin\alpha}{r}+\dfrac{m^{2}}{r^{2}}+\dfrac{n^{2}}{R^{2}}-k_{\Vert}^{2}\label{kperp}\end{equation}

\end_inset

 and
\begin_inset Formula \begin{equation}
k_{\Vert}=\sigma_{I}P\cos\alpha\dfrac{m}{r}+\sigma_{B}T\dfrac{n}{R}\end{equation}

\end_inset

 
\end_layout

\begin_layout Standard
We get an expression for 
\begin_inset Formula $n$
\end_inset


\begin_inset Formula \begin{equation}
n=\sigma_{B}\dfrac{R}{T}\left(k_{\Vert}-\sigma_{I}P\cos\alpha\dfrac{m}{r}\right)\label{toroidalwavenumberdef}\end{equation}

\end_inset

 which is inserted back in (
\begin_inset CommandInset ref
LatexCommand ref
reference "kperp"

\end_inset

) to get
\begin_inset Formula \begin{equation}
k_{\bot}^{2}=k_{\rho}^{2}\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2}-2\sin\alpha\dfrac{m}{r}k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert +\dfrac{m^{2}}{r^{2}}+\dfrac{1}{T^{2}}\left(k_{\Vert}-\sigma_{I}P\cos\alpha\dfrac{m}{r}\right)^{2}-k_{\Vert}^{2}\label{kperp2def}\end{equation}

\end_inset

 and 
\begin_inset Formula $k_{\rho}$
\end_inset

 is solution of the equation
\begin_inset Formula \begin{equation}
k_{\rho}^{2}\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2}-2\sin\alpha\dfrac{m}{r}k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert +\left(1+\dfrac{P^{2}}{T^{2}}\cos^{2}\alpha\right)\dfrac{m^{2}}{r^{2}}+\dfrac{P^{2}}{T^{2}}k_{\Vert}^{2}-2\sigma_{I}\dfrac{P}{T^{2}}\cos\alpha\dfrac{m}{r}k_{\Vert}-k_{\bot}^{2}=0\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Defining
\begin_inset Formula \begin{equation}
X=k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert \end{equation}

\end_inset

 and
\begin_inset Formula \begin{align}
B & =\sin\alpha\dfrac{m}{r}\\
C & =\left(1+\dfrac{P^{2}}{T^{2}}\cos^{2}\alpha\right)\dfrac{m^{2}}{r^{2}}+\dfrac{P^{2}}{T^{2}}k_{\Vert}^{2}-2\sigma_{I}\dfrac{P}{T^{2}}\dfrac{m}{r}k_{\Vert}\cos\alpha-k_{\bot}^{2}\end{align}

\end_inset

 we have
\begin_inset Formula \begin{equation}
X^{2}-2BX+C=0\end{equation}

\end_inset

 such that
\begin_inset Formula \begin{equation}
X=B\pm\sqrt{B^{2}-C}\end{equation}

\end_inset

 which gives
\begin_inset Formula \begin{equation}
k_{\rho}=\dfrac{1}{\left\Vert \mathbf{\nabla}\rho\right\Vert }\left[\sin\alpha\dfrac{m}{r}\pm\sqrt{k_{\bot}^{2}-\dfrac{1}{T^{2}}\left(\cos\alpha\dfrac{m}{r}-\sigma_{I}Pk_{\Vert}\right)^{2}}\right]\end{equation}

\end_inset

 To sum up
\begin_inset Formula \begin{equation}
\fbox{$\begin{array}{l}
n=\sigma_{B}\dfrac{R}{T}\left(k_{\Vert}-\sigma_{I}P\cos\alpha\dfrac{m}{r}\right)\\
m=\sigma_{I}\dfrac{r}{P\cos\alpha}\left(k_{\Vert}-\sigma_{B}T\dfrac{n}{R}\right)\\
k_{\rho}=\dfrac{1}{\left\Vert \mathbf{\nabla}\rho\right\Vert }\left[\sin\alpha\dfrac{m}{r}+\sigma_{\rho}\sqrt{k_{\bot}^{2}-\dfrac{1}{T^{2}}\left(\cos\alpha\dfrac{m}{r}-\sigma_{I}Pk_{\Vert}\right)^{2}}\right]\end{array}$}\label{eq:nmkrho}\end{equation}

\end_inset

 where 
\begin_inset Formula $\sigma_{\rho}=\pm1$
\end_inset

.
 We can also express 
\begin_inset Formula $k_{\rho}$
\end_inset

 as 
\begin_inset Formula \begin{equation}
\fbox{$k_{\rho}=\dfrac{1}{\left\Vert \mathbf{\nabla}\rho\right\Vert }\left[\sin\alpha\dfrac{m}{r}+\sigma_{\rho}\sqrt{k^{2}-\cos^{2}\alpha\dfrac{m^{2}}{r^{2}}-\dfrac{n^{2}}{R^{2}}}\right]$}\label{krhoeq}\end{equation}

\end_inset

 The correct solution for 
\begin_inset Formula $k_{\rho}$
\end_inset

 can be determined from (
\begin_inset CommandInset ref
LatexCommand ref
reference "inwardcond"

\end_inset

).
\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $k_{\rho}$
\end_inset

, 
\begin_inset Formula $m$
\end_inset

 and 
\begin_inset Formula $n$
\end_inset

 as a function of 
\begin_inset Formula $k_{R}$
\end_inset

, 
\begin_inset Formula $k_{Z}$
\end_inset

 and 
\begin_inset Formula $k_{\phi}$
\end_inset


\end_layout

\begin_layout Standard
The vector 
\begin_inset Formula $\mathbf{k}$
\end_inset

 is projected onto the covariant basis 
\begin_inset Formula \begin{equation}
\mathbf{e}_{i}=\left(\dfrac{\mathbf{\hat{r}}}{\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha},\dfrac{r\mathbf{\hat{s}}}{\cos\alpha},R\mathbf{\hat{\phi}}\right)\end{equation}

\end_inset

 such that 
\begin_inset Formula \begin{equation}
\begin{array}{l}
k_{\rho}=\dfrac{\mathbf{\hat{r}}\cdot\mathbf{k}}{\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha}\\
m=\dfrac{r\mathbf{\hat{s}}\cdot\mathbf{k}}{\cos\alpha}\\
n=R\mathbf{\hat{\phi}}\cdot\mathbf{k}\end{array}\end{equation}

\end_inset

 If 
\begin_inset Formula $\mathbf{k}$
\end_inset

 is expressed in coordinates 
\begin_inset Formula $\left(R,Z,\phi\right)$
\end_inset

 as 
\begin_inset Formula $\mathbf{k}=k_{R}\mathbf{\hat{R}}+k_{Z}\mathbf{\hat{Z}}+k_{\phi}\mathbf{\hat{\phi}}$
\end_inset

 or in coordinates 
\begin_inset Formula $\left(r,\theta,\phi\right)$
\end_inset

 as 
\begin_inset Formula $\mathbf{k}=k_{r}\mathbf{\hat{r}}+k_{\theta}\mathbf{\hat{\theta}}+k_{\phi}\mathbf{\hat{\phi}}$
\end_inset

 we get
\begin_inset Formula \begin{equation}
\begin{array}{l}
k_{\rho}=\dfrac{k_{r}}{\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha}\\
m=r\left(k_{\theta}+k_{r}\tan\alpha\right)\\
n=Rk_{\phi}\end{array}\label{projection}\end{equation}

\end_inset

 where
\begin_inset Formula \begin{equation}
\begin{array}{l}
k_{r}=k_{R}\cos\theta+k_{Z}\sin\theta\\
k_{\theta}=-k_{R}\sin\theta+k_{Z}\cos\theta\end{array}\end{equation}

\end_inset

 Note that we retrieve
\begin_inset Formula \begin{equation}
\begin{array}{l}
k_{\Vert}=\sigma_{I}P\left(\mathbf{\hat{s}}\cdot\mathbf{k}\right)+\sigma_{B}T\left(\mathbf{\hat{\phi}}\cdot\mathbf{k}\right)=\dfrac{\mathbf{B}\cdot\mathbf{k}}{\left\Vert \mathbf{B}\right\Vert }\\
k_{\bot}=\sqrt{\left[\left(\mathbf{\hat{\rho}}\cdot\mathbf{k}\right)^{2}+\left(\mathbf{\hat{s}}\cdot\mathbf{k}\right)^{2}+\left(\mathbf{\hat{\phi}}\cdot\mathbf{k}\right)^{2}-k_{\Vert}^{2}\right]}=\sqrt{k^{2}-k_{\Vert}^{2}}\end{array}\end{equation}

\end_inset

 since
\begin_inset Formula \begin{equation}
\begin{array}{l}
\mathbf{\hat{s}}\cdot\mathbf{k}=\sin\alpha k_{r}+\cos\alpha k_{\theta}\\
\mathbf{\hat{\rho}}\cdot\mathbf{k}=\cos\alpha k_{r}-\sin\alpha k_{\theta}\end{array}\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Wave scattering by fluctuations
\end_layout

\begin_layout Standard
Low frequency fluctuations of the electron density or the magnetic field
 can strongly affect the propagation of rf waves in a magnetized plasma.
 This effect has been extensively investigated for the Lower Hybrid wave
 by solving a wave kinetic equation in the weak turbulence approximation.
 
\begin_inset CommandInset citation
LatexCommand citep
key "bon82,vah92"

\end_inset

.
 In this approach, the flow of rf energy is described by a usual ray-tracing
 between random scattering events where the initial wave vector 
\begin_inset Formula $\mathbf{k}$
\end_inset

 can be modified both in amplitude and direction with the constraint to
 remain solution of the local dispersion relation.
 This physical mechanism is a good candidate for explaining a possible strong
 upshift of the power spectrum as the Lower Hybrid wave propagates in the
 plasma, even if the toroidal mode coupling for bridging the spectral gap
 is very weak.
 Though primarily dedicated to the Lower Hybrid wave, the concept of wave
 scattering by low frequency density or magnetic field fluctuations can
 be easily extended to other types of rf waves provided that 
\begin_inset Formula $\widetilde{k}_{\Vert}\ll k_{\Vert}$
\end_inset

 and 
\begin_inset Formula $\widetilde{\omega}\ll\omega$
\end_inset

, where 
\begin_inset Formula $k_{\Vert}=\mathbf{k}\cdot\mathbf{b}$
\end_inset

 and 
\begin_inset Formula $\widetilde{k}_{\Vert}=\mathbf{\widetilde{k}}\cdot\mathbf{b}$
\end_inset

 are the projections of the rf and fluctuation wave vectors respectively
 along the direction of the local magnetic field 
\begin_inset Formula $\mathbf{b}=\mathbf{B}/\left\Vert \mathbf{B}\right\Vert $
\end_inset

, while 
\begin_inset Formula $\omega$
\end_inset

 and 
\begin_inset Formula $\widetilde{\omega}$
\end_inset

 are the rf and fluctuation frequencies respectively.
 Consequently, the scattering process becomes a two dimensional problem
 in the plane perpendicular to the local magnetic field direction, a reasonable
 assumption regarding the large difference between the long wave length
 of the low frequency fluctuations and the short length of the rf waves
 along 
\begin_inset Formula $\mathbf{b}$
\end_inset

.
\begin_inset Foot
status open

\begin_layout Plain Layout
The parallel wave length 
\begin_inset Formula $\lambda_{\Vert}$
\end_inset

 is related to the parallel refractive index 
\begin_inset Formula $N_{\Vert}$
\end_inset

 of the rf wave by the simple relation 
\begin_inset Formula $\lambda_{\Vert}=c/fN_{\Vert},$
\end_inset

where 
\begin_inset Formula $f=\omega/2\pi$
\end_inset

.
 For the Lower Hybrid wave at 
\begin_inset Formula $f_{LH}=3.7GHz$
\end_inset

 and 
\begin_inset Formula $N_{\Vert LH}$
\end_inset


\begin_inset Formula $\simeq2$
\end_inset

, 
\begin_inset Formula $\lambda_{\Vert LH}$
\end_inset


\begin_inset Formula $\simeq2cm$
\end_inset

.
 From turwhich is much less than the wave length 
\begin_inset Formula $\widetilde{\lambda}_{\Vert}\simeq***cm$
\end_inset

 of density fluctuation along the parallel direction.
 For the Electron Cyclotron wave, 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $f_{EC}=110GHz$
\end_inset

 and 
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit

\begin_inset Formula $N_{\Vert EC}$
\end_inset


\begin_inset Formula $\simeq0.2$
\end_inset

, so that 
\begin_inset Formula $\lambda_{\Vert EC}$
\end_inset


\begin_inset Formula $\simeq2cm$
\end_inset

 is even smaller than 
\begin_inset Formula $\lambda_{\Vert LH}$
\end_inset


\begin_inset Formula $\simeq2cm$
\end_inset

 as compared to 
\begin_inset Formula $\widetilde{\lambda}_{\Vert}$
\end_inset

.
 
\end_layout

\end_inset


\end_layout

\begin_layout Standard
Calculations are organized in three steps.
 In the first section, the components of the scattered rf wave vector are
 calculated, according to the curvilinear coordinate system chosen for describin
g the magnetic equilibrium in C3PO.
 The wave kinetic equation corresponding to the wave-wave interaction is
 then derived from first principles in the second section.
 Finally, in the third section, the wave kinetic equation is solved using
 a Monte-Carlo method and the procedure for the numerical implementation
 in the code is explicited.
\end_layout

\begin_layout Standard
Before entering into the details of the calculations, it is possible to
 estimate the impact of a simple transfer from the toroidal mode number
 
\begin_inset Formula $n$
\end_inset

 to the poloidal one 
\begin_inset Formula $m$
\end_inset

 at fixed 
\begin_inset Formula $k_{\Vert0}$
\end_inset

 on the ray properties, by changing the initial conditions.
 The benchmark case presented in Sec.
\begin_inset CommandInset ref
LatexCommand ref
reference "sub:JET-like-plasma"

\end_inset

 is considered using 
\begin_inset Formula $N_{\phi0}=-1.8$
\end_inset

.
 From a scan of 
\begin_inset Formula $m$
\end_inset


\begin_inset Formula $\in\left\{ -300,300\right\} $
\end_inset

 with steps 
\begin_inset Formula $\Delta m=50$
\end_inset

, it is possible to show that a variation of 
\begin_inset Formula $m$
\end_inset

 and 
\begin_inset Formula $n$
\end_inset

 strongly affect the ray propagation, even if 
\begin_inset Formula $k_{\Vert0}$
\end_inset

 remains unchanged.
 
\end_layout

\begin_layout Subsubsection
Calculation of the scattered wave vector
\end_layout

\begin_layout Standard
When the rf wave vector 
\begin_inset Formula $\mathbf{k}$
\end_inset

 is scattered by low density fluctuations, it may change both in module
 and direction, with the conditions
\begin_inset Formula \begin{equation}
\mathbf{k}\cdot\mathbf{b}=\mathbf{k}^{\prime}\cdot\mathbf{b}=k_{\Vert}\label{eq:kparconservation}\end{equation}

\end_inset

where 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\mathbf{k}^{\prime}$
\end_inset

 is the scattered wave vector.
 Its perpendicular component 
\begin_inset Formula $k_{\bot}^{\prime}=\left\Vert \mathbf{k}_{\bot}^{\prime}\right\Vert $
\end_inset

, where 
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit

\begin_inset Formula $\mathbf{k}_{\bot}^{\prime}=\mathbf{k^{\prime}}\times\mathbf{b}$
\end_inset

,
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none
 is determined by solving the local dispersion relation (
\begin_inset CommandInset ref
LatexCommand ref
reference "disprel"

\end_inset

) at fixed 
\begin_inset Formula $k_{\Vert}$
\end_inset

, and its direction results from a rotation 
\begin_inset Formula $\mathcal{R}_{\beta}$
\end_inset

 of an angle 
\begin_inset Formula $\beta$
\end_inset

 around the magnetic field direction 
\begin_inset Formula $\mathbf{b}$
\end_inset

 so that
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit

\begin_inset Formula \begin{equation}
\mathbf{k}_{\bot}\cdot\mathbf{k}_{\bot}^{\prime}=k_{\bot}k_{\bot}^{\prime}\cos\beta\label{eq:wskperprotation}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
For unlike transitions, the scattered wave moves to a different branch of
 propagation and 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $k_{\bot}^{\prime}\neq k_{\bot}$
\end_inset

, otherwise 
\begin_inset Formula $k_{\bot}^{\prime}=k_{\bot}$
\end_inset

 for like transitions.
 From the relations (
\begin_inset CommandInset ref
LatexCommand ref
reference "disprel"

\end_inset

), (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:kparconservation"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wskperprotation"

\end_inset

), all the components 
\begin_inset Formula $\left(k_{\rho}^{\prime},m^{\prime},n^{\prime}\right)$
\end_inset

 of 
\begin_inset Formula $\mathbf{k}^{\prime}$
\end_inset

 can be deduced from those of 
\begin_inset Formula $\mathbf{k}$
\end_inset

.
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
In Ref.
 
\begin_inset CommandInset citation
LatexCommand citet
key "bon82"

\end_inset

, the relation 
\begin_inset Formula $\mathbf{b}\cdot\left(\mathbf{k}_{\bot}\times\mathbf{k}_{\bot}^{\prime}\right)=k_{\bot}k_{\bot}^{\prime}\sin\beta$
\end_inset

 is also introduced in addition to (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:kparconservation"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wskperprotation"

\end_inset

).
 However, it is fully equivalent to (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wskperprotation"

\end_inset

) and does not provide any additional information.
 
\end_layout

\end_inset

 
\end_layout

\begin_layout Standard
The wave scattering may be therefore described as a two steps process, and
 the mode conversion 
\begin_inset Formula $\mathcal{M}$
\end_inset

 and the rotation 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\mathcal{R}_{\beta}$
\end_inset

.
 
\end_layout

\begin_layout Subsubsection
Derivation of the wave kinetic equation
\end_layout

\begin_layout Subsubsection
Solution of the wave kinetic equation
\end_layout

\begin_layout Standard
Using the Rodrigues general formula for the rotation 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula $\mathcal{R}_{\beta}$
\end_inset


\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
 of a vector 
\begin_inset Formula $\mathbf{k}$
\end_inset

, 
\begin_inset Formula \begin{equation}
\mathbf{\widetilde{k}}=\mathcal{R}_{\beta}\left(\mathbf{k}\right)=\cos\beta\mathbf{k}+\left(1-\cos\beta\right)\left(\mathbf{k}\cdot\mathbf{b}\right)\mathbf{b}+\sin\beta\left(\mathbf{b}\times\mathbf{k}\right)\label{eq:rodrigues}\end{equation}

\end_inset

it turns out that each components of 
\begin_inset Formula $\mathbf{\widetilde{k}}$
\end_inset

 is given by the relations 
\begin_inset Formula \begin{multline*}
\mathbf{\widetilde{k}}\cdot\widehat{\rho}=\cos\beta\mathbf{k\cdot\widehat{\rho}}+\left(1-\cos\beta\right)\left(\mathbf{k}\cdot\mathbf{b}\right)\mathbf{b}\cdot\widehat{\rho}+\sin\beta\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\rho}\\
\mathbf{\widetilde{k}}\cdot\widehat{\theta}=\cos\beta\mathbf{k\cdot\widehat{\theta}}+\left(1-\cos\beta\right)\left(\mathbf{k}\cdot\mathbf{b}\right)\mathbf{b}\cdot\widehat{\theta}+\sin\beta\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\theta}\\
\mathbf{\widetilde{k}}\cdot\widehat{\phi}=\cos\beta\mathbf{k\cdot\widehat{\phi}}+\left(1-\cos\beta\right)\left(\mathbf{k}\cdot\mathbf{b}\right)\mathbf{b}\cdot\widehat{\phi}+\sin\beta\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\phi}\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
Using the vectorial relations 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula \begin{multline*}
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\rho}=\left(\widehat{\rho}\times\mathbf{b}\right)\cdot\mathbf{k}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\theta}=\left(\widehat{\theta}\times\mathbf{b}\right)\cdot\mathbf{k}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\phi}=\left(\widehat{\phi}\times\mathbf{b}\right)\cdot\mathbf{k}\end{multline*}

\end_inset


\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
and the expression on the magnetic field 
\begin_inset Formula $\mathbf{b}=\sigma_{B}T\mathbf{\widehat{\phi}}+\sigma_{I}P\mathbf{\hat{s}}$
\end_inset

 according to the relation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Bfield"

\end_inset

), recalling that 
\begin_inset Formula $T=B_{T}/B$
\end_inset

 and 
\begin_inset Formula $P=B_{P}/B$
\end_inset

, one obtains
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula \begin{multline*}
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\rho}=\sigma_{B}T\left(\mathbf{\widehat{\rho}\times\widehat{\phi}}\right)\cdot\mathbf{k}+\sigma_{I}P\left(\mathbf{\widehat{\rho}\times\hat{s}}\right)\cdot\mathbf{k}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\theta}=\sigma_{B}T\left(\mathbf{\widehat{\theta}\times\widehat{\phi}}\right)\cdot\mathbf{k}+\sigma_{I}P\left(\mathbf{\widehat{\theta}\times\hat{s}}\right)\cdot\mathbf{k}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\phi}=\sigma_{B}T\left(\mathbf{\widehat{\phi}\times\widehat{\phi}}\right)\cdot\mathbf{k}+\sigma_{I}P\left(\mathbf{\widehat{\phi}\times\hat{s}}\right)\cdot\mathbf{k}\end{multline*}

\end_inset

which simplifies to
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
 
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula \begin{multline*}
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\rho}=-\sigma_{B}T\hat{\mathbf{s}}\cdot\mathbf{k}+\sigma_{I}P\widehat{\phi}\cdot\mathbf{k}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\theta}=\sigma_{B}T\widehat{\mathbf{r}}\cdot\mathbf{k}-\sigma_{I}P\sin\alpha\widehat{\phi}\cdot\mathbf{k}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\phi}=-\sigma_{I}P\widehat{\rho}\cdot\mathbf{k}\end{multline*}

\end_inset

since
\family default
\series default
\shape default
\size default
\emph default
\bar default
\noun default
\color inherit
 
\begin_inset Formula \begin{multline*}
\widehat{\rho}\times\widehat{\phi}=-\widehat{\mathbf{s}}\\
\mathbf{\widehat{\theta}\times\widehat{\phi}}=\widehat{\mathbf{r}}\end{multline*}

\end_inset

and 
\begin_inset Formula \begin{multline*}
\mathbf{\widehat{\rho}\times\hat{s}}=\widehat{\phi}\\
\mathbf{\widehat{\theta}\times\hat{s}}=-\sin\alpha\widehat{\phi}\\
\mathbf{\widehat{\phi}\times\hat{s}}=-\widehat{\rho}\end{multline*}

\end_inset

using the relations 
\begin_inset Formula $\hat{\mathbf{s}}=\sin\alpha\widehat{\mathbf{r}}+\cos\alpha\widehat{\theta}$
\end_inset

 and 
\begin_inset Formula $\widehat{\theta}=\mathbf{\widehat{\phi}\times\hat{r}}$
\end_inset

.
 Using (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wavevector"

\end_inset

),
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\noun off
\color none

\begin_inset Formula \begin{multline*}
\hat{\mathbf{s}}\cdot\mathbf{k=}\dfrac{m}{r}\cos\alpha\\
\widehat{\phi}\cdot\mathbf{k}=\frac{n}{R}\\
\widehat{\mathbf{r}}\cdot\mathbf{k}=k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha\\
\widehat{\rho}\cdot\mathbf{k}=k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert -\sin\alpha\dfrac{m}{r}\\
\widehat{\theta}\cdot\mathbf{k}=-\sin\alpha k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert +\dfrac{m}{r}\end{multline*}

\end_inset

and
\begin_inset Formula \begin{multline*}
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\rho}=-\sigma_{B}T\dfrac{m}{r}\cos\alpha+\sigma_{I}P\frac{n}{R}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\theta}=\sigma_{B}Tk_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha-\sigma_{I}P\sin\alpha\frac{n}{R}\\
\left(\mathbf{b}\times\mathbf{k}\right)\cdot\widehat{\phi}=-\sigma_{I}P\left(k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert -\sin\alpha\dfrac{m}{r}\right)\end{multline*}

\end_inset


\end_layout

\begin_layout Standard
Finally, since
\begin_inset Formula \begin{multline*}
\mathbf{b}\cdot\widehat{\rho}=0\\
\mathbf{b}\cdot\widehat{\theta}=\sigma_{I}P\cos\alpha\\
\mathbf{b}\cdot\widehat{\phi}=\sigma_{B}T\end{multline*}

\end_inset

one obtains 
\begin_inset Formula \begin{multline*}
\widetilde{k}_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert -\sin\alpha\dfrac{\widetilde{m}}{r}=\cos\beta\left(k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert -\sin\alpha\dfrac{m}{r}\right)+\sin\beta\left(-\sigma_{B}T\dfrac{m}{r}\cos\alpha+\sigma_{I}P\frac{n}{R}\right)\\
-\sin\alpha\widetilde{k}_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert +\dfrac{\widetilde{m}}{r}=\cos\beta\left(-\sin\alpha k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert +\dfrac{m}{r}\right)+\left(1-\cos\beta\right)k_{\Vert}\sigma_{I}P\cos\alpha+\sin\beta\left(\sigma_{B}Tk_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert \cos\alpha-\sigma_{I}P\sin\alpha\frac{n}{R}\right)\\
\frac{\widetilde{n}}{R}=\cos\beta\frac{n}{R}+\left(1-\cos\beta\right)k_{\Vert}\sigma_{B}T-\sin\beta\sigma_{I}P\left(k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert -\sin\alpha\dfrac{m}{r}\right)\end{multline*}

\end_inset

or
\begin_inset Formula \begin{multline}
\widetilde{k}_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert =\cos\beta k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert +\left(1-\cos\beta\right)k_{\Vert}\sigma_{I}P\tan\alpha+\sin\beta\left(\frac{\sigma_{B}T}{\cos\alpha}\left(k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha-\frac{m}{r}\right)+\sigma_{I}P\frac{n}{R}\right)\\
\dfrac{\widetilde{m}}{r}=\cos\beta\dfrac{m}{r}+\left(1-\cos\beta\right)k_{\Vert}\frac{\sigma_{I}P}{\cos\alpha}+\sin\beta\frac{\sigma_{B}T}{\cos\alpha}\left(k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert -\frac{m}{r}\sin\alpha\right)\\
\frac{\widetilde{n}}{R}=\cos\beta\frac{n}{R}+\left(1-\cos\beta\right)k_{\Vert}\sigma_{B}T+\sin\beta\sigma_{I}P\left(-k_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert +\sin\alpha\dfrac{m}{r}\right)\label{eq:kscattered}\end{multline}

\end_inset

where 
\begin_inset Formula $\mathbf{k}\cdot\mathbf{b}=k_{\Vert}$
\end_inset

 and the scattered wave vector is 
\begin_inset Formula \begin{equation}
\widetilde{\mathbf{k}}=\widetilde{k}_{\rho}\left\Vert \mathbf{\nabla}\rho\right\Vert \widehat{\mathbf{\rho}}+\dfrac{\widetilde{m}}{r}\widehat{\mathbf{\theta}}+\dfrac{\widetilde{n}}{R}\widehat{\mathbf{\phi}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
If 
\begin_inset Formula $\beta=0,$
\end_inset

 it is straightforward to demonstrate that 
\begin_inset Formula $\widetilde{\mathbf{k}}=\mathbf{k}$
\end_inset

.
 In addition, the relation 
\begin_inset Formula $\mathbf{\widetilde{\mathbf{k}}\cdot\mathbf{b}}=\mathbf{\mathbf{k}\cdot\mathbf{b}}$
\end_inset

 or
\begin_inset Formula \begin{equation}
\sigma_{I}b_{P}\dfrac{\widetilde{m}}{r}\cos\alpha+\sigma_{B}b_{T}\dfrac{\widetilde{n}}{R}=\sigma_{I}b_{P}\dfrac{m}{r}\cos\alpha+\sigma_{B}b_{T}\dfrac{n}{R}\label{eq:ws1}\end{equation}

\end_inset

is also well satisfied whatever 
\begin_inset Formula $\beta$
\end_inset

, as expected from the initial assumption on the invariance of 
\begin_inset Formula $k_{\Vert}$
\end_inset

 with the rotation of angle 
\begin_inset Formula $\beta$
\end_inset

, which is intrinsically considered in the Rodrigues formula (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:rodrigues"

\end_inset

).
\end_layout

\begin_layout Standard
In the cold limit approximation, the plasma has bi-refringent optical properties
 which means that for a given 
\begin_inset Formula $k_{\Vert}$
\end_inset

, the dispersion relation cannot have more than two different roots in 
\begin_inset Formula $k_{\bot}$
\end_inset

.
 
\end_layout

\begin_layout Standard
From the definitions 
\begin_inset Formula $\mathbf{k}_{\bot}=\mathbf{k}\times\mathbf{b}$
\end_inset

 and 
\begin_inset Formula $\mathbf{k}_{\bot}^{\prime}=\mathbf{k}^{\prime}\times\mathbf{b}$
\end_inset

, the relation 
\begin_inset Formula $\mathbf{k}_{\bot}\cdot\mathbf{k}_{\bot}^{\prime}=k_{\bot}k_{\bot}^{\prime}\cos\beta$
\end_inset

 becomes
\begin_inset Formula \[
\left(\mathbf{k}\times\mathbf{b}\right)\cdot\left(\mathbf{k}^{\prime}\times\mathbf{b}\right)=\left(\mathbf{k}\cdot\mathbf{k}^{\prime}\right)\left(\mathbf{b}\cdot\mathbf{b}\right)-\left(\mathbf{k}\cdot\mathbf{b}\right)\left(\mathbf{b\cdot}\mathbf{k}^{\prime}\right)=\mathbf{k}\cdot\mathbf{k}^{\prime}-k_{\Vert}^{2}\]

\end_inset

and 
\begin_inset Formula \begin{equation}
k_{\bot}k_{\bot}^{\prime}\cos\beta=k_{\rho}k_{\rho}^{\prime}\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2}+\dfrac{mm^{\prime}}{r^{2}}+\dfrac{nn^{\prime}}{R^{2}}-\frac{\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r}\left(mk_{\rho}^{\prime}+m^{\prime}k_{\rho}\right)-k_{\Vert}^{2}\label{eq:ws2}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
For like mode scattering, 
\begin_inset Formula $k_{\bot}^{\prime}=k_{\bot}$
\end_inset

 and 
\begin_inset Formula \begin{equation}
k_{\bot}^{2}\cos\beta=k_{\rho}k_{\rho}^{\prime}\left\Vert \mathbf{\nabla}\rho\right\Vert ^{2}+\dfrac{mm^{\prime}}{r^{2}}+\dfrac{nn^{\prime}}{R^{2}}-\frac{\left\Vert \mathbf{\nabla}\rho\right\Vert \sin\alpha}{r}\left(mk_{\rho}^{\prime}+m^{\prime}k_{\rho}\right)-k_{\Vert}^{2}\label{eq:ws2like}\end{equation}

\end_inset

a relation which can be well verified by replacing 
\begin_inset Formula $\left(k_{\rho}^{\prime}\left\Vert \mathbf{\nabla}\rho\right\Vert ,\dfrac{m^{\prime}}{r},\dfrac{n^{\prime}}{R}\right)$
\end_inset

 from (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:kscattered"

\end_inset

) into (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:ws2like"

\end_inset

).
 Therefore, for like mode scattering, 
\begin_inset Formula $\left(k_{\rho}^{\prime},m^{\prime},n^{\prime}\right)$
\end_inset

 have just to be deduced from (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:kscattered"

\end_inset

) knowing 
\begin_inset Formula $\left(k_{\rho},m,n\right)$
\end_inset

.
\end_layout

\begin_layout Standard
For unlike mode scattering, 
\begin_inset Formula $k_{\bot}^{\prime}\neq k_{\bot}$
\end_inset

, 
\end_layout

\begin_layout Standard
Therefore, The coordinates of 
\begin_inset Formula $\mathbf{k}^{\prime}$
\end_inset

 are therefore determined by relations (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wskparconservation"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:wskperprotation"

\end_inset

) and (
\begin_inset CommandInset ref
LatexCommand ref
reference "krhoeq"

\end_inset

), 
\begin_inset Formula \begin{equation}
k_{\rho}^{\prime}=\dfrac{1}{\left\Vert \mathbf{\nabla}\rho\right\Vert }\left[\sin\alpha\dfrac{m^{\prime}}{r}+\sigma_{\rho}\sqrt{k_{\Vert}^{2}+k_{\bot}^{\prime2}-\cos^{2}\alpha\dfrac{m^{\prime2}}{r^{2}}-\dfrac{n^{\prime2}}{R^{2}}}\right]\label{eq:wskrho}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
By definition, the variation of the poloidal mode number 
\begin_inset Formula $m$
\end_inset

 is made possible by the breaking of the toroidal symmetry resulting from
 the fluctuations, so that the toroidal mode number 
\begin_inset Formula $n$
\end_inset

 is no more conserved in the scattering process.
\end_layout

\begin_layout Subsection
Calculation of 
\begin_inset Formula $\left\Vert \mathbf{\nabla}\rho\right\Vert $
\end_inset


\end_layout

\begin_layout Standard
So far the only restriction over the radial coordinate 
\begin_inset Formula $\rho$
\end_inset

 is that it is a monotonic flux function going from 
\begin_inset Formula $0$
\end_inset

 at the center to 
\begin_inset Formula $1$
\end_inset

 at the edge.
 In the code we take 
\begin_inset Formula $\rho\left(\psi\right)=r\left(\psi,0\right)/a_{p}$
\end_inset

 where 
\begin_inset Formula $r$
\end_inset

 is defined as a function of 
\begin_inset Formula $\left(\psi,\theta\right)$
\end_inset

 and 
\begin_inset Formula $a_{p}=r\left(\psi_{a},0\right)$
\end_inset

.
 Using 
\begin_inset Formula \begin{equation}
\mathbf{\nabla}\rho=\dfrac{d\rho}{d\psi}\left\Vert \mathbf{\nabla}\psi\right\Vert \mathbf{\hat{\psi}}\end{equation}

\end_inset

 we find
\begin_inset Formula \begin{equation}
\fbox{$\left\Vert \mathbf{\nabla}\rho\right\Vert =\left.\dfrac{\partial r}{\partial\psi}\right\vert _{\theta=0}\dfrac{RB_{P}}{a_{p}}$}\end{equation}

\end_inset


\end_layout

