\begin_layout Standard
A JET-like equilibrium was used in Ref.
\begin_inset CommandInset citation
LatexCommand citet
key "hei99"

\end_inset

 where results from a ray-tracing code using the cold plasma model is presented.
 A circular concentric toroidal plasma is considered such that
\begin_inset Formula \begin{equation}
\rho=\dfrac{r}{a_{p}}\end{equation}

\end_inset

 with the following equilibrium parameters
\begin_inset Formula \begin{equation}
\begin{tabular}{|c|c|}
\hline  $R_{p}$  &  $3.05\text{ m}$\\
\hline $a_{p}$  &  $0.95\text{ m}$\\
\hline $\hat{B}_{T}$  &  $3.2\text{ T}$\\
\hline $I_{p}$  &  $3.5\text{ MA}$\\\hline \end{tabular}\end{equation}

\end_inset

 and the following profiles
\begin_inset Formula \begin{equation}
\begin{array}{l}
n_{e}\left(\rho\right)=\left(n_{e0}-n_{ea}\right)\left(1-\rho^{2}\right)+n_{ea}\\
J_{z}\left(\rho\right)=J_{0}\left(1-\rho^{2}\right)^{\alpha}\end{array}\end{equation}

\end_inset

 with
\begin_inset Formula \begin{equation}
\begin{array}{l}
n_{e0}=5\times10^{19}\text{ m}^{-3}\\
n_{ea}=0.01\times10^{19}\text{ m}^{-3}\end{array}\end{equation}

\end_inset

 The total current is then
\begin_inset Formula \begin{equation}
I_{P}=2\pi\int_{0}^{a_{p}}J_{z}rdr=\pi J_{0}\dfrac{a_{p}^{2}}{\left(\alpha+1\right)}\end{equation}

\end_inset

 such that 
\begin_inset Formula \begin{equation}
J_{0}=\dfrac{\left(\alpha+1\right)I_{P}}{\pi a_{p}^{2}}\end{equation}

\end_inset

 The magnetic field profile is 
\begin_inset Formula \begin{equation}
\begin{array}{l}
B_{T}=\hat{B}_{T}\dfrac{R_{p}}{R}\\
B_{P}=\hat{B}_{P}\dfrac{R_{p}}{R}\end{array}\end{equation}

\end_inset

 Ampere's law gives in the small aspect ratio limit (consistent with concentric
 flux surfaces) 
\begin_inset Formula \begin{equation}
\dfrac{1}{r}\dfrac{d}{dr}\left(r\hat{B}_{P}\right)=\mu_{0}J_{z}\end{equation}

\end_inset

 we get
\begin_inset Formula \begin{equation}
\hat{B}_{P}=\dfrac{1}{r}\mu_{0}J_{0}\int_{0}^{r}r\left(1-\dfrac{r^{2}}{a_{p}^{2}}\right)^{\alpha}dr=\dfrac{\hat{B}_{Pa}}{\rho}\left[1-\left(1-\rho^{2}\right)^{\alpha+1}\right]\end{equation}

\end_inset

 with
\begin_inset Formula \begin{equation}
\hat{B}_{Pa}=\dfrac{\mu_{0}I_{P}}{2\pi a_{p}}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The poloidal flux coordinate 
\begin_inset Formula $\psi=R_{p}\int_{0}^{r}B_{P}dr$
\end_inset

 is then
\begin_inset Formula \begin{equation}
\psi=R_{p}\dfrac{\mu_{0}I_{P}}{2\pi}\int_{0}^{\rho}\dfrac{1}{\rho}\left[1-\left(1-\rho^{2}\right)^{\alpha+1}\right]d\rho\end{equation}

\end_inset

 In the case 
\begin_inset Formula $\alpha=1$
\end_inset

 it gives
\begin_inset Formula \begin{equation}
\psi=R_{p}\dfrac{\mu_{0}I_{P}}{2\pi}\int_{0}^{\rho}\dfrac{1}{\rho}\left[1-\left(1-\rho^{2}\right)^{2}\right]d\rho\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Defining 
\begin_inset Formula $\rho=\sin\theta$
\end_inset


\begin_inset Formula \[
\begin{array}{c}
1-\rho^{2}=\cos^{2}\theta\\
d\rho=\cos\theta d\theta\end{array}\]

\end_inset

 yields
\begin_inset Formula \begin{align}
\psi & =R_{p}\dfrac{\mu_{0}I_{P}}{2\pi}\int_{0}^{\theta}\sin\theta\left[1+\cos^{2}\theta\right]\cos\theta d\theta\nonumber \\
 & =R_{p}\dfrac{\mu_{0}I_{P}}{2\pi}\rho^{2}\left[1-\dfrac{1}{4}\rho^{2}\right]\end{align}

\end_inset

 and finally for 
\begin_inset Formula $\alpha=1$
\end_inset

 we gather
\begin_inset Formula \[
\fbox{$\begin{array}{l}
J_{z}=\dfrac{2I_{P}}{\pi a_{p}^{2}}\left(1-\rho^{2}\right)\\
\hat{B}_{P}=\dfrac{\mu_{0}I_{P}}{2\pi a_{p}}\dfrac{1}{\rho}\left[1-\left(1-\rho^{2}\right)^{2}\right]\\
\psi=R_{p}\dfrac{\mu_{0}I_{P}}{2\pi}\rho^{2}\left[1-\dfrac{1}{4}\rho^{2}\right]\end{array}$}\]

\end_inset

 Note that the 
\begin_inset Formula $q$
\end_inset

 profile is approximately (to order 
\begin_inset Formula $\epsilon$
\end_inset

)
\begin_inset Formula \begin{equation}
q\simeq\dfrac{r}{R_{p}}\dfrac{B_{T}}{B_{P}}\simeq\dfrac{r}{R}\dfrac{\hat{B}_{T}}{B_{P}}\end{equation}

\end_inset

 which gives
\begin_inset Formula \begin{equation}
q\simeq q_{\max}\dfrac{\rho^{2}}{1-\left(1-\rho^{2}\right)^{\alpha+1}}\end{equation}

\end_inset

 and for 
\begin_inset Formula $\alpha=1$
\end_inset


\begin_inset Formula \begin{equation}
\fbox{$q\simeq q_{\max}\dfrac{\rho^{2}}{1-\left(1-\rho^{2}\right)^{2}}$}\end{equation}

\end_inset

 where 
\begin_inset Formula \begin{equation}
q_{\max}=\dfrac{\hat{B}_{T}}{\hat{B}_{Pa}}\dfrac{a_{p}}{R_{p}}\end{equation}

\end_inset

 Note that 
\begin_inset Formula $q\left(0\right)=q_{\max}/(1+\alpha)$
\end_inset

 and 
\begin_inset Formula $dq/d\rho\left(0\right)=0$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Wave initial conditions
\end_layout

\begin_layout Standard
The ray is launched in the slow mode from the position
\begin_inset Formula \begin{equation}
\begin{array}{l}
\rho_{0}=0.968\\
\theta_{0}=0\\
\phi_{0}=0\end{array}\end{equation}

\end_inset

 with the spectral properties
\begin_inset Formula \begin{equation}
\begin{array}{l}
\omega/\left(2\pi\right)=3.7\text{ GHz}\\
N_{\phi0}=2.0\\
m_{0}=0\end{array}\end{equation}

\end_inset

 From (
\begin_inset CommandInset ref
LatexCommand ref
reference "projection"

\end_inset

) the initial 
\begin_inset Formula $n$
\end_inset

 can be determined
\begin_inset Formula \begin{equation}
n_{0}=\dfrac{\omega R_{0}}{c}N_{\phi0}\end{equation}

\end_inset

 and then the parallel index of refraction is 
\begin_inset Formula \begin{equation}
N_{\Vert0}=\sigma_{B}\dfrac{B_{T}}{B}N_{\phi0}\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Results
\end_layout

\begin_layout Standard
The results are plotted in figures 
\begin_inset CommandInset ref
LatexCommand ref
reference "Jet20"

\end_inset

-
\begin_inset CommandInset ref
LatexCommand ref
reference "Jet20d"

\end_inset

.
 The wave is mode-converted between the slow to the fast mode several times.
 The results agree remarkably well with those from Ref.
\begin_inset CommandInset citation
LatexCommand citet
key "hei99"

\end_inset

.
 A small difference in the ray path between the analytical and the interpolated
 magnetic equilibria is observed in the case 
\begin_inset Formula $N_{\phi0}=-1.8$
\end_inset

.
 The deviation is certainly due to the ray passing near the center of the
 plasma where the numerical interpolation is intrinsically less accurate.
\end_layout

\begin_layout Subsubsection
Numerical performances
\end_layout

\begin_layout Standard
The magnetic equilibrium is defined on a numerical grid of size 
\begin_inset Formula $\left(101\times65\right)$
\end_inset

 along the radial and poloidal direction respectively.
 It is vectorized using a Fourier series expansion with 
\begin_inset Formula $32$
\end_inset

 harmonics and the Matlab built-in cubic spline interpolation for the Fourier
 coefficients.
 The vectorization procedure takes typically 
\begin_inset Formula $8.3$
\end_inset

 seconds on computer equipped with a 64 bits biprocessor AMD opteron clocked
 at 
\begin_inset Formula $2.4$
\end_inset

 GHz, with 
\begin_inset Formula $4$
\end_inset

 GBytes of RAM memory.
\end_layout

\begin_layout Standard
Ray calculation parameters for the example presented here are typical of
 tokamak current drive simulation.
 Ray parameters are stored in the memory each time the radial increment
 
\begin_inset Formula $\Delta\rho$
\end_inset

 is larger than 
\begin_inset Formula $10^{-4}$
\end_inset

.
 
\begin_inset Formula $\Delta\rho$
\end_inset

 may be adapted depending upon the problem.
 In the 
\begin_inset Formula $6^{th}$
\end_inset

 order Runge-Kutta procedure, the generalized incremental step 
\begin_inset Formula $h$
\end_inset

 is adjusted so that the norm
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
The infinite norm 
\begin_inset Formula $\left\Vert \mathbf{X}\right\Vert _{\infty}=\max_{i\in\left[1,N\right]}\left(\left\vert X_{i}\right\vert \right)$
\end_inset

 is used, where 
\begin_inset Formula $N$
\end_inset

 is the dimension of the vector 
\begin_inset Formula $\mathbf{X}.$
\end_inset


\end_layout

\end_inset

 of the variation along the six directions of extrapolation never exceeds
 the tolerance level which is set to 
\begin_inset Formula $10^{-12}$
\end_inset

.
 The tolerance level is arbitrarily chosen so that the ray trajectory as
 well as all wave parameters are independent of its value.
 Below 
\begin_inset Formula $10^{-12}$
\end_inset

, the gain on the ray accuracy is marginal while the computer time increases.
\end_layout

\begin_layout Standard
The initial time increment is set to 
\begin_inset Formula $h_{0}=10^{-4}$
\end_inset

 in normalized units, and the calculation ends when 
\begin_inset Formula $t_{\text{end}}=10000,$
\end_inset

 with a maximum of 
\begin_inset Formula $60000$
\end_inset

 values stored in the memory.
 Since the time step 
\begin_inset Formula $h$
\end_inset

 evolves along the ray trajectory depending upon the ray curvature, the
 effective number of steps is typically much less that 
\begin_inset Formula $t_{\text{end}}/h_{0}$
\end_inset

.
 For the current example 
\begin_inset Formula $t_{\text{end}}$
\end_inset

 is reached after 
\begin_inset Formula $5499$
\end_inset

 steps.
\end_layout

\begin_layout Standard
Using the numerical equilibrium, the ray trajectory is calculated in 
\begin_inset Formula $35.15$
\end_inset

 seconds, while it takes only 
\begin_inset Formula $1.21$
\end_inset

 seconds with the analytic equilibrium.
 Although the numerical equilibrium is more time consuming by at least an
 order of magnitude, typical calculation times remain at an acceptable low
 level for realistic time-dependent tokamak simulations, which require several
 hundred ray trajectories calculations.
\end_layout

