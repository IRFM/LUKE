\begin_inset CommandInset label
LatexCommand label
name "sec:Susceptibility-tensor-and"

\end_inset

Susceptibility tensor and dispersion relation
\end_layout

\begin_layout Subsection
Cold plasma model
\end_layout

\begin_layout Standard
In the cold plasma model 
\begin_inset Formula $\mathbb{X}^{s\text{C}}$
\end_inset

 is independent of 
\begin_inset Formula $\mathbf{N}$
\end_inset


\series bold
.

\series default
 Also, 
\begin_inset Formula $X_{xz}^{s\text{C}}=X_{yz}^{s\text{C}}=0$
\end_inset

 and 
\begin_inset Formula $X_{xx}^{s\text{C}}=X_{yy}^{s\text{C}}$
\end_inset

.
 
\begin_inset Formula \begin{equation}
\begin{array}{l}
X_{\bot}^{s\text{C}}\equiv X_{xx}^{s\text{C}}=X_{yy}^{s\text{C}}=-\dfrac{\overline{\omega}_{ps}^{2}}{1-\overline{\omega}_{cs}^{2}}\\
X_{\Vert}^{s\text{C}}\equiv X_{zz}^{s\text{C}}=-\overline{\omega}_{ps}^{2}\\
X_{\times}^{s\text{C}}\equiv iX_{xy}^{s\text{C}}=\dfrac{\overline{\omega}_{ps}^{2}\overline{\omega}_{cs}}{1-\overline{\omega}_{cs}^{2}}\end{array}\end{equation}

\end_inset

 Therefore, 
\begin_inset Formula $P_{3}^{\text{C}}=P_{1}^{\text{C}}=0$
\end_inset

 so that 
\begin_inset Formula \[
\mathcal{D}^{\text{C}}\left(\mathbf{k},\omega\right)=P_{4}^{\text{C}}N_{\bot}^{4}+P_{2}^{\text{C}}N_{\bot}^{2}+P_{0}^{\text{C}}\]

\end_inset

 with
\begin_inset Formula \begin{equation}
\begin{array}{l}
P_{4}^{\text{C}}=K_{\bot}^{\text{C}}\\
P_{2}^{\text{C}}=\left(N_{\Vert}^{2}-K_{\bot}^{\text{C}}\right)\left(K_{\bot}^{\text{C}}+K_{\Vert}^{\text{C}}\right)+\left(K_{\times}^{\text{C}}\right)^{2}\\
P_{0}^{\text{C}}=K_{\Vert}^{\text{C}}\left[\left(N_{\Vert}^{2}-K_{\bot}^{\text{C}}\right)^{2}-\left(K_{\times}^{\text{C}}\right)^{2}\right]\end{array}\end{equation}

\end_inset

 where 
\begin_inset Formula $K_{\bot}^{\text{C}}=1+\sum_{s}X_{\bot}^{s\text{C}}$
\end_inset

, 
\begin_inset Formula $K_{\Vert}^{\text{C}}=1+\sum_{s}X_{\Vert}^{s\text{C}}$
\end_inset

, 
\begin_inset Formula $K_{\times}^{\text{C}}=\sum_{s}X_{\times}^{s\text{C}}$
\end_inset

.
\end_layout

\begin_layout Section
\begin_inset CommandInset label
LatexCommand label
name "sec:Kinetic-plasma-model"

\end_inset

Kinetic plasma model
\end_layout

\begin_layout Standard
The kinetic plasma susceptibility tensor 
\begin_inset Formula $\mathbb{X}_{\text{M}}$
\end_inset

 for a non-relativistic is the sum over contributions from all species 
\begin_inset Formula \begin{equation}
\mathbb{X}_{\text{M}}=\sum_{s}\mathbb{X}_{\text{M}}^{s}\end{equation}

\end_inset

 
\begin_inset Formula $\mathbb{X}_{\text{M}}^{s}$
\end_inset

 being itself the sum over contributions from all harmonics numbers 
\begin_inset Formula $n$
\end_inset


\begin_inset Formula \begin{equation}
\mathbb{X}_{\text{M}}^{s}=\overline{\omega}_{ps}^{2}\zeta_{0s}\sum_{n=-\infty}^{n=+\infty}\mathbb{Y}_{\text{M}}^{s,n}\end{equation}

\end_inset

 where
\begin_inset Formula \begin{equation}
\begin{array}{l}
Y_{\text{M},xx}^{s,n}=\dfrac{n^{2}}{\lambda_{s}}\Gamma_{ns}Z_{ns}\\
Y_{\text{M},yy}^{s,n}=\left(\dfrac{n^{2}}{\lambda_{s}}\Gamma_{ns}-2\lambda_{s}n^{2}\Gamma_{ns}^{\prime}\right)Z_{ns}\\
Y_{\text{M},zz}^{s,n}=-\Gamma_{ns}\zeta_{ns}Z_{ns}^{\prime}\\
Y_{\text{M},xy}^{s,n}=i\sigma_{s}n\Gamma_{ns}^{\prime}Z_{ns}\\
Y_{\text{M},yx}^{s,n}=-Y_{\text{M},xy}^{s,n}\\
Y_{\text{M},xz}^{s,n}=-\sigma_{\Vert}\dfrac{n}{\sqrt{2\lambda_{s}}}\Gamma_{ns}Z_{ns}^{\prime}\\
Y_{\text{M},xz}^{s,n}=Y_{\text{M},zx}^{s,n}\\
Y_{\text{M},yz}^{s,n}=i\sigma_{s}\sigma_{\Vert}\sqrt{\dfrac{\lambda_{s}}{2}}\Gamma_{ns}^{\prime}Z_{ns}^{\prime}\\
Y_{\text{M},zy}^{s,n}=-Y_{\text{M},yz}^{s,n}\end{array}\label{a}\end{equation}

\end_inset

 with
\begin_inset Formula \begin{align*}
\Gamma_{ns} & =e^{-\lambda_{s}}I_{n}\left(\lambda_{s}\right)\\
Z_{ns} & =Z\left(\zeta_{ns}\right)\\
\lambda_{s} & =\left(N_{\bot}\overline{\omega}_{cs}\beta_{Ts}\right)^{2}\\
\zeta_{ns} & =\frac{1-n\overline{\omega}_{cs}}{\sqrt{2}\left\vert N_{\Vert}\right\vert \beta_{Ts}}\\
\sigma_{s} & =\text{sign}\left(q_{s}\right)\\
\sigma_{\Vert} & =\text{sign}\left(N_{\Vert}\right)\end{align*}

\end_inset

 where 
\begin_inset Formula $I_{n}\left(N_{\Vert}\right)$
\end_inset

 is the modified Bessel function of the first kind and 
\begin_inset Formula $Z\left(N_{\Vert}\right)$
\end_inset

 is the plasma dispersion function 
\begin_inset CommandInset citation
LatexCommand citet
key "bra98"

\end_inset

.
\end_layout

