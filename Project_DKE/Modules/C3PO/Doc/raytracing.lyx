\phi_{0}=0\end{array}\end{equation}

\end_inset

 with the spectral properties
\begin_inset Formula \begin{equation}
\begin{tabular}{|c|c|c|}
\hline   &  VERSATOR$\text{ II}$  &  PLT\\
\hline $\omega/\left(2\pi\right)$  &  $0.8\text{ GHz}$  &  $0.8\text{ GHz}$\\
\hline $N_{\Vert0}$  &  $5.0$  &  $1.33$\\
\hline $m_{0}$  &  $-25$  &  $+20$\\\hline \end{tabular}\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The non-zero 
\begin_inset Formula $m_{0}$
\end_inset

 arises from the fact that simulations in references 
\begin_inset CommandInset citation
